; NBIOS11.DEF *dg* 15.10.2026
; drive definition for MC CP/M NBIOS 1.x

; NDISKDEF parameters:
; - drive
; - phys. Bytes/Sector
; - phys. Sectors/Track
; - phys. Tracks/Side
; - phys. Sides / Disk
; - Disktype (MiniHD, MaxiSD, MiniDD, MaxiDD)
; - BDOS Blocks size
; - BDOS directory entries
; - BDOS checked direcory entries
; - BDOS Boot tracks (offset)
; - Format UseSSO
; - Format Gap3 length
; - Filler byte
; or
; - drive
; - drive with same parameters

; --- formats ---------------------------------------------

; PHYSICAL FORMAT: 800KB, DD, DS, 1024 BYTES/SECTOR, 5 SECTORS/TRACK, 80 TRACKS, 2048 Bytes/Block
DEFINE F800K = NDISKDEF 0,1024,5,80,2,1,MiniDD , 2048,256,256,4 , 1,54,229

; PHYSICAL FORMAT: 1.44 MB, HD, DS, 512 BYTES/SECTOR, 9 SECTORS/TRACK, 80 TRACKS, 4096 Bytes/Block
DEFINE F1440K = NDISKDEF 0,512,18,80,2,1,MiniHD , 4096,256,256,2 , 1,40,229

; PHYSICAL FORMAT: 1.4 MB, HD, DS, 1024 BYTES/SECTOR, 8 SECTORS/TRACK, 80 TRACKS, 4096 Bytes/Block
;DEFINE F1280K = NDISKDEF 0,1024,8,80,2,1,MiniHD , 4096,256,256,2 , 1,40,229

; PHYSICAL FORMAT: 1.2 MB, HD, DS, 512 BYTES/SECTOR, 15 SECTORS/TRACK, 80 TRACKS, 4096 Bytes/Block
DEFINE F1200K = NDISKDEF 0,512,15,80,2,1,MiniHD , 4096,256,256,2 , 1,40,229

; PHYSICAL FORMAT: 720 KB, DD, DS, 512 BYTES/SECTOR, 9 SECTORS/TRACK, 80 TRACKS, 2048 Bytes/Block
DEFINE F720K = NDISKDEF 0,512,9,80,2,1,MiniDD , 2048,256,256,4 , 1,40,229

; PHYSICAL FORMAT: 400KB, DD, DS, 1024 BYTES/SECTOR, 5 SECTORS/TRACK, 40 TRACKS, 2048 Bytes/Block
DEFINE F400K = NDISKDEF 0,1024,5,40,2,1,MiniDD , 2048,128,128,4 , 1,54,229

; PHYSICAL FORMAT: 250KB, SD, SS, 128 BYTES/SECTOR, 26 SECTORS/TRACK, 77 TRACKS, 2048 Bytes/Block
DEFINE IBMSD = NDISKDEF 0,128,26,77,1,6,MaxiSD , 1024,64,64,2 , 0,27,229

; PHYSICAL FORMAT: 2MB, 128 BYTES/SECTOR,64 SECTORS/TRACK, 256 TRACKS, 4096 Bytes/Block
DEFINE CF2M = NDISKDEF 0,128,64,256,1,1,IDE , 4096,256,0,1 , 0,0,0

; PHYSICAL FORMAT: 8MB, 256 BYTES/SECTOR,128 SECTORS/TRACK, 256 TRACKS, 8192 Bytes/Block
DEFINE CF8M = NDISKDEF 0,256,128,256,1,1,IDE , 8192,256,0,1 , 0,0,0

; --- drives ----------------------------------------------

NDISKDEF 0,F800K
NDISKDEF 1,F800K
NDISKDEF 2,F800K
NDISKDEF 3,F1200K
;NDISKDEF 3,F400K
NDISKDEF 4,CF8M,BOOT
NDISKDEF 5,4
NDISKDEF 6,4
NDISKDEF 7,4

; end of file
