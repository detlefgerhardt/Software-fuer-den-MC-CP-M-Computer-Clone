/* format F800K 800KB  (1024/5/80/2) */
drvprm F800K =
{
	"F800K",
	800,
	{
		1024,	/* bytes/sector */
		5,	/* sectors/track */
		80,	/* tracks/side */
		1,	/* 0=SS/1=DS */
		1,	/* 0=DD/1=SD */
		0,	/* 0=Maxi/1=Mini */
		1,	/* UseSSO */
		54,	/* gap3 length */
		0xE5	/* filler */
	}
};

