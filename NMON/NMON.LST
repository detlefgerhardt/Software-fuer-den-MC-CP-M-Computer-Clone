  266                   ;==============================================================================
  267                   ; IO Routines
  268                   ;==============================================================================
  269                   ; Output 0-terminated string, address in HL
  270                   
  271 F049  DB 21       WRSTR:	IN  A,(CO_STS)	; read status
  272 F04B  E6 01       	AND CO_TXB	; check TxRDY bit
  273 F04D  CA F049     	JP Z,WRSTR	; wait if not set
  274                   	
  275 F050  7E          	LD A,(HL)	; get char from string
  276 F051  A7          	AND A		; check if 0
  277 F052  C8          	RET Z		; -> end of string
  278                   	
  279 F053  D3 20       	OUT (CO_DAT),A	; write char to output
  280 F055  23          	INC HL		; next char in string
  281 F056  C3 F049     	JP WRSTR	; start over
  282                   
  283                   ;------------------------------------------------------------------------------
  284                   ; Console Input main routine (SYS)
  285                   ; Input -> A
  286                   
  287 F059  3A F121     CONIN:	LD A,(IOBYT)
  288 F05C  E6 03       	AND 00000011b		; console mask
  289 F05E  20 09       	JR NZ,CONI2		; -> user device
  290                   
  291 F060  DB 21       CONI1:	IN A,(CO_STS)
  292 F062  E6 02       	AND CO_RXB
  293 F064  28 FA       	JR Z,CONI1
  294                   	
  295 F066  DB 20       	IN A,(CO_DAT)		; read character
  296 F068  C9          	RET
  297                   
  298 F069  C3 F10F     CONI2:	JP USERCI  		; user device
  299                   
  300                   ;------------------------------------------------------------------------------
