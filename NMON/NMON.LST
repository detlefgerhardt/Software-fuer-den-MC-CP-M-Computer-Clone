  251                   ;==============================================================================
  252                   ; IO Routines
  253                   ;==============================================================================
  254                   ; Output 0-terminated string, address in HL
  255                   
  256 F052  DB 21       WRSTR:	IN  A,(CO_STS)	; read status
  257 F054  E6 01       	AND CO_TXB	; check TxRDY bit
  258 F056  CA F052     	JP Z,WRSTR	; wait if not set
  259                   	
  260 F059  7E          	LD A,(HL)	; get char from string
  261 F05A  A7          	AND A		; check if 0
  262 F05B  C8          	RET Z		; -> end of string
  263                   	
  264 F05C  D3 20       	OUT (CO_DAT),A	; write char to output
  265 F05E  23          	INC HL		; next char in string
  266 F05F  C3 F052     	JP WRSTR	; start over
  267                   
  268                   ;------------------------------------------------------------------------------
  269                   ; Console Input main routine (SYS)
  270                   ; Input -> A
  271                   
  272 F062  3A F12A     CONIN:	LD A,(IOBYT)
  273 F065  E6 03       	AND 00000011b		; console mask
  274 F067  20 09       	JR NZ,CONI2		; -> user device
  275                   
  276 F069  DB 21       CONI1:	IN A,(CO_STS)
  277 F06B  E6 02       	AND CO_RXB
  278 F06D  28 FA       	JR Z,CONI1
  279                   	
  280 F06F  DB 20       	IN A,(CO_DAT)		; read character
  281 F071  C9          	RET
  282                   
  283 F072  C3 F118     CONI2:	JP USERCI  		; user device
  284                   
  285                   ;------------------------------------------------------------------------------
  286                   ; Reader Input routine (SIO B)
  287                   ; Input -> A
  288                   
  289 F075  3A F12A     READIN:	LD A,(IOBYT)
  290 F078  E6 0C       	AND 00001100b
  291 F07A  CA F062     	JP Z,CONIN  		; assign: AR=T
  292                   
  293 F07D  FE 04       	CP 00000100B 
  294 F07F  C2 F11B     	JP NZ,USERRI
  295                   
  296 F082              READI1:	; assign: AR=P
  297 F082  DB F3       	IN A,(RE_STS)
  298 F084  E6 01       	AND RE_RXB
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   6
