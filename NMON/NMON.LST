  750                   ;    -------------------------
  751                   ;      1=Laufwerk an
  752                   
  753         00C0      FLO	EQU 0C0H 		; Basisadresse Floppy-Controller
  754                   ;FLO0	EQU 0C0H   	
  755                   ;FLO1	EQU 0C1H
  756                   ;FLO2	EQU 0C2H
  757                   ;FLO3	EQU 0C3H
  758                   ;FLO4	EQU 0C4H 		; Port fuer Zusatzstatus etc.
  759                   				; write REG4-Latch
  760                   				; read REG4-Status
  761                   
  762                   ;------------------------------------------------------------------------------
  763                   ; Bei einem Interrupt wird an diese Stelle gesprungen
  764                   ; Der Interrupt erfolgt vom Floppy-Controller
  765                   
  766 F134              INTEX:	; Das INT-Program arbeitet nicht als Unterprogramm
  767 F134  F1          	POP AF  		; alte Ret-Adresse vernichten
  768 F135  DB C0       	IN A,(FLO) 		; Status lesen und INT loeschen
  769 F137  FB          	EI  			; Interrupt wieder freigeben
  770 F138  ED 4D       	RETI  			; zurueck zum vorherigen Aufrufer
  771                   
  772                   ;------------------------------------------------------------------------------
  773                   ; Floppy Routinen Init
  774                   
  775 F13A  3E 02       INIFLP:	LD A,2  		; 3 = langsamste Steprate, kein SSO
  776 F13C  32 F31C     	LD (STEPRATE),A
  777                   	
  778 F13F  3E FF       	LD A,0FFH
  779 F141  32 F325     	LD (CURDRV),A 		; no current drive
  780 F144  C9          	RET 
  781                   
  782                   ;------------------------------------------------------------------------------
  783                   
  784         0038      INTVEK	EQU 38h 		; Interruptziel
  785                   
  786                   ;------------------------------------------------------------------------------
  787                   ; Haupteingang der Floppy-Routinen
  788                   ; HL = Buffer address
  789                   ; E = Physical sector (1..n)
  790                   ; D = Track (0..n-1)
  791                   ; C = Drive-code + Density + Side (REG4-Latch)
  792                   ;   7    6    5    4    3    2    1    0
  793                   ;   sso  mot  min  dens d    d    d    d
  794                   ;   sso  = seitenauswahl (0=side 0, 1=side 1)
  795                   ;   mot  = motor on code (std=0)
  796                   ;   min  = 1 bei Minilaufwerken
  797                   ;   dens = 1 bei Single Dense Aufzeichnung
  798                   ;   d = binary drive code
  799                   ;     normalerweise nur 1,2,4,8 moeglich
  800                   ;     Kombinationen moeglich, wenn binaere
  801                   ;     Dekodierung beim Laufwerk verwendet wird
  802                   ; B = 0 Set steprate and SSO-Flag (steprate in D: s00000rr, rr=steprate, s=sso)
  803                   ;   = 1 Read sector
  804                   ;   = 2 Write sector
  805                   
  806                   ; Entry SSO = 0
  807                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  11
NMON    Z80

  808 F145  AF          FLOP:	XOR A  			; SSO-Flag auf 0 setzen
