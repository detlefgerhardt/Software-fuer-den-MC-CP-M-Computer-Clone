   10                   ;*****************************************************************************
   11                   ;
   12                   ; Monitor for MC-Computer board SYS-80 and SYS-80s
   13                   ; Assembliert mit Z80ASM von SLR Systems wegen der langen
   14                   ;
   15                   ; Comment by Ulrich Haumann:
   16                   ; Treiber fuer Serielle Schnittstelle auf CPU-Platine mit UART 8251
   17                   ; implementiert.
   18                   ; Flo1 und Flo2 waehlber auf Hardware Basis Adresse 0C0h.
   19                   ; Der Mointor erwartet 64KB Ram Memory. Er darf selbst nicht
   20                   ; groesser als 4KB werden, es sein denn man schiebt die ROMSTRT
   21                   ; und CCP weiter nach unten. Der CPM Bereich verkleinert sich dann.
   22                   ; Der Monitor kopiert sich nach Reset an das Speicherende
   23                   ; auf den Wert in ROMSTRT und gibt den unteren RAM Bereich frei.
   24                   ; Dies wird auf der SYS CPU Platine mit einem Lesebefehl auf
   25                   ; Adresse 7000h erreicht. Das Eprom ist dann ausgeblendet.
   26                   ; Somit steht der Speicher durchgaengig ab 0000h bis zu ROMSTRT
   27                   ; zur Verfuehgung.
   28                   ; Das CPM BIOS fuer den MC-Computer ueberschreibt den Monitorbereich
   29                   ; ab FC00h. Alle relevanten Teile fuer den Betrieb des Rechners 
   30                   ; muessen vor FC00h plaziert werden.
   31                   ; Ergaenzung: Das betrifft alle Teile des interaktiven Monitors, der
   32                   ; dann nicht mehr funktionsfaehig ist. Funktionsfaehig bleiben nur
   33                   ; die Ein-/Ausgabe-Routinen und die Floppy-Routinen, die vom BIOS
   34                   ; benoetigt werden.
   35                   ;
   36                   ; NMON Version history
   37                   ;
   38                   ; 01.07.2026 *dg* Komplette Ueberarbeitung der Kommentate ohne funktionale Aenderungen
   39                   ; 17.10.2026 *dg* IDE Routinen geaendert
   40                   ; 25.10.2026 *dg* IDE Routinen geaendert, uebergaben von Drive, Track und Sector statt LBA Daten
   41                   ;		  added debug outputs (decimal, hex)
   42                   
   43                   ;------------------------------------------------------------------------------
   44                   ; Mapping of REG4-Latch
   45                   
   46                   ; write
   47                   ; Bit0 = Drive Select 1
   48                   ; Bit1 = Drive Select 1
   49                   ; Bit2 = Drive Select 3
   50                   ; Bit3 = Drive Select 4
   51                   ; Bit4 = FDC9239 Dens (0=DD, 1=SS)
   52                   ; Bit5 = FDC9239 Mini (0=Maxi, 1=Mini)
   53                   ; Bit6 = Motor On (Jumper) (0=Motor on, 1=Motor off)
   54                   ; Bit7 = Side Select (Jumper) (0=Side 0, 1=Side 1)
   55                   
   56                   ; read
   57                   ; Bit5 = Headload Status (0=head loaded, 1=head unloaded)
   58                   ; Bit6 = FD197x INTREQ (0=not active, 1=active)
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NMON    Z80

   59                   ; Bit7 = FD197x DRQ (0=not active, 1=actice)
   60                   
   61                   ;------------------------------------------------------------------------------
   62                   ; Constants
   63                   
   64         0000      FALSE	EQU 0
   65         FFFF      TRUE	EQU NOT FALSE
   66         000D      CR 	EQU 0DH		; carriage return
   67         000A      LF 	EQU 0AH		; line feed
   68         0007      BELL	EQU 07H		; bell
   69         00FF      RUB 	EQU 0FFH	; rub out
   70                   ;FIL 	EQU 0
   71                   ;MAX	EQU 7
   72         001B      ESC	EQU 1BH
   73                   
   74         0038      RST7	EQU 38H		; der Vektor RST7 wird fuer Breakpoints gebraucht
   75                   
   76                   ;------------------------------------------------------------------------------
   77                   ; Variant switches
   78                   
   79         000C      VERSION	EQU 12		; Version 1.2
   80                   
   81                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 7.x
   82         FFFF      DG01	EQU TRUE
   83         0000      LOAD100	EQU FALSE	; load from 100h
   84                   
   85                   ; 3 Mini drives (A..C), 1 Maxi drives (D), 1 RAM-Disk (E)
   86                   ;MINI3	EQU FALSE
   87                   
   88                   ; version for CPU80/S with UART 8251
   89         FFFF      SYS80S	EQU TRUE
   90                   
   91                   ;------------------------------------------------------------------------------
   92                   ; I/O addresses
   93                   
   94                   ; SYS80S = TRUE:  serial port of SYS-80S card ist used for console
   95                   ; SYS80S = FALSE: serial port SIO A at OUT-80 card is used for console
   96                   
   97                   ; OUT-80 card SIO B is used for reader, punch and lister
   98                   
   99                   ; Addresses of serial port UART 8251 at SYS-80s CPU card
  100         0020      SU_DAT	EQU 020H	; UART 8251 Daten
  101         0021      SU_STS	EQU 021H	; UART 8251 Control
  102         0002      SU_RXB	EQU 002h	; RX Ready Bit UART 8251
  103         0001      SU_TXB	EQU 001h	; TX Ready Bit UART 8251
  104                   
  105                   ; Addresses of serial port MC Computer OUT-80 card with SIO
  106         00F0      SA_DAT	EQU 0F0H	; SIO A Daten
  107         00F1      SA_STS	EQU 0F1H	; SIO A Control
  108         00F2      SB_DAT	EQU 0F2H	; SIO B Daten
  109         00F3      SB_STS	EQU 0F3H	; SIO B Control
  110         0001      SI_RXB	EQU 01h		; SIO RX Ready Bit
  111         0004      SI_TXB	EQU 04h		; SIO TX Ready Bit
  112                   
  113         FFFF      	IF SYS80S
  114                   
  115                   ; Console is redirected to UART on SYS-80s
  116         0020      CO_DAT	EQU SU_DAT
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NMON    Z80

  117         0021      CO_STS	EQU SU_STS
  118         0002      CO_RXB	EQU SU_RXB
  119         0001      CO_TXB	EQU SU_TXB
  120                   
  121                   	ELSE
  129                   	ENDIF
  130                   
  131                   ; Reader port (SIO B)
  132         00F2      RE_DAT	EQU SB_DAT
  133         00F3      RE_STS	EQU SB_STS
  134         0001      RE_RXB	EQU SI_RXB
  135         0004      RE_TXB	EQU SI_TXB
  136                   
  137                   ; Punch port (SIO B)
  138         00F2      PU_DAT	EQU SB_DAT
  139         00F3      PU_STS	EQU SB_STS
  140         0001      PU_RXB	EQU SI_RXB
  141         0004      PU_TXB	EQU SI_TXB
  142                   
  143                   ; List port (SIO B)
  144         00F2      LI_DAT	EQU SB_DAT
  145         00F3      LI_STS	EQU SB_STS
  146         0001      LI_RXB	EQU SI_RXB
  147         0004      LI_TXB	EQU SI_TXB
  148                   
  149                   ;------------------------------------------------------------------------------
  150                   
  151                   ; Addresses of IDE-80 CF-Adapter card
  152                   
  153         0018      IDE_BASE	EQU 018h	; IDE/CF adapter base address
  154                   
  155         0018      IDE_DATA	EQU IDE_BASE+0	; IDE Data Register
  156         0019      IDE_FEAT	EQU IDE_BASE+1	; Feature Register
  157         001A      IDE_SECCNT	EQU IDE_BASE+2	; Sector Count Register
  158         001B      IDE_LBA7	EQU IDE_BASE+3	; LBA Bits 0-7
  159         001C      IDE_LBA15	EQU IDE_BASE+4	; LBA Bits 8-15
  160         001D      IDE_LBA23	EQU IDE_BASE+5	; LBA Bits 16-23
  161         001E      IDE_HEAD	EQU IDE_BASE+6	; IDE Drive Head Register
  162         001F      IDE_STAT	EQU IDE_BASE+7	; IDE Command/Status Register
  163                   
  164                   ;------------------------------------------------------------------------------
  165                   
  166         0000      IF LOAD100
  168                   ELSE	
  169         0000      	ORG 0000h		; Start address in ROM after hardware reset
  170                   ENDIF
  171                   
  172                   	; Copy Monitor from ROM address ROMSTRT to RAM address F000
  173                   
  174 0000  31 FFFF     BEGIN:	LD SP,0FFFFh 		; set Stack to end of memory
  175 0003  3E C9       	LD A,0C9h 		; place RET command at F000h
  176 0005  32 F000     	LD (0F000h),A 		; 
  177 0008  CD F000     	CALL 0F000h 		; and call it
  178                   
  179 000B  3B          OFFS:	DEC SP  		; get return address from Stack to calculate
  180 000C  3B          	DEC SP  		; Monitor location in ROM
  181 000D  D1          	POP DE
  182 000E  21 0012     	LD HL,ROMSTRT-OFFS	; offset from BEGIN to ROMSTRT
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
NMON    Z80

  183 0011  19          	ADD HL,DE		; actual Montor address in ROM as source address in HL
  184 0012  11 F000     	LD DE,0F000h 		; dest address in DE
  185 0015  01 0FFF     	LD BC,0FFFh 		; length in BC (4KB - 1)
  186 0018  ED B0       	LDIR  			; copy
  187 001A  C3 F000     	JP 0F000h 		; jump to Monitor in RAM
  188                   
  189                   ;------------------------------------------------------------------------------
  190                   ; Start of Monitor program, ROM address 0F000h
  191                   
  192 001D              ROMSTRT:
  193                   	; Start address of Monitor in ROM
  194                   	; label must be located before .PHASE
  195                   
  196                   	.PHASE 0F000H	; monitor start address in RAM
  197                   
  198 F000  C3 F04F     	JP INIT
  199 F003  C3 F062     	JP CONIN	; Console In (-> A)
  200 F006  C3 F075     	JP READIN	; Reader In (<- SIO B)
  201 F009  C3 F08B     	JP CONOUT	; Console Out (character in C)
  202 F00C  C3 F09F     	JP PUNOUT	; Punch Out (-> SIO B)
  203 F00F  C3 F0B6     	JP LSTOUT	; List Out (-> SIO B)
  204 F012  C3 F0CD     	JP CONSTS	; Get console status, 0FFh in A, if character available
  205 F015  C3 F0E0     	JP IOGET	; Get iobyte, current configuration in A
  206 F018  C3 F0E4     	JP IOSET	; Set iobyte, new configuration in C
  207 F01B  C3 F0E9     	JP MEMCHK	; High memory in B, low memory in A
  208                   
  209 F01E              TRAP:	; trap/breakpoint entry -> RSTRT
  210                   
  211 F01E  C3 F04C     	JP RSTRT
  212                   	
  213 F021  C3 F145     	JP FLOP	 	; new floppy interface rev 1.0 (used by BIOS 3.1)
  214                   	
  215         0000      	IF NOT DG01
  218                   	ELSE
  219 F024  C3 F048     	JP ILLEGAL	; old Maxi routines removed
  220 F027  C3 F048     	JP ILLEGAL	; old Mini routines removed
  221                   	ENDIF
  222                   	
  223 F02A  C3 F39B     	JP IDERD	; Read IDE sector
  224 F02D  C3 F3B0     	JP IDEWR	; Write IDE Sector
  225 F030  C3 F530     	JP COLD		; Monitor Cold Start (no hardware init)
  226 F033  C3 F561     	JP WARM		; Monitor Warm Start (will be overwritten by BIOS with BIOS Warm Boot)
  227 F036  C3 F052     	JP WRSTR	; gibt einen 0-terminierten String aus (will be overwritten by BIOS with BIOS Warm Boot)
  228                   	
  229 F039  C3 F412     	JP DEBDEC	; debug display unsigned 16 bit value in HL (decimal)
  230 F03C  C3 F441     	JP DEBX16	; debug display unsigned 16 bit value in HL (4 digit hex)
  231 F03F  C3 F44C     	JP DEBX8	; debug display unsigned 8 bit value in A (2 digit hex)
  232                   
  233                   
  234 F042  F118        TABPTR:	DEFW TABSTART 	; Start of user jump table
  235 F044  FC59        ENDPTR:	DEFW LASTMON 	; End address of Monitor
  236 F046  F471        FREPTR:	DEFW FREEMEM 	; End of Monitor driver section. The area behind it can be overwritten by CP/M.
  237                   
  238         0000      	IF NOT DG01
  256                   	ENDIF
