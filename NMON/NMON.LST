  313 F078  E6 0C       	AND 00001100b
  314 F07A  CA F062     	JP Z,CONIN  		; assign: AR=T
  315                   
  316 F07D  FE 04       	CP 00000100B 
  317 F07F  C2 F11B     	JP NZ,USERRI
