    2                   ;*****************************************************************************
    3                   ;* NMON.Z80								     *
    4                   ;*									     *
    5                   ;* based on Mon80V1 by Ulrich Haumann 05/2026	        	             *
    6                   ;* V7.2 851216, sowie Teile aus dem Monitor von Donn Stewart ("CPU-Ville"    *
    7                   ;* Z80 Computer)                 					     *
    8                   ;* based on RDK Monitor 1.1 850129					     *
    9                   ;*                                                                           *
   10                   ;*****************************************************************************
   11                   ;
   12                   ; Monitor for MC-Computer board SYS-80 and SYS-80s
   13                   ; Assembliert mit Z80ASM von SLR Systems wegen der langen
   14                   ;
   15                   ; Comment by Ulrich Haumann:
   16                   ; Treiber fuer Serielle Schnittstelle auf CPU-Platine mit UART 8251
   17                   ; implementiert.
   18                   ; Flo1 und Flo2 waehlber auf Hardware Basis Adresse 0C0h.
   19                   ; Der Mointor erwartet 64KB Ram Memory. Er darf selbst nicht
   20                   ; groesser als 4KB werden, es sein denn man schiebt die ROMSTRT
   21                   ; und CCP weiter nach unten. Der CPM Bereich verkleinert sich dann.
   22                   ; Der Monitor kopiert sich nach Reset an das Speicherende
   23                   ; auf den Wert in ROMSTRT und gibt den unteren RAM Bereich frei.
   24                   ; Dies wird auf der SYS CPU Platine mit einem Lesebefehl auf
   25                   ; Adresse 7000h erreicht. Das Eprom ist dann ausgeblendet.
   26                   ; Somit steht der Speicher durchgaengig ab 0000h bis zu ROMSTRT
   27                   ; zur Verfuehgung.
   28                   ; Das CPM BIOS fuer den MC-Computer ueberschreibt den Monitorbereich
   29                   ; ab FC00h. Alle relevanten Teile fuer den Betrieb des Rechners 
   30                   ; muessen vor FC00h plaziert werden.
   31                   ; Ergaenzung: Das betrifft alle Teile des interaktiven Monitors, der
   32                   ; dann nicht mehr funktionsfaehig ist. Funktionsfaehig bleiben nur
   33                   ; die Ein-/Ausgabe-Routinen und die Floppy-Routinen, die vom BIOS
   34                   ; benoetigt werden.
   35                   ;
   36                   ; NMON Version history
   37                   ;
   38                   ; 01.07.2026 *dg* Komplette Ueberarbeitung der Kommentate ohne funktionale Aenderungen
   39                   ; 17.10.2026 *dg* IDE Routinen geaendert
   40                   
   41                   ;------------------------------------------------------------------------------
   42                   ; Mapping of REG4-Latch
   43                   
   44                   ; write
   45                   ; Bit0 = Drive Select 1
   46                   ; Bit1 = Drive Select 1
   47                   ; Bit2 = Drive Select 3
   48                   ; Bit3 = Drive Select 4
   49                   ; Bit4 = FDC9239 Dens (0=DD, 1=SS)
   50                   ; Bit5 = FDC9239 Mini (0=Maxi, 1=Mini)
   51                   ; Bit6 = Motor On (Jumper) (0=Motor on, 1=Motor off)
   52                   ; Bit7 = Side Select (Jumper) (0=Side 0, 1=Side 1)
   53                   
   54                   ; read
   55                   ; Bit5 = Headload Status (0=head loaded, 1=head unloaded)
   56                   ; Bit6 = FD197x INTREQ (0=not active, 1=active)
   57                   ; Bit7 = FD197x DRQ (0=not active, 1=actice)
   58                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NMON    Z80

   59                   ;------------------------------------------------------------------------------
   60                   ; Constants
   61                   
   62         0000      FALSE	EQU 0
   63         FFFF      TRUE	EQU NOT FALSE
   64         000D      CR 	EQU 0DH		; carriage return
   65         000A      LF 	EQU 0AH		; line feed
   66         0007      BELL	EQU 07H		; bell
   67         00FF      RUB 	EQU 0FFH	; rub out
   68                   ;FIL 	EQU 0
   69                   ;MAX	EQU 7
   70         001B      ESC	EQU 1BH
   71                   
   72         0038      RST7	EQU 38H		; der Vektor RST7 wird fuer Breakpoints gebraucht
   73                   
   74                   ;------------------------------------------------------------------------------
   75                   ; Variant switches
   76                   
   77         000B      VERSION	EQU 11
   78                   
   79                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 7.x
   80         FFFF      DG01	EQU TRUE
   81         0000      LOAD100	EQU FALSE	; load from 100h
   82                   
   83                   ; 3 Mini drives (A..C), 1 Maxi drives (D), 1 RAM-Disk (E)
   84                   ;MINI3	EQU FALSE
   85                   
   86                   ; version for CPU80/S with UART 8251
   87         FFFF      SYS80S	EQU TRUE
   88                   
   89                   ;------------------------------------------------------------------------------
   90                   ; I/O addresses
   91                   
   92                   ; SYS80S = TRUE:  serial port of SYS-80S card ist used for console
   93                   ; SYS80S = FALSE: serial port SIO A at OUT-80 card is used for console
   94                   
   95                   ; OUT-80 card SIO B is used for reader, punch and lister
   96                   
   97                   ; Addresses of serial port UART 8251 at SYS-80s CPU card
   98         0020      SU_DAT	EQU 020H	; UART 8251 Daten
   99         0021      SU_STS	EQU 021H	; UART 8251 Control
  100         0002      SU_RXB	EQU 002h	; RX Ready Bit UART 8251
  101         0001      SU_TXB	EQU 001h	; TX Ready Bit UART 8251
  102                   
  103                   ; Addresses of serial port MC Computer OUT-80 card with SIO
  104         00F0      SA_DAT	EQU 0F0H	; SIO A Daten
  105         00F1      SA_STS	EQU 0F1H	; SIO A Control
  106         00F2      SB_DAT	EQU 0F2H	; SIO B Daten
  107         00F3      SB_STS	EQU 0F3H	; SIO B Control
  108         0001      SI_RXB	EQU 01h		; SIO RX Ready Bit
  109         0004      SI_TXB	EQU 04h		; SIO TX Ready Bit
  110                   
  111         FFFF      	IF SYS80S
  112                   
  113                   ; Console is redirected to UART on SYS-80s
  114         0020      CO_DAT	EQU SU_DAT
  115         0021      CO_STS	EQU SU_STS
  116         0002      CO_RXB	EQU SU_RXB
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
