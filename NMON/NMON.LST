 1132                   ; Read/Write command in D (20h = READ, 30h = WRITE)
 1133                   ; Address of data in HL
 1134                   ; LBA bits 0 to 7 passed in C
 1135                   ; LBA bits 8 to 15 passed in B
 1136                   ; LBA bits 16 to 23 passed in E
 1137                   
 1138                   ; Read one IDE/CF card sector (256 bytes)
 1139                   ; HL = Buffer address
 1140                   ; E = Physical sector (1..n)
 1141                   ; D = Track (0..n-1)
 1142                   ; C = Volume (0..3)
 1143                   ; B = Command (20h = read, 30h = write)
 1144                   
 1145                   ; NEWIDE LBA assignment (8192K):
 1146                   ; 00000000 00000000 00000000
 1147                   ; 0000000d dsssssss tttttttt
 1148                   ;        E        B        C
 1149                   
 1150 F3CD  00          IDESET:	DB 0			; ide initialisation (0 = not, 1 = initalized)
 1151                   
