  147                   ;------------------------------------------------------------------------------
  148                   
  149                   ; Addresses of IDE-80 CF-Adapter card
  150                   
  151         0018      IDE_BASE	EQU 018h	; IDE/CF adapter base address
  152                   
  153         0018      IDE_DATA	EQU IDE_BASE+0	; IDE Data Register
  154         0019      IDE_FEAT	EQU IDE_BASE+1	; Feature Register
  155         001A      IDE_SECCNT	EQU IDE_BASE+2	; Sector Count Register
  156         001B      IDE_LBA7	EQU IDE_BASE+3	; LBA Bits 0-7
  157         001C      IDE_LBA15	EQU IDE_BASE+4	; LBA Bits 8-15
  158         001D      IDE_LBA23	EQU IDE_BASE+5	; LBA Bits 16-23
  159         001E      IDE_HEAD	EQU IDE_BASE+6	; IDE Drive Head Register
  160         001F      IDE_STAT	EQU IDE_BASE+7	; IDE Command/Status Register
  161                   
  162                   ;------------------------------------------------------------------------------
  163                   
  164         0000      IF LOAD100
  166                   ELSE	
  167         0000      	ORG 0000h		; Start address in ROM after hardware reset
  168                   ENDIF
  169                   
  170                   	; Copy Monitor from ROM address ROMSTRT to RAM address F000
  171                   
  172 0000  31 FFFF     BEGIN:	LD SP,0FFFFh 		; set Stack to end of memory
  173 0003  3E C9       	LD A,0C9h 		; place RET command at F000h
  174 0005  32 F000     	LD (0F000h),A 		; 
  175 0008  CD F000     	CALL 0F000h 		; and call it
  176                   
  177 000B  3B          OFFS:	DEC SP  		; get return address from Stack to calculate
  178 000C  3B          	DEC SP  		; Monitor location in ROM
  179 000D  D1          	POP DE
  180 000E  21 0012     	LD HL,ROMSTRT-OFFS	; offset from BEGIN to ROMSTRT
  181 0011  19          	ADD HL,DE		; actual Montor address in ROM as source address in HL
  182 0012  11 F000     	LD DE,0F000h 		; dest address in DE
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
NMON    Z80

  183 0015  01 0FFF     	LD BC,0FFFh 		; length in BC (4KB - 1)
  184 0018  ED B0       	LDIR  			; copy
  185 001A  C3 F000     	JP 0F000h 		; jump to Monitor in RAM
  186                   
  187                   ;------------------------------------------------------------------------------
  188                   ; Start of Monitor program, ROM address 0F000h
  189                   
  190 001D              ROMSTRT:
  191                   	; Start address of Monitor in ROM
  192                   	; label must be located before .PHASE
  193                   
  194                   	.PHASE 0F000H	; monitor start address in RAM
  195                   
  196 F000  C3 F046     	JP INIT
  197 F003  C3 F059     	JP CONIN	; Console In (-> A)
  198 F006  C3 F06C     	JP READIN	; Reader In (<- SIO B)
  199 F009  C3 F082     	JP CONOUT	; Console Out (character in C)
  200 F00C  C3 F096     	JP PUNOUT	; Punch Out (-> SIO B)
  201 F00F  C3 F0AD     	JP LSTOUT	; List Out (-> SIO B)
  202 F012  C3 F0C4     	JP CONSTS	; Get console status, 0FFh in A, if character available
  203 F015  C3 F0D7     	JP IOGET	; Get iobyte, current configuration in A
  204 F018  C3 F0DB     	JP IOSET	; Set iobyte, new configuration in C
  205 F01B  C3 F0E0     	JP MEMCHK	; High memory in B, low memory in A
  206                   
  207 F01E              TRAP:	; trap/breakpoint entry -> RSTRT
  208                   
  209 F01E  C3 F043     	JP RSTRT
  210                   	
  211 F021  C3 F13C     	JP FLOP	 	; new floppy interface rev 1.0 (used by BIOS 3.1)
  212                   	
  213         0000      	IF NOT DG01
  216                   	ELSE
  217 F024  C3 F03F     	JP ILLEGAL	; old Maxi routines removed
  218 F027  C3 F03F     	JP ILLEGAL	; old Mini routines removed
  219                   	ENDIF
  220                   	
  221 F02A  C3 F392     	JP IDERD	; Read IDE sector
  222 F02D  C3 F3A7     	JP IDEWR	; Write IDE Sector
  223 F030  C3 F4C0     	JP COLD		; Monitor Cold Start (no hardware init)
  224 F033  C3 F4F1     	JP WARM		; Monitor Warm Start (will be overwritten by BIOS with BIOS Warm Boot)
  225 F036  C3 F049     	JP WRSTR	; gibt einen 0-terminierten String aus (will be overwritten by BIOS with BIOS Warm Boot)
  226                   
  227 F039  F10F        TABPTR:	DEFW TABSTART 	; Start of user jump table
  228 F03B  FBE8        ENDPTR:	DEFW LASTMON 	; End address of Monitor
  229 F03D  F401        FREPTR:	DEFW FREEMEM 	; End of Monitor driver section. The area behind it can be overwritten by CP/M.
  230                   
  231         0000      	IF NOT DG01
  248                   	ENDIF
  249                   
  250                   ; End of area of tables and fixed addresses, that are used by CP/M BIOS, UFORMAT etc.
  251                   
  252                   ;------------------------------------------------------------------------------
  253                   
  254 F03F              ILLEGAL:
  255 F03F  3E FF       	LD A,0FFh
  256 F041  37          	SCF
  257 F042  C9          	RET  		; return with error
