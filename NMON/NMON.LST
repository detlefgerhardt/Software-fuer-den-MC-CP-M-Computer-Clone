 1071                   ; IDE/CF card interface
 1072                   ;
 1073                   ; Read one IDE/CF card sector (256 bytes)
 1074                   
 1075                   ; Read one IDE/CF card sector (256 bytes)
 1076                   ; HL = Buffer address
 1077                   ; E = Physical sector (1..n)
 1078                   ; D = Track (0..n-1)
 1079                   ; C = Volume
 1080                   
 1081 F39B  06 20       IDERD:	LD B,20h		; read command
 1082 F39D  CD F3CE     	CALL IDEINI		; do all the settings and wait for DRQ
 1083                   
 1084 F3A0  CD F3C6     	CALL IDEBSY
 1085                   	
 1086 F3A3  DB 1F       	IN A,(IDE_STAT)	; clear INTRQ
 1087                   
 1088 F3A5              IDERD1: ; read loop
 1089 F3A5  DB 18       	IN A,(IDE_DATA)	; get data
 1090 F3A7  77          	LD (HL),A
 1091 F3A8  23          	INC HL
 1092 F3A9  DB 1F       	IN A,(IDE_STAT)	; check status
 1093 F3AB  E6 08       	AND 08H		; DRQ bit
 1094 F3AD  20 F6       	JR NZ,IDERD1	; loop until cleared
 1095                   	
 1096 F3AF  C9          	RET
 1097                   
 1098                   ;------------------------------------------------------------------------------
 1099                   ; Write one IDE/CF-card sector (256 bytes)
 1100                   ;
 1101                   ; Read one IDE/CF card sector (256 bytes)
 1102                   ; HL = Buffer address
 1103                   ; E = Physical sector (1..n)
 1104                   ; D = Track (0..n-1)
 1105                   ; C = Volume
 1106                   	
 1107 F3B0  06 30       IDEWR:	LD B,30h		; write command
 1108 F3B2  CD F3CE     	CALL IDEINI		; do all the settings and wait for DRQ
 1109                   
