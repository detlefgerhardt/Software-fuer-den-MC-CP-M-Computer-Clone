    5                   ;* based on Mon80V1 by Ulrich Haumann 05/2026	        	             *
    6                   ;* V7.2 851216, sowie Teile aus dem Monitor von Donn Stewart ("CPU-Ville"    *
    7                   ;* Z80 Computer)                 					     *
    8                   ;* based on RDK Monitor 1.1 850129					     *
    9                   ;*                                                                           *
   10                   ;*****************************************************************************
   11                   ;
   12                   ; Monitor for MC-Computer board SYS-80 and SYS-80s
   13                   ; Assembliert mit Z80ASM von SLR Systems wegen der langen
   14                   ;
   15                   ; Comment by Ulrich Haumann:
   16                   ; Treiber fuer Serielle Schnittstelle auf CPU-Platine mit UART 8251
   17                   ; implementiert.
   18                   ; Flo1 und Flo2 waehlber auf Hardware Basis Adresse 0C0h.
   19                   ; Der Mointor erwartet 64KB Ram Memory. Er darf selbst nicht
   20                   ; groesser als 4KB werden, es sein denn man schiebt die ROMSTRT
   21                   ; und CCP weiter nach unten. Der CPM Bereich verkleinert sich dann.
   22                   ; Der Monitor kopiert sich nach Reset an das Speicherende
   23                   ; auf den Wert in ROMSTRT und gibt den unteren RAM Bereich frei.
   24                   ; Dies wird auf der SYS CPU Platine mit einem Lesebefehl auf
   25                   ; Adresse 7000h erreicht. Das Eprom ist dann ausgeblendet.
   26                   ; Somit steht der Speicher durchgaengig ab 0000h bis zu ROMSTRT
   27                   ; zur Verfuehgung.
   28                   ; Das CPM BIOS fuer den MC-Computer ueberschreibt den Monitorbereich
   29                   ; ab FC00h. Alle relevanten Teile fuer den Betrieb des Rechners 
   30                   ; muessen vor FC00h plaziert werden.
   31                   ; Ergaenzung: Das betrifft alle Teile des interaktiven Monitors, der
   32                   ; dann nicht mehr funktionsfaehig ist. Funktionsfaehig bleiben nur
   33                   ; die Ein-/Ausgabe-Routinen und die Floppy-Routinen, die vom BIOS
   34                   ; benoetigt werden.
   35                   ;
   36                   ; NMON Version history
   37                   ;
   38                   ; 01.07.2026 *dg* Komplette Ueberarbeitung der Kommentate ohne funktionale Aenderungen
   39                   ; 17.10.2026 *dg* IDE Routinen geaendert
   40                   ; 25.10.2026 *dg* - IDE Routinen geaendert, Uebergaben von Drive, Track und
   41                   ;		    Sector statt LBA Daten
   42                   ;		  - Added debug outputs (decimal, hex)
   43                   ;		  - Cleanup
   44                   
   45                   ;------------------------------------------------------------------------------
   46                   ; Mapping of REG4-Latch
   47                   
   48                   ; write
   49                   ; Bit0 = Drive Select 1
   50                   ; Bit1 = Drive Select 1
   51                   ; Bit2 = Drive Select 3
   52                   ; Bit3 = Drive Select 4
   53                   ; Bit4 = FDC9239 Dens (0=DD, 1=SS)
   54                   ; Bit5 = FDC9239 Mini (0=Maxi, 1=Mini)
   55                   ; Bit6 = Motor On (Jumper) (0=Motor on, 1=Motor off)
   56                   ; Bit7 = Side Select (Jumper) (0=Side 0, 1=Side 1)
   57                   
   58                   ; read
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NMON    Z80

   59                   ; Bit5 = Headload Status (0=head loaded, 1=head unloaded)
   60                   ; Bit6 = FD197x INTREQ (0=not active, 1=active)
   61                   ; Bit7 = FD197x DRQ (0=not active, 1=actice)
   62                   
   63                   ;------------------------------------------------------------------------------
   64                   ; Constants
   65                   
   66         0000      FALSE	EQU 0
   67         FFFF      TRUE	EQU NOT FALSE
   68         000D      CR 	EQU 0DH		; carriage return
   69         000A      LF 	EQU 0AH		; line feed
   70         0007      BELL	EQU 07H		; bell
   71         00FF      RUB 	EQU 0FFH	; rub out
   72                   ;FIL 	EQU 0
   73                   ;MAX	EQU 7
   74         001B      ESC	EQU 1BH
   75                   
   76         0038      RST7	EQU 38H		; der Vektor RST7 wird fuer Breakpoints gebraucht
   77                   
   78                   ;------------------------------------------------------------------------------
   79                   ; Variant switches
   80                   
   81         000C      VERSION	EQU 12		; Version 1.2
   82                   
   83                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 7.x
   84         FFFF      DG01	EQU TRUE
   85         0000      LOAD100	EQU FALSE	; load from 100h
   86                   
   87                   ; 3 Mini drives (A..C), 1 Maxi drives (D), 1 RAM-Disk (E)
   88                   ;MINI3	EQU FALSE
   89                   
   90                   ; version for CPU80/S with UART 8251
   91         FFFF      SYS80S	EQU TRUE
   92                   
   93                   ;------------------------------------------------------------------------------
   94                   ; I/O addresses
   95                   
   96                   ; SYS80S = TRUE:  serial port of SYS-80S card ist used for console
   97                   ; SYS80S = FALSE: serial port SIO A at OUT-80 card is used for console
   98                   
   99                   ; OUT-80 card SIO B is used for reader, punch and lister
  100                   
  101                   ; Addresses of serial port UART 8251 at SYS-80s CPU card
  102         0020      SU_DAT	EQU 020H	; UART 8251 Daten
  103         0021      SU_STS	EQU 021H	; UART 8251 Control
  104         0002      SU_RXB	EQU 002h	; RX Ready Bit UART 8251
  105         0001      SU_TXB	EQU 001h	; TX Ready Bit UART 8251
  106                   
  107                   ; Addresses of serial port MC Computer OUT-80 card with SIO
  108         00F0      SA_DAT	EQU 0F0H	; SIO A Daten
  109         00F1      SA_STS	EQU 0F1H	; SIO A Control
  110         00F2      SB_DAT	EQU 0F2H	; SIO B Daten
  111         00F3      SB_STS	EQU 0F3H	; SIO B Control
  112         0001      SI_RXB	EQU 01h		; SIO RX Ready Bit
  113         0004      SI_TXB	EQU 04h		; SIO TX Ready Bit
  114                   
  115         FFFF      	IF SYS80S
  116                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NMON    Z80

  117                   ; Console is redirected to UART on SYS-80s
  118         0020      CO_DAT	EQU SU_DAT
  119         0021      CO_STS	EQU SU_STS
  120         0002      CO_RXB	EQU SU_RXB
  121         0001      CO_TXB	EQU SU_TXB
  122                   
  123                   	ELSE
  131                   	ENDIF
  132                   
  133                   ; Reader port (SIO B)
  134         00F2      RE_DAT	EQU SB_DAT
  135         00F3      RE_STS	EQU SB_STS
  136         0001      RE_RXB	EQU SI_RXB
  137         0004      RE_TXB	EQU SI_TXB
  138                   
  139                   ; Punch port (SIO B)
  140         00F2      PU_DAT	EQU SB_DAT
  141         00F3      PU_STS	EQU SB_STS
  142         0001      PU_RXB	EQU SI_RXB
  143         0004      PU_TXB	EQU SI_TXB
  144                   
  145                   ; List port (SIO B)
  146         00F2      LI_DAT	EQU SB_DAT
  147         00F3      LI_STS	EQU SB_STS
  148         0001      LI_RXB	EQU SI_RXB
  149         0004      LI_TXB	EQU SI_TXB
  150                   
  151                   ;------------------------------------------------------------------------------
  152                   
  153                   ; Addresses of IDE-80 CF-Adapter card
  154                   
  155         0018      IDE_BASE	EQU 018h	; IDE/CF adapter base address
  156                   
  157         0018      IDE_DATA	EQU IDE_BASE+0	; IDE Data Register
  158         0019      IDE_FEAT	EQU IDE_BASE+1	; Feature Register
  159         001A      IDE_SECCNT	EQU IDE_BASE+2	; Sector Count Register
  160         001B      IDE_LBA7	EQU IDE_BASE+3	; LBA Bits 0-7
  161         001C      IDE_LBA15	EQU IDE_BASE+4	; LBA Bits 8-15
  162         001D      IDE_LBA23	EQU IDE_BASE+5	; LBA Bits 16-23
  163         001E      IDE_HEAD	EQU IDE_BASE+6	; IDE Drive Head Register
  164         001F      IDE_STAT	EQU IDE_BASE+7	; IDE Command/Status Register
  165                   
  166                   ;------------------------------------------------------------------------------
  167                   
  168         0000      IF LOAD100
  170                   ELSE	
  171         0000      	ORG 0000h		; Start address in ROM after hardware reset
  172                   ENDIF
  173                   
  174                   	; Copy Monitor from ROM address ROMSTRT to RAM address F000
  175                   
  176 0000  31 FFFF     BEGIN:	LD SP,0FFFFh 		; set Stack to end of memory
  177 0003  3E C9       	LD A,0C9h 		; place RET command at F000h
  178 0005  32 F000     	LD (0F000h),A 		; 
  179 0008  CD F000     	CALL 0F000h 		; and call it
  180                   
  181 000B  3B          OFFS:	DEC SP  		; get return address from Stack to calculate
  182 000C  3B          	DEC SP  		; Monitor location in ROM
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
NMON    Z80

  183 000D  D1          	POP DE
  184 000E  21 0012     	LD HL,ROMSTRT-OFFS	; offset from BEGIN to ROMSTRT
  185 0011  19          	ADD HL,DE		; actual Montor address in ROM as source address in HL
  186 0012  11 F000     	LD DE,0F000h 		; dest address in DE
  187 0015  01 0FFF     	LD BC,0FFFh 		; length in BC (4KB - 1)
  188 0018  ED B0       	LDIR  			; copy
  189 001A  C3 F000     	JP 0F000h 		; jump to Monitor in RAM
  190                   
  191                   ;------------------------------------------------------------------------------
  192                   ; Start of Monitor program, ROM address 0F000h
  193                   
  194 001D              ROMSTRT:
  195                   	; Start address of Monitor in ROM
  196                   	; label must be located before .PHASE
  197                   
  198                   	.PHASE 0F000H	; monitor start address in RAM
  199                   
  200 F000  C3 F04F     	JP INIT
  201 F003  C3 F062     	JP CONIN	; Console In (-> A)
  202 F006  C3 F075     	JP READIN	; Reader In (<- SIO B)
  203 F009  C3 F08B     	JP CONOUT	; Console Out (character in C)
  204 F00C  C3 F09F     	JP PUNOUT	; Punch Out (-> SIO B)
  205 F00F  C3 F0B6     	JP LSTOUT	; List Out (-> SIO B)
  206 F012  C3 F0CD     	JP CONSTS	; Get console status, 0FFh in A, if character available
  207 F015  C3 F0E0     	JP IOGET	; Get iobyte, current configuration in A
  208 F018  C3 F0E4     	JP IOSET	; Set iobyte, new configuration in C
  209 F01B  C3 F0E9     	JP MEMCHK	; High memory in B, low memory in A
  210                   
  211 F01E              TRAP:	; trap/breakpoint entry -> RSTRT
  212                   
  213 F01E  C3 F04C     	JP RSTRT
  214                   	
  215 F021  C3 F145     	JP FLOP	 	; new floppy interface rev 1.0 (used by BIOS 3.1)
  216                   	
  217 F024  C3 F048     	JP ILLEGAL	; old Maxi routines removed
  218 F027  C3 F048     	JP ILLEGAL	; old Mini routines removed
  219                   	
  220 F02A  C3 F39B     	JP IDERD	; Read IDE sector
  221 F02D  C3 F3B0     	JP IDEWR	; Write IDE Sector
  222 F030  C3 F530     	JP COLD		; Monitor Cold Start (no hardware init)
  223 F033  C3 F561     	JP WARM		; Monitor Warm Start (will be overwritten by BIOS with BIOS Warm Boot)
  224 F036  C3 F052     	JP WRSTR	; gibt einen 0-terminierten String aus (will be overwritten by BIOS with BIOS Warm Boot)
  225                   	
  226 F039  C3 F412     	JP DEBDEC	; debug display unsigned 16 bit value in HL (decimal)
  227 F03C  C3 F441     	JP DEBX16	; debug display unsigned 16 bit value in HL (4 digit hex)
  228 F03F  C3 F44C     	JP DEBX8	; debug display unsigned 8 bit value in A (2 digit hex)
  229                   
  230                   
  231 F042  F118        TABPTR:	DEFW TABSTART 	; Start of user jump table
  232 F044  FC59        ENDPTR:	DEFW LASTMON 	; End address of Monitor
  233 F046  F471        FREPTR:	DEFW FREEMEM 	; End of Monitor driver section. The area behind it can be overwritten by CP/M.
  234                   
  235                   ;------------------------------------------------------------------------------
  236                   ; End of area of tables and fixed addresses, that are used by CP/M BIOS, UFORMAT etc.
  237                   ;------------------------------------------------------------------------------
  238                   
  239 F048              ILLEGAL:
  240 F048  3E FF       	LD A,0FFh
