  274                   ;==============================================================================
  275                   ; IO Routines
  276                   ;==============================================================================
  277                   ; Output 0-terminated string, address in HL
  278                   
  279 F052  DB 21       WRSTR:	IN  A,(CO_STS)	; read status
  280 F054  E6 01       	AND CO_TXB	; check TxRDY bit
  281 F056  CA F052     	JP Z,WRSTR	; wait if not set
  282                   	
  283 F059  7E          	LD A,(HL)	; get char from string
  284 F05A  A7          	AND A		; check if 0
  285 F05B  C8          	RET Z		; -> end of string
  286                   	
  287 F05C  D3 20       	OUT (CO_DAT),A	; write char to output
  288 F05E  23          	INC HL		; next char in string
  289 F05F  C3 F052     	JP WRSTR	; start over
  290                   
