  302                   ; Input -> A
  303                   
  304 F06C  3A F121     READIN:	LD A,(IOBYT)
  305 F06F  E6 0C       	AND 00001100b
  306 F071  CA F059     	JP Z,CONIN  		; assign: AR=T
  307                   
  308 F074  FE 04       	CP 00000100B 
  309 F076  C2 F112     	JP NZ,USERRI
  310                   
  311 F079              READI1:	; assign: AR=P
  312 F079  DB F3       	IN A,(RE_STS)
  313 F07B  E6 01       	AND RE_RXB
  314 F07D  28 FA       	JR Z,READI1
  315                   
  316 F07F  DB F2       	IN A,(RE_DAT)		; read character
