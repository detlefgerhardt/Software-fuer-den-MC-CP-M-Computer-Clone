  473                   ;==============================================================================
  474                   ; Format detection (not used)
  475                   ;
  476                   ; in C ist danach der gueltige ; Laufwerkscode,
  477                   ; Vorgabe ist in C die Laufwerksnummer und ggf. Seite.
  478                   ; testet mini,sd =11
  479                   ;        mini,dd =10
  480                   ;        maxi,sd =01
  481                   ;        maxi,dd =00
  482                   
  483         0000      	IF FALSE
  560                   	ENDIF	; FALSE
  561                   
  562                   ;==============================================================================
  563                   ; Floppy-Unterprogramme fuer FLO2
  564                   ; verwendet 1797 als Controller
  565                   ; Version 1.0   840506
  566                   ; Rolf-Dieter Klein (C) 1984 Muenchen
  567                   ;
  568                   ; Die Routinen ermoeglichen sowohl den Anschluss von Mini-,Mikro- als auch
  569                   ; von Maxi-Laufwerken. Die Routinen muessen im RAM stehen, da die Buffer
  570                   ; am Ende stehen. Alle Buffer sind jedoch gesammelt.
  571                   
  572                   ; FLO4    als Leseport
  573                   ;
  574                   ; 7 6 5 4 3 2 1 0
  575                   ;
  576                   ; DRQ   INTRQ   headld x      x x x x
  577                   ; 0=request
  578                   ;      0=request
  579                   ;  1=head down
  580                   ;
  581                   
  582                   ; FLO4    als Schreibport
  583                   ;
  584                   ; 7 6 5 4 3 2 1 0
  585                   ;
  586                   ; sso moton mini dense d c b a
  587                   ;
  588                   ; 1=Seite 1
  589                   ; 0=Motor an
  590                   ;  1=Minilaufwerk
  591                   ;   1=Single Dense
  592                   ;    -------------------------
  593                   ;      1=Laufwerk an
  594                   
  595         00C0      FLO	EQU 0C0H 		; Basisadresse Floppy-Controller
  596                   ;FLO4	EQU 0C4H 		; Port fuer Zusatzstatus etc.
  597                   				; write REG4-Latch
  598                   				; read REG4-Status
  599                   
  600                   ;------------------------------------------------------------------------------
  601                   ; Bei einem Interrupt wird an diese Stelle gesprungen
  602                   ; Der Interrupt erfolgt vom Floppy-Controller
  603                   
  604 F134              INTEX:	; Das INT-Program arbeitet nicht als Unterprogramm
  605 F134  F1          	POP AF  		; alte Ret-Adresse vernichten
  606 F135  DB C0       	IN A,(FLO) 		; Status lesen und INT loeschen
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  10
NMON    Z80

  607 F137  FB          	EI  			; Interrupt wieder freigeben
  608 F138  ED 4D       	RETI  			; zurueck zum vorherigen Aufrufer
  609                   
  610                   ;------------------------------------------------------------------------------
  611                   ; Floppy Routinen Init
  612                   
  613 F13A  3E 02       INIFLP:	LD A,2  		; 3 = langsamste Steprate, kein SSO
  614 F13C  32 F31C     	LD (STEPRATE),A
  615                   	
  616 F13F  3E FF       	LD A,0FFH
  617 F141  32 F325     	LD (CURDRV),A 		; no current drive
  618 F144  C9          	RET 
  619                   
  620                   ;------------------------------------------------------------------------------
  621                   
  622         0038      INTVEK	EQU 38h 		; Interruptziel
  623                   
  624                   ;------------------------------------------------------------------------------
  625                   ; Haupteingang der Floppy-Routinen
  626                   ; HL = Buffer address
  627                   ; E = Physical sector (1..n)
  628                   ; D = Track (0..n-1)
  629                   ; C = Drive-code + Density + Side (REG4-Latch)
  630                   ;   7    6    5    4    3    2    1    0
  631                   ;   sso  mot  min  dens d    d    d    d
  632                   ;   sso  = seitenauswahl (0=side 0, 1=side 1)
  633                   ;   mot  = motor on code (std=0)
  634                   ;   min  = 1 bei Minilaufwerken
  635                   ;   dens = 1 bei Single Dense Aufzeichnung
  636                   ;   d = binary drive code
  637                   ;     normalerweise nur 1,2,4,8 moeglich
  638                   ;     Kombinationen moeglich, wenn binaere
  639                   ;     Dekodierung beim Laufwerk verwendet wird
  640                   ; B = 0 Set steprate and SSO-Flag (steprate in D: s00000rr, rr=steprate, s=sso)
  641                   ;   = 1 Read sector
  642                   ;   = 2 Write sector
  643                   
  644                   ; Entry SSO = 0
  645                   
  646 F145  AF          FLOP:	XOR A  			; SSO-Flag auf 0 setzen
  647                   
  648                   ; Entry SSO in A
  649                   ; called only from old MINI routine
  650                   
  651 F146              FLOP1:	; SSO flag in A, only 0 and 2 allowed
  652 F146  32 F31D     	LD (SSOFLAG),A
  653                   
  654 F149  ED 73 F31E  FLOP2:	LD (SP0),SP 		; save user-stack, maybe to deep for BDOS
  655 F14D  31 F39A     	LD SP,TSTACK 		;
  656                   
  657 F150  3E D0       	LD A,11010000B		; Command "Force interrupt"
  658 F152  D3 C0       	OUT (FLO),A 		; reset floppy controller
  659                   	
  660                   	; set interrupt vector to INTEX
  661 F154  3A 0038     	LD A,(INTVEK)
  662 F157  32 F320     	LD (SAVINT),A
  663 F15A  3E C3       	LD A,0C3H 		; JP-Befehl
  664 F15C  32 0038     	LD (INTVEK),A
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  11
NMON    Z80

  665 F15F  E5          	PUSH HL
  666 F160  2A 0039     	LD HL,(INTVEK+1)
  667 F163  22 F321     	LD (SAVINT+1),HL
  668 F166  21 F134     	LD HL,INTEX 		; set to JP INTEX
  669 F169  22 0039     	LD (INTVEK+1),HL
  670 F16C  E1          	POP HL
  671                   	
  672 F16D  DB C0       	IN A,(FLO)		; Status - Port
  673 F16F  ED 56       	IM 1  			; set interrupt mode 1 ->  execure at 38h
  674 F171  FB          	EI  			; Interrupt freigeben
  675 F172  CD F21D     	CALL EXFLO
  676 F175  F3          	DI  			; disable interrupt
  677                   	
  678                   	; restore interrupt vector
  679 F176  F5          	PUSH AF 		; Status
  680 F177  3A F320     	LD A,(SAVINT)
  681 F17A  32 0038     	LD (INTVEK),A 		; zurueckspeichern
  682 F17D  E5          	PUSH HL
  683 F17E  2A F321     	LD HL,(SAVINT+1)
  684 F181  22 0039     	LD (INTVEK+1),HL
  685 F184  E1          	POP HL
  686 F185  F1          	POP AF
  687                   	
  688 F186  ED 7B F31E  	LD SP,(SP0) 		; restore user-stack
  689 F18A  C9          	RET
  690                   
  691                   ;------------------------------------------------------------------------------
  692                   ; Diverse Unterprogramme
  693                   ;------------------------------------------------------------------------------
  694                   ; Prepare command byte for floppy controller
  695                   
  696 F18B              SETCMD:				; testet ob der Kopf noch
  697                   				; geladen ist und setzt die
  698 F18B  06 00       	LD B,0  		; Flag fuer SSO-Bit
  699 F18D  3A F324     	LD A,(DRVCOD) 		; wenn Bit 7 gesetzt, dann abfragen
  700 F190  E6 80       	AND 80H
  701 F192  28 11       	JR Z,SETC2 		; Seite 0, immer mit SSO=0
  702                   	
  703 F194  3A F31C     	LD A,(STEPRATE) 	; jetzt pruefen ob flags da
  704 F197  E6 80       	AND 80H 		; <>0, dann SSO setzen, wenn seite 1
  705 F199  28 04       	JR Z,SETC1 		; =0, dann code 0, oder SSOFLAG
  706                   	
  707 F19B  06 02       	LD B,2  		; SSO setzen 
  708 F19D  18 06       	JR SETC2
  709                   
  710 F19F              SETC1:	; pruefen ob SSO-Flag
  711 F19F  3A F31D     	LD A,(SSOFLAG) 		; ok, 2=Flag
  712 F1A2  E6 02       	AND 2  			; SSO-Bit
  713 F1A4  47          	LD B,A  		; 0,2 erlaubt 
  714                   
  715 F1A5              SETC2:	; entsprechenden Bits
  716 F1A5  DB C4       	IN A,(FLO+4) 		; REG4-Status
  717 F1A7  E6 20       	AND 20H 		; Head-Load Bit
  718 F1A9  20 04       	JR NZ,SETC3 		; =1 dann Kopf auf Diskette
  719                   	
  720 F1AB  78          	LD A,B
  721 F1AC  F6 04       	OR 04h 			; sonst Bitmaske fuer headdown
  722 F1AE  C9          	RET
