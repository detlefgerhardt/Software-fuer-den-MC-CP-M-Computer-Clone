 1441                   ; Read/Write command in D (20h = READ, 30h = WRITE)
 1442                   ; Address of data in HL
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  20
NMON    Z80

 1443                   ; LBA bits 0 to 7 passed in C
 1444                   ; LBA bits 8 to 15 passed in B
 1445                   ; LBA bits 16 to 23 passed in E
 1446                   
 1447                   ; Read one IDE/CF card sector (256 bytes)
 1448                   ; HL = Buffer address
 1449                   ; E = Physical sector (1..n)
 1450                   ; D = Track (0..n-1)
 1451                   ; C = Volume (0..3)
 1452                   ; B = Command (20h = read, 30h = write)
 1453                   
 1454                   ; NEWIDE LBA assignment (8192K):
 1455                   ; 00000000 00000000 00000000
 1456                   ; 0000000d dsssssss tttttttt
 1457                   ;        E        B        C
 1458                   
 1459 F3CD  00          IDESET:	DB 0			; ide initialisation (0 = not, 1 = initalized)
 1460                   
 1461 F3CE  CD F3C6     IDEINI:	CALL IDEBSY
 1462                   
 1463 F3D1  DB 1F       IDEIN1:	IN A,(IDE_STAT)		; check status
 1464 F3D3  E6 40       	AND 40H			; check DRDY bit
 1465 F3D5  CA F3D1     	JP Z,IDEIN1		; loop until ready
 1466                   
 1467 F3D8  3A F3CD     	LD A,(IDESET)
 1468 F3DB  A7          	AND A
 1469 F3DC  20 14       	JR NZ,IDEIN2		; -> skip init
 1470                   
 1471                   	; one time initialisation
