 1455 F3EB  D3 1A       	OUT (IDE_SECCNT),A	; sector count register
 1456 F3ED  79          	LD A,C
 1457 F3EE  D3 1B       	OUT (IDE_LBA7),A	; lba bits 0 - 7
 1458 F3F0  78          	LD A,B
 1459 F3F1  D3 1C       	OUT (IDE_LBA15),A	; lba bits 8 - 15
