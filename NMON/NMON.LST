  826                   ;------------------------------------------------------------------------------
  827                   ; Floppy Kernal Routines
  828                   
  829                   ; HL = buffer address
  830                   ; D = track (0..?) or parameter for set steprate
  831                   ; E = sector (1..n)
  832                   ; B = command (0=set steprate+SSO, 1=read, 2=write)
  833                   ;     B = 0 steprate+sso in D: s00000rr
  834                   ; C = drive code
  835                   ;   REG4-Latch format
  836                   ;   7   6   5   4   3   2   1   0
  837                   ;   sid mot min den d   d   d   d
  838                   ;   sid: 0=side, 1=side1
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  14
