 1008                   ;------------------------------------------------------------------------------
 1009                   ; Floppy Kernal Routines
 1010                   
 1011                   ; HL = buffer address
 1012                   ; D = track (0..?) or parameter for set steprate
 1013                   ; E = sector (1..n)
 1014                   ; B = command (0=set steprate+SSO, 1=read, 2=write)
 1015                   ;     B = 0 steprate+sso in D: s00000rr
 1016                   ; C = drive code
 1017                   ;   REG4-Latch format
 1018                   ;   7   6   5   4   3   2   1   0
 1019                   ;   sid mot min den d   d   d   d
 1020                   ;   sid: 0=side, 1=side1
 1021                   ;   mot: motor on code (std=0)
 1022                   ;   min: 0=maxi drive, 1=mini drive
 1023                   ;   den: 0=dd, 1=ss
 1024                   ;   d=binary drive code
 1025                   ;     normalerweise nur 1,2,4,8 moeglich
 1026                   ;     Kombinationen moeglich, wenn binaere
 1027                   ;     Dekodierung beim Laufwerk verwendet wird
 1028                   
 1029 F21D  78          EXFLO:	LD A,B			; B = command
 1030 F21E  B7          	OR A
 1031 F21F  20 08       	JR NZ,EXFL1
 1032                   
 1033                   	;---------------------------------------------------------------------
 1034                   	; B=0: set steprate and SSO
 1035                   	; steprate in D, Bit0/1=steprate, bit7=SSO
 1036                   	
 1037 F221  7A          	LD A,D   		; (+80h =SSO verwenden und pruefen).
 1038 F222  E6 83       	AND 83h  		; Bit 7=SSO-Flag bei Zugriffen wichtig
 1039 F224  32 F31C     	LD (STEPRATE),A		; die die zweite Seite verwenden.
 1040 F227  AF          	XOR A
 1041 F228  C9          	RET
 1042                   
