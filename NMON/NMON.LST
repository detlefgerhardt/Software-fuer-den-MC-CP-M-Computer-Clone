  839                   ;   mot: motor on code (std=0)
  840                   ;   min: 0=maxi drive, 1=mini drive
  841                   ;   den: 0=dd, 1=ss
  842                   ;   d=binary drive code
  843                   ;     normalerweise nur 1,2,4,8 moeglich
  844                   ;     Kombinationen moeglich, wenn binaere
  845                   ;     Dekodierung beim Laufwerk verwendet wird
  846                   
  847 F21D  78          EXFLO:	LD A,B			; B = command
