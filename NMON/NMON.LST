  409                   ;------------------------------------------------------------------------------
  410                   ; prueft den Speicherbereich und gibt die hoechste verfuegbare Zelle an
  411                   ; MEMCHK IN B HIGH IN A LOW MEMORY
  412                   
  413 F0E0  E5          MEMCHK:	PUSH HL
  414 F0E1  CD F0ED     	CALL MEMSIZ
  415 F0E4  7D          	LD A,L
  416 F0E5  D6 3C       	SUB 3CH
  417 F0E7  30 01       	JR NC,MEMCK1
  418                   
  419 F0E9  25          	DEC H
  420                   	
  421 F0EA  44          MEMCK1:	LD B,H
  422 F0EB  E1          	POP HL
  423 F0EC  C9          	RET
  424                   
  425                   ;------------------------------------------------------------------------------
  426                   ; Detect end of memory from 0000h to EFFFh
  427                   
  428 F0ED  C5          MEMSIZ:	PUSH BC
  429                   
  430                   	; entry point
  431 F0EE              MEMSIZB:
  432 F0EE  21 FFFF     	LD HL,-1
