  797 F1FB  7B          	LD A,E
  798 F1FC  D3 C2       	OUT (FLO+2),A 		; Sector
  799 F1FE  7A          	LD A,D
  800 F1FF  D3 C3       	OUT (FLO+3),A 		; track
  801 F201  06 1C       	LD B,1CH 		; seek command
  802 F203  3A F31C     	LD A,(STEPRATE)
  803 F206  E6 03       	AND 3  			; 0,1,2,3 zulaessig
  804 F208  B0          	OR B  			; 
  805 F209  D3 C0       	OUT (FLO),A 		; execute Seek together with steprate
  806                   
  807 F20B  76          	HALT  			; wait for INT
