NMON    Z80

  723                   
  724 F1AF              SETC3:	; noset
  725 F1AF  78          	LD A,B
  726 F1B0  C9          	RET 			; Code belassen
  727                   
  728                   ;------------------------------------------------------------------------------
  729                   ; Read one sector
  730                   ; sector number in E
  731                   ; buffer addr in HL
  732                   
  733 F1B1  79          RDFLP:	LD A,C
  734 F1B2  D3 C4       	OUT (FLO+4),A 		; density + side -> REG4-Latch
  735 F1B4  7B          	LD A,E
  736 F1B5  D3 C2       	OUT (FLO+2),A 		; ins Sektorregister
  737 F1B7  0E C3       	LD C,FLO+3 		; Adresse Datenport dann nach C
  738 F1B9  CD F18B     	CALL SETCMD 		; Register A vorbereiten
  739 F1BC  C6 88       	ADD A,10001000B		; Command "Read Sector", without SSO
  740 F1BE  D3 C0       	OUT (FLO),A 		; Befehl ausfuehren
  741                   
  742 F1C0              RDFLP1:	; wait for DRQ = 1
  743 F1C0  DB C4       	IN A,(FLO+4) 		; DRQ schon da ?
  744 F1C2  07          	RLCA  			; bit7 = DRQ, bit6 = int
  745 F1C3  D2 F1C0     	JP NC,RDFLP1 		; -> DRQ = 0
  746                   	
  747 F1C6  ED A2       	INI  			; IN (C) -> (HL), HL++, B--
  748 F1C8  C3 F1C0     	JP RDFLP1  		; verlassen nur durch INT
  749                   
  750                   ;------------------------------------------------------------------------------
  751                   ; Write one sector
  752                   
  753 F1CB  79          WRFLP:	LD A,C
  754 F1CC  D3 C4       	OUT (FLO+4),A 		; density + side -> REG4-Latch
  755 F1CE  7B          	LD A,E  		; Sektorregister setzen
  756 F1CF  D3 C2       	OUT (FLO+2),A
  757 F1D1  0E C3       	LD C,FLO+3		; Adresse Datenport laden
  758 F1D3  CD F18B     	CALL SETCMD		; E-Code in A laden
  759 F1D6  C6 A8       	ADD A,0A8H		; Befehl Schreibe-Sektor
  760 F1D8  D3 C0       	OUT (FLO),A 		; und Befehl ausfuehren
  761                   
  762 F1DA              WRFLP1:	; wait for DRQ = 1
  763 F1DA  DB C4       	IN A,(FLO+4) 		; DRQ schon da ?
  764 F1DC  07          	RLCA  			; bit7 = DRQ, bit6 = int
  765 F1DD  D2 F1DA     	JP NC,WRFLP1
  766                   	
  767 F1E0  ED A3       	OUTI  			; (HL) -> OUT (C), HL++, B--
  768 F1E2  C3 F1DA     	JP WRFLP1  		; verlassen nur durch INT
  769                   
  770                   ;------------------------------------------------------------------------------
  771                   ; delay: 4 ms at 4 MHz
  772                   
  773 F1E5  C5          WAWA:	PUSH BC 		; pro Schleife ca 6us bei 4MHz
  774 F1E6  01 01F4     	LD BC,500 		; 500*6us Dauer
  775 F1E9  CD F1EE     	CALL DELAY
  776 F1EC  C1          	POP BC
  777 F1ED  C9          	RET
  778                   
  779                   ;------------------------------------------------------------------------------
  780                   ; delay: 6 microseconds at 4 MHz
