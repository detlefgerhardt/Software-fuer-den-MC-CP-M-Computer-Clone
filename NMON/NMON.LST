  292                   ; Console Input main routine (SYS)
  293                   ; Input -> A
  294                   
  295 F062  3A F12A     CONIN:	LD A,(IOBYT)
  296 F065  E6 03       	AND 00000011b		; console mask
  297 F067  20 09       	JR NZ,CONI2		; -> user device
  298                   
  299 F069  DB 21       CONI1:	IN A,(CO_STS)
  300 F06B  E6 02       	AND CO_RXB
  301 F06D  28 FA       	JR Z,CONI1
  302                   	
  303 F06F  DB 20       	IN A,(CO_DAT)		; read character
  304 F071  C9          	RET
  305                   
  306 F072  C3 F118     CONI2:	JP USERCI  		; user device
  307                   
