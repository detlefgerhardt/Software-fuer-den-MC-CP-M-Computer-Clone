  394                   ;------------------------------------------------------------------------------
  395                   ; prueft den Speicherbereich und gibt die hoechste verfuegbare Zelle an
  396                   ; MEMCHK IN B HIGH IN A LOW MEMORY
  397                   
  398 F0E9  E5          MEMCHK:	PUSH HL
  399 F0EA  CD F0F6     	CALL MEMSIZ
  400 F0ED  7D          	LD A,L
  401 F0EE  D6 3C       	SUB 3CH
  402 F0F0  30 01       	JR NC,MEMCK1
  403                   
  404 F0F2  25          	DEC H
  405                   	
  406 F0F3  44          MEMCK1:	LD B,H
  407 F0F4  E1          	POP HL
  408 F0F5  C9          	RET
  409                   
  410                   ;------------------------------------------------------------------------------
  411                   ; Detect end of memory from 0000h to EFFFh
  412                   
  413 F0F6  C5          MEMSIZ:	PUSH BC
  414                   
