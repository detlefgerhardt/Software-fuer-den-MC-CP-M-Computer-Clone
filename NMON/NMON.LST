 1000                   ;------------------------------------------------------------------------------
 1001                   ; Floppy Kernal Routines
 1002                   
 1003                   ; HL = buffer address
 1004                   ; D = track (0..?) or parameter for set steprate
 1005                   ; E = sector (1..n)
 1006                   ; B = command (0=set steprate+SSO, 1=read, 2=write)
 1007                   ;     B = 0 steprate+sso in D: s00000rr
 1008                   ; C = drive code
 1009                   ;   REG4-Latch format
 1010                   ;   7   6   5   4   3   2   1   0
 1011                   ;   sid mot min den d   d   d   d
 1012                   ;   sid: 0=side, 1=side1
 1013                   ;   mot: motor on code (std=0)
 1014                   ;   min: 0=maxi drive, 1=mini drive
 1015                   ;   den: 0=dd, 1=ss
 1016                   ;   d=binary drive code
 1017                   ;     normalerweise nur 1,2,4,8 moeglich
 1018                   ;     Kombinationen moeglich, wenn binaere
 1019                   ;     Dekodierung beim Laufwerk verwendet wird
 1020                   
 1021 F214  78          EXFLO:	LD A,B			; B = command
 1022 F215  B7          	OR A
 1023 F216  20 08       	JR NZ,EXFL1
 1024                   
 1025                   	;---------------------------------------------------------------------
 1026                   	; B=0: set steprate and SSO
 1027                   	; steprate in D, Bit0/1=steprate, bit7=SSO
 1028                   	
 1029 F218  7A          	LD A,D   		; (+80h =SSO verwenden und pruefen).
 1030 F219  E6 83       	AND 83h  		; Bit 7=SSO-Flag bei Zugriffen wichtig
 1031 F21B  32 F313     	LD (STEPRATE),A		; die die zweite Seite verwenden.
 1032 F21E  AF          	XOR A
 1033 F21F  C9          	RET
 1034                   
 1035                   	;---------------------------------------------------------------------
 1036                   
 1037 F220  AF          EXFL1:	XOR A
 1038 F221  32 F31A     	LD (ERRCNT),A 		; Fehlerzahl 0
 1039 F224  79          	LD A,C
 1040 F225  32 F31B     	LD (DRVCOD),A 		; drive-code
 1041 F228  E6 0F       	AND 0FH 		; in bit 0..3
 1042 F22A  4F          	LD C,A
 1043 F22B  3A F31C     	LD A,(CURDRV)
 1044 F22E  FE FF       	CP 0FFH 		; current drive invalid -> set
 1045 F230  28 14       	JR Z,EXFL2
