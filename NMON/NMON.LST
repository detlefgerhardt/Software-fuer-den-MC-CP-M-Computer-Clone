  851 F169  22 0039     	LD (INTVEK+1),HL
  852 F16C  E1          	POP HL
  853                   	
  854 F16D  DB C0       	IN A,(FLO)		; Status - Port
  855 F16F  ED 56       	IM 1  			; set interrupt mode 1 ->  execure at 38h
  856 F171  FB          	EI  			; Interrupt freigeben
  857 F172  CD F21D     	CALL EXFLO
  858 F175  F3          	DI  			; disable interrupt
  859                   	
  860                   	; restore interrupt vector
  861 F176  F5          	PUSH AF 		; Status
  862 F177  3A F320     	LD A,(SAVINT)
  863 F17A  32 0038     	LD (INTVEK),A 		; zurueckspeichern
  864 F17D  E5          	PUSH HL
  865 F17E  2A F321     	LD HL,(SAVINT+1)
  866 F181  22 0039     	LD (INTVEK+1),HL
  867 F184  E1          	POP HL
  868 F185  F1          	POP AF
