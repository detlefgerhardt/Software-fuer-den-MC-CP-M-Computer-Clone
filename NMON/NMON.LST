  880 F18B  06 00       	LD B,0  		; Flag fuer SSO-Bit
  881 F18D  3A F324     	LD A,(DRVCOD) 		; wenn Bit 7 gesetzt, dann abfragen
  882 F190  E6 80       	AND 80H
