  712                   ;==============================================================================
  713                   ; Floppy-Unterprogramme fuer FLO2
  714                   ; verwendet 1797 als Controller
  715                   ; Version 1.0   840506
  716                   ; Rolf-Dieter Klein (C) 1984 Muenchen
  717                   ;
  718                   ; Die Routinen ermoeglichen sowohl den Anschluss von Mini-,Mikro- als auch
  719                   ; von Maxi-Laufwerken. Die Routinen muessen im RAM stehen, da die Buffer
  720                   ; am Ende stehen. Alle Buffer sind jedoch gesammelt.
  721                   
  722                   ; FLO4    als Leseport
  723                   ;
  724                   ; 7 6 5 4 3 2 1 0
  725                   ;
  726                   ; DRQ   INTRQ   headld x      x x x x
  727                   ; 0=request
  728                   ;      0=request
  729                   ;  1=head down
  730                   ;
  731                   
  732                   ; FLO4    als Schreibport
  733                   ;
  734                   ; 7 6 5 4 3 2 1 0
  735                   ;
  736                   ; sso moton mini dense d c b a
  737                   ;
  738                   ; 1=Seite 1
  739                   ; 0=Motor an
  740                   ;  1=Minilaufwerk
  741                   ;   1=Single Dense
  742                   ;    -------------------------
  743                   ;      1=Laufwerk an
  744                   
