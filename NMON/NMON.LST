 1269                   ; IDE/CF card interface
 1270                   ;
 1271                   ; Read one IDE/CF card sector (256 bytes)
 1272                   ;
 1273                   ; Address for data in HL
 1274                   ; LBA bits 0 to 7 passed in C
 1275                   ; LBA bits 8 to 15 passed in B
 1276                   ; LBA bits 16 to 23 passed in E
 1277                   
 1278         0000      	IF NOT DG01
 1324                   	ELSE
 1325                   
 1326                   ; Read one IDE/CF card sector (256 bytes)
 1327                   ; HL = Buffer address
 1328                   ; E = Physical sector (1..n)
 1329                   ; D = Track (0..n-1)
 1330                   ; C = Volume
 1331                   
 1332 F39B  06 20       IDERD:	LD B,20h		; read command
 1333 F39D  CD F3CE     	CALL IDEINI		; do all the settings and wait for DRQ
 1334                   
 1335 F3A0  CD F3C6     	CALL IDEBSY
 1336                   	
 1337 F3A3  DB 1F       	IN A,(IDE_STAT)	; clear INTRQ
 1338                   
 1339 F3A5              IDERD1: ; read loop
 1340 F3A5  DB 18       	IN A,(IDE_DATA)	; get data
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  19
NMON    Z80

 1341 F3A7  77          	LD (HL),A
 1342 F3A8  23          	INC HL
 1343 F3A9  DB 1F       	IN A,(IDE_STAT)	; check status
 1344 F3AB  E6 08       	AND 08H		; DRQ bit
 1345 F3AD  20 F6       	JR NZ,IDERD1	; loop until cleared
 1346                   	
 1347 F3AF  C9          	RET
 1348                   
 1349                   	ENDIF 	; DG01
