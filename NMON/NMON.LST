 1111 F3B5  7E          	LD A,(HL)
 1112 F3B6  D3 18       	OUT (IDE_DATA),A	; write data
 1113 F3B8  23          	INC HL
 1114 F3B9  DB 1F       	IN A,(IDE_STAT)		; read status
 1115 F3BB  E6 08       	AND 08H			; check DRQ bit
 1116 F3BD  C2 F3B5     	JP NZ,IDEWR1		; write until bit cleared
 1117                   
 1118 F3C0  CD F3C6     IDEWR2:	CALL IDEBSY
 1119                   
 1120 F3C3  DB 1F       	IN A,(IDE_STAT)		; clear INTRQ
 1121 F3C5  C9          	RET
