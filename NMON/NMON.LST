  751                   				; write REG4-Latch
  752                   				; read REG4-Status
  753                   
  754                   ;------------------------------------------------------------------------------
  755                   ; Bei einem Interrupt wird an diese Stelle gesprungen
  756                   ; Der Interrupt erfolgt vom Floppy-Controller
  757                   
  758 F12B              INTEX:	; Das INT-Program arbeitet nicht als Unterprogramm
  759 F12B  F1          	POP AF  		; alte Ret-Adresse vernichten
  760 F12C  DB C0       	IN A,(FLO) 		; Status lesen und INT loeschen
  761 F12E  FB          	EI  			; Interrupt wieder freigeben
  762 F12F  ED 4D       	RETI  			; zurueck zum vorherigen Aufrufer
  763                   
  764                   ;------------------------------------------------------------------------------
  765                   ; Floppy Routinen Init
  766                   
  767 F131  3E 02       INIFLP:	LD A,2  		; 3 = langsamste Steprate, kein SSO
  768 F133  32 F313     	LD (STEPRATE),A
  769                   	
  770 F136  3E FF       	LD A,0FFH
  771 F138  32 F31C     	LD (CURDRV),A 		; no current drive
  772 F13B  C9          	RET 
  773                   
  774                   ;------------------------------------------------------------------------------
  775                   
  776         0038      INTVEK	EQU 38h 		; Interruptziel
  777                   
  778                   ;------------------------------------------------------------------------------
  779                   ; Haupteingang der Floppy-Routinen
  780                   ; HL = Buffer address
  781                   ; E = Physical sector (1..n)
  782                   ; D = Track (0..n-1)
  783                   ; C = Drive-code + Density + Side (REG4-Latch)
  784                   ;   7    6    5    4    3    2    1    0
  785                   ;   sso  mot  min  dens d    d    d    d
  786                   ;   sso  = seitenauswahl (0=side 0, 1=side 1)
  787                   ;   mot  = motor on code (std=0)
  788                   ;   min  = 1 bei Minilaufwerken
  789                   ;   dens = 1 bei Single Dense Aufzeichnung
  790                   ;   d = binary drive code
  791                   ;     normalerweise nur 1,2,4,8 moeglich
  792                   ;     Kombinationen moeglich, wenn binaere
  793                   ;     Dekodierung beim Laufwerk verwendet wird
  794                   ; B = 0 Set steprate and SSO-Flag (steprate in D: s00000rr, rr=steprate, s=sso)
  795                   ;   = 1 Read sector
  796                   ;   = 2 Write sector
  797                   
  798                   ; Entry SSO = 0
  799                   
  800 F13C  AF          FLOP:	XOR A  			; SSO-Flag auf 0 setzen
  801                   
  802                   ; Entry SSO in A
  803                   ; called only from old MINI routine
  804                   
  805 F13D              FLOP1:	; SSO flag in A, only 0 and 2 allowed
  806 F13D  32 F314     	LD (SSOFLAG),A
