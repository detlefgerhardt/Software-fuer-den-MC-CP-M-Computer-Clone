  418                   ; prueft den Speicherbereich und gibt die hoechste verfuegbare Zelle an
  419                   ; MEMCHK IN B HIGH IN A LOW MEMORY
  420                   
  421 F0E9  E5          MEMCHK:	PUSH HL
  422 F0EA  CD F0F6     	CALL MEMSIZ
  423 F0ED  7D          	LD A,L
  424 F0EE  D6 3C       	SUB 3CH
  425 F0F0  30 01       	JR NC,MEMCK1
  426                   
  427 F0F2  25          	DEC H
  428                   	
  429 F0F3  44          MEMCK1:	LD B,H
  430 F0F4  E1          	POP HL
  431 F0F5  C9          	RET
