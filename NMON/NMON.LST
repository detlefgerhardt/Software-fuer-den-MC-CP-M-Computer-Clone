 1477 F3E4  D3 19       	OUT (IDE_FEAT),A	; sector count register
 1478 F3E6  3E EF       	LD A,0EFH		; set feature command
 1479 F3E8  D3 1F       	OUT (IDE_STAT),A	; 
 1480                   
 1481 F3EA  CD F3C6     	CALL IDEBSY
 1482                   
 1483 F3ED  3E 01       	LD A,1
 1484 F3EF  32 F3CD     	LD (IDESET),A
 1485                   
