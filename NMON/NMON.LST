 1260                   ;==============================================================================
 1261                   ; IDE/CF card interface
 1262                   ;
 1263                   ; Read one IDE/CF card sector (256 bytes)
 1264                   ;
 1265                   ; Address for data in HL
 1266                   ; LBA bits 0 to 7 passed in C
 1267                   ; LBA bits 8 to 15 passed in B
 1268                   ; LBA bits 16 to 23 passed in E
 1269                   
 1270         0000      	IF NOT DG01
 1316                   	ELSE
 1317                   
 1318 F392  16 20       IDERD:	LD D,20h		; read command
 1319 F394  CD F3C5     	CALL IDEINI		; do all the settings and wait for DRQ
 1320                   
 1321 F397  CD F3BD     	CALL IDEBSY
 1322                   	
 1323 F39A  DB 1F       	IN A,(IDE_STAT)	; clear INTRQ
 1324                   
 1325 F39C              IDERD1: ; read loop
 1326 F39C  DB 18       	IN A,(IDE_DATA)	; get data
 1327 F39E  77          	LD (HL),A
 1328 F39F  23          	INC HL
 1329 F3A0  DB 1F       	IN A,(IDE_STAT)	; check status
 1330 F3A2  E6 08       	AND 08H		; DRQ bit
 1331 F3A4  20 F6       	JR NZ,IDERD1	; loop until cleared
 1332                   	
 1333 F3A6  C9          	RET
 1334                   
 1335                   	ENDIF 	; DG01
 1336                   			
 1337                   ;------------------------------------------------------------------------------
 1338                   ; Write one IDE/CF-card sector (256 bytes)
 1339                   ;
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  19
NMON    Z80

 1340                   ; Address of data in HL
 1341                   ; LBA bits 0 to 7 passed in C
 1342                   ; LBA bits 8 to 15 passed in B
 1343                   ; LBA bits 16 to 23 passed in E
 1344                   
 1345         0000      	IF NOT DG01
 1390                   	ELSE
 1391                   	
 1392 F3A7  16 30       IDEWR:	LD D,30h		; write command
 1393 F3A9  CD F3C5     	CALL IDEINI		; do all the settings and wait for DRQ
 1394                   
 1395 F3AC              IDEWR1:	; write loop
 1396 F3AC  7E          	LD A,(HL)
 1397 F3AD  D3 18       	OUT (IDE_DATA),A	; write data
 1398 F3AF  23          	INC HL
 1399 F3B0  DB 1F       	IN A,(IDE_STAT)		; read status
 1400 F3B2  E6 08       	AND 08H			; check DRQ bit
 1401 F3B4  C2 F3AC     	JP NZ,IDEWR1		; write until bit cleared
 1402                   
 1403 F3B7  CD F3BD     IDEWR2:	CALL IDEBSY
 1404                   
 1405 F3BA  DB 1F       	IN A,(IDE_STAT)		; clear INTRQ
 1406 F3BC  C9          	RET
 1407                   
 1408                   	ENDIF	; DG01
 1409                   
 1410         FFFF      	IF DG01
 1411                   
 1412                   ;------------------------------------------------------------------------------
 1413                   ; IDE wait for Busy cleared
 1414                   
 1415 F3BD  DB 1F       IDEBSY:	IN A,(IDE_STAT)		; check status
 1416 F3BF  E6 80       	AND 80H			; check BSY bit
 1417 F3C1  20 FA       	JR NZ,IDEBSY		; loop until not busy
 1418 F3C3  C9          	RET
 1419                   
 1420                   ;------------------------------------------------------------------------------
 1421                   ; Read/Write command in D (20h = READ, 30h = WRITE)
 1422                   ; Address of data in HL
 1423                   ; LBA bits 0 to 7 passed in C
 1424                   ; LBA bits 8 to 15 passed in B
 1425                   ; LBA bits 16 to 23 passed in E
 1426                   
 1427 F3C4  00          IDESET:	DB 0			; ide initialisation (0 = not, 1 = initalized)
 1428                   
 1429 F3C5  CD F3BD     IDEINI:	CALL IDEBSY
 1430                   
 1431 F3C8  DB 1F       IDEIN1:	IN A,(IDE_STAT)		; check status
 1432 F3CA  E6 40       	AND 40H			; check DRDY bit
 1433 F3CC  CA F3C8     	JP Z,IDEIN1		; loop until ready
 1434                   
 1435 F3CF  3A F3C4     	LD A,(IDESET)
 1436 F3D2  A7          	AND A
 1437 F3D3  20 14       	JR NZ,IDEIN2		; -> skip init
 1438                   
 1439                   	; one time initialisation
 1440 F3D5  3E E0       	LD A,11100000B		; LBA mode, select drive 0
 1441 F3D7  D3 1E       	OUT (IDE_HEAD),A	; sector count register
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  20
NMON    Z80

 1442                   	;LD A,01		; 8 bit mode
 1443                   	;OUT (IDE_FEAT),A	; sector count register
