  789                   ;------------------------------------------------------------------------------
  790                   ; Seek to track
  791                   ; C=Drive D=Track E=Sector
  792                   
  793 F1F5  CD F1E5     SEEK:	CALL WAWA 		; short delay (4 ms)
  794                   
  795 F1F8  79          	LD A,C
