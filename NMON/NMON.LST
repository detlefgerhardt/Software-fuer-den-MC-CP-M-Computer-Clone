 1351                   ;------------------------------------------------------------------------------
 1352                   ; Write one IDE/CF-card sector (256 bytes)
 1353                   ;
 1354                   ; Address of data in HL
 1355                   ; LBA bits 0 to 7 passed in C
 1356                   ; LBA bits 8 to 15 passed in B
 1357                   ; LBA bits 16 to 23 passed in E
 1358                   
 1359         0000      	IF NOT DG01
 1404                   	ELSE
 1405                   	
 1406                   ; Read one IDE/CF card sector (256 bytes)
 1407                   ; HL = Buffer address
 1408                   ; E = Physical sector (1..n)
 1409                   ; D = Track (0..n-1)
 1410                   ; C = Volume
 1411                   	
 1412 F3B0  06 30       IDEWR:	LD B,30h		; write command
 1413 F3B2  CD F3CE     	CALL IDEINI		; do all the settings and wait for DRQ
 1414                   
 1415 F3B5              IDEWR1:	; write loop
