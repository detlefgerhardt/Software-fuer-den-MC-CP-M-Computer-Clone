; NBIOS11.DEF *dg* 26.09.2026
; drive definition for MC CP/M NBIOS 1.x

; NDISKDEF parameters:
; - drive
; - phys. Bytes/Sector
; - phys. Sectors/Track
; - phys. Tracks/Side
; - phys. Sides / Disk
; - Disktype (MiniHD, MaxiSD, MiniDD, MaxiDD)
; - BDOS Blocks size
; - BDOS directory entries
; - BDOS checked direcory entries
; - BDOS Boot tracks (offset)
; or
; - drive
; - drive with same parameters

; --- formats ---------------------------------------------

; drive d (800K, 1024 bytes/sec, 5 sec/trk, 80 trks/side, 2 sides, MiniDD)
DEFINE F800K = NDISKDEF 0,1024,5,80,2,1,MiniDD , 2048,256,256,4 , 1,54,229

; PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
DEFINE F1440K = NDISKDEF 0,1024,9,80,2,1,MiniHD , 4096,256,256,2 , 1,40,229

; PHYSICAL FORMAT: 1.4 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 8 SECTORS/TRACK, 80 TRACKS
DEFINE F1280K = NDISKDEF 0,1024,8,80,2,1,MiniHD , 4096,256,256,2 , 1,40,229

; PHYSICAL FORMAT: 1.2 MB, HD, DS, 512 BYTES/SECTOR, 4096 Bytes/Block, 15 SECTORS/TRACK, 80 TRACKS
DEFINE F1200K = NDISKDEF 0,512,15,80,2,1,MiniHD , 4096,256,256,2 , 1,40,229

; drive d (250K, 128 bytes/sec, 26 sec/trk, 77 trks/side, 1 sides, MaxiDD)
DEFINE IBMSD = NDISKDEF 0,128,26,77,1,6,MaxiSD , 1024,64,64,2 , 0,27,229

; Disk size 2 MB, 128 Byte/Sector, 64 sectors, 256 tracks (0 to 255), Blocksize 4096
DEFINE CF2M = NDISKDEF 0,64,128,256,1,1,None , 4096,256,0,0 , 0,0,0

; phys: Disk size 8 MB, 256 Byte/Sector, 128 sectors/track, 256 tracks
DEFINE CF8M = NDISKDEF 0,256,128,256,1,1,None , 8192,256,0,0 , 0,0,0

; --- drives ----------------------------------------------

NDISKDEF 0,F800K
NDISKDEF 1,F800K
;NDISKDEF 1,0
NDISKDEF 2,F800K
NDISKDEF 3,F1200K
NDISKDEF 4,CF8M
NDISKDEF 5,4
NDISKDEF 6,4
NDISKDEF 7,4

; end of file
