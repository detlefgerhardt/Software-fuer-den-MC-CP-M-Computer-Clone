    1                   ;************************************************************************
    2                   ;* NBIOS11.Z80		RDK/UH/*DG*	09/2026				*
    3                   ;*									*
    4                   ;* basiert direct auf der Version 3.1 841220 von Rolf-Dieter Klein	*
    5                   ;* Urspruengliche Version fuer 2 Mini- und 2 Maxi-Laufwerke		*
    6                   ;*									*
    7                   ;************************************************************************
    8                   ;
    9                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
   10                   ;
   11                   ; 24.06.2026 *dg* Kommentare hinzugefuegt
   12                   ;                 Binaer identisch zur Origial-Version
   13                   ; 06.07.2026 *dg* V1.0 Erste Aenderungen am BIOS. Alte Monnitor-Routinen werden
   14                   ;                 nicht mehr verwendet. Laufwerksumrechnung geaendert.
   15                   ;                 Version getestet.
   16                   ;                 Alle Aenderungen mit bedingter Assemblierung (Flag MINI3)
   17                   ;                 Testweise den Speicherbereich fuer das BIOS auf E200..EFFF
   18                   ;		  geaendert. CP/M startet dann bei CC00 (58K)
   19                   ; 09.07.2026 *dg* V1.0 Erweitert um 4 IDE/CF-Laufwerke - funktioniert nicht
   20                   ;                 System bootet aber Schreiben auf die IDE-Laufwerke schlaegt fehl.
   21                   ; 12.07.2026 *dg* Lesen und Schreiben von CF funktioniert
   22                   ; 31.07.2026 *dg* V1.0 Laufwerk C als HD Laufwerk konfiguriert (1.44 MB)
   23                   ;                 Probleme immer beim ersten Scheiben nach dem Formatieren
   24                   ; 02.08.2026 *dg* Laufwerk B: als 5.25 Zoll HD Laufwerk
   25                   ;		  Funktioniert noch nicht, Format und Laufwerksparameter unklar 
   26                   ; 03.08.2026 *dg* BIOS Debug-Ausgaben per Ctrl-A toggelbar
   27                   ; 06.08.2026 *dg* 5.25 Zoll Format mit 1024*8 funktioniert (1.4 MB)
   28                   ;                 5.25 Zoll Format mit 512*15 funktioniert! (1.2 MB)
   29                   ; 08.08.2026 *dg* CF-Card Laufwerksparameter geaendert
   30                   ; 09.08.2026 *dg* Quick'n dirty fix for Warmboot from IDE/CF
   31                   ;		  (Disk-Parameter immer hardcodiert beim Warmboot aber konfigurierbar)
   32                   ; 03.09.2026 *dg* Deblocking-Parameter fuer jedes Laufwerk stehen jetzt direkt hinter den
   33                   ;		  DPBx Parameter-Bloecken         
   34                   ; 05.09.2026 *dg* New 8192K format for CF/IDE with deblocking
   35                   ; 06.09.2026 *dg* Cleanup
   36                   ; 08.09.2026 *dg* Cleanup
   37                   ; 19.09.2026 *dg* Change selection of disk formats (more defines)
   38                   ; 21.09.2026 *dg* Die Ausmaskierung von Bit 7 bei CONIN herausgenommen, damit
   39                   ;		  Binaer-Transfers wie zum Beispiel Xmodem ueber das BIOS
   40                   ;		  funktionieren.
   41                   ; 25.09.2026 *dg* Laufwerktabelle als Includes, Erzeugung mit neuem Tool NDiskDef.exe
   42                   ;                 NBIOS10 umgenannt in NBIOS11
   43                   ;
   44                   ; Verbesserung/Veraenderungen zu BIOS 3.1 seit Juni 2026
   45                   ;
   46                   ; BIOS vergroessert, dadurch geaenderte Startadressen. CP/M ab CC00-E1FF,
   47                   ; BIOS ab E200-EFFF.
   48                   ; Dateinamen geaendert, die meisten Files und Tools beginnen mit "N" zu
   49                   ; Unterscheidung von den Original-Files.
   50                   ; Laufwerksparameter geaendert, A ist 800KB (NDR/NKC), B und C unterschiedlich,
   51                   ; D ist IBM 8 Zoll SS/SD.
   52                   ; CF/IDE eingebunden, Laufwerke E bis H, je 8 MB, E ist bootfaehig (geaenderte
   53                   ; BIOS-Parameter)
   54                   ; Blocking/Deblocking geaendert, ist jetzt flexibler und leichter zu
   55                   ; konfigurieren max.
   56                   ; max. Steprate wird beim Warmstart gesetzt.
   57                   ; Debug-Ausgaben im BIOS ueber Compiler-Schalter und zur Laufzeit mit Ctrl-A
   58                   ; ein- und ausschaltbar.
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBIOS11 Z80

   59                   ; Diverse Laufwerksformate gestestet, Test mit echten 8 Zoll Laufwerken steht
   60                   ; noch aus.
   61                   ; MOVCPM und SYSGEN funktionieren mit der geaenderten BIOS-Groesse
   62                   ; vermutlich nicht mehr und muessen angasst werden (oder flexible Variante
   63                   ; verwenden).
   64                   ;
   65                   ; TO-DO:
   66                   ; x Drive-spezifische Tabellen direkt bei den Laufwerkstabellen platzieren
   67                   ;   (erledigt 03.09.26)
   68                   ; - Maxi-Routinen in Mini-Routinen integrieren. Gemeinsame Routinen fuer
   69                   ;   Blocking/Deblocking fuer alle Laufwerkstypen.
   70                   ; x Make shure not to override the BIOS on WBOOT -> das war schon so
   71                   ;   (CP/M Alteration Guide page 17)
   72                   ;
   73                   ;------------------------------------------------------------------------------
   74                   
   75                   	.LFCOND
   76                   
   77         000B      BIOSVER EQU 11		; BIOS version 1.1
   78                   
   79         0016      CPMVER	EQU 22		; CP/M version 2.2
   80         0000      FALSE	EQU 0
   81         FFFF      TRUE	EQU NOT FALSE
   82         FFFF      TEST	EQU TRUE
   83         000D      CR	EQU 0DH		; carriage return
   84         000A      LF	EQU 0AH		; line feed
   85                   
   86                   ;------------------------------------------------------------------------------
   87                   ; Variant switches
   88                   
   89         FFFF      DG_NEW	EQU TRUE	; new drive tables (include files generated with
   90                   			; NDiskDef)
   91                   
   92                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 3.1
   93         FFFF      DG_B800	EQU TRUE	; drive B is 800 KB (same as drive A)
   94         0000      DG_B144	EQU FALSE	; drive B as HD drive (5 1/4 inch, 1.44 MB)
   95         0000      DG_B14	EQU FALSE	; drive B as HD drive (5 1/4 inch, 1.4 MB)
   96         0000      DG_B12	EQU FALSE	; drive B as HD drive (5 1/4 inch, 1.2 MB)
   97                   
   98         FFFF      DG_C800	EQU TRUE	; drive C is 800 KB (same as drive A)
   99         0000      DG_C14	EQU FALSE	; drive C as HD drive (5 1/4 inch, 1.4 MB)
  100         0000      DG_C12	EQU FALSE	; drive C as HD drive (5 1/4 inch, 1.2 MB)
  101         0000      DG_CIBM	EQU FALSE	; drive C is IBM
  102                   
  103         0000      DG_D800	EQU FALSE	; drive D is 800 KB (same as drive A)
  104         0000      DG_D144	EQU FALSE	; drive D as HD drive (5 1/4 inch, 1.44 MB)
  105         0000      DG_D14	EQU FALSE	; drive D as HD drive (5 1/4 inch, 1.4 MB)
  106         FFFF      DG_D12	EQU TRUE	; drive D as HD drive (5 1/4 inch, 1.2 MB)
  107         0000      DG_DIBM	EQU FALSE	; drive D is IBM
  108                   
  109         FFFF      NEWIDE	EQU TRUE	; new IDE/CF format (8192 KB)
  110                   
  111         0000      DEBOUT	EQU FALSE	; debug outputs
  112         0000      BTDRV	EQU 0		; drive A:
  113                   ;BTDRV	EQU 4		; drive E: (IDE/CF)
  114                   
  115                   ; logical drive to boot from
  116                   	; boot from disk A (800KB NDE/NKC format)
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBIOS11 Z80

  117         FFFF      	IF BTDRV = 0	; drive A
  118         0008      BTSEC	EQU 8		; start sector of CP/M on disk with 1024 bytes/sector
  119         0028      BTSECN	EQU 40		; sector per track
  120                   	ENDIF
  121                   	
  122                   	; boot from IDE/CF (2 MB format)
  123         0000      	IF BTDRV = 4	; drive E
  124                   BTSEC	EQU 1		; start sector of CP/M on IDE/CF (second sector)
  125                   BTSECN	EQU 64		; sector per track
  126                   	ENDIF
  127                   
  128                   ;------------------------------------------------------------------------------
  129                   ; Monitor functions
  130                   
  131         F003      MCONIN	EQU 0F003H	; read one char from READER device -> A
  132         F006      MREAD	EQU 0F006H	; read one char from READER device -> A
  133         F009      MCONOUT	EQU 0F009H	; write one char to CONSOLE (C)
  134         F00C      MPUNCH	EQU 0F00CH	; write one char to PUNCH device (C)
  135         F00F      MLIST	EQU 0F00FH	; write one char to LIST device (C)			
  136         F012      MCONST	EQU 0F012H	; get console status
  137         F01E      MSTART	EQU 0F01EH	; restart Monitor
  138         F021      MFLOP	EQU 0F021H	; new Mini/Maxi routine in Monitor
  139         F02A      MIDERD	EQU 0F02AH	; read sector from mini/maxi floppy
  140         F02D      MIDEWR	EQU 0F02DH	; write sector to mini/maxi floppy
  141         F033      MWARM	EQU 0F033H	; Monitor warm start, will be overwritten by BIOS
  142         F036      MWRSTR	EQU 0F036H	; Write string, will be overwritten by BIOS (do no call!)
  143                   
  144                   ;------------------------------------------------------------------------------
  145                   ; CPM and BIOS sizes and addresses
  146                   
  147         003A      MSIZE 	EQU 58			; actual memory size of this BIOS (58K)
  148                   ;MSIZE 	EQU 59			; actual memory size of this BIOS (58K)
  149                   ;MSIZE 	EQU 60			; default memory size model (60K)
  150                   
  151         9800      BIAS	EQU (MSIZE - 20) * 1024	; smallest memory model is 20K
  152         CC00      CCP	EQU 3400H + BIAS	; start of CCP (CP/M), smallest memory model starts at 3400h
  153         D406      BDOS	EQU CCP + 806H		; BDOS entry behind 6 byte serial number, size of CCP is 800h
  154         1600      CPML	EQU 1600H		; length of CP/M (CCP + BDOS)
  155         E200      BIOS	EQU CCP + CPML		; start of BIOS
  156                   
  157         D400      BDOSADR	EQU BDOS - 6		; actual start address of BDOS (used for patches)
  158                   
  159         CC00      CPMB	EQU CCP			; CP/M boot entry
  160                   
  161         002C      NSECTS	EQU CPML / 128		; Number of logical sectors ocupied by CP/M
  162                   				; (used for for WBOOT)
  163                   
  164                   ;-----------------------------------------------------------------------------
  165                   ; Memory addresses below 0100h
  166                   
  167         0000      JWARM	EQU 0000H	; JMP to WBOOT
  168         0003      IOBYTE	EQU 0003H	; Address of IOBYTE
  169         0004      CDISK	EQU 0004H	; Address of last used drive and user (low-nibble: current drive, high-nibble: current user)
  170         0005      JBDOS	EQU 0005H	; JMP to BDOS
  171         0038      JRST7	EQU 0038H	; JMP RST7 (7*8)
  172         0080      BUFF	EQU 0080H	; buffer address
  173         0005      RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write
  174                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
NBIOS11 Z80

  175                   ;-----------------------------------------------------------------------------
  176                   
  177         E200      	ORG BIOS	; regular start of BIOS
  178                   	;ORG BIOS-4000H	; for debugging
  179                   
  180 E200              STARTBIOS:
  181                   
  182 E200  C3 E3AF     	JP BOOT		; Cold boot
  183                   
  184                   	; --- start of offical BIOS calls ---
  185                   	
  186 E203  C3 E3DC     WBOOTE:	JP WBOOT	; Warm boot (CTRL-C)
  187 E206  C3 F012     	JP MCONST	; Get CONSOLE status -> A, 0FFh if character available
  188 E209  C3 E3AB     	JP CONIN	; Input character from CONSOLE -> A
  189 E20C  C3 F009     	JP MCONOUT	; Output character to CONSOLE (C)
  190 E20F  C3 F00F     	JP MLIST	; Output character to LIST device (C)
  191 E212  C3 F00C     	JP MPUNCH	; Output character to PUNCH device (C)
  192 E215  C3 F006     	JP MREAD	; Input character from READER device -> A
  193                   
  194 E218  C3 E47D     	JP HOME		; Select track home position (no execution)
  195 E21B  C3 E482     	JP SELDSK	; Select drive, drive 0..n-1 in C, returns disk parameter header block in HL
  196 E21E  C3 E4CC     	JP SETTRK	; Select track for read/write, track in C (logic tracks!!! e.g. 0..159)
  197 E221  C3 E4D1     	JP SETSEC	; Select sector for read/write, sector in C (logic sectors!!! e.g. 0..39)
  198 E224  C3 E4EF     	JP SETDMA	; Set disk read/write address (no real DMA), address in BC
  199 E227  C3 E518     	JP READ		; Read sector
  200 E22A  C3 E5A4     	JP WRITE	; Write sector
  201 E22D  C3 E47A     	JP LISTST	; Listener ready? (not implemented, returns 1 = not ready)
  202 E230  C3 E4D6     	JP SECTRAN	; sector translation (skew only)
  203                   	
  204                   	; --- end of offical BIOS calls ---
  205                   
  206 E233  C3 E3A8     	JP GETVER	; get BIOS version
  207 E236  C3 E4F5     	JP GETPHY	; get physical drive parameters (for diskcopy and similar
  208                   			; utilities)
  209                   	
  210                   	;JP FLUSH	; BDOS close and write sector buffer to disk (not used)
  211                   
  212                   ;-----------------------------------------------------------------------------
  213                   
  214                   	; size of mini disks A, B, C
  215                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  216                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  217                   
  218                   	;DISKS 8		; define 8 drives (A..H)
  219         0008      NDISKS	EQU	8	
  220                   
  221         E239      DPBASE	EQU	$		;BASE OF DISK PARAMETER BLOCKS
