 1275                   ;-----------------------------------------------------------------------------
 1276                   ; Write sector using MFLOP into monitor
 1277                   
 1278                   ; Buffer (DMA address) in IOD
 1279                   ; Drive in DBANK (0..n-1)
 1280                   ; Track in IOT (0..n-1)
 1281                   ; Sector in IOS (0..n-1)
 1282                   ; BDOS-Flag in C (0 = standard sector, 1 = directory sector, 2 =  first sector in block)
 1283                   
 1284 E5A6              WRITE:
 1285         FFFF      	IF NEWIDE
 1286                   	; reset CF/IDE flag
 1287 E5A6  AF          	XOR A
 1288 E5A7  32 E7B9     	LD (ISIDE),A
 1289                   	ENDIF
 1290                   	
 1291 E5AA  3A E7B1     	LD A,(DBANK)
 1292 E5AD  FE 08       	CP 8
 1293 E5AF  30 1C       	JR NC,WRERR	; DBANK >= 8 -> does not exist
 1294                   
 1295                   	; DBANK < 8
 1296 E5B1  3A E7B8     	LD A,(BLREG)
 1297 E5B4  E6 80       	AND 10000000B	; flag for IDE disk
 1298 E5B6  28 08       	JR Z,WRITE1	; -> no IDE disk
 1299                   
 1300                   	; IDE disk
 1301 E5B8  3E 01       	LD A,1
 1302 E5BA  32 E7B9     	LD (ISIDE),A
 1303 E5BD  C3 E677     	JP MINIWR	; -> IDE disk
 1304                   	
 1305 E5C0  3A E7B8     WRITE1:	LD A,(BLREG)
 1306 E5C3  E6 30       	AND 00110000B
 1307 E5C5  FE 10       	CP 00010000B
 1308 E5C7  CA E5D0     	JP Z,MAXIWR	; -> Maxi disk
 1309 E5CA  C3 E677     	JP MINIWR
 1310                   
 1311         0000      	if NOT NEWIDE
 1312                   	
 1313                   	CP 8
 1314                   	JP C,IDEWR	; A < 8 -> IDE disks 4,5,6,7
 1315                   	
 1316                   	ENDIF		; NOT NEWIDE
 1317                   	
