 1807                   ;-----------------------------------------------------------------------------
 1808                   
 1809                   ; Addresses of IDE-80 CF-Adapter card
 1810                   
 1811         0018      IDEDATA	EQU 018h	; IDE Data Register
 1812         001A      SECCND	EQU 01Ah	; Sector Count Register
 1813         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1814         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1815         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1816         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1817         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1818                   
 1819                   ; IDE/CF physical format: 
 1820                   ; 4 partitions
 1821                   ; 8192 KB bytes/partition 
 1822                   ; 128 bytes/sector
 1823                   ; 256 sectors/track
 1824                   ; 256 tracks
 1825                   ; 128 * 256 * 256 / 1024 = 8192
 1826                   
 1827                   ; old (2048K):
 1828                   ; LBA
 1829                   ; 00000000 00000000 00000000
 1830                   ; 00000000 tttttttt ssssssdd
 1831                   ;        E        B        C
 1832                   
 1833                   ; NEWIDE (8192K):
 1834                   ; LBA
 1835                   ; 00000000 00000000 00000000
 1836                   ; 000000dd tttttttt ssssssss
 1837                   ;        E        B        C
 1838                   
 1839                   ;-----------------------------------------------------------------------------
 1840                   ; Read one 256 byte sector from disk.
 1841                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1842                   ; Disk number in DBANK  (4..7)
 1843                   ; Track number in IOT
 1844                   ; Sector number in IOS
 1845                   ; DMA address in IOD
 1846                   
 1847         0000      	IF NOT NEWIDE
 1848                   
 1849                   IDERD:	LD HL,PHSBUF
 1850                   
 1851                   	; LBA0..7 -> C
 1852                   	LD A,(IOS)
 1853                   	SLA A		; make room for 4 disks (0 to 3, 2 bits)
 1854                   	SLA A
 1855                   	LD B,A
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  36
NBIOS11 Z80

 1856                   	LD A,(DBANK)
 1857                   	SUB A,4
 1858                   	OR B
 1859                   	LD C,A		; C = sector * 4 + (diskno - 4)
 1860                   
 1861                   	; LBA8..15 -> B
 1862                   	LD A,(IOT)
 1863                   	LD B,A
 1864                   	
 1865                   	; LBA16..23) -> E
 1866                   	LD E,0
 1867                   
 1868                   	CALL MIDERD
 1869                   
 1870                   	PUSH AF
 1871                   	LD C,'*'
 1872                   	CALL MCONOUT
 1873                   	LD C,'R'
 1874                   	CALL MCONOUT
 1875                   	CALL DEBX16
 1876                   	LD C,'*'
 1877                   	CALL MCONOUT
 1878                   	POP AF
 1879                   
 1880                   	AND 01H
 1881                   	RET NZ		; -> exit with error
 1882                   			
 1883                   	LD HL,(IOD)	; memory location to place data read from disk
 1884                   	LD DE,PHSBUF	; host buffer
 1885                   
 1886                   	LD B,128	; size of CP/M sector
 1887                   IDERD6:	LD A,(DE)	; get byte from host buffer
 1888                   	LD (HL),A	; put in memory
 1889                   	INC HL
 1890                   	INC DE
 1891                   	DJNZ IDERD6	; put 128 bytes into memory
 1892                   
 1893                   	; no error
 1894                   	XOR A
 1895                   	RET
 1896                   
 1897                   	ENDIF		; NEWIDE
 1898                   	
 1899                   ;-----------------------------------------------------------------------------
 1900                   ; Write one 26 byte sector to IDE
 1901                   ; Return a 00h in register A if the operation completes properly, and 0lh if an error occurs during the read or write
 1902                   ; Disk number in DBANK (4..7)
 1903                   ; Track number in IOT (0..n-1)
 1904                   ; Sector number in IOS (0..n-1)
 1905                   ; DMA address in IOD (0-65535)
 1906                   
 1907         0000      	IF NOT NEWIDE
 1908                   
 1909                   IDEWR:	LD HL,(IOD)	; memory location of data to write
 1910                   	LD DE,PHSBUF	; host buffer
 1911                   	LD B,128	; size of CP/M sector
 1912                   
 1913                   IDEWR1:	LD A,(HL)	; get byte from memory
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  37
NBIOS11 Z80

 1914                   	LD (DE),A	; put in host buffer
 1915                   	INC HL
 1916                   	INC DE
