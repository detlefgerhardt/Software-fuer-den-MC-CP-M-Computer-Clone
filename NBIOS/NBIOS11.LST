  912 E438  CD E4EF     	CALL SETDMA	; so wie es CP/M braucht
  913                   	
  914 E43B  3E C3       	LD A,0C3H	; Sprung auf den WARM-Boot im
  915 E43D  32 0000     	LD (JWARM),A	; RAM ablegen.
  916 E440  21 E203     	LD HL,WBOOTE	; Warm-Boot-Adresse
  917 E443  22 0001     	LD (JWARM+1),HL	; nicht vergessen
  918                   	
  919 E446  32 0005     	LD (JBDOS),A	; Sprung auf die BDOS-CALL-Adresse
  920 E449  21 D406     	LD HL,BDOS	; legen und auch das Ziel
  921 E44C  22 0006     	LD (JBDOS+1),HL	; dorthin
