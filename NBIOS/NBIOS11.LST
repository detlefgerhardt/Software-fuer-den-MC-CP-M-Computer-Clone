  857 E3E7              WBOO2:	; loop, load CP/M
  858 E3E7  01 CC00     	LD BC,CPMB	; Init load address to CPM start address
  859 E3EA  CD E4E5     	CALL SETDMA
  860 E3ED  0E 00       	LD C,BTDRV	; drive 0 (or BTDRV)
  861 E3EF  CD E478     	CALL SELDSK
  862 E3F2  0E 00       	LD C,0		; track 0
  863 E3F4  CD E4C2     	CALL SETTRK
  864 E3F7  0E 08       	LD C,BTSEC	; start with first logical sector behind physical boot sector
  865 E3F9  CD E4C7     	CALL SETSEC	; (depends on the number of logical sectors per phyiscal sector)
  866 E3FC  C1          	POP BC
  867 E3FD  06 2C       	LD B,NSECTS	; number of sectors for CP/M without BIOS, do not overwrite BIOS
  868                   			; to preserve patches.
  869                   
  870                   	;LD C,'1'
  871                   	;CALL MCONOUT
  872                   
  873 E3FF              WBOO3:	; sector read loop
  874 E3FF  C5          	PUSH BC
  875 E400  CD E508     	CALL READ	; read logical secor
  876 E403  C2 E458     	JP NZ,BOOTERR	; -> error
  877                   	
  878 E406  2A E882     	LD HL,(IOD)	; increment DMA address by 128
  879 E409  11 0080     	LD DE,128
  880 E40C  19          	ADD HL,DE
  881 E40D  22 E882     	LD (IOD),HL
  882 E410  3A E881     	LD A,(IOS)	; check for end of track
  883 E413  FE 27       	CP BTSECN-1
  884 E415  DA E422     	JP C,WBOO4
  885                   
  886                   	; next track, Caution! track scheme is hardcoded !!!
  887 E418  3A E880     	LD A,(IOT)	; increment track
  888 E41B  3C          	INC A	  	; jedoch im Verfahren 0,2,...
  889 E41C  3C          	INC A		; SPUR 0, dann SPUR 2, wegen BOOT.ASM
  890 E41D  32 E880     	LD (IOT),A	; denn 1,3,5 ist die Rueckseite des Laufwerks
  891 E420  3E FF       	LD A,0FFH	; 0,1,2,3.... will by incremented to 0
  892                   	
  893 E422  3C          WBOO4:	INC A
  894 E423  32 E881     	LD (IOS),A	; set new sector
  895                   	
  896 E426  C1          	POP BC		; Schleifenzaehler zuruech
  897 E427  05          	DEC B		; und immer weiter lesen
  898 E428  C2 E3FF     	JP NZ,WBOO3	; -> read next sector
  899                   	
  900                   	;---------------------------------------------------------------------
  901                   
  902 E42B  01 0080     GOCPM:	LD BC,BUFF	; Buffer auf Default einstellen
  903 E42E  CD E4E5     	CALL SETDMA	; so wie es CP/M braucht
  904                   	
  905 E431  3E C3       	LD A,0C3H	; Sprung auf den WARM-Boot im
  906 E433  32 0000     	LD (JWARM),A	; RAM ablegen.
  907 E436  21 E203     	LD HL,WBOOTE	; Warm-Boot-Adresse
  908 E439  22 0001     	LD (JWARM+1),HL	; nicht vergessen
  909                   	
  910 E43C  32 0005     	LD (JBDOS),A	; Sprung auf die BDOS-CALL-Adresse
  911 E43F  21 D406     	LD HL,BDOS	; legen und auch das Ziel
  912 E442  22 0006     	LD (JBDOS+1),HL	; dorthin
  913                   	
  914 E445  32 0038     	LD (JRST7),A	; RST7 definieren, default ist Monitor
