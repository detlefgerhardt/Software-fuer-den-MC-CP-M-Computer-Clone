 1377                   ; only for Mini disks
 1378                   
 1379                   ; DBANK, IOT     C
 1380                   ;  0     F    -> 0
 1381                   ;  1     F    -> 2
 1382                   ;  0     B    -> 1
 1383                   ;  1     B    -> 3
 1384                   
 1385                   ; muss fuer Minidisk C und D erweitert werden
 1386                   
 1387                   ; drive number (0..n-1) -> C, Bit 0..3
 1388                   ; side -> (0..n-1) -> C, Bit 7
