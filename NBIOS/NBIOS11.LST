 1224                   ; Umrechnen fuer Maxi fuer neue Monitor Floppy-Routine
 1225                   ; drive-code -> C
 1226                   
 1227 E56A              MAXCAL:	; drive A,B,C,D -> 0001,0010,0100,1000
 1228 E56A  3A E7B1     	LD A,(DBANK)	; 0..3
 1229 E56D  3C          	INC A		; -> 1..4
 1230 E56E  47          	LD B,A
 1231 E56F  37          	SCF		; shift in carry
 1232 E570  17          MAXC2:	RLA
 1233 E571  10 FD       	DJNZ MAXC2
 1234                   	
 1235 E573  47          	LD B,A
 1236 E574  3A E7B8     	LD A,(BLREG)
 1237 E577  B0          	OR B
 1238 E578  4F          	LD C,A
 1239                   
 1240 E579  3A E7B1     	LD A,(DBANK)
 1241 E57C  FE 04       	CP 4
 1242 E57E  C2 E585     	JP NZ,MAXC3
 1243                   	
 1244                   	; drive E, side 1
 1245 E581  79          	LD A,C
 1246 E582  F6 80       	OR 10000000B
 1247 E584  4F          	LD C,A
 1248                   
 1249 E585  C9          MAXC3:	RET
