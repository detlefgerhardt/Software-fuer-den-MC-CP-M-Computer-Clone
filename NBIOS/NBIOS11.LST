 1816                   ; IDE/CF physical format: 
 1817                   ; 4 partitions
 1818                   ; 8192 KB bytes/partition 
 1819                   ; 128 bytes/sector
 1820                   ; 256 sectors/track
 1821                   ; 256 tracks
 1822                   ; 128 * 256 * 256 / 1024 = 8192
 1823                   
 1824                   ; old (2048K):
 1825                   ; LBA
 1826                   ; 00000000 00000000 00000000
 1827                   ; 00000000 tttttttt ssssssdd
 1828                   ;        E        B        C
 1829                   
 1830                   ; NEWIDE (8192K):
 1831                   ; LBA
 1832                   ; 00000000 00000000 00000000
 1833                   ; 000000dd tttttttt ssssssss
 1834                   ;        E        B        C
