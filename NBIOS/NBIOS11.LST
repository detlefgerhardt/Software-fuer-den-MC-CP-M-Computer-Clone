 1057                   ;-----------------------------------------------------------------------------
 1058                   ; Sector translation (used by BDOS)
 1059                   ; sector in C
 1060                   ; skew table in DE (or 0)
 1061                   ; write calculated sector to IOS and L
 1062                   
 1063 E4D6  7A          SECTRAN:LD A,D		; check if skew table != 0
 1064 E4D7  B3                  OR E
 1065 E4D8  CA E4E7             JP Z,SECTR1	; =0, -> no skew
 1066                   
 1067                   	; calc sector offset into skew table
 1068 E4DB  06 00       	LD B,0
 1069 E4DD  EB          	EX DE,HL
 1070 E4DE  09          	ADD HL,BC	; sector in C
 1071 E4DF  7E          	LD A,(HL)	; load skew value
