 1058                   ; Select sector  (used by BDOS)
 1059                   ; sector in C
 1060                   
 1061 E4D1  21 E7B3     SETSEC:	LD HL,IOS
 1062 E4D4  71          	LD (HL),C
 1063 E4D5  C9          	RET
 1064                   
 1065                   ;-----------------------------------------------------------------------------
 1066                   ; Sector translation (used by BDOS)
 1067                   ; sector in C
 1068                   ; skew table in DE (or 0)
 1069                   ; write calculated sector to IOS and L
 1070                   
 1071 E4D6  7A          SECTRAN:LD A,D		; check if skew table != 0
 1072 E4D7  B3                  OR E
 1073 E4D8  CA E4E7             JP Z,SECTR1	; =0, -> no skew
 1074                   
 1075                   	; calc sector offset into skew table
 1076 E4DB  06 00       	LD B,0
 1077 E4DD  EB          	EX DE,HL
 1078 E4DE  09          	ADD HL,BC	; sector in C
 1079 E4DF  7E          	LD A,(HL)	; load skew value
 1080 E4E0  32 E7B3     	LD (IOS),A	; save in IOS 
 1081 E4E3  6F          	LD L,A		; and in L
 1082 E4E4  26 00               LD H,0		; was missing *dg* 27.07.2026
 1083 E4E6  C9          	RET
 1084                   
 1085 E4E7              SECTR1:	; no skew, return sector
 1086 E4E7  69          	LD L,C		; sector in C
 1087 E4E8  79                  LD A,C
 1088 E4E9  32 E7B3             LD (IOS),A	; save in IOS
 1089 E4EC  26 00               LD H,0
 1090 E4EE  C9                  RET
