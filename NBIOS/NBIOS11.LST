  818 E3B8  3E 00       	LD A,BTDRV
  819 E3BA  32 0004     	LD (CDISK),A
  820                   	
  821                   	; sector buffer is empty, set to physical sector buffer not changed
  822 E3BD  AF          	XOR A
  823 E3BE  32 E7AA     	LD (BUFCHG),A
  824                   	
  825                   	; drive is undefined
  826 E3C1  3E FF       	LD A,0FFH
  827 E3C3  32 E7AB     	LD (CURDRV),A
  828                   
