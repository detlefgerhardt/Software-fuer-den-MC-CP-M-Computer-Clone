  885 E40D  C2 E462     	JP NZ,BOOTERR	; -> error
  886                   	
  887 E410  2A E7B4     	LD HL,(IOD)	; increment DMA address by 128
  888 E413  11 0080     	LD DE,128
  889 E416  19          	ADD HL,DE
  890 E417  22 E7B4     	LD (IOD),HL
  891 E41A  3A E7B3     	LD A,(IOS)	; check for end of track
  892 E41D  FE 27       	CP BTSECN-1
  893 E41F  DA E42C     	JP C,WBOO4
  894                   
  895                   	; next track, Caution! track scheme is hardcoded !!!
  896 E422  3A E7B2     	LD A,(IOT)	; increment track
  897 E425  3C          	INC A	  	; jedoch im Verfahren 0,2,...
  898 E426  3C          	INC A		; SPUR 0, dann SPUR 2, wegen BOOT.ASM
  899 E427  32 E7B2     	LD (IOT),A	; denn 1,3,5 ist die Rueckseite des Laufwerks
  900 E42A  3E FF       	LD A,0FFH	; 0,1,2,3.... will by incremented to 0
  901                   	
  902 E42C  3C          WBOO4:	INC A
  903 E42D  32 E7B3     	LD (IOS),A	; set new sector
  904                   	
  905 E430  C1          	POP BC		; Schleifenzaehler zuruech
  906 E431  05          	DEC B		; und immer weiter lesen
  907 E432  C2 E409     	JP NZ,WBOO3	; -> read next sector
  908                   	
