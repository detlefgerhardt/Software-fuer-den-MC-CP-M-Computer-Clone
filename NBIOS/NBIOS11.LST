  840 E3D2  16 80       	LD D,10000000B	; max steprate 00b, use sso
  841 E3D4  06 00       	LD B,0		; set steprate
  842 E3D6  CD F021     	CALL MFLOP
  843                   	
  844 E3D9  C3 E435     	JP GOCPM	; start CP/M
  845                   
  846                   ;-----------------------------------------------------------------------------
  847                   ; Warm boot
  848                   
  849 E3DC              WBOOT:	; write physical sector buffer to disk if changed
  850 E3DC  3A E7AA     	LD A,(BUFCHG)
  851 E3DF  B7          	OR A
  852 E3E0  CA E3E6     	JP Z,WBOO1
  853                   
  854 E3E3  CD E735     	CALL PUTPHS	; normalerweise ist Schreibvorgang
  855                   			; nach einem Direktoryzugriff abgeschlossen
  856                   			; ACHTUNG BUG!? PUTPHS nur fuer Mini/DD-Laufwerke
  857                   			; Bei einem anderen Laufwerk geht das wohl schief
  858                   			
  859 E3E6  3E FF       WBOO1:	LD A,0FFH	; alle Tracks ungueltig, bei Diskettenwechsel wichtig
  860 E3E8  32 E7AB     	LD (CURDRV),A
  861                   
  862 E3EB  31 0080     	LD SP,BUFF	; Stack zuweisen
  863 E3EE  0E 05       	LD C,RETRY	; Anzahl der Versuche
