 1065                   
 1066                   	; calc sector offset into skew table
 1067 E4D1  06 00       	LD B,0
 1068 E4D3  EB          	EX DE,HL
 1069 E4D4  09          	ADD HL,BC	; sector in C
 1070 E4D5  7E          	LD A,(HL)	; load skew value
