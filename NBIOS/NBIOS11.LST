 1196 E547  0F           	RRCA			; txxxxxxx
 1197 E548  E6 80        	AND 80H
 1198 E54A  6F           	LD L,A			; t0000000
 1199 E54B  3A E880      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
