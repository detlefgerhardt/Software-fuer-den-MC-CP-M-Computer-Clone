 1371                   ; Calculates physical drive from DBANK and IOT -> C
 1372                   ; only for Mini disks
 1373                   
 1374                   ; DBANK, IOT     C
 1375                   ;  0     F    -> 0
 1376                   ;  1     F    -> 2
 1377                   ;  0     B    -> 1
 1378                   ;  1     B    -> 3
 1379                   
 1380                   ; muss fuer Minidisk C und D erweitert werden
 1381                   
 1382                   ; drive number (0..n-1) -> C, Bit 0..3
 1383                   ; side -> (0..n-1) -> C, Bit 7
 1384                   
 1385                   ; calculates physical sector from logical sector, IOS -> E
 1386                   ; logical sector 0..39 -> physical sector 1..5
 1387                   
 1388                   ; calculates logical track from physical track, IOT -> D
 1389                   ; 0..159 -> 0..79 (max 127)
 1390                   
 1391 E5DC              MINCAL:	; logical sector to physical sector
 1392                   	; get drive specific factor
 1393 E5DC  3A E884     	LD A,(BLPOW)
 1394 E5DF  A7          	AND A
 1395 E5E0  28 0A       	JR Z,MINIC4	; -> factor = 0
