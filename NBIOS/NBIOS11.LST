 1213                   
 1214 E558              MAXCAL:	; drive A,B,C,D -> 0001,0010,0100,1000
 1215 E558  3A E87F     	LD A,(DBANK)	; 0..3
 1216 E55B  3C          	INC A		; -> 1..4
 1217 E55C  47          	LD B,A
