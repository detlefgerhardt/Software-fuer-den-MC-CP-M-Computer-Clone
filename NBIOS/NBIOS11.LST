 1251 E584  CD E558     	CALL MAXCAL	; vorher Laufwerkscode umrechnen
 1252 E587  CD F021     	CALL MFLOP	; und dann ausfuehren
 1253 E58A  C1          	POP BC		; Retry-Zaehler
 1254 E58B  C8          	RET Z		; kein Fehler, dann ok zurueck
 1255 E58C  05          	DEC B		; sonst nochmals probieren
 1256 E58D  C2 E576     	JP NZ,MAXIR1	; -> retry		
