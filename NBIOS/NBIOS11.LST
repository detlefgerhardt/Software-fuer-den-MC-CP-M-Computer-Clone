 1049                   ;-----------------------------------------------------------------------------
 1050                   ; Select track (used by BDOS)
 1051                   ; track in C
 1052                   
 1053 E4CC  21 E7B2     SETTRK:	LD HL,IOT
 1054 E4CF  71          	LD (HL),C
 1055 E4D0  C9          	RET
