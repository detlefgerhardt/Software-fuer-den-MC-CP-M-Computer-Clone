 1059                   ;-----------------------------------------------------------------------------
 1060                   ; Sector translation (used by BDOS)
 1061                   ; sector in C
 1062                   ; skew table in DE (or 0)
 1063                   ; write calculated sector to IOS and L
 1064                   
 1065 E4D6  7A          SECTRAN:LD A,D		; check if skew table != 0
 1066 E4D7  B3                  OR E
 1067 E4D8  CA E4E7             JP Z,SECTR1	; =0, -> no skew
 1068                   
 1069                   	; calc sector offset into skew table
 1070 E4DB  06 00       	LD B,0
 1071 E4DD  EB          	EX DE,HL
 1072 E4DE  09          	ADD HL,BC	; sector in C
 1073 E4DF  7E          	LD A,(HL)	; load skew value
 1074 E4E0  32 E7AF     	LD (IOS),A	; save in IOS 
 1075 E4E3  6F          	LD L,A		; and in L
 1076 E4E4  26 00               LD H,0		; was missing *dg* 27.07.2026
 1077 E4E6  C9          	RET
 1078                   
 1079 E4E7              SECTR1:	; no skew, return sector
 1080 E4E7  69          	LD L,C		; sector in C
 1081 E4E8  79                  LD A,C
 1082 E4E9  32 E7AF             LD (IOS),A	; save in IOS
 1083 E4EC  26 00               LD H,0
 1084 E4EE  C9                  RET
