 1386                   ; DBANK, IOT     C
 1387                   ;  0     F    -> 0
 1388                   ;  1     F    -> 2
 1389                   ;  0     B    -> 1
 1390                   ;  1     B    -> 3
 1391                   
 1392                   ; muss fuer Minidisk C und D erweitert werden
 1393                   
 1394                   ; drive number (0..n-1) -> C, Bit 0..3
 1395                   ; side -> (0..n-1) -> C, Bit 7
 1396                   
 1397                   ; calculates physical sector from logical sector, IOS -> E
 1398                   ; logical sector 0..39 -> physical sector 1..5
 1399                   
 1400                   ; calculates logical track from physical track, IOT -> D
 1401                   ; 0..159 -> 0..79 (max 127)
 1402                   
