 1379                   ; only for Mini disks
 1380                   
 1381                   ; DBANK, IOT     C
 1382                   ;  0     F    -> 0
 1383                   ;  1     F    -> 2
 1384                   ;  0     B    -> 1
 1385                   ;  1     B    -> 3
 1386                   
 1387                   ; muss fuer Minidisk C und D erweitert werden
 1388                   
 1389                   ; drive number (0..n-1) -> C, Bit 0..3
 1390                   ; side -> (0..n-1) -> C, Bit 7
 1391                   
