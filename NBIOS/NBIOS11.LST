 1359                   ;READ und WRITE unter Verwendung von MEXEC
 1360                   ; HL=DMA ADR
 1361                   ; DE=TRACK/SECTOR
 1362                   ; B=0 RSTORE
 1363                   ;   1 READ
 1364                   ;   2 WRITE
