 1816                   ;-----------------------------------------------------------------------------
 1817                   
 1818                   ; Addresses of IDE-80 CF-Adapter card
 1819                   
 1820         0018      IDEDATA	EQU 018h	; IDE Data Register
 1821         001A      SECCND	EQU 01Ah	; Sector Count Register
 1822         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1823         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1824         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1825         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1826         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1827                   
 1828                   ; IDE/CF physical format: 
 1829                   ; 4 partitions
 1830                   ; 8192 KB bytes/partition 
 1831                   ; 128 bytes/sector
 1832                   ; 256 sectors/track
 1833                   ; 256 tracks
 1834                   ; 128 * 256 * 256 / 1024 = 8192
 1835                   
 1836                   ; old (2048K):
 1837                   ; LBA
 1838                   ; 00000000 00000000 00000000
 1839                   ; 00000000 tttttttt ssssssdd
 1840                   ;        E        B        C
 1841                   
 1842                   ; NEWIDE (8192K):
 1843                   ; LBA
 1844                   ; 00000000 00000000 00000000
 1845                   ; 000000dd tttttttt ssssssss
 1846                   ;        E        B        C
 1847                   
 1848                   ;-----------------------------------------------------------------------------
 1849                   ; Read one 256 byte sector from disk.
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  36
NBIOS11 Z80

 1850                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1851                   ; Disk number in DBANK  (4..7)
 1852                   ; Track number in IOT
 1853                   ; Sector number in IOS
 1854                   ; DMA address in IOD
 1855                   
 1856         0000      	IF NOT NEWIDE
 1857                   
 1858                   IDERD:	LD HL,PHSBUF
 1859                   
 1860                   	; LBA0..7 -> C
 1861                   	LD A,(IOS)
 1862                   	SLA A		; make room for 4 disks (0 to 3, 2 bits)
 1863                   	SLA A
 1864                   	LD B,A
 1865                   	LD A,(DBANK)
 1866                   	SUB A,4
 1867                   	OR B
 1868                   	LD C,A		; C = sector * 4 + (diskno - 4)
 1869                   
 1870                   	; LBA8..15 -> B
 1871                   	LD A,(IOT)
 1872                   	LD B,A
 1873                   	
 1874                   	; LBA16..23) -> E
 1875                   	LD E,0
 1876                   
 1877                   	CALL MIDERD
 1878                   
 1879                   	PUSH AF
 1880                   	LD C,'*'
 1881                   	CALL MCONOUT
 1882                   	LD C,'R'
 1883                   	CALL MCONOUT
 1884                   	CALL DEBX16
 1885                   	LD C,'*'
 1886                   	CALL MCONOUT
 1887                   	POP AF
 1888                   
 1889                   	AND 01H
 1890                   	RET NZ		; -> exit with error
 1891                   			
 1892                   	LD HL,(IOD)	; memory location to place data read from disk
 1893                   	LD DE,PHSBUF	; host buffer
 1894                   
 1895                   	LD B,128	; size of CP/M sector
 1896                   IDERD6:	LD A,(DE)	; get byte from host buffer
 1897                   	LD (HL),A	; put in memory
 1898                   	INC HL
 1899                   	INC DE
 1900                   	DJNZ IDERD6	; put 128 bytes into memory
 1901                   
 1902                   	; no error
 1903                   	XOR A
 1904                   	RET
 1905                   
 1906                   	ENDIF		; NEWIDE
 1907                   	
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  37
NBIOS11 Z80

 1908                   ;-----------------------------------------------------------------------------
 1909                   ; Write one 26 byte sector to IDE
 1910                   ; Return a 00h in register A if the operation completes properly, and 0lh if an error occurs during the read or write
 1911                   ; Disk number in DBANK (4..7)
 1912                   ; Track number in IOT (0..n-1)
 1913                   ; Sector number in IOS (0..n-1)
 1914                   ; DMA address in IOD (0-65535)
 1915                   
 1916         0000      	IF NOT NEWIDE
 1917                   
 1918                   IDEWR:	LD HL,(IOD)	; memory location of data to write
 1919                   	LD DE,PHSBUF	; host buffer
 1920                   	LD B,128	; size of CP/M sector
 1921                   
 1922                   IDEWR1:	LD A,(HL)	; get byte from memory
 1923                   	LD (DE),A	; put in host buffer
 1924                   	INC HL
 1925                   	INC DE
 1926                   	DJNZ IDEWR1	; put 128 bytes in host buffer
 1927                   
 1928                   	LD HL,PHSBUF
 1929                   
 1930                   	; LBA0..7 -> C
 1931                   	LD A,(IOS)
 1932                   	SLA A		; make room for 4 disks (0 to 3, 2 bits)
 1933                   	SLA A
 1934                   	LD B,A
 1935                   	LD A,(DBANK)
 1936                   	SUB A,4
 1937                   	OR B
 1938                   	LD C,A		; C = sector * 4 + (diskno - 4)
 1939                   	
 1940                   	; LBA8..15 -> B
 1941                   	LD A,(IOT)
 1942                   	LD B,A
 1943                   	
 1944                   	; LBA16..23) -> E
 1945                   	LD E,0
 1946                   
 1947                   	CALL MIDEWR
 1948                   
 1949                   	; status in A
 1950                   	AND 01h		; error flag
 1951                   	RET
 1952                   
 1953                   	ENDIF		; NEWIDE
