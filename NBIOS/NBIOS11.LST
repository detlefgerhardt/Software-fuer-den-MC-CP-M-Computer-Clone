 1360                   ; Read Mini disk, 80 Spur, DD, DS
 1361                   
 1362                   ;READ und WRITE unter Verwendung von MEXEC
 1363                   ; HL=DMA ADR
 1364                   ; DE=TRACK/SECTOR
 1365                   ; B=0 RSTORE
 1366                   ;   1 READ
 1367                   ;   2 WRITE
