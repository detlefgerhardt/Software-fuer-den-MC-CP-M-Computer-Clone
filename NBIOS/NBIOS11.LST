 1812                   
 1813                   ; Addresses of IDE-80 CF-Adapter card
 1814                   
 1815         0018      IDEDATA	EQU 018h	; IDE Data Register
 1816         001A      SECCND	EQU 01Ah	; Sector Count Register
 1817         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1818         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1819         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1820         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1821         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1822                   
 1823                   ; IDE/CF physical format: 
 1824                   ; 4 partitions
 1825                   ; 8192 KB bytes/partition 
 1826                   ; 128 bytes/sector
 1827                   ; 256 sectors/track
 1828                   ; 256 tracks
 1829                   ; 128 * 256 * 256 / 1024 = 8192
 1830                   
 1831                   ; old (2048K):
 1832                   ; LBA
 1833                   ; 00000000 00000000 00000000
 1834                   ; 00000000 tttttttt ssssssdd
 1835                   ;        E        B        C
 1836                   
 1837                   ; NEWIDE (8192K):
 1838                   ; LBA
 1839                   ; 00000000 00000000 00000000
 1840                   ; 000000dd tttttttt ssssssss
 1841                   ;        E        B        C
 1842                   
 1843                   ;-----------------------------------------------------------------------------
 1844                   ; Read one 256 byte sector from disk.
 1845                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1846                   ; Disk number in DBANK  (4..7)
 1847                   ; Track number in IOT
 1848                   ; Sector number in IOS
 1849                   ; DMA address in IOD
 1850                   
 1851         0000      	IF NOT NEWIDE
 1852                   
 1853                   IDERD:	LD HL,PHSBUF
 1854                   
 1855                   	; LBA0..7 -> C
 1856                   	LD A,(IOS)
 1857                   	SLA A		; make room for 4 disks (0 to 3, 2 bits)
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  36
NBIOS11 Z80

 1858                   	SLA A
 1859                   	LD B,A
 1860                   	LD A,(DBANK)
 1861                   	SUB A,4
 1862                   	OR B
 1863                   	LD C,A		; C = sector * 4 + (diskno - 4)
 1864                   
 1865                   	; LBA8..15 -> B
 1866                   	LD A,(IOT)
 1867                   	LD B,A
 1868                   	
 1869                   	; LBA16..23) -> E
 1870                   	LD E,0
 1871                   
 1872                   	CALL MIDERD
 1873                   
 1874                   	PUSH AF
 1875                   	LD C,'*'
 1876                   	CALL MCONOUT
 1877                   	LD C,'R'
 1878                   	CALL MCONOUT
 1879                   	CALL DEBX16
 1880                   	LD C,'*'
 1881                   	CALL MCONOUT
 1882                   	POP AF
 1883                   
 1884                   	AND 01H
 1885                   	RET NZ		; -> exit with error
 1886                   			
 1887                   	LD HL,(IOD)	; memory location to place data read from disk
 1888                   	LD DE,PHSBUF	; host buffer
 1889                   
 1890                   	LD B,128	; size of CP/M sector
 1891                   IDERD6:	LD A,(DE)	; get byte from host buffer
 1892                   	LD (HL),A	; put in memory
 1893                   	INC HL
 1894                   	INC DE
 1895                   	DJNZ IDERD6	; put 128 bytes into memory
 1896                   
 1897                   	; no error
 1898                   	XOR A
 1899                   	RET
 1900                   
 1901                   	ENDIF		; NEWIDE
 1902                   	
 1903                   ;-----------------------------------------------------------------------------
 1904                   ; Write one 26 byte sector to IDE
 1905                   ; Return a 00h in register A if the operation completes properly, and 0lh if an error occurs during the read or write
 1906                   ; Disk number in DBANK (4..7)
 1907                   ; Track number in IOT (0..n-1)
 1908                   ; Sector number in IOS (0..n-1)
 1909                   ; DMA address in IOD (0-65535)
 1910                   
 1911         0000      	IF NOT NEWIDE
 1912                   
 1913                   IDEWR:	LD HL,(IOD)	; memory location of data to write
 1914                   	LD DE,PHSBUF	; host buffer
 1915                   	LD B,128	; size of CP/M sector
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  37
NBIOS11 Z80

