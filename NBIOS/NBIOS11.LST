 1204 E558  E6 80        	AND 80H
 1205 E55A  6F           	LD L,A			; t0000000
 1206 E55B  3A E7AE      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
 1207 E55E  07           	RLCA			; und dazu msb-Teil des Tracks verwenden
