 1809                   ;-----------------------------------------------------------------------------
 1810                   
 1811                   ; Addresses of IDE-80 CF-Adapter card
 1812                   
 1813         0018      IDEDATA	EQU 018h	; IDE Data Register
 1814         001A      SECCND	EQU 01Ah	; Sector Count Register
 1815         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1816         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1817         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1818         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1819         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1820                   
 1821                   ; IDE/CF physical format: 
 1822                   ; 4 partitions
 1823                   ; 8192 KB bytes/partition 
 1824                   ; 128 bytes/sector
 1825                   ; 256 sectors/track
 1826                   ; 256 tracks
 1827                   ; 128 * 256 * 256 / 1024 = 8192
 1828                   
 1829                   ; old (2048K):
 1830                   ; LBA
 1831                   ; 00000000 00000000 00000000
 1832                   ; 00000000 tttttttt ssssssdd
 1833                   ;        E        B        C
 1834                   
 1835                   ; NEWIDE (8192K):
 1836                   ; LBA
 1837                   ; 00000000 00000000 00000000
 1838                   ; 000000dd tttttttt ssssssss
 1839                   ;        E        B        C
 1840                   
 1841                   ;-----------------------------------------------------------------------------
 1842                   ; Read one 256 byte sector from disk.
 1843                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1844                   ; Disk number in DBANK  (4..7)
 1845                   ; Track number in IOT
 1846                   ; Sector number in IOS
 1847                   ; DMA address in IOD
 1848                   
 1849         0000      	IF NOT NEWIDE
 1850                   
 1851                   IDERD:	LD HL,PHSBUF
 1852                   
 1853                   	; LBA0..7 -> C
 1854                   	LD A,(IOS)
 1855                   	SLA A		; make room for 4 disks (0 to 3, 2 bits)
 1856                   	SLA A
 1857                   	LD B,A
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  36
NBIOS11 Z80

 1858                   	LD A,(DBANK)
 1859                   	SUB A,4
 1860                   	OR B
 1861                   	LD C,A		; C = sector * 4 + (diskno - 4)
 1862                   
 1863                   	; LBA8..15 -> B
 1864                   	LD A,(IOT)
 1865                   	LD B,A
 1866                   	
 1867                   	; LBA16..23) -> E
 1868                   	LD E,0
 1869                   
 1870                   	CALL MIDERD
 1871                   
 1872                   	PUSH AF
 1873                   	LD C,'*'
 1874                   	CALL MCONOUT
 1875                   	LD C,'R'
 1876                   	CALL MCONOUT
 1877                   	CALL DEBX16
 1878                   	LD C,'*'
 1879                   	CALL MCONOUT
 1880                   	POP AF
 1881                   
 1882                   	AND 01H
 1883                   	RET NZ		; -> exit with error
 1884                   			
 1885                   	LD HL,(IOD)	; memory location to place data read from disk
 1886                   	LD DE,PHSBUF	; host buffer
 1887                   
 1888                   	LD B,128	; size of CP/M sector
 1889                   IDERD6:	LD A,(DE)	; get byte from host buffer
 1890                   	LD (HL),A	; put in memory
 1891                   	INC HL
 1892                   	INC DE
 1893                   	DJNZ IDERD6	; put 128 bytes into memory
 1894                   
 1895                   	; no error
 1896                   	XOR A
 1897                   	RET
 1898                   
 1899                   	ENDIF		; NEWIDE
 1900                   	
 1901                   ;-----------------------------------------------------------------------------
 1902                   ; Write one 26 byte sector to IDE
 1903                   ; Return a 00h in register A if the operation completes properly, and 0lh if an error occurs during the read or write
 1904                   ; Disk number in DBANK (4..7)
 1905                   ; Track number in IOT (0..n-1)
 1906                   ; Sector number in IOS (0..n-1)
 1907                   ; DMA address in IOD (0-65535)
 1908                   
 1909         0000      	IF NOT NEWIDE
 1910                   
 1911                   IDEWR:	LD HL,(IOD)	; memory location of data to write
 1912                   	LD DE,PHSBUF	; host buffer
 1913                   	LD B,128	; size of CP/M sector
 1914                   
 1915                   IDEWR1:	LD A,(HL)	; get byte from memory
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  37
NBIOS11 Z80

