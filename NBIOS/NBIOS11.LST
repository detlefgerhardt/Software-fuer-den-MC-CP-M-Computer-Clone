 1078 E4E7  69          	LD L,C		; sector in C
 1079 E4E8  79                  LD A,C
 1080 E4E9  32 E7AF             LD (IOS),A	; save in IOS
 1081 E4EC  26 00               LD H,0
 1082 E4EE  C9                  RET
