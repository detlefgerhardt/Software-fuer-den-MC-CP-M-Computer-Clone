    1                   ;************************************************************************
    2                   ;* NBIOS11.Z80		RDK/UH/*DG*	09/2026				*
    3                   ;*									*
    4                   ;* basiert direct auf der Version 3.1 841220 von Rolf-Dieter Klein	*
    5                   ;* Urspruengliche Version fuer 2 Mini- und 2 Maxi-Laufwerke		*
    6                   ;*									*
    7                   ;************************************************************************
    8                   ;
    9                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
   10                   ;
   11                   ; 24.06.2026 *dg* Kommentare hinzugefuegt
   12                   ;                 Binaer identisch zur Origial-Version
   13                   ; 06.07.2026 *dg* V1.0 Erste Aenderungen am BIOS. Alte Monnitor-Routinen werden
   14                   ;                 nicht mehr verwendet. Laufwerksumrechnung geaendert.
   15                   ;                 Version getestet.
   16                   ;                 Alle Aenderungen mit bedingter Assemblierung (Flag MINI3)
   17                   ;                 Testweise den Speicherbereich fuer das BIOS auf E200..EFFF
   18                   ;		  geaendert. CP/M startet dann bei CC00 (58K)
   19                   ; 09.07.2026 *dg* V1.0 Erweitert um 4 IDE/CF-Laufwerke - funktioniert nicht
   20                   ;                 System bootet aber Schreiben auf die IDE-Laufwerke schlaegt fehl.
   21                   ; 12.07.2026 *dg* - Lesen und Schreiben von CF funktioniert
   22                   ; 31.07.2026 *dg* - V1.0 Laufwerk C als HD Laufwerk konfiguriert (1.44 MB)
   23                   ;                 - Probleme immer beim ersten Scheiben nach dem Formatieren
   24                   ; 02.08.2026 *dg* - Laufwerk B: als 5.25 Zoll HD Laufwerk
   25                   ;		  - Funktioniert noch nicht, Format und Laufwerksparameter unklar 
   26                   ; 03.08.2026 *dg* - BIOS Debug-Ausgaben per Ctrl-A toggle-bar
   27                   ; 06.08.2026 *dg* - 5.25 Zoll Format mit 1024*8 funktioniert (1.4 MB)
   28                   ;                 - 5.25 Zoll Format mit 512*15 funktioniert! (1.2 MB)
   29                   ; 08.08.2026 *dg* - CF-Card Laufwerksparameter geaendert
   30                   ; 09.08.2026 *dg* - Quick'n dirty fix for Warmboot from IDE/CF 
   31                   ;		    (Disk-Parameter immer hardcodiert beim Warmboot aber
   32                   ;                   konfigurierbar)
   33                   ; 03.09.2026 *dg* - Deblocking-Parameter fuer jedes Laufwerk stehen jetzt
   34                   ;                   direkt hinter den DPBx Parameter-Bloecken         
   35                   ; 05.09.2026 *dg* - New 8192K format for CF/IDE with deblocking
   36                   ; 06.09.2026 *dg* - Cleanup
   37                   ; 08.09.2026 *dg* - Cleanup
   38                   ; 19.09.2026 *dg* - Change selection of disk formats (more defines)
   39                   ; 21.09.2026 *dg* - Die Ausmaskierung von Bit 7 bei CONIN herausgenommen,
   40                   ;                   damit Binaer-Transfers wie zum Beispiel Xmodem ueber das
   41                   ;                   BIOS funktionieren.
   42                   ; 25.09.2026 *dg* - Laufwerktabelle als Includes, Erzeugung mit neuem Tool
   43                   ;                   NDiskDef.exe
   44                   ;                 - NBIOS10 umgenannt in NBIOS11
   45                   ;
   46                   ; Verbesserung/Veraenderungen zu BIOS 3.1 seit Juni 2026
   47                   ;
   48                   ; - BIOS vergroessert, dadurch geaenderte Startadressen. CP/M ab CC00-E1FF,
   49                   ;   BIOS ab E200-EFFF.
   50                   ; - Dateinamen geaendert, die meisten Files und Tools beginnen mit "N" zu
   51                   ;   Unterscheidung von den Original-Files.
   52                   ; - Die Laufwerks-Parameter kC6nnen C<ber ein Windows-Tool definiert werden.
   53                   ;   Dabei werden notwendigen Include-Dateien fC<r das BIOS und einige Tools
   54                   ;   erzeugt. Die Parameter einzelner Disk-Laufwerke kC6nnen dann zu Laufzeit
   55                   ;   geC$ndert werden.
   56                   ; - CF/IDE eingebunden, Laufwerke E bis H, je 8 MB, E ist bootfaehig
   57                   ;   (geaenderte BIOS-Parameter)
   58                   ; - Blocking/Deblocking geaendert, ist jetzt flexibler und leichter zu
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBIOS11 Z80

   59                   ;   konfigurieren.
   60                   ; - max. Steprate wird beim Warmstart gesetzt.
   61                   ; - Debug-Ausgaben im BIOS ueber Compiler-Schalter und zur Laufzeit mit Ctrl-A
   62                   ;   ein- und ausschaltbar (C<ber Assemnbler DEFINE komplett deaktivierbar)
   63                   ; - Diverse Laufwerksformate gestestet, Test mit echten 8 Zoll Laufwerken
   64                   ;   steht noch aus.
   65                   ; - MOVCPM und SYSGEN funktionieren mit der geaenderten BIOS-Groesse
   66                   ;   vermutlich nicht mehr und muessen angasst werden (oder flexible Variante
   67                   ;   verwenden).
   68                   ;
   69                   ; TO-DO:
   70                   ;
   71                   ;-----------------------------------------------------------------------------
   72                   
   73                   	.LFCOND
   74                   
   75         000B      BIOSVER EQU 11		; BIOS version 1.1
   76                   
   77         0016      CPMVER	EQU 22		; CP/M version 2.2
   78         0000      FALSE	EQU 0
   79         FFFF      TRUE	EQU NOT FALSE
   80         FFFF      TEST	EQU TRUE
   81         000D      CR	EQU 0DH		; carriage return
   82         000A      LF	EQU 0AH		; line feed
   83                   
   84                   ;------------------------------------------------------------------------------
   85                   ; Variant switches
   86                   
   87         FFFF      DG_NEW	EQU TRUE	; new drive tables (include files generated with
   88                   			; NDiskDef)
   89                   
   90                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 3.1
   91         FFFF      DG_B800	EQU TRUE	; drive B is 800 KB (same as drive A)
   92         0000      DG_B144	EQU FALSE	; drive B as HD drive (5 1/4 inch, 1.44 MB)
   93         0000      DG_B14	EQU FALSE	; drive B as HD drive (5 1/4 inch, 1.4 MB)
   94         0000      DG_B12	EQU FALSE	; drive B as HD drive (5 1/4 inch, 1.2 MB)
   95                   
   96         FFFF      DG_C800	EQU TRUE	; drive C is 800 KB (same as drive A)
   97         0000      DG_C14	EQU FALSE	; drive C as HD drive (5 1/4 inch, 1.4 MB)
   98         0000      DG_C12	EQU FALSE	; drive C as HD drive (5 1/4 inch, 1.2 MB)
   99         0000      DG_CIBM	EQU FALSE	; drive C is IBM
  100                   
  101         0000      DG_D800	EQU FALSE	; drive D is 800 KB (same as drive A)
  102         0000      DG_D144	EQU FALSE	; drive D as HD drive (5 1/4 inch, 1.44 MB)
  103         0000      DG_D14	EQU FALSE	; drive D as HD drive (5 1/4 inch, 1.4 MB)
  104         FFFF      DG_D12	EQU TRUE	; drive D as HD drive (5 1/4 inch, 1.2 MB)
  105         0000      DG_DIBM	EQU FALSE	; drive D is IBM
  106                   
  107         FFFF      NEWIDE	EQU TRUE	; new IDE/CF format (8192 KB)
  108                   
  109         0000      DEBOUT	EQU FALSE	; debug outputs
  110         0000      BTDRV	EQU 0		; drive A:
  111                   ;BTDRV	EQU 4		; drive E: (IDE/CF)
  112                   
  113                   ; logical drive to boot from
  114                   	; boot from disk A (800KB NDE/NKC format)
  115         FFFF      	IF BTDRV = 0	; drive A
  116         0008      BTSEC	EQU 8		; start sector of CP/M on disk with 1024 bytes/sector
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBIOS11 Z80

  117         0028      BTSECN	EQU 40		; sector per track
  118                   	ENDIF
  119                   	
  120                   	; boot from IDE/CF (2 MB format)
  121         0000      	IF BTDRV = 4	; drive E
  122                   BTSEC	EQU 1		; start sector of CP/M on IDE/CF (second sector)
  123                   BTSECN	EQU 64		; sector per track
  124                   	ENDIF
  125                   
  126                   ;------------------------------------------------------------------------------
  127                   ; Monitor functions
  128                   
  129         F003      MCONIN	EQU 0F003H	; read one char from READER device -> A
  130         F006      MREAD	EQU 0F006H	; read one char from READER device -> A
  131         F009      MCONOUT	EQU 0F009H	; write one char to CONSOLE (C)
  132         F00C      MPUNCH	EQU 0F00CH	; write one char to PUNCH device (C)
  133         F00F      MLIST	EQU 0F00FH	; write one char to LIST device (C)			
  134         F012      MCONST	EQU 0F012H	; get console status
  135         F01E      MSTART	EQU 0F01EH	; restart Monitor
  136         F021      MFLOP	EQU 0F021H	; new Mini/Maxi routine in Monitor
  137         F02A      MIDERD	EQU 0F02AH	; read sector from mini/maxi floppy
  138         F02D      MIDEWR	EQU 0F02DH	; write sector to mini/maxi floppy
  139         F033      MWARM	EQU 0F033H	; Monitor warm start, will be overwritten by BIOS
  140         F036      MWRSTR	EQU 0F036H	; Write string, will be overwritten by BIOS (do no call!)
  141                   
  142                   ;------------------------------------------------------------------------------
  143                   ; CPM and BIOS sizes and addresses
  144                   
  145         003A      MSIZE 	EQU 58			; actual memory size of this BIOS (58K)
  146                   ;MSIZE 	EQU 59			; actual memory size of this BIOS (58K)
  147                   ;MSIZE 	EQU 60			; default memory size model (60K)
  148                   
  149         9800      BIAS	EQU (MSIZE - 20) * 1024	; smallest memory model is 20K
  150         CC00      CCP	EQU 3400H + BIAS	; start of CCP (CP/M), smallest memory model starts at 3400h
  151         D406      BDOS	EQU CCP + 806H		; BDOS entry behind 6 byte serial number, size of CCP is 800h
  152         1600      CPML	EQU 1600H		; length of CP/M (CCP + BDOS)
  153         E200      BIOS	EQU CCP + CPML		; start of BIOS
  154                   
  155         D400      BDOSADR	EQU BDOS - 6		; actual start address of BDOS (used for patches)
  156                   
  157         CC00      CPMB	EQU CCP			; CP/M boot entry
  158                   
  159         002C      NSECTS	EQU CPML / 128		; Number of logical sectors ocupied by CP/M
  160                   				; (used for for WBOOT)
  161                   
  162                   ;-----------------------------------------------------------------------------
  163                   ; Memory addresses below 0100h
  164                   
  165         0000      JWARM	EQU 0000H	; JMP to WBOOT
  166         0003      IOBYTE	EQU 0003H	; Address of IOBYTE
  167         0004      CDISK	EQU 0004H	; Address of last used drive and user (low-nibble: current drive, high-nibble: current user)
  168         0005      JBDOS	EQU 0005H	; JMP to BDOS
  169         0038      JRST7	EQU 0038H	; JMP RST7 (7*8)
  170         0080      BUFF	EQU 0080H	; buffer address
  171         0005      RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write
  172                   
  173                   ;-----------------------------------------------------------------------------
  174                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
NBIOS11 Z80

  175         E200      	ORG BIOS	; regular start of BIOS
  176                   	;ORG BIOS-4000H	; for debugging
  177                   
  178 E200              STARTBIOS:
  179                   
  180 E200  C3 E3AF     	JP BOOT		; Cold boot
  181                   
  182                   	; --- start of offical BIOS calls ---
  183                   	
  184 E203  C3 E3DC     WBOOTE:	JP WBOOT	; Warm boot (CTRL-C)
  185 E206  C3 F012     	JP MCONST	; Get CONSOLE status -> A, 0FFh if character available
  186 E209  C3 E3AB     	JP CONIN	; Input character from CONSOLE -> A
  187 E20C  C3 F009     	JP MCONOUT	; Output character to CONSOLE (C)
  188 E20F  C3 F00F     	JP MLIST	; Output character to LIST device (C)
  189 E212  C3 F00C     	JP MPUNCH	; Output character to PUNCH device (C)
  190 E215  C3 F006     	JP MREAD	; Input character from READER device -> A
  191                   
  192 E218  C3 E47D     	JP HOME		; Select track home position (no execution)
  193 E21B  C3 E482     	JP SELDSK	; Select drive, drive 0..n-1 in C, returns disk parameter header block in HL
  194 E21E  C3 E4CC     	JP SETTRK	; Select track for read/write, track in C (logic tracks!!! e.g. 0..159)
  195 E221  C3 E4D1     	JP SETSEC	; Select sector for read/write, sector in C (logic sectors!!! e.g. 0..39)
  196 E224  C3 E4EF     	JP SETDMA	; Set disk read/write address (no real DMA), address in BC
  197 E227  C3 E518     	JP READ		; Read sector
  198 E22A  C3 E5A4     	JP WRITE	; Write sector
  199 E22D  C3 E47A     	JP LISTST	; Listener ready? (not implemented, returns 1 = not ready)
  200 E230  C3 E4D6     	JP SECTRAN	; sector translation (skew only)
  201                   	
  202                   	; --- end of offical BIOS calls ---
  203                   
  204 E233  C3 E3A8     	JP GETVER	; get BIOS version
  205 E236  C3 E4F5     	JP GETPHY	; get physical drive parameters (for diskcopy and similar
  206                   			; utilities)
  207                   	
  208                   	;JP FLUSH	; BDOS close and write sector buffer to disk (not used)
  209                   
  210                   ;-----------------------------------------------------------------------------
  211                   
  212                   	; size of mini disks A, B, C
  213                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  214                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  215                   
  216                   	;DISKS 8		; define 8 drives (A..H)
  217         0008      NDISKS	EQU	8	
