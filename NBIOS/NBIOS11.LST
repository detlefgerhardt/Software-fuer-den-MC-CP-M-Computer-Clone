 1373                   ;-----------------------------------------------------------------------------
 1374                   ; Calculates physical drive from DBANK and IOT -> C
 1375                   ; only for Mini disks
 1376                   
 1377                   ; DBANK, IOT     C
 1378                   ;  0     F    -> 0
 1379                   ;  1     F    -> 2
 1380                   ;  0     B    -> 1
 1381                   ;  1     B    -> 3
 1382                   
 1383                   ; muss fuer Minidisk C und D erweitert werden
 1384                   
 1385                   ; drive number (0..n-1) -> C, Bit 0..3
 1386                   ; side -> (0..n-1) -> C, Bit 7
 1387                   
 1388                   ; calculates physical sector from logical sector, IOS -> E
 1389                   ; logical sector 0..39 -> physical sector 1..5
 1390                   
 1391                   ; calculates logical track from physical track, IOT -> D
