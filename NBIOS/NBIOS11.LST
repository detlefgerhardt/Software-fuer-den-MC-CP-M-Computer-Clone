  800                   ;-----------------------------------------------------------------------------
  801                   ; Cold boot
  802                   
  803 E3A5  31 0100     BOOT:	LD SP,BUFF+80H	; set stack
  804                   
  805 E3A8  21 E315     	LD HL,SIGNON	; output start message
  806 E3AB  CD E4FB     	CALL PRMSG
  807                   	
  808                   	; clear / set last used drive
  809 E3AE  3E 00       	LD A,BTDRV
  810 E3B0  32 0004     	LD (CDISK),A
  811                   	
  812                   	; sector buffer is empty, set to physical sector buffer not changed
  813 E3B3  AF          	XOR A
  814 E3B4  32 E878     	LD (BUFCHG),A
  815                   	
  816                   	; drive is undefined
  817 E3B7  3E FF       	LD A,0FFH
  818 E3B9  32 E879     	LD (CURDRV),A
  819                   
  820                   	; disable monitor entries, set to WBOOT
  821 E3BC  21 E3D2     	LD HL,WBOOT
  822 E3BF  22 F034     	LD (MWARM+1),HL
  823 E3C2  22 F037     	LD (MWRSTR+1),HL
  824                   	
  825                   	;CALL PATF	; patch BDOS close function
  826 E3C5  CD E768     	CALL PATA	; patch BDOS active drive
  827                   	;CALL PATB
  828                   
  829                   	; set steprate
  830                   	;LD D,00000000B	; max steprate 00b, no sso
  831 E3C8  16 80       	LD D,10000000B	; max steprate 00b, use sso
  832 E3CA  06 00       	LD B,0		; set steprate
  833 E3CC  CD F021     	CALL MFLOP
  834                   	
  835 E3CF  C3 E42B     	JP GOCPM	; start CP/M
  836                   
  837                   ;-----------------------------------------------------------------------------
  838                   ; Warm boot
  839                   
  840 E3D2              WBOOT:	; write physical sector buffer to disk if changed
  841 E3D2  3A E878     	LD A,(BUFCHG)
  842 E3D5  B7          	OR A
  843 E3D6  CA E3DC     	JP Z,WBOO1
  844                   
  845 E3D9  CD E721     	CALL PUTPHS	; normalerweise ist Schreibvorgang
  846                   			; nach einem Direktoryzugriff abgeschlossen
  847                   			; ACHTUNG BUG!? PUTPHS nur fuer Mini/DD-Laufwerke
  848                   			; Bei einem anderen Laufwerk geht das wohl schief
  849                   			
  850 E3DC  3E FF       WBOO1:	LD A,0FFH	; alle Tracks ungueltig, bei Diskettenwechsel wichtig
  851 E3DE  32 E879     	LD (CURDRV),A
  852                   
  853 E3E1  31 0080     	LD SP,BUFF	; Stack zuweisen
  854 E3E4  0E 05       	LD C,RETRY	; Anzahl der Versuche
  855 E3E6  C5          	PUSH BC		; und dann anfangen zu booten
  856                   
