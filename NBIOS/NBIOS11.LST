 1255                   
 1256 E588              MAXIR1:	; retry loop
 1257 E588  C5          	PUSH BC		; dann ausfuehren
 1258 E589  2A E7B4     	LD HL,(IOD)	; Zieladresse holen
 1259 E58C  3A E7B2     	LD A,(IOT)	; Spurnummer
 1260 E58F  57          	LD D,A	
 1261 E590  3A E7B3     	LD A,(IOS)	; Sektornummer
 1262 E593  5F          	LD E,A
 1263 E594  06 01       	LD B,1		; Lese-Befehlscode
 1264 E596  CD E56A     	CALL MAXCAL	; vorher Laufwerkscode umrechnen
 1265 E599  CD F021     	CALL MFLOP	; und dann ausfuehren
 1266 E59C  C1          	POP BC		; Retry-Zaehler
 1267 E59D  C8          	RET Z		; kein Fehler, dann ok zurueck
 1268 E59E  05          	DEC B		; sonst nochmals probieren
 1269 E59F  C2 E588     	JP NZ,MAXIR1	; -> retry		
