Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NBOOT-CFZ80

    1                   ;*****************************************************************************
    2                   ; NBOOT-CF.Z80
    3                   ;
    4                   ; Boot loader for MC CP/M-Computer IDE/CF drive
    5                   ;
    6                   ; based on BLOAD-CF von Uli Haumann from 06/2026
    7                   ;
    8                   ;*****************************************************************************
    9                   ; Load CP/M image from IDE/Compact-Flash into memory starting at cpm_start
   10                   ; Uses calls to Monitor routine for read directly from IDE interface
   11                   ;
   12                   ; Reads track 0, sectors 1 to 50
   13                   ; This program is loaded into LBA sector 0 of disk with the tool NBPUT-CF.
   14                   ; At boot time it is loaded by the Monitor to address 08000h and executed.
   15                   ;
   16                   ; PLEASE NOTE THE CHANGED CPM & BIOS START ADDRESS!!!
   17                   ;
   18                   ; Version history
   19                   ;
   20                   ; 10.07.2026 *dg* Renamed to NBOOT-CF and reformatted
   21                   ; 11.07.2026 *dg* Increased number of sectors to read to 63 because of larger BIOS
   22                   ; 05.09.2026 *dg* Adapted to new IDE/CF format NEWIDE (8192 KB)
   23                   ; 25.10.2026 *dg* Adapted to new IDE/CF monitor routines
   24                   
   25         0000      FALSE	EQU 0
   26         FFFF      TRUE	EQU NOT FALSE
   27                   
   28         FFFF      NEWIDE	EQU TRUE
   29                   
   30         8000      START	EQU 08000H
   31                   
   32         E200      BIOS	EQU 0EA00H-800H		; CP/M cold start entry
   33         CC00      CPM	EQU 0D400H-800H		; CCP Start
   34                   
   35         F009      MCONOUT	EQU 0F009H		; Console out
   36         F02A      MIDERD	EQU 0F02AH		; Monitor function IDEREAD
   37                   
   38                   ;IDESTAT EQU 010+0FH		; Hardwareadresse IDE Statusregister
   39                   
   40                    ; on a IDE/CF disk 1 track is reserved: 128 sectors
   41         0100      SECSIZ	EQU 256
   42                   ; 256 byte sectors needed for CP/M + BIOS (CP/M start to EFFF)
   43         0024      SECCNT	EQU (0F000h-CPM)/SECSIZ
   44                   	
   45                   ;-----------------------------------------------------------------------------
   46                   
   47         8000      	ORG START
   48                   
   49                   ; read track 0, sectors 2, SECCNT sectors
   50                   
   51 8000  31 7FFF     BOOT:	LD SP,START - 1
   52                   
   53 8003  21 8049     	LD HL,MSG
   54 8006  CD 803F     	CALL WRSTR
   55                   
   56 8009  3E 02       	LD A,2			; starting sector 2 - sector 1 is boot sector
   57 800B  32 8064     	LD (SECTOR),A
   58 800E  21 CC00     	LD HL,CPM		; memory address to place image
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBOOT-CFZ80

   59 8011  22 8065     	LD (ADDR),HL
   60 8014  06 24       	LD B,SECCNT
   61                   
   62 8016              BOOT1:	; read sectors loop
   63 8016  3A 8064     	LD A,(SECTOR)
   64 8019  5F          	LD E,A		; sector (1..)
   65 801A  16 00       	LD D,0		; track 0
   66 801C  0E 00       	LD C,0		; volume 0
   67 801E  2A 8065     	LD HL,(ADDR)
   68                   	
   69 8021  C5          	PUSH BC
   70 8022  CD F02A     	CALL MIDERD
   71 8025  C1          	POP BC
   72                   
   73 8026  05          	DEC B
   74 8027  28 13       	JR Z,BOOT2
   75                   
   76 8029  3A 8064     	LD A,(SECTOR)
   77 802C  3C          	INC A
   78 802D  32 8064     	LD (SECTOR),A
   79                   
   80                   	; (ADDR) += SECSIZ
   81 8030  2A 8065     	LD HL,(ADDR)
   82 8033  11 0100     	LD DE,SECSIZ
   83 8036  19          	ADD HL,DE
   84 8037  22 8065     	LD (ADDR),HL
   85                   	
   86 803A  18 DA       	JR BOOT1
   87                   
   88 803C  C3 E200     BOOT2:	JP BIOS
   89                   
   90                   ;-----------------------------------------------------------------------------
   91                   ; Read one CP/M sector from volume 0 by calling the monitor.
   92                   ; No drive number needed)
   93                   ; Track number in (TRACK)
   94                   ; Sector number in (SECTOR)
   95                   ; Addr address in (ADDR), location in memory to place the CP/M sector
   96                   
   97         0000      	IF FALSE
  166                   	ENDIF	; FALSE
  167                   
  168                   ;-----------------------------------------------------------------------------
  169                   
  170 803F  7E          WRSTR:	LD A,(HL)	; get char from string
  171 8040  A7          	AND A		; check if 0
  172 8041  C8          	RET Z		; -> end of string
  173                   	
  174 8042  4F          	LD C,A
  175 8043  CD F009     	CALL MCONOUT
  176 8046  23          	INC HL		; next char in string
  177 8047  18 F6       	JR WRSTR	; start over
  178                   
  179         000D      CR	EQU 0DH
  180         000A      LF	EQU 0AH
  181                   
  182 8049  0D 0A 4E 42 MSG:	DEFB CR,LF,"NBOOT-CF 1.2 261025-03",CR,LF,0
  183                   
  184                   ;-----------------------------------------------------------------------------
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBOOT-CFZ80

  185                   
  186 8064    0001      SECTOR:	DS	1
  187                   ;TRACK:	DS	1
  188 8065    0002      ADDR:	DS	2
  189                   
  190                   	END
