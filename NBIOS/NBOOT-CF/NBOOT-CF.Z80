;*****************************************************************************
; NBOOT-CF.Z80
;
; Boot loader for MC CP/M-Computer IDE/CF drive
;
; based on BLOAD-CF von Uli Haumann from 06/2026
;
;*****************************************************************************
; Load CP/M image from IDE/Compact-Flash into memory starting at cpm_start
; Uses calls to Monitor routine for read directly from IDE interface
;
; Reads track 0, sectors 1 to 50
; This program is loaded into LBA sector 0 of disk with the tool NBPUT-CF.
; At boot time it is loaded by the Monitor to address 08000h and executed.
;
; PLEASE NOTE THE CHANGED CPM & BIOS START ADDRESS!!!
;
; Version history
;
; 10.07.2026 *dg* Renamed to NBOOT-CF and reformatted
; 11.07.2026 *dg* Increased number of sectors to read to 63 because of larger BIOS
; 05.09.2026 *dg* Adapted to new IDE/CF format NEWIDE (8192 KB)
; 25.10.2026 *dg* Adapted to new IDE/CF monitor routines

FALSE	EQU 0
TRUE	EQU NOT FALSE

NEWIDE	EQU TRUE

START	EQU 08000H

BIOS	EQU 0EA00H-800H		; CP/M cold start entry
CPM	EQU 0D400H-800H		; CCP Start

MCONOUT	EQU 0F009H		; Console out
MIDERD	EQU 0F02AH		; Monitor function IDEREAD

;IDESTAT EQU 010+0FH		; Hardwareadresse IDE Statusregister

 ; on a IDE/CF disk 1 track is reserved: 128 sectors
SECSIZ	EQU 256
; 256 byte sectors needed for CP/M + BIOS (CP/M start to EFFF)
SECCNT	EQU (0F000h-CPM)/SECSIZ
	
;-----------------------------------------------------------------------------

	ORG START

; read track 0, sectors 2, SECCNT sectors

BOOT:	LD SP,START - 1

	LD HL,MSG
	CALL WRSTR

	LD A,2			; starting sector 2 - sector 1 is boot sector
	LD (SECTOR),A
	LD HL,CPM		; memory address to place image
	LD (ADDR),HL
	LD B,SECCNT

BOOT1:	; read sectors loop
	LD A,(SECTOR)
	LD E,A		; sector (1..)
	LD D,0		; track 0
	LD C,0		; volume 0
	LD HL,(ADDR)
	
	PUSH BC
	CALL MIDERD
	POP BC

	DEC B
	JR Z,BOOT2

	LD A,(SECTOR)
	INC A
	LD (SECTOR),A

	; (ADDR) += SECSIZ
	LD HL,(ADDR)
	LD DE,SECSIZ
	ADD HL,DE
	LD (ADDR),HL
	
	JR BOOT1

BOOT2:	JP BIOS

;-----------------------------------------------------------------------------
; Read one CP/M sector from volume 0 by calling the monitor.
; No drive number needed)
; Track number in (TRACK)
; Sector number in (SECTOR)
; Addr address in (ADDR), location in memory to place the CP/M sector

	IF FALSE

RDSEC:	
	IF NOT NEWIDE

	LD HL,HSTBUF	; buffer to place raw disk sector (256 bytes)

	LD A,(SECTOR)
	SLA A		; shifts to match BIOS CP/M disk read routine
	SLA A		; no parition number (volume = 0)
	LD C,A		; LBA bits 0 to 7
	LD A,(TRACK)
	LD B,A		; LBA bits 8 to 15
	LD E,00H	; LBA bits 16 to 23
	CALL IDEREAD	; ide read routine in Monitor
			; Transfer top 128-bytes out of buffer to memory
	LD HL,(ADDR)	; memory location to place data read from disk
	LD DE,HSTBUF	; host buffer

	LD B,SECSIZ	; size of CP/M sector

RDSEC1:	; read sector bytes loop
	LD A,(DE)	; get byte from host buffer
	LD (HL),A	; put into ADDR
	INC HL
	INC DE
	DJNZ RDSEC1	; put 128 bytes into memory

	IN A,(IDESTAT)	; get status
	AND 01H		; error bit
	RET

	ELSE		; NEWIDE

	; NEWIDE (8192K):
	; LBA
	; 00000000 00000000 00000000
	; 0000000d dsssssss tttttttt
	;        E        B        C

	; LBA0..7 -> C
	LD A,(TRACK)
	LD C,A		; LBA0..7 -> B

	;LD A,(CURDRV)
	;SUB A,4	; drive 4..7 -> drive 0..3
	;LD E,A
	LD E,0		; volume 0
	SRL E		; drive bit 1 -> bit 0, bit 0 -> carry
			; LBA16..23 -> E

	LD B,0
	RR B		; carry -> bit 7
	LD A,(SECTOR)
	DEC A		; phys sect. starts wird 1
	OR B
	LD B,A		; LBA8..15 -> B

	LD HL,HSTBUF	; buffer to place raw disk sector (256 bytes)

	CALL IDEREAD	; ide read routine in Monitor
			; Transfer top 256-bytes out of buffer to memory
			
	IN A,(IDESTAT)	; get status
	AND 01H		; error bit
	RET
	
	ENDIF		; NEWIDE

	ENDIF	; FALSE

;-----------------------------------------------------------------------------

WRSTR:	LD A,(HL)	; get char from string
	AND A		; check if 0
	RET Z		; -> end of string
	
	LD C,A
	CALL MCONOUT
	INC HL		; next char in string
	JR WRSTR	; start over

CR	EQU 0DH
LF	EQU 0AH

MSG:	DEFB CR,LF,"NBOOT-CF 1.2 261025-03",CR,LF,0

;-----------------------------------------------------------------------------

SECTOR:	DS	1
;TRACK:	DS	1
ADDR:	DS	2

	END

;-----------------------------------------------------------------------------
