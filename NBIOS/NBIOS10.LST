  617                   ;-----------------------------------------------------------------------------
  618                   ; Cold boot
  619                   
  620 E39A  31 0100     BOOT:	LD SP,BUFF+80H	; set stack
  621                   
  622 E39D  21 E31B     	LD HL,SIGNON	; output start message
  623 E3A0  CD E4AC     	CALL PRMSG
  624                   	
  625                   	; clear / set last used drive
  626         0000      	IF NOT DG01
  628                   	ELSE
  629 E3A3  3E 00       	LD A,BTDRV
  630                   	ENDIF
  631 E3A5  32 0004     	LD (CDISK),A
  632                   	
  633                   	; sector buffer is empty, set to physical sector buffer not changed
  634 E3A8  AF          	XOR A
  635 E3A9  32 E847     	LD (BUFCHG),A
  636                   	
  637                   	; drive is undefined
  638 E3AC  3E FF       	LD A,0FFH
  639 E3AE  32 E848     	LD (CURDRV),A
  640                   
  641                   	; disable monitor entries, set to WBOOT
  642 E3B1  21 E3C7     	LD HL,WBOOT
  643 E3B4  22 F034     	LD (MWARM+1),HL
  644 E3B7  22 F037     	LD (MWRSTR+1),HL
