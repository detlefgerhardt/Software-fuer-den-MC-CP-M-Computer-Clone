 1434                   	;LD A,(IOS)	; PHSBUF + ((0..39) MOD 8) * 128
 1435                   	;AND 00000111b	; 0..7 (mod 8)
 1436                   	;LD D,A		; * 256 (low byte is written into the high byte)
 1437                   	;LD E,0
 1438                   	;SRA D		; div/2 by shift right
 1439                   	;RR E
 1440                   	;ADD HL,DE	; HL = source (PHSBUF+offset)
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  21
NBIOS10 Z80

 1441                   	;EX DE,HL	; DE = source
 1442                   	;LD HL,(IOD)	; HL = dest (IOD)
