  570 E312              SIGNON:
  571                   
  572         0000      	IF NOT DG01
  581                   	ELSE
  582                   
  583 E312  1A          	DB 26
  584 E313  0D 0A 43 50 	DB CR,LF,'CP/M '
  585 E31A  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
  586 E31D  20 66 6F 72 	DB ' for MC-Computer '
  587 E32E  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  588 E330  4B 20 4E 42 	DB 'K NBIOS 260904-01'
  589 E341  20 42 4F 4F 	DB " BOOT=",BTDRV+'A',CR,LF
  590                   
  591 E34A  41 3A 4E 4B 	DB "A:NKC800"
  592                   
