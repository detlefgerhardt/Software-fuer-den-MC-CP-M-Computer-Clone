  440         E2D4       DPB2	EQU	$	; DISK PARM BLOCK
  441 E2D4  0048         	DW	72	; SEC PER TRACK
  442 E2D6  05           	DB	5	; BLOCK SHIFT
  443 E2D7  1F           	DB	31	; BLOCK MASK
  444 E2D8  01           	DB	1	; EXTNT MASK
  445 E2D9  0162         	DW	354	; DISK SIZE-1
  446 E2DB  00FF          	DW	255	; DIRECTORY MAX
  447 E2DD  C0           	DB	192	; ALLOC0
  448 E2DE  00           	DB	0	; ALLOC1
  449 E2DF  0040         	DW	64	; CHECK SIZE
  450 E2E1  0002         	DW	2	; OFFSET
  451         0000       XLT2	EQU	0	; NO XLATE TABLE
  452                   	
  453                   	ENDIF
