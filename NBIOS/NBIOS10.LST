  506                   ; CP/M message after cold start
  507                   
  508 E31B              SIGNON:
  509                   
  510         0000      	IF NOT DG01
  519                   	ELSE
  520                   
  521 E31B  1A          	DB 26
  522 E31C  0D 0A 43 50 	DB CR,LF,'CP/M '
  523 E323  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
  524 E326  20 66 6F 72 	DB ' for MC-Computer '
  525 E337  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  526 E339  4B 20 4E 42 	DB 'K NBIOS 260806-04'
  527 E34A  20 42 4F 4F 	DB " BOOT=",BTDRV+'A',CR,LF
