 1041                   ; sector in C
 1042                   ; skew table in DE (or 0)
 1043                   ; write calculated sector to IOS and L
 1044                   
 1045 E4A6  7A          SECTRAN:LD A,D		; check if skew table != 0
 1046 E4A7  B3                  OR E
 1047 E4A8  CA E4B7             JP Z,SECTR1	; =0, -> no skew
 1048                   
 1049                   	; calc sector offset into skew table
 1050 E4AB  06 00       	LD B,0
 1051 E4AD  EB          	EX DE,HL
 1052 E4AE  09          	ADD HL,BC	; sector in C
 1053 E4AF  7E          	LD A,(HL)	; load skew value
 1054 E4B0  32 E85B     	LD (IOS),A	; save in IOS 
 1055 E4B3  6F          	LD L,A		; and in L
 1056 E4B4  26 00               LD H,0		; was missing *dg* 27.07.2026
 1057 E4B6  C9          	RET
 1058                   
 1059 E4B7              SECTR1:	; no skew, return sector
 1060 E4B7  69          	LD L,C		; sector in C
 1061 E4B8  79                  LD A,C
 1062 E4B9  32 E85B             LD (IOS),A	; save in IOS
 1063 E4BC  26 00               LD H,0
 1064 E4BE  C9                  RET
