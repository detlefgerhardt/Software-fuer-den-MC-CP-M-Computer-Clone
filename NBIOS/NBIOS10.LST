  824         0000      	if NOT NEWIDE
  828                   	ELSE		; NEWIDE
  829                   	
  830 E4E3  3E 01       	LD A,1
  831 E4E5  32 E83B     	LD (ISIDE),A
  832 E4E8  DA E5D2     	JP C,MINIRD
  833                   	
  834                   	ENDIF		; NEWIDE
