 1049                   ;=============================================================================
 1050                   ; Read Mini disk, 80 Spur, DD, DS
 1051                   
 1052                   ;READ und WRITE unter Verwendung von MEXEC
 1053                   ; HL=DMA ADR
 1054                   ; DE=TRACK/SECTOR
 1055                   ; B=0 RSTORE
 1056                   ;   1 READ
 1057                   ;   2 WRITE
 1058                   ; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
 1059                   ;                                          A   C    B    D
 1060                   
 1061         FC00      PHSBUF	EQU 0FC00H	; Memory area of interactive Monitor for logical sector (1K)
 1062                   
 1063                   ;-----------------------------------------------------------------------------
 1064                   ; Calculates physical drive from DBANK and IOT -> C
 1065                   ; only for Mini disks
 1066                   
 1067                   ; DBANK, IOT     C
 1068                   ;  0     F    -> 0
 1069                   ;  1     F    -> 2
 1070                   ;  0     B    -> 1
 1071                   ;  1     B    -> 3
 1072                   
 1073                   ; muss fuer Minidisk C und D erweitert werden
 1074                   
 1075                   ; drive number (0..n-1) -> C, Bit 0..3
 1076                   ; side -> (0..n-1) -> C, Bit 7
 1077                   
 1078                   ; calculates physical sector from logical sector, IOS -> E
 1079                   ; logical sector 0..39 -> physical sector 1..5
 1080                   
 1081                   ; calculates logical track from physical track, IOT -> D
 1082                   ; 0..159 -> 0..79 (max 127)
 1083                   
 1084 E590              MINCAL:	; logical sector to physical sector
 1085                   	; get drive specific factor
 1086 E590  3A E839     	LD A,(BLPOW)
