  573                   	ELSE
  574 E35B  2C 42 3A 31 	DB ",B:1.4MB"
  575                   	ENDIF
  576                   
  577         0000      	IF NOT DG_CHD
  579                   	ELSE
  580 E363  2C 43 3A 31 	DB ",C:1.44MB"
  581                   	ENDIF
  582                   
  583 E36C  2C 44 3A 49 	DB ",D:IBM SS/SD,E..H:IDE"
  584                   
  585 E381  0D 0A 00    	DB CR,LF,0
  586                   
  587                   	ENDIF
