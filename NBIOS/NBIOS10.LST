  441                   
  442                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  443                   	; 64-sector tracks, numbering starting at zero (sectors 0 to 63)
  444                   	; Block size 2048
  445                   	; Disk size 2 mb, DSM 1023, yields 256 tracks (0 to 255)
  446 E2FD              DPB4:	;disk parameter block for all disks.
  447 E2FD  0040        	DW	64	; sectors per track
  448 E2FF  04          	DB	4	; block shift factor
  449 E300  0F          	DB	15	; block mask - with block shift, sets block size to 1024
  450 E301  00          	DB	0	; null mask
  451 E302  03FF        	DW	1023	; disk size-1 = number of blocks in a disk - 1
  452 E304  0100        	DW	256	; directory max = no. directory entries/disk, arbitrary
  453 E306  F0          	DB	240	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  454 E307  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  455 E308  0000        	DW	0	; check size -- no checking, so zero
  456 E30A  0001        	DW	1	; track offset -- first track for system
  457                   
  458                   	; Disk 5 (F), IDE partition 1 ----------------------------------------
  459         E2FD      DPB5	EQU	DPB4	; EQUIVALENT PARAMETERS
  460                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  461                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  462                   
  463                   	; Disk 6 (G), IDE partition 2 ----------------------------------------
  464         E2FD      DPB6	EQU	DPB4	; EQUIVALENT PARAMETERS
  465                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  466                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  467                   
  468                   	; Disk 7 (H), IDE partition 3 ----------------------------------------
  469         E2FD      DPB7	EQU	DPB4	; EQUIVALENT PARAMETERS
  470                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  471                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  472                   
  473                   	ENDIF	; MINI3
  474                   
  475                   ;-----------------------------------------------------------------------------
  476                   ; CP/M message after cold start
  477                   
  478 E30C              SIGNON:
  479                   
  480         0000      	IF NOT DG01
  489                   	ELSE
  490                   
  491 E30C  1A          	DB 26
  492 E30D  0D 0A 43 50 	DB CR,LF,'CP/M '
  493 E314  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
  494 E317  20 66 6F 72 	DB ' for MC-Computer '
  495 E328  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  496 E32A  4B 20 4E 42 	DB 'K NBIOS 260731-03 BOOT='
  497 E341  30          	DB BTDRV+'0'
  498 E342  0D 0A 00    	DB CR,LF,0
  499                   	
  500                   	ENDIF
  501                   
  502                   ;-----------------------------------------------------------------------------
  503                   ; Monitor routines and addresses
  504                   
  505                   ; get state of CONSOLE (if character is available)
  506 E345  C3 F012     CONST:	JP 0F012H
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   7
NBIOS10 Z80

  507                   	
  508                   ; read one char from CONSOLE and clears parity bit
  509 E348  CD F003     CONIN:	CALL 0F003H
  510 E34B  E6 7F       	AND 7FH
  511 E34D  C9          	RET
  512                   
  513                   ; read one char from READER device -> A
  514         F006      READER	EQU 0F006H
  515                   
  516                   ; write one char to CONSOLE (C)
  517         F009      CONOUT	EQU 0F009H
  518                   
  519                   ; write one char to PUNCH device (C)
  520         F00C      PUNCH	EQU 0F00CH
  521                   
  522                   ; write one char to LIST device (C)			
  523         F00F      LIST	EQU 0F00FH
  524                   
  525                   ; restart Monitor
  526         F01E      MSTART	EQU 0F01EH
  527                   
  528                   ; Monitor warm start
  529         F033      MWARM	EQU 0F033H	; Monitor warm start, will be overwritten by BIOS
  530                   
  531                   ; Monitor write string
  532         F036      MWRSTR	EQU 0F036H	; Write string, will be overwritten by BIOS
  533                   
  534                   ;-----------------------------------------------------------------------------
  535                   ; Cold boot
  536                   
  537 E34E  31 0100     BOOT:	LD SP,BUFF+80H	; set stack
  538                   
  539 E351  21 E30C     	LD HL,SIGNON	; output start message
  540 E354  CD E459     	CALL PRMSG
  541                   	
  542                   	; clear / set last used drive
  543         0000      	IF NOT MINI3
  545                   	ELSE
  546 E357  3E 00       	LD A,BTDRV
  547                   	ENDIF
  548 E359  32 0004     	LD (CDISK),A
  549                   	
  550                   	; sector buffer is empty, set to physical sector buffer not changed
  551 E35C  AF          	XOR A
  552 E35D  32 E711     	LD (BUFCHG),A
  553                   	
  554                   	; drive is undefined
  555 E360  3E FF       	LD A,0FFH
  556 E362  32 E712     	LD (CURDRV),A
  557                   
  558                   	; disable monitor entries, set to WBOOT
  559 E365  21 E374     	LD HL,WBOOT
  560 E368  22 F034     	LD (MWARM+1),HL
  561 E36B  22 F037     	LD (MWRSTR+1),HL
  562                   	
  563         FFFF      	IF DG01
  564                   	;CALL PATF	; patch BDOS close function
  565 E36E  CD E6DD     	CALL PATA	; patch BDOS active drive
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   8
NBIOS10 Z80

  566                   	;CALL PATB
  567                   	ENDIF
  568                   	
  569 E371  C3 E3CD     	JP GOCPM	; start CP/M
  570                   
  571                   ;-----------------------------------------------------------------------------
  572                   ; Warm boot
  573                   
  574 E374              WBOOT:	; write physical sector buffer to disk if changed
  575 E374  3A E711     	LD A,(BUFCHG)
  576 E377  B7          	OR A
  577 E378  CA E37E     	JP Z,WBOO1
  578                   
  579                   	;IF NOT MINI3
  580                   	
  581 E37B  CD E64E     	CALL PUTPHS	; normalerweise ist Schreibvorgang
  582                   			; nach einem Direktoryzugriff abgeschlossen
  583                   			; ACHTUNG BUG!? PUTPHS nur fuer Mini/DD-Laufwerke
  584                   			; Bei einem anderen Laufwerk geht das wohl schief
  585                   			
  586                   	;ENDIF
  587                   			
  588 E37E  3E FF       WBOO1:	LD A,0FFH	; alle Tracks ungueltig, bei Diskettenwechsel wichtig
  589 E380  32 E712     	LD (CURDRV),A
  590                   
  591 E383  31 0080     	LD SP,BUFF	; Stack zuweisen
  592 E386  0E 05       	LD C,RETRY	; Anzahl der Versuche
  593 E388  C5          	PUSH BC		; und dann anfangen zu booten
  594                   
  595 E389              WBOO2:	; loop, load CP/M
  596                   	; hier ist noch das Format des Boot-Laufwerks hardkodiert !!!
  597 E389  01 CC00     	LD BC,CPMB	; Boot von MINI-Diskette / Boot drive
  598 E38C  CD E453     	CALL SETDMA	; auf der Startadresse des CP/Ms
  599 E38F  0E 00       	LD C,BTDRV	; Laufwerk A (or BTDRV)
  600 E391  CD E41A     	CALL SELDSK	; auswaehlen
  601 E394  0E 00       	LD C,0		; Track 0
  602 E396  CD E430     	CALL SETTRK	; und den zweiten phys. Sektor, (Nr 8 logisch)
  603 E399  0E 08       	LD C,8		; entspricht Nr 2 bei 1024 Bytes
  604 E39B  CD E435     	CALL SETSEC	; wichtig, da andere Zaehlweise
  605 E39E  C1          	POP BC		; und von da an n Sektoren einlesen
  606 E39F  06 2C       	LD B,NSECTS	; aber das BIOS nicht ueberschreiben
