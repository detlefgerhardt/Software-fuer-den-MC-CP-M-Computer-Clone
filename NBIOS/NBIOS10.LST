  256                   	; Disk 0 (A) ---------------------------------------------------------
  257                   
  258                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  259                   	; 0 = NUMMER DES LAUFWERKS
  260                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  261                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  262                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  263                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  264                   	; 2048 = GROESSE EINES BLOCKS
  265                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  266                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  267                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  268                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  269                   
  270                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  271                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  272         E2B9      DPB0	EQU	$	; DISK PARM BLOCK
  273 E2B9  0028        	DW	40	; SEC PER TRACK
  274 E2BB  04          	DB	4	; BLOCK SHIFT
  275 E2BC  0F          	DB	15	; BLOCK MASK
  276 E2BD  00          	DB	0	; EXTNT MASK
  277 E2BE  0184        	DW	388	; DISK SIZE-1
  278 E2C0  00FF        	DW	255	; DIRECTORY MAX
  279 E2C2  F0          	DB	240	; ALLOC0
  280 E2C3  00          	DB	0	; ALLOC1
  281 E2C4  0040        	DW	64	; CHECK SIZE
  282 E2C6  0004        	DW	4	; OFFSET
  283                   	; additional parameters:
  284 E2C8  20          	DB	00100000B ; Mini/DD
  285 E2C9  03          	DB 	3	  ; 40 / 5 sectors = 8 -> 2^3
  286 E2CA  07          	DB	00000111B ; 1024 bytes/sector -> modulo 8 (0..7)
  287                   	; phys. parameter
  288 E2CB  0400        	DW	1024	; bytes/sectors
  289 E2CD  04          	DB	5-1	; max sectors/track
  290 E2CE  4F          	DB	80-1	; max. tracks per side
  291 E2CF  02          	DB	2	; sides
  292                   	
