  298 E25A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  299 E25E  E857  E2D4  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
  300 E262  E9DA  E9AD  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
  301                   	
