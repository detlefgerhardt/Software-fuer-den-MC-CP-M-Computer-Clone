  745                   ;-----------------------------------------------------------------------------
  746                   ; Sector translation (used by BDOS)
  747                   ; sector in C
  748                   ; skew table in DE (or 0)
  749                   ; write calculated sector to IOS and L
  750                   
  751 E4A4  7A          SECTRAN:LD A,D		; check if skew table != 0
  752 E4A5  B3                  OR E
  753 E4A6  CA E4B5             JP Z,SECTR1	; =0, -> no skew
  754                   
  755                   	; calc sector offset into skew table
  756 E4A9  06 00       	LD B,0
  757 E4AB  EB          	EX DE,HL
  758 E4AC  09          	ADD HL,BC	; sector in C
  759 E4AD  7E          	LD A,(HL)	; load skew value
  760 E4AE  32 E835     	LD (IOS),A	; save in IOS 
  761 E4B1  6F          	LD L,A		; and in L
  762 E4B2  26 00               LD H,0		; was missing *dg* 27.07.2026
  763 E4B4  C9          	RET
  764                   
