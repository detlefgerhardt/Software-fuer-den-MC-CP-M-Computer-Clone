 1263                   ;-----------------------------------------------------------------------------
 1264                   ; Calculates physical drive from DBANK and IOT -> C
 1265                   ; only for Mini disks
 1266                   
 1267                   ; DBANK, IOT     C
 1268                   ;  0     F    -> 0
 1269                   ;  1     F    -> 2
 1270                   ;  0     B    -> 1
 1271                   ;  1     B    -> 3
 1272                   
 1273                   ; muss fuer Minidisk C und D erweitert werden
 1274                   
 1275                   ; drive number (0..n-1) -> C, Bit 0..3
 1276                   ; side -> (0..n-1) -> C, Bit 7
 1277                   
 1278                   ; calculates physical sector from logical sector, IOS -> E
 1279                   ; logical sector 0..39 -> physical sector 1..5
 1280                   
 1281                   ; calculates logical track from physical track, IOT -> D
 1282                   ; 0..159 -> 0..79 (max 127)
