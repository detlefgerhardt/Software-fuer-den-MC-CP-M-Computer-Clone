Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NBIOS10 Z80

    1                   ;************************************************************************
    2                   ;* NBIOS10.Z80								*
    3                   ;*									*
    4                   ;* basiert auf der Version 3.1 1984 Rolf-Dieter Klein 841220            *
    5                   ;* Urspr|ngliche Version fuer 2 Mini und 2 Maxi Laufwerke		*
    6                   ;*									*
    7                   ;************************************************************************
    8                   ;
    9                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
   10                   ;
   11                   ; 24.06.2026 *dg* Kommentare hinzugefuegt
   12                   ;                 Binaer identisch zur Origial-Version
   13                   ; 06.07.2026 *dg* V1.0 Erste Aenderungen am BIOS. Alte Monnitor-Routinen werden
   14                   ;                 nicht mehr verwendet. Laufwerksumrechnung gedndert.
   15                   ;                 Version getestet.
   16                   ;                 Alle Aenderungen mit bedingter Assemblierung (Flag MINI3)
   17                   ;                 Testweise den Speicherbereich fuer das BIOS auf E200..EFFF
   18                   ;		  geaendert. CP/M startet dann bei CC00 (58K)
   19                   ; 09.07.2026 *dg* V1.0 Erweitert um 4 IDE/CF-Laufwerke - funktioniert nicht
   20                   ;                 System bootet aber Schreiben auf die IDE-Laufwerke schldgt fehl.
   21                   ; 12.07.2026 *dg* Lesen und Schreiben von CF funktioniert
   22                   ; 31.07.2026 *dg* V1.0 Laufwerk C als HD Laufwerk konfiguriert (1.44 MB)
   23                   ;                 Probleme immer beim ersten Scheiben nach dem Formatieren
   24                   ; 02.08.2026 *dg* Laufwerk B: als 5.25 Zoll HD Laufwerk
   25                   ;		  Funktioniert noch nicht, Format und Laufwerksparameter unklar 
   26                   ; 03.08.2026 *dg* BIOS Debug-Ausgaben per Ctrl-A toggelbar
   27                   ; 06.08.2026 *dg* 5.25 Zoll Format mit 1024*8 funktioniert (1.4 MB)
   28                   ;                 5.25 Zoll Format mit 512*15 funktioniert! (1.2 MB)
   29                   ; 08.08.2026 *dg* CF-Card Laufwerksparameter geaendert
   30                   ; 09.08.2026 *dg* Quick'n dirty fix for Warmboot from IDE/CF
   31                   ;		  (Disk-Parameter immer hardcodiert beim Warmboot aber konfigurierbar)
   32                   ;
   33                   ; Verbesserung/Verdndernungen zu BIOS 3.1 seit Juni 2026
   34                   ;
   35                   ; BIOS vergroessert, dadurch geaenderte Startadressen. CP/M ab CC00-E1FF, BIOS E200-EFFF
   36                   ; Dateinamen geaendert, die meisten Files und Tools beinnen "N" zu Unterscheidung von den Original-Files
   37                   ; Laufwerksparameter gedndert, A ist 800KB (NDR/NKC), B und C unterschiedlich, D ist IBM 8" SS/SD
   38                   ; IDE/CF eingebunden, Laufwerke E bis H, je 2 MB, E ist bootfdhig (geaenderte BIOS-Parameter)
   39                   ; Blocking/Deblocking gedndert, ist jetzt flexibler und leichter zu konfigurieren
   40                   ; max. Steprate wird beim Warmstart gesetzt
   41                   ; Debug-Ausgaben im BIOS |ber, |ber Compiler-Schalter und zu Laufzeit mit Ctrl-A ein- und ausschaltbar
   42                   ; Diverse Laufwerksformate gestestet, est mit echten 8 Zoll Laufwerken steht noch aus.
   43                   ; MOVCPM und SYSGEN funktionieren werden der gednderten BIOS-Groesse vermutlich nicht mehr und muessen
   44                   ; neu angasst werden (oder flexible Variante verwenden)
   45                   ;
   46                   ; TO-DO:
   47                   ; Drive-spezifische Tabellen zu den Laufwerkstabellen
   48                   ; Maxi-Routinen in Mini-Routinen integrieren
   49                   
   50                   ;------------------------------------------------------------------------------
   51                   
   52         0016      CPMVER	EQU 22		; CP/M version
   53         0000      FALSE	EQU 0
   54         FFFF      TRUE	EQU NOT FALSE
   55         FFFF      TEST	EQU TRUE
   56         000D      CR	EQU 0DH		; carriage return
   57         000A      LF	EQU 0AH		; line feed
   58                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBIOS10 Z80

   59                   ;------------------------------------------------------------------------------
   60                   ; Variant switches
   61                   
   62                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 3.1
   63         FFFF      DG01	EQU TRUE
   64         FFFF      DG_BHD	EQU TRUE	; drive B as HD drive (5 1/4 inch, 1.4 MB)
   65         FFFF      DG_CHD	EQU TRUE	; drive C as HD drive (3 1/2 inch, 1.44 MB)
   66         FFFF      DEBOUT	EQU TRUE	; debug outputs
   67         0000      BTDRV	EQU 0		; drive A:
   68                   ;BTDRV	EQU 4		; drive E: (IDE/CF)
   69                   
   70                   ; logical drive to boot from
   71         0000      	IF NOT DG01
   74                   	ELSE
   75                   	; boot from disk A (800KB NDE/NKC format)
   76         FFFF      	IF BTDRV = 0	; drive A
   77         0008      BTSEC	EQU 8		; start sector of CP/M on disk with 1024 bytes/sector
   78         0028      BTSECN	EQU 40		; sector per track
   79                   	ENDIF
   80                   	; boot from IDE/CF (2 MB format)
   81         0000      	IF BTDRV = 4	; drive E
   84                   	ENDIF
   85                   	ENDIF		; if DG_01
   86                   
   87                   ;------------------------------------------------------------------------------
   88                   ; Monitor functions
   89                   
   90         FFFF      	IF DG01
   91                   
   92         F009      MCONOUT	EQU 0F009h	; character in C
   93                   
   94                   	ENDIF
   95                   
   96                   ;------------------------------------------------------------------------------
   97                   ; CPM and BIOS sizes and addresses
   98                   
   99                   ;MSIZE 	EQU 60			; Speichergroesse, hier 60K
  100         003A      MSIZE 	EQU 58			; Speichergroesse, hier 58K
  101                   
  102         9800      BIAS	EQU (MSIZE-20)*1024	; min=20K
  103         CC00      CCP	EQU 3400H+BIAS		; start of CCP (CP/M)
  104         D406      BDOS	EQU CCP+806H		; BDOS entry behind serial number (6 bytes)
  105         E200      BIOS	EQU CCP+1600H		; start of BIOS
  106                   
  107         D400      BDOSADR	EQU BDOS - 6
  108                   
  109         CC00      CPMB	EQU CCP			; Start CP/M-Boot
  110                   
  111         1600      CPML	EQU BIOS-CPMB		; Laenge des CP/Ms
  112         002C      NSECTS	EQU CPML/128		; Anzahl der von CP/M belegten Sektoren for Warmboot
  113                   
  114                   ;-----------------------------------------------------------------------------
  115                   
  116         0000      JWARM	EQU 0000H	; JMP to WBOOT
  117         0003      IOBYTE	EQU 0003H	; Address of IOBYTE
  118         0004      CDISK	EQU 0004H	; Address of last used drive and user (low-nibble: current drive, high-nibble: current user)
  119         0005      JBDOS	EQU 0005H	; JMP to BDOS
  120         0038      JRST7	EQU 0038H	; JMP RST7 (7*8)
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBIOS10 Z80

  121         0080      BUFF	EQU 0080H	; buffer address
  122         0005      RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write
  123                   
  124                   ;-----------------------------------------------------------------------------
  125                   
  126         E200      	ORG BIOS	; regular start of BIOS
  127                   	;ORG BIOS-4000H	; for debugging
  128                   
  129 E200              STARTBIOS:
  130                   
  131 E200  C3 E39A     	JP BOOT		; Cold boot
  132                   
  133                   	; --- start of offical BIOS calls ---
  134                   	
  135 E203  C3 E3C7     WBOOTE:	JP WBOOT	; Warm boot (CTRL-C)
  136 E206  C3 E384     	JP CONST	; Get CONSOLE status -> A
  137 E209  C3 E387     	JP CONIN	; Input character from CONSOLE -> A
  138 E20C  C3 F009     	JP CONOUT	; Output character to CONSOLE (C)
  139 E20F  C3 F00F     	JP LIST		; Output character to LIST device (C)
  140 E212  C3 F00C     	JP PUNCH	; Output character to PUNCH device (C)
  141 E215  C3 F006     	JP READER	; Input character from READER device -> A
  142                   
  143 E218  C3 E468     	JP HOME		; Select track home position (no execution)
  144 E21B  C3 E46D     	JP SELDSK	; Select drive, drive 0..n-1 in C, returns disk parameter header block in HL
  145 E21E  C3 E483     	JP SETTRK	; Select track for read/write, track in C (logic tracks!!! e.g. 0..159)
  146 E221  C3 E488     	JP SETSEC	; Select sector for read/write, sector in C (logic sectors!!! e.g. 0..39)
  147 E224  C3 E4A6     	JP SETDMA	; Set disk read/write address (no real DMA), address in BC
  148 E227  C3 E4B9     	JP READ		; Read sector
  149 E22A  C3 E52F     	JP WRITE	; Write sector
  150 E22D  C3 E465     	JP LISTST	; Listener ready? (not implemented, returns 1 = not ready)
  151 E230  C3 E48D     	JP SECTRAN	; sector translation (skew only)
  152                   	
  153                   	; --- end of offical BIOS calls ---
  154                   	
  155         FFFF      	IF DG01
  156 E233  C3 E564     	JP FLUSH	; BDOS close and write sector buffer to disk (not used)
  157                   	ENDIF
  158                   
  159                   ;-----------------------------------------------------------------------------
  160                   
  161         0000      	IF NOT DG01
  300                   	ELSE	; ------------------------------------------------------------
  301                   
  302                   	; size of mini disks A, B, C
  303                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  304                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  305                   
  306                   	;DISKS 8		; define 8 drives (A..H)
  307         0008      NDISKS	EQU	8	
  308                   
  309         E236      DPBASE	EQU	$		;BASE OF DISK PARAMETER BLOCKS
  310                   
  311 E236  0000  0000  DPE0:	DW	XLT0,0000H	;TRANSLATE TABLE
  312 E23A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  313 E23E  E857  E2B6  	DW	DIRBUF,DPB0	;DIR BUFF,PARM BLOCK
  314 E242  E908  E8D7  	DW	CSV0,ALV0	;CHECK, ALLOC VECTORS
  315                   	
  316 E246  0000  0000  DPE1:	DW	XLT1,0000H	;TRANSLATE TABLE
