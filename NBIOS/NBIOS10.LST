  299 E256  0000  0000  DPE2:	DW	XLT2,0000H	;TRANSLATE TABLE
  300 E25A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  301 E25E  E832  E2D4  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
  302 E262  EA46  E986  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
  303                   	
