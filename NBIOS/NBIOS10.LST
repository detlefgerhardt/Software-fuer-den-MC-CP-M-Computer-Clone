 1789                   ; Addresses of IDE-80 CF-Adapter card
 1790                   
 1791         0018      IDEDATA	EQU 018h	; IDE Data Register
 1792         001A      SECCND	EQU 01Ah	; Sector Count Register
 1793         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1794         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1795         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1796         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1797         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1798                   
 1799                   ; IDE/CF physical format: 
 1800                   ; 4 partitions
 1801                   ; 8192 KB bytes/partition 
 1802                   ; 128 bytes/sector
 1803                   ; 256 sectors/track
 1804                   ; 256 tracks
 1805                   ; 128 * 256 * 256 / 1024 = 8192
 1806                   
 1807                   ; old (2048K):
 1808                   ; LBA
 1809                   ; 00000000 00000000 00000000
 1810                   ; 00000000 tttttttt ssssssdd
 1811                   ;        E        B        C
 1812                   
 1813                   ; NEWIDE (8192K):
 1814                   ; LBA
 1815                   ; 00000000 00000000 00000000
 1816                   ; 000000dd tttttttt ssssssss
 1817                   ;        E        B        C
