 1266                   ;-----------------------------------------------------------------------------
 1267                   ; Calculates the pointer into PHSBUF based on sector number in IOS
 1268                   ; (PHSBUF + offset) -> DE
 1269                   ; (IOD) -> HL
 1270                   ; 128 -> BC (logical sector length)
 1271                   
 1272 E676              CALCPHS:
 1273 E676  3A E880     	LD A,(BLMSK)
 1274 E679  47          	LD B,A
 1275                   
 1276 E67A  3A E87B     	LD A,(IOS)	; logical sector number (0..n-1)
 1277 E67D  A0          	AND B
 1278 E67E  57          	LD D,A		; load to high-byte (mul 256)
 1279 E67F  1E 00       	LD E,0
 1280 E681  CB 2A       	SRA D		; div/2 by shift right
 1281 E683  CB 1B       	RR E
 1282                   	; now we have (IOS mod SECSIZE) * 128 in DE
 1283 E685  21 FC00     	LD HL,PHSBUF
 1284 E688  19          	ADD HL,DE	; pointer into PHSBUF in DE
 1285                   	
 1286         FFFF      	IF DEBOUT
 1287                   	;LD C,'['
 1288                   	;CALL CONOUT
 1289                   	;CALL DEBX16
 1290                   	;LD C,']'
 1291                   	;CALL CONOUT
 1292                   	ENDIF
 1293                   	
 1294 E689  EB          	EX DE,HL
 1295 E68A  2A E87C     	LD HL,(IOD)
 1296 E68D  01 0080     	LD BC,128
 1297 E690  C9          	RET
