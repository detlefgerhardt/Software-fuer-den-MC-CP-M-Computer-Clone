  837 E47A  B3                  OR E
  838 E47B  CA E48A             JP Z,SECTR1	; =0, -> no skew
  839                   
  840                   	; calc sector offset into skew table
  841 E47E  06 00       	LD B,0
  842 E480  EB          	EX DE,HL
  843 E481  09          	ADD HL,BC	; sector in C
  844 E482  7E          	LD A,(HL)	; load skew value
