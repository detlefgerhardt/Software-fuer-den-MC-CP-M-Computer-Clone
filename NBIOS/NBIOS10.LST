 1628                   
 1629                   ; Read one sector from disk.
 1630                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1631                   ; Disk number in 'diskno' (4..7)
 1632                   ; Track number in 'track' (0..255)
 1633                   ; Sector number in 'sector' (0..63)
 1634                   ; DMA address in 'dmaad' (0-65535)
 1635                   ; 
 1636                   ; LBA
 1637                   ; 00000000 00000000 00000000
 1638                   ; 00000000 tttttttt ssssssdd
 1639                   ;        E        B        C
 1640                   
 1641         FC00      HSTBUF	EQU PHSBUF	; buffer for phyiscal sector
 1642         E82A      DISKNO	EQU DBANK
 1643         E82D      TRACK	EQU IOT
 1644         E82E      SECTOR	EQU IOS
 1645         E82F      DMAAD	EQU IOD
 1646                   
 1647         F02A      MIDERD	EQU 0F02Ah
 1648         F02D      MIDEWR	EQU 0F02Dh
