  305 E26A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  306 E26E  E832  E2E3  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
  307 E272  EAA5  EA86  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
