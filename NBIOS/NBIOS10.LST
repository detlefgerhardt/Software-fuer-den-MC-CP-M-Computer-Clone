Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NBIOS10 Z80

    1                   ;************************************************************************
    2                   ;* NBIOS10.Z80								*
    3                   ;*									*
    4                   ;* basiert auf der Version 3.1 1984 Rolf-Dieter Klein 841220            *
    5                   ;* Urspr|ngliche Version fuer 2 Mini und 2 Maxi Laufwerke		*
    6                   ;*									*
    7                   ;************************************************************************
    8                   ;
    9                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
   10                   ;
   11                   ; 24.06.2026 *dg* Kommentare hinzugefuegt
   12                   ;                 Binaer identisch zur Origial-Version
   13                   ; 06.07.2026 *dg* V1.0 Erste Aenderungen am BIOS. Alte Monnitor-Routinen werden
   14                   ;                 nicht mehr verwendet. Laufwerksumrechnung gedndert.
   15                   ;                 Version getestet.
   16                   ;                 Alle Aenderungen mit bedingter Assemblierung (Flag MINI3)
   17                   ;                 Testweise den Speicherbereich fuer das BIOS auf E200..EFFF
   18                   ;		  geaendert. CP/M startet dann bei CC00 (58K)
   19                   ; 09.07.2026 *dg* V1.0 Erweitert um 4 IDE/CF-Laufwerke - funktioniert nicht
   20                   ;                 System bootet aber Schreiben auf die IDE-Laufwerke schldgt fehl.
   21                   ; 12.07.2026 *dg* Lesen und Schreiben von CF funktioniert
   22                   ; 31.07.2026 *dg* V1.0 Laufwerk C als HD Laufwerk konfiguriert (1.44 MB)
   23                   ;                 Probleme immer beim ersten Scheiben nach dem Formatieren
   24                   ; 02.08.2026 *dg* Laufwerk B: als 5.25 Zoll HD Laufwerk
   25                   ;		  Funktioniert noch nicht, Format und Laufwerksparameter unklar 
   26                   ; 03.08.2026 *dg* BIOS Debug-Ausgaben per Ctrl-A toggelbar
   27                   ; 06.08.2026 *dg* 5.25 Zoll Format mit 1024*8 funktioniert (1.4 MB)
   28                   ;                 5.25 Zoll Format mit 512*15 funktioniert! (1.2 MB)
   29                   ; 08.08.2026 *dg* CF-Card Laufwerksparameter geaendert
   30                   ; 09.08.2026 *dg* Quick'n dirty fix for Warmboot from IDE/CF
NBIOS10.Z80 - Bad Opcode Line 00031
		  (disk params still hardcoded for Warmboot)
   31                   		  (disk params still hardcoded for Warmboot)
   32                   
   33                   ; TODO:
   34                   ; Drive-spezifische Tabellen zu den Laufwerkstabellen
   35                   
   36                   ;------------------------------------------------------------------------------
   37                   
   38         0016      CPMVER	EQU 22		; CP/M version
   39         0000      FALSE	EQU 0
   40         FFFF      TRUE	EQU NOT FALSE
   41         FFFF      TEST	EQU TRUE
   42         000D      CR	EQU 0DH		; carriage return
   43         000A      LF	EQU 0AH		; line feed
   44                   
   45                   ;------------------------------------------------------------------------------
   46                   ; Variant switches
   47                   
   48                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 3.1
   49         FFFF      DG01	EQU TRUE
   50         FFFF      DG_BHD	EQU TRUE	; drive B as HD drive (5 1/4 inch, 1.4 MB)
   51         FFFF      DG_CHD	EQU TRUE	; drive C as HD drive (3 1/2 inch, 1.44 MB)
   52         FFFF      DEBOUT	EQU TRUE	; debug outputs
   53         0000      BTDRV	EQU 0		; drive A:
   54                   ;BTDRV	EQU 4		; drive E: (IDE/CF)
   55                   
   56                   ; logical drive to boot from
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBIOS10 Z80

   57         0000      	IF NOT DG01
   60                   	ELSE
   61         FFFF      	IF BTDRV = 0
   62         0008      BTSEC	EQU 8		; start sector of CP/M on disk with 1024 bytes/sector
   63         0028      BTSECN	EQU 40		; sector per track
   64                   	ENDIF
   65         0000      	IF BTDRV = 4
   68                   	ENDIF
   69                   	ENDIF		; if DG_01
   70                   
   71                   ;------------------------------------------------------------------------------
   72                   ; Monitor functions
   73                   
   74         FFFF      	IF DG01
   75                   
   76         F009      MCONOUT	EQU 0F009h	; character in C
   77                   
   78                   	ENDIF
   79                   
   80                   ;------------------------------------------------------------------------------
   81                   
   82                   ;MSIZE 	EQU 60		; Speichergroesse, hier 60K
   83         003A      MSIZE 	EQU 58		; Speichergroesse, hier 58K
   84                   
   85         9800      BIAS	EQU (MSIZE-20)*1024	; min=20K
   86         CC00      CCP	EQU 3400H+BIAS	; start of CCP (CP/M)
   87         D406      BDOS	EQU CCP+806H	; BDOS entry behind serial number (6 bytes)
   88         E200      BIOS	EQU CCP+1600H	; start of BIOS
   89                   
   90         D400      BDOSADR	EQU BDOS - 6
   91                   
   92         CC00      CPMB	EQU CCP		; Start CP/M-Boot
   93                   
   94         1600      CPML	EQU BIOS-CPMB	; Laenge des CP/Ms
   95         002C      NSECTS	EQU CPML/128	; Anzahl der von CP/M belegten Sektoren for Warmboot
   96                   
   97                   
   98         0000      JWARM	EQU 0000H	; JMP to WBOOT
   99         0003      IOBYTE	EQU 0003H	; Address of IOBYTE
  100         0004      CDISK	EQU 0004H	; Address of last used drive and user (low-nibble: current drive, high-nibble: current user)
  101         0005      JBDOS	EQU 0005H	; JMP to BDOS
  102         0038      JRST7	EQU 0038H	; JMP RST7 (7*8)
  103         0080      BUFF	EQU 0080H	; buffer address
  104         0005      RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write
  105                   
  106                   ;-----------------------------------------------------------------------------
  107                   
  108         E200      	ORG BIOS	; regular start of BIOS
  109                   	;ORG BIOS-4000H	; for debugging
  110                   
  111 E200              STARTBIOS:
  112                   
  113 E200  C3 E39A     	JP BOOT		; Cold boot
  114                   
  115                   	; --- start of offical BIOS calls ---
  116                   	
  117 E203  C3 E3C7     WBOOTE:	JP WBOOT	; Warm boot (CTRL-C)
  118 E206  C3 E384     	JP CONST	; Get CONSOLE status -> A
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBIOS10 Z80

  119 E209  C3 E387     	JP CONIN	; Input character from CONSOLE -> A
  120 E20C  C3 F009     	JP CONOUT	; Output character to CONSOLE (C)
  121 E20F  C3 F00F     	JP LIST		; Output character to LIST device (C)
  122 E212  C3 F00C     	JP PUNCH	; Output character to PUNCH device (C)
  123 E215  C3 F006     	JP READER	; Input character from READER device -> A
  124                   
  125 E218  C3 E468     	JP HOME		; Select track home position (no execution)
  126 E21B  C3 E46D     	JP SELDSK	; Select drive, drive 0..n-1 in C, returns disk parameter header block in HL
  127 E21E  C3 E483     	JP SETTRK	; Select track for read/write, track in C (logic tracks!!! e.g. 0..159)
  128 E221  C3 E488     	JP SETSEC	; Select sector for read/write, sector in C (logic sectors!!! e.g. 0..39)
  129 E224  C3 E4A6     	JP SETDMA	; Set disk read/write address (no real DMA), address in BC
  130 E227  C3 E4B9     	JP READ		; Read sector
  131 E22A  C3 E52F     	JP WRITE	; Write sector
  132 E22D  C3 E465     	JP LISTST	; Listener ready? (not implemented, returns 1 = not ready)
  133 E230  C3 E48D     	JP SECTRAN	; sector translation (skew only)
  134                   	
  135                   	; --- end of offical BIOS calls ---
  136                   	
  137         FFFF      	IF DG01
  138 E233  C3 E564     	JP FLUSH	; BDOS close and write sector buffer to disk
  139                   	ENDIF
