  479                   	; Disk 3 (D) --------------------------------------------------------
  480                   	; physical format: 8 inch, SD, SS, 128 bytes/sector, 26 sectors/track, 77 tracks
  481                   	; DISKDEF 3,1,26,6,1024,243,64,64,2 ; 8 ZOLL DEFINITION
  482                   
  483         E2D7      DPB3	EQU	$	; DISK PARM BLOCK
  484 E2D7  001A         	DW	26	; SEC PER TRACK
  485 E2D9  03           	DB	3	; BLOCK SHIFT
  486 E2DA  07           	DB	7	; BLOCK MASK
  487 E2DB  00           	DB	0	; EXTNT MASK
  488 E2DC  00F2         	DW	242	; DISK SIZE-1
  489 E2DE  003F         	DW	63	; DIRECTORY MAX
  490 E2E0  C0           	DB	192	; ALLOC0
  491 E2E1  00           	DB	0	; ALLOC1
  492 E2E2  0010         	DW	16	; CHECK SIZE
  493 E2E4  0002         	DW	2	; OFFSET
  494                   	; new parameters:
  495 E2E6  10          	DB	00010000B ; Maxi/SD
  496 E2E7  00          	DB	0	; no deblocking
  497 E2E8  00          	DB	0	; no deblocking
  498                   	
  499         E2E9      XLT3	EQU	$	; TRANSLATE TABLE
  500 E2E9  01           	DB	1		
