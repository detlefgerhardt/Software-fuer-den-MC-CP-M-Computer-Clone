  955                   	
  956 E459  32 E859     	LD (DBANK),A
  957                   
  958                   	;POP HL
  959                   	;PUSH HL
  960                   	;CALL DEBSEL
  961                   
  962                   	; get address of DPEx -> HL (= DPBASE + disk number * 16)
  963 E45C  69          	LD L,C		; disk number
  964 E45D  26 00       	LD H,0
  965 E45F  29          	ADD HL,HL	; HL <- HL * 16
  966 E460  29          	ADD HL,HL	
  967 E461  29          	ADD HL,HL	
  968 E462  29          	ADD HL,HL	
  969 E463  11 E239     	LD DE,DPBASE	; add DPBASE
  970 E466  19          	ADD HL,DE
