  221                   	; Disk 0 (A) ---------------------------------------------------------
  222                   
  223                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  224                   	; 0 = NUMMER DES LAUFWERKS
  225                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  226                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  227                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  228                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  229                   	; 2048 = GROESSE EINES BLOCKS
  230                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  231                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  232                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  233                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  234                   
