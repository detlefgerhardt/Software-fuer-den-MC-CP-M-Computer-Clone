  458                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  459                   	; 64-sector tracks, numbering starting at zero (sectors 0 to 63)
  460                   	; Block size 2048
  461                   	; Disk size 2 mb, DSM 1023, yields 256 tracks (0 to 255)
  462 E30C              DPB4:	;disk parameter block for all disks.
  463 E30C  0040        	DW	64	; sectors per track
  464 E30E  04          	DB	4	; block shift factor
  465 E30F  0F          	DB	15	; block mask - with block shift, sets block size to 1024
  466 E310  00          	DB	0	; null mask
  467 E311  03FF        	DW	1023	; disk size-1 = number of blocks in a disk - 1
  468 E313  0100        	DW	256	; directory max = no. directory entries/disk, arbitrary
  469 E315  F0          	DB	240	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  470 E316  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  471 E317  0000        	DW	0	; check size -- no checking, so zero
  472 E319  0001        	DW	1	; track offset -- first track for system
  473                   
  474                   	; Disk 5 (F), IDE partition 1 ----------------------------------------
  475         E30C      DPB5	EQU	DPB4	; EQUIVALENT PARAMETERS
  476                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  477                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  478                   
  479                   	; Disk 6 (G), IDE partition 2 ----------------------------------------
  480         E30C      DPB6	EQU	DPB4	; EQUIVALENT PARAMETERS
  481                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  482                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  483                   
  484                   	; Disk 7 (H), IDE partition 3 ----------------------------------------
  485         E30C      DPB7	EQU	DPB4	; EQUIVALENT PARAMETERS
  486                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  487                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  488                   
  489                   	ENDIF	; MINI3
  490                   
