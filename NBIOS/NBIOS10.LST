  235                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  236                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  237                   
  238                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  239                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  240         E2B3      DPB0	EQU	$	; DISK PARM BLOCK
  241 E2B3  0028        	DW	40	; SEC PER TRACK
  242 E2B5  04          	DB	4	; BLOCK SHIFT
  243 E2B6  0F          	DB	15	; BLOCK MASK
  244 E2B7  00          	DB	0	; EXTNT MASK
  245 E2B8  0184        	DW	388	; DISK SIZE-1
  246 E2BA  00FF        	DW	255	; DIRECTORY MAX
  247 E2BC  F0          	DB	240	; ALLOC0
  248 E2BD  00          	DB	0	; ALLOC1
  249 E2BE  0040        	DW	64	; CHECK SIZE
  250 E2C0  0004        	DW	4	; OFFSET
  251                   	; new parameters:
  252 E2C2  20          	DB	00100000B ; Mini/DD
  253 E2C3  03          	DB 	3	  ; 40 / 5 sectors = 8 -> 2^3
  254 E2C4  07          	DB	00000111B ; 1024 bytes/sector -> modulo 8 (0..7)
  255                   	
  256         0000      XLT0	EQU	0	; NO XLATE TABLE
  257                   
  258         FFFF      	IF NOT DG_BHD
  259                   
  260                   	; Disk 1 (B), same as Disk A -----------------------------------------
  261                   	; DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
  262         E2B3      DPB1	EQU	DPB0	; EQUIVALENT PARAMETERS
  263         0000      XLT1	EQU	XLT0	; SAME TRANSLATE TABLE
  264                   
  265                   	ELSE	; DG_BHD
  309                   	ENDIF	; DG_BHD
  310                   
  311         0000      	IF NOT DG_CHD
  319                   	ELSE	; DG_CHD
  320                   
  321                   	; Disk 2 (C): PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
  322         E2C5       DPB2	EQU	$	; DISK PARM BLOCK
  323 E2C5  0048         	DW	72	; SEC PER TRACK
  324 E2C7  05           	DB	5	; BLOCK SHIFT
  325 E2C8  1F           	DB	31	; BLOCK MASK
  326 E2C9  01           	DB	1	; EXTNT MASK
  327 E2CA  0162         	DW	354	; DISK SIZE-1
  328 E2CC  00FF          	DW	255	; DIRECTORY MAX
  329 E2CE  C0           	DB	192	; ALLOC0
  330 E2CF  00           	DB	0	; ALLOC1
  331 E2D0  0040         	DW	64	; CHECK SIZE
  332 E2D2  0002         	DW	2	; OFFSET
  333                   	; new parameters:
  334 E2D4  00           	DB	00000000B ; Maxi/HD
  335 E2D5  03          	DB 	3	  ; 72 / 9 = 8 -> 2^3
  336 E2D6  03          	DB	00000011B ; 512 bytes/sector -> modulo 4 (0..3)
  337                   	
  338         0000       XLT2	EQU	0	; NO XLATE TABLE
  339                   	
  340                   	ENDIF	; DG_CHD
  341                   
  342                   
