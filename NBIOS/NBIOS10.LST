  573                   ;-----------------------------------------------------------------------------
  574                   ; get state of CONSOLE (if character is available)
  575                   
  576 E384  C3 F012     CONST:	JP 0F012H
  577                   
  578                   ;-----------------------------------------------------------------------------
  579                   ; read one char from CONSOLE and clears parity bit
  580                   
  581 E387  CD F003     CONIN:	CALL 0F003H
  582 E38A  E6 7F       	AND 7FH
  583                   
  584         FFFF      	IF DG01
  585         FFFF      	IF DEBOUT
  586                   
  587 E38C  FE 01       	CP A,1
  588 E38E  C0          	RET NZ
  589                   
  590                   	; toggle debug
  591 E38F  47          	LD B,A
  592 E390  3A E856     	LD A,(DEBACT)
  593 E393  EE 01       	XOR A,01H
  594 E395  32 E856     	LD (DEBACT),A
  595 E398  78          	LD A,B
  596                   
  597                   	ENDIF
  598                   	ENDIF
