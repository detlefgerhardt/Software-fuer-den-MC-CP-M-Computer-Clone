  549                   ;-----------------------------------------------------------------------------
  550                   ; get state of CONSOLE (if character is available)
  551                   
  552 E384  C3 F012     CONST:	JP 0F012H
  553                   
  554                   ;-----------------------------------------------------------------------------
  555                   ; read one char from CONSOLE and clears parity bit
  556                   
  557 E387  CD F003     CONIN:	CALL 0F003H
  558 E38A  E6 7F       	AND 7FH
  559                   
  560         FFFF      	IF DG01
  561         0000      	IF DEBOUT
  573                   	ENDIF
  574                   	ENDIF
  575                   	
  576 E38C  C9          	RET
