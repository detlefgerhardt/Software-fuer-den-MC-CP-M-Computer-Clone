  424 E313  0D 0A 43 50 	DB CR,LF,'CP/M '
  425 E31A  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
  426 E31D  20 66 6F 72 	DB ' for MC-Computer '
  427 E32E  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  428 E330  4B 20 4E 42 	DB 'K NBIOS 260904-01'
  429 E341  20 42 4F 4F 	DB " BOOT=",BTDRV+'A',CR,LF
