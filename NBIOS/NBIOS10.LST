  939 E4A2  B3                  OR E
  940 E4A3  CA E4B2             JP Z,SECTR1	; =0, -> no skew
  941                   
  942                   	; calc sector offset into skew table
  943 E4A6  06 00       	LD B,0
  944 E4A8  EB          	EX DE,HL
  945 E4A9  09          	ADD HL,BC	; sector in C
  946 E4AA  7E          	LD A,(HL)	; load skew value
  947 E4AB  32 E829     	LD (IOS),A	; save in IOS 
  948 E4AE  6F          	LD L,A		; and in L
  949         FFFF      	IF DG01
  950 E4AF  26 00               LD H,0		; was missing *dg* 27.07.2026
  951                   	ENDIF
  952 E4B1  C9          	RET
  953                   
