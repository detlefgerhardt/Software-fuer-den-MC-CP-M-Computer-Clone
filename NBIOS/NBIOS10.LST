  608                   ; Monitor warm start
  609                   
  610         F033      MWARM	EQU 0F033H	; Monitor warm start, will be overwritten by BIOS
  611                   
  612                   ;-----------------------------------------------------------------------------
  613                   ; Monitor write string
  614                   
  615         F036      MWRSTR	EQU 0F036H	; Write string, will be overwritten by BIOS
