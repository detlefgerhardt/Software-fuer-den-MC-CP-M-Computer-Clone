  424         E2D4       DPB2	EQU	$	; DISK PARM BLOCK
  425 E2D4  0048         	DW	72	; SEC PER TRACK
  426 E2D6  05           	DB	5	; BLOCK SHIFT
  427 E2D7  1F           	DB	31	; BLOCK MASK
  428 E2D8  01           	DB	1	; EXTNT MASK
  429 E2D9  0162         	DW	354	; DISK SIZE-1
  430 E2DB  00FF          	DW	255	; DIRECTORY MAX
  431 E2DD  C0           	DB	192	; ALLOC0
  432 E2DE  00           	DB	0	; ALLOC1
  433 E2DF  0040         	DW	64	; CHECK SIZE
  434 E2E1  0002         	DW	2	; OFFSET
  435         0000       XLT2	EQU	0	; NO XLATE TABLE
  436                   	
  437                   	ENDIF
