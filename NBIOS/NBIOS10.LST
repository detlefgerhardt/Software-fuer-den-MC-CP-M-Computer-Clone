  590                   ; get state of CONSOLE (if character is available)
  591                   
  592 E384  C3 F012     CONST:	JP 0F012H
  593                   
  594                   ;-----------------------------------------------------------------------------
  595                   ; read one char from CONSOLE and clears parity bit
  596                   
  597 E387  CD F003     CONIN:	CALL 0F003H
  598 E38A  E6 7F       	AND 7FH
  599                   
