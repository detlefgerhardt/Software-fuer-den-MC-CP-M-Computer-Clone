  491                   
  492                   ;-----------------------------------------------------------------------------
  493                   ; get state of CONSOLE (if character is available)
  494                   
  495         F012      CONST	EQU 0F012H
  496                   
  497                   ;-----------------------------------------------------------------------------
  498                   ; read one char from CONSOLE and clears parity bit
  499                   
  500 E382  CD F003     CONIN:	CALL 0F003H
  501 E385  E6 7F       	AND 7FH
  502                   
  503         FFFF      	IF DEBOUT
  504                   
  505 E387  FE 01       	CP A,1
  506 E389  C0          	RET NZ
  507                   
  508                   	; toggle debug
  509 E38A  47          	LD B,A
  510 E38B  3A E83C     	LD A,(DEBACT)
  511 E38E  EE 01       	XOR A,01H
  512 E390  32 E83C     	LD (DEBACT),A
  513 E393  78          	LD A,B
