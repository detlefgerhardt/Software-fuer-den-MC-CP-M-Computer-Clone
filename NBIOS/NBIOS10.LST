  746 E3D7  CD E4BA     	CALL SETDMA
  747 E3DA  0E 00       	LD C,BTDRV	; drive 0 (or BTDRV)
  748 E3DC  CD E465     	CALL SELDSK
  749 E3DF  0E 00       	LD C,0		; track 0
  750 E3E1  CD E497     	CALL SETTRK
  751 E3E4  0E 08       	LD C,BTSEC	; start with first logical sector behind physical boot sector
  752 E3E6  CD E49C     	CALL SETSEC	; (depends on the number of logical sectors per phyiscal sector)
  753 E3E9  C1          	POP BC
  754 E3EA  06 2C       	LD B,NSECTS	; number of sectors for CP/M without BIOS, do not overwrite BIOS
  755                   			; to preserve patches.
  756                   
  757                   	;LD C,'1'
  758                   	;CALL CONOUT
  759                   
