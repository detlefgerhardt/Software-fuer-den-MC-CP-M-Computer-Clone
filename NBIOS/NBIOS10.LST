  994                   	;---------------------------------------------------------------------
  995                   	; Calculate address for ram disk, source in HL
  996                   	; SEKTOR 0..E,  TRAck 0..5fh
  997                   	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
  998 E4D0  3A E852     ADRERZ:	LD A,(IOT)		; Track holen
  999 E4D3  0F           	RRCA 			; und umrechnen
 1000 E4D4  E6 0F        	AND 0FH			; unterer Teil vom MSB
 1001 E4D6  67           	LD H,A
 1002 E4D7  3A E853      	LD A,(IOS)		; dann Sektor dazu
 1003 E4DA  07           	RLCA
 1004 E4DB  07           	RLCA
 1005 E4DC  07           	RLCA
 1006 E4DD  07           	RLCA
 1007 E4DE  E6 F0        	AND 0F0H
 1008 E4E0  B4           	OR H
 1009 E4E1  67           	LD H,A			; damit sssstttt ok
 1010 E4E2  3A E852      	LD A,(IOT)
 1011 E4E5  0F           	RRCA			; txxxxxxx
 1012 E4E6  E6 80        	AND 80H
 1013 E4E8  6F           	LD L,A			; t0000000
 1014 E4E9  3A E852      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
 1015 E4EC  07           	RLCA			; und dazu msb-Teil des Tracks verwenden
 1016 E4ED  07           	RLCA			; 0mmttttt
 1017 E4EE  07           	RLCA			; Banknummer
 1018 E4EF  E6 03        	AND 03H			; 000000mm
 1019 E4F1  C6 01       	ADD A,1			; erst ab Bank 1 starten
 1020 E4F3  47           	LD B,A			; da BANK 0=CP/M RAM und TPA
 1021 E4F4  4F           	LD C,A			; ok beide definiert
 1022 E4F5  C9           	RET
