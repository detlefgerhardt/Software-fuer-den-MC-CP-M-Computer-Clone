 1160 E52C  CA E537     	JP Z,MINIC3
 1161                   
 1162 E52F  C5          	PUSH BC
 1163 E530  43          	LD B,E
 1164 E531  0F          MINIC2:	RRCA
 1165 E532  10 FD       	DJNZ MINIC2
 1166 E534  C1          	POP BC
 1167                   
 1168 E535  E6 07       	AND 00000111b	; important because of rotate command
 1169                   
 1170 E537  3C          MINIC3:	INC A		; sector number starts with 1
 1171 E538  5F          	LD E,A		; save in E
 1172                   
 1173                   	; drive A,B,C -> 001,010,100
 1174 E539  E5          	PUSH HL
 1175 E53A  3A E718     	LD A,(DBANK)
 1176 E53D  21 E556     	LD HL,CALCTB
