 1564                   ;-----------------------------------------------------------------------------
 1565                   
 1566                   ; Read one sector from disk.
 1567                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1568                   ; Disk number in 'diskno' (4..7)
 1569                   ; Track number in 'track' (0..255)
 1570                   ; Sector number in 'sector' (0..63)
 1571                   ; DMA address in 'dmaad' (0-65535)
 1572                   ; 
 1573                   ; LBA
 1574                   ; 00000000 00000000 00000000
 1575                   ; 00000000 tttttttt ssssssdd
 1576                   ;        E        B        C
 1577                   
 1578         FC00      HSTBUF	EQU PHSBUF	; buffer for phyiscal sector
 1579         E718      DISKNO	EQU DBANK
 1580         E71B      TRACK	EQU IOT
 1581         E71C      SECTOR	EQU IOS
 1582         E71D      DMAAD	EQU IOD
 1583                   
 1584         F02A      MIDERD	EQU 0F02Ah
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  23
