  318 E28E  E71F  E2FD  	DW	DIRBUF, DPB5
  319 E292  EAB1  EA31  	DW	CSV5, ALV5
  320                   	
  321 E296  0000  0000  DPE6:	DW	0000h, 0000h
  322 E29A  0000  0000  	DW	0000h, 0000h
  323 E29E  E71F  E2FD  	DW	DIRBUF, DPB6
  324 E2A2  EB32  EAB2  	DW	CSV6, ALV6
  325                   	
  326 E2A6  0000  0000  DPE7:	DW	0000h, 0000h
  327 E2AA  0000  0000  	DW	0000h, 0000h
