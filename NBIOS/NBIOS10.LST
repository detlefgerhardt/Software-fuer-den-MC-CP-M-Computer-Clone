  409         E2C5       DPB1	EQU	$	; DISK PARM BLOCK
  410                    	;DW	56 ; 60	; SEC PER TRACK
  411 E2C5  003C         	DW	60	; SEC PER TRACK
  412 E2C7  05           	DB	5	; BLOCK SHIFT
  413 E2C8  1F           	DB	31	; BLOCK MASK
  414 E2C9  01           	DB	1	; EXTNT MASK
  415                    	;DW	275 ; 295	; DISK SIZE-1
  416 E2CA  0127         	DW	295	; DISK SIZE-1
  417 E2CC  00FF          	DW	255	; DIRECTORY MAX
  418 E2CE  C0           	DB	192	; ALLOC0
  419 E2CF  00           	DB	0	; ALLOC1
  420 E2D0  0040         	DW	64	; CHECK SIZE
  421 E2D2  0002         	DW	2	; OFFSET
  422         0000       XLT1	EQU	0	; NO XLATE TABLE
  423                   
  424                   
  425                   	ENDIF
  426                   
  427         0000      	IF NOT DG_CHD
  437                   	ELSE
  438                   
