  955 E4B2  69          	LD L,C		; sector in C
  956 E4B3  79                  LD A,C
  957 E4B4  32 E829             LD (IOS),A	; save in IOS
  958 E4B7  26 00               LD H,0
  959 E4B9  C9                  RET
