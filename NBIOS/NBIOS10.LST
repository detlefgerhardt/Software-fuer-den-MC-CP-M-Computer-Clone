  624                   ;-----------------------------------------------------------------------------
  625                   ; get state of CONSOLE (if character is available)
  626                   
  627 E37C  C3 F012     CONST:	JP 0F012H
  628                   
  629                   ;-----------------------------------------------------------------------------
  630                   ; read one char from CONSOLE and clears parity bit
  631                   
  632 E37F  CD F003     CONIN:	CALL 0F003H
  633 E382  E6 7F       	AND 7FH
  634                   
  635         FFFF      	IF DG01
  636         FFFF      	IF DEBOUT
  637                   
  638 E384  FE 01       	CP A,1
  639 E386  C0          	RET NZ
  640                   
  641                   	; toggle debug
  642 E387  47          	LD B,A
