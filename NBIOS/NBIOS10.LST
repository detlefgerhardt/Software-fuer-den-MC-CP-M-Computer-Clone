 1034                   ;=============================================================================
 1035                   ; Read Mini disk, 80 Spur, DD, DS
 1036                   
 1037                   ;READ und WRITE unter Verwendung von MEXEC
 1038                   ; HL=DMA ADR
 1039                   ; DE=TRACK/SECTOR
 1040                   ; B=0 RSTORE
 1041                   ;   1 READ
 1042                   ;   2 WRITE
 1043                   ; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
 1044                   ;                                          A   C    B    D
 1045                   
 1046         FC00      PHSBUF	EQU 0FC00H	; Memory area of interactive Monitor for logical sector (1K)
 1047                   
 1048                   ;-----------------------------------------------------------------------------
 1049                   ; Calculates physical drive from DBANK and IOT -> C
 1050                   ; only for Mini disks
 1051                   
 1052                   ; DBANK, IOT     C
 1053                   ;  0     F    -> 0
 1054                   ;  1     F    -> 2
 1055                   ;  0     B    -> 1
 1056                   ;  1     B    -> 3
 1057                   
 1058                   ; muss fuer Minidisk C und D erweitert werden
 1059                   
 1060                   ; drive number (0..n-1) -> C, Bit 0..3
 1061                   ; side -> (0..n-1) -> C, Bit 7
 1062                   
 1063                   ; calculates physical sector from logical sector, IOS -> E
 1064                   ; logical sector 0..39 -> physical sector 1..5
 1065                   
 1066                   ; calculates logical track from physical track, IOT -> D
 1067                   ; 0..159 -> 0..79 (max 127)
 1068                   
 1069 E590              MINCAL:	; logical sector to physical sector
 1070                   	; get drive specific factor
 1071 E590  3A E87F     	LD A,(BLPOW)
 1072 E593  A7          	AND A
 1073 E594  28 0A       	JR Z,MINIC4	; -> factor = 0
 1074                   
 1075 E596  47          	LD B,A		; factor
 1076 E597  3A E87B     	LD A,(IOS)	; logical sector
 1077 E59A  CB 3F       MINIC2:	SRL A
 1078 E59C  10 FC       	DJNZ MINIC2
 1079                   	
 1080 E59E  18 03       	JR MINIC5
 1081                   
 1082 E5A0              MINIC4:	; factor = 0
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  18
NBIOS10 Z80

 1083 E5A0  3A E87B     	LD A,(IOS)
 1084                   
 1085 E5A3  3C          MINIC5:	INC A		; sector number starts with 1
 1086 E5A4  5F          	LD E,A		; save in E
 1087                   
 1088         FFFF      	IF NEWIDE
 1089 E5A5  3A E881     	LD A,(ISIDE)
 1090 E5A8  A7          	AND A
 1091 E5A9  28 09       	JR Z,MINC5A	; -> no IDE drive
 1092                   
 1093                   	; -> is IDE drive, no drive or track translation
 1094 E5AB  3A E879     	LD A,(DBANK)
 1095 E5AE  4F          	LD C,A
 1096 E5AF  3A E87A     	LD A,(IOT)
 1097 E5B2  57          	LD D,A
 1098 E5B3  C9          	RET
 1099                   
 1100 E5B4              MINC5A:
 1101                   	ENDIF
