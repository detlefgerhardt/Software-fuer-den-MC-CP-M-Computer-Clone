  532 E31B              SIGNON:
  533                   
  534         0000      	IF NOT DG01
  543                   	ELSE
  544                   
  545 E31B  1A          	DB 26
  546 E31C  0D 0A 43 50 	DB CR,LF,'CP/M '
  547 E323  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
  548 E326  20 66 6F 72 	DB ' for MC-Computer '
  549 E337  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  550 E339  4B 20 4E 42 	DB 'K NBIOS 260809-02'
  551 E34A  20 42 4F 4F 	DB " BOOT=",BTDRV+'A',CR,LF
  552                   
  553 E353  41 3A 4E 4B 	DB "A:NKC800"
  554                   
  555         0000      	IF NOT DG_BHD
  557                   	ELSE
  558 E35B  2C 42 3A 31 	DB ",B:1.4MB"
  559                   	ENDIF
  560                   
  561         0000      	IF NOT DG_CHD
  563                   	ELSE
  564 E363  2C 43 3A 31 	DB ",C:1.44MB"
  565                   	ENDIF
  566                   
  567 E36C  2C 44 3A 49 	DB ",D:IBM SS/SD,E..H:IDE"
  568                   
  569 E381  0D 0A 00    	DB CR,LF,0
  570                   
  571                   	ENDIF
