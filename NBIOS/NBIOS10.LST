  375 E2C0  00          	DB	0	; ALLOC1
  376 E2C1  0040        	DW	64	; CHECK SIZE
  377 E2C3  0004        	DW	4	; OFFSET
  378         0000      XLT0	EQU	0	; NO XLATE TABLE
  379                   
  380         0000      	IF NOT DG_BHD
  389                   	ELSE
  390                   
  391         0000      	IF FALSE
  406                   	ENDIF
  407                   
