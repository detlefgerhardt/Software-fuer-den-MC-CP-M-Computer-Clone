  511                   
  512 E31B              SIGNON:
  513                   
  514         0000      	IF NOT DG01
  523                   	ELSE
  524                   
  525 E31B  1A          	DB 26
  526 E31C  0D 0A 43 50 	DB CR,LF,'CP/M '
  527 E323  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
