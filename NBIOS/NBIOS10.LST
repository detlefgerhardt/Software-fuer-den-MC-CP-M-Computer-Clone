  246                   	; Disk 0 (A) ---------------------------------------------------------
  247                   
  248                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  249                   	; 0 = NUMMER DES LAUFWERKS
  250                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  251                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  252                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  253                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  254                   	; 2048 = GROESSE EINES BLOCKS
  255                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  256                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  257                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  258                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  259                   
  260                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  261                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  262         E2B3      DPB0	EQU	$	; DISK PARM BLOCK
  263 E2B3  0028        	DW	40	; SEC PER TRACK
  264 E2B5  04          	DB	4	; BLOCK SHIFT
  265 E2B6  0F          	DB	15	; BLOCK MASK
  266 E2B7  00          	DB	0	; EXTNT MASK
  267 E2B8  0184        	DW	388	; DISK SIZE-1
  268 E2BA  00FF        	DW	255	; DIRECTORY MAX
  269 E2BC  F0          	DB	240	; ALLOC0
  270 E2BD  00          	DB	0	; ALLOC1
  271 E2BE  0040        	DW	64	; CHECK SIZE
  272 E2C0  0004        	DW	4	; OFFSET
  273                   	; new parameters:
  274 E2C2  20          	DB	00100000B ; Mini/DD
  275 E2C3  03          	DB 	3	  ; 40 / 5 sectors = 8 -> 2^3
  276 E2C4  07          	DB	00000111B ; 1024 bytes/sector -> modulo 8 (0..7)
  277                   	
  278         0000      XLT0	EQU	0	; NO XLATE TABLE
  279                   
