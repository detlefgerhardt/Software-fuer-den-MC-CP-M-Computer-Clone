  766 E4B5  69          	LD L,C		; sector in C
  767 E4B6  79                  LD A,C
  768 E4B7  32 E835             LD (IOS),A	; save in IOS
  769 E4BA  26 00               LD H,0
  770 E4BC  C9                  RET
  771                   
