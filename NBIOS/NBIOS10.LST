  224                   	; Disk 0 (A) ---------------------------------------------------------
  225                   
  226                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  227                   	; 0 = NUMMER DES LAUFWERKS
  228                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  229                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  230                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  231                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  232                   	; 2048 = GROESSE EINES BLOCKS
  233                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  234                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
