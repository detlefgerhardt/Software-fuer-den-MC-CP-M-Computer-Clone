 1344 E58F  5F          	LD E,A		; save in E
 1345                   
 1346                   	; drive A,B,C,D -> 0001,0010,0100,1000
 1347 E590  3A E825     	LD A,(DBANK)	; 0..3
 1348 E593  3C          	INC A		; -> 1..4
 1349 E594  47          	LD B,A
 1350 E595  AF          	XOR A
 1351 E596  37          	SCF		; shift in carry
 1352 E597  17          MINIC6:	RLA
