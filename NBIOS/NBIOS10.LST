  363                   	; Disk 0 (A) ---------------------------------------------------------
  364                   	
  365                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  366                   	; 0 = NUMMER DES LAUFWERKS
  367                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  368                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  369                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  370                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  371                   	; 2048 = GROESSE EINES BLOCKS
  372                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  373                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  374                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NBIOS10 Z80

  375                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  376                   
  377                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  378                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  379         E2B3      DPB0	EQU	$	; DISK PARM BLOCK
  380 E2B3  0028        	DW	40	; SEC PER TRACK
  381 E2B5  04          	DB	4	; BLOCK SHIFT
  382 E2B6  0F          	DB	15	; BLOCK MASK
  383 E2B7  00          	DB	0	; EXTNT MASK
  384 E2B8  0184        	DW	388	; DISK SIZE-1
  385 E2BA  00FF        	DW	255	; DIRECTORY MAX
  386 E2BC  F0          	DB	240	; ALLOC0
  387 E2BD  00          	DB	0	; ALLOC1
  388 E2BE  0040        	DW	64	; CHECK SIZE
  389 E2C0  0004        	DW	4	; OFFSET
  390                   	; new parameters:
  391 E2C2  20          	DB	00100000B ; Mini/DD
  392 E2C3  03          	DB 	3	  ; 40 / 5 Tracks = 8 -> 2^3
  393 E2C4  07          	DB	00000111B ; 1024 bytes/sector -> modulo 0..7
  394                   	
  395         0000      XLT0	EQU	0	; NO XLATE TABLE
  396                   
  397         FFFF      	IF NOT DG_BHD
  398                   
  399                   	; Disk 1 (B), same as Disk A -----------------------------------------
  400                   	; DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
  401         E2B3      DPB1	EQU	DPB0	; EQUIVALENT PARAMETERS
  402                   ;ALS1	EQU	ALS0	; SAME ALLOCATION VECTOR SIZE
  403                   ;CSS1	EQU	CSS0	; SAME CHECKSUM VECTOR SIZE
  404         0000      XLT1	EQU	XLT0	; SAME TRANSLATE TABLE
  405                   
  406                   	ELSE
  450                   	ENDIF
  451                   
  452         0000      	IF NOT DG_CHD
  462                   	ELSE
  463                   
  464                   	; Disk 2 (C): PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
  465         E2C5       DPB2	EQU	$	; DISK PARM BLOCK
  466 E2C5  0048         	DW	72	; SEC PER TRACK
  467 E2C7  05           	DB	5	; BLOCK SHIFT
  468 E2C8  1F           	DB	31	; BLOCK MASK
  469 E2C9  01           	DB	1	; EXTNT MASK
  470 E2CA  0162         	DW	354	; DISK SIZE-1
  471 E2CC  00FF          	DW	255	; DIRECTORY MAX
  472 E2CE  C0           	DB	192	; ALLOC0
  473 E2CF  00           	DB	0	; ALLOC1
  474 E2D0  0040         	DW	64	; CHECK SIZE
  475 E2D2  0002         	DW	2	; OFFSET
  476                   	; new parameters:
  477 E2D4  00           	DB	00000000B ; Maxi/HD
  478 E2D5  02          	DB 	2	  ; 72 / 9 = 8 -> 2^3
  479 E2D6  03          	DB	00000011B ; 512 bytes/sector -> modulo 0..3
  480                   	
  481         0000       XLT2	EQU	0	; NO XLATE TABLE
  482                   	
  483                   	ENDIF
  484                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   6
