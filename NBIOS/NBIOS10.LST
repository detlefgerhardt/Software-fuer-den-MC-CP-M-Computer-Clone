  130                   
  131         0000      	IF NOT DG01
  271                   	ELSE	; ------------------------------------------------------------
  272                   
  273                   	; size of mini disks A, B, C
  274                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  275                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  276         0185      SIZEAB	EQU 389
  277                   
  278                   	;DISKS 8		; define 8 drives (A..H)
  279         0008      NDISKS	EQU	8	
  280                   
