 1179                   
 1180                   ; drive number (0..n-1) -> C, Bit 0..3
 1181                   ; side -> (0..n-1) -> C, Bit 7
 1182                   
 1183                   ; calculates physical sector from logical sector, IOS -> E
 1184                   ; logical sector 0..39 -> physical sector 1..5
 1185                   
 1186                   ; calculates logical track from physical track, IOT -> D
 1187                   ; 0..159 -> 0..79 (max 127)
 1188                   
 1189 E55B              MINCAL:
 1190                   
 1191         0000      	IF NOT DG01	; ----------
 1230                   	ELSE	; ----------
