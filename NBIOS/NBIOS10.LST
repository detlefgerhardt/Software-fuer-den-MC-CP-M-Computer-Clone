  846                   	; Calculate address for ram disk, source in HL
  847                   	; SEKTOR 0..E,  TRAck 0..5fh
  848                   	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
  849 E4F0  3A E834     ADRERZ:	LD A,(IOT)		; Track holen
  850 E4F3  0F           	RRCA 			; und umrechnen
  851 E4F4  E6 0F        	AND 0FH			; unterer Teil vom MSB
  852 E4F6  67           	LD H,A
