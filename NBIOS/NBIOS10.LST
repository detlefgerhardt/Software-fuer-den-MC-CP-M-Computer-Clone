 1399                   ; Calculates the pointer into PHSBUF based on sector number in IOS
 1400                   ; (PHSBUF + offset) -> DE
 1401                   ; (IOD) -> HL
 1402                   ; 128 -> BC (logical sector length)
 1403                   
 1404         FFFF      	IF DG01
 1405                   
 1406                   ; mask for modulo (n = IOS mod mask)
 1407 E60A  07          MSKTB:	DB 00000111B	; drive a: phys. sector = 1024, modulo 0..7
 1408 E60B  07          	DB 00000111B	; drive b: phys. sector = 1024, modulo 0..7
 1409 E60C  07          	DB 00000111B	; drive c: phys. sector = 1024, modulo 0..7
 1410                   	;DB 00000011B	; drive c: phys. sector = 512, modulo 0..3
 1411 E60D  00          	DB 00000000B	; phys. sector = 128, modulo 0
 1412                   
 1413 E60E              CALCPHS:
 1414 E60E  3A E718     	LD A,(DBANK)
 1415 E611  21 E60A     	LD HL,MSKTB
 1416 E614  CD E55E     	CALL LOOKUP
 1417 E617  47          	LD B,A
 1418                   
 1419 E618  3A E71C     	LD A,(IOS)	; logical sector number (0..n-1)
 1420 E61B  A0          	AND B
 1421 E61C  57          	LD D,A		; load to high-byte (mul 256)
 1422 E61D  1E 00       	LD E,0
 1423 E61F  CB 2A       	SRA D		; div/2 by shift right
 1424 E621  CB 1B       	RR E
 1425                   	; now we have (IOS mod SECSIZE) * 128 in DE
 1426 E623  21 FC00     	LD HL,PHSBUF
 1427 E626  19          	ADD HL,DE	; pointer into PHSBUF in DE
 1428 E627  EB          	EX DE,HL
 1429 E628  2A E71D     	LD HL,(IOD)
 1430 E62B  01 0080     	LD BC,128
 1431 E62E  C9          	RET
 1432                   
