 1500                   	;LD E,0
 1501                   	;SRA D		; div/2 by shift right
 1502                   	;RR E
 1503                   	;ADD HL,DE	; HL = source (PHSBUF+offset)
 1504                   	;EX DE,HL	; DE = source
 1505                   	;LD HL,(IOD)	; HL = dest (IOD)
 1506                   	;EX DE,HL	; DE = dest, HL = source
