 1064 E4F4  B4           	OR H
 1065 E4F5  67           	LD H,A			; damit sssstttt ok
 1066 E4F6  3A E828      	LD A,(IOT)
 1067 E4F9  0F           	RRCA			; txxxxxxx
 1068 E4FA  E6 80        	AND 80H
 1069 E4FC  6F           	LD L,A			; t0000000
