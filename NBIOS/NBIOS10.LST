 1468                   ; Calculates the pointer into PHSBUF based on sector number in IOS
 1469                   ; (PHSBUF + offset) -> DE
 1470                   ; (IOD) -> HL
 1471                   ; 128 -> BC (logical sector length)
 1472                   
 1473         FFFF      	IF DG01
 1474                   
 1475                   ; mask for modulo (n = IOS mod mask)
 1476 E630  07          MSKTB:	DB 00000111B	; drive a: phys. sector = 1024, modulo 0..7
 1477 E631  07          	DB 00000111B	; drive b: phys. sector = 1024, modulo 0..7
 1478 E632  07          	DB 00000111B	; drive c: phys. sector = 1024, modulo 0..7
 1479                   	;DB 00000011B	; drive c: phys. sector = 512, modulo 0..3
 1480 E633  00          	DB 00000000B	; phys. sector = 128, modulo 0
 1481                   
 1482 E634              CALCPHS:
 1483 E634  3A E865     	LD A,(DBANK)
 1484 E637  21 E630     	LD HL,MSKTB
 1485 E63A  CD E584     	CALL LOOKUP
 1486 E63D  47          	LD B,A
 1487                   
 1488 E63E  3A E869     	LD A,(IOS)	; logical sector number (0..n-1)
 1489 E641  A0          	AND B
 1490 E642  57          	LD D,A		; load to high-byte (mul 256)
 1491 E643  1E 00       	LD E,0
 1492 E645  CB 2A       	SRA D		; div/2 by shift right
 1493 E647  CB 1B       	RR E
 1494                   	; now we have (IOS mod SECSIZE) * 128 in DE
 1495 E649  21 FC00     	LD HL,PHSBUF
 1496 E64C  19          	ADD HL,DE	; pointer into PHSBUF in DE
