 1745                   
 1746                   ; Read one sector from disk.
 1747                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1748                   ; Disk number in 'diskno' (4..7)
 1749                   ; Track number in 'track' (0..255)
 1750                   ; Sector number in 'sector' (0..63)
 1751                   ; DMA address in 'dmaad' (0-65535)
 1752                   ; 
 1753                   ; LBA
 1754                   ; 00000000 00000000 00000000
 1755                   ; 00000000 tttttttt ssssssdd
 1756                   ;        E        B        C
 1757                   
 1758         FC00      HSTBUF	EQU PHSBUF	; buffer for phyiscal sector
 1759         E825      DISKNO	EQU DBANK
 1760         E828      TRACK	EQU IOT
 1761         E829      SECTOR	EQU IOS
 1762         E82A      DMAAD	EQU IOD
 1763                   
 1764         F02A      MIDERD	EQU 0F02Ah
 1765         F02D      MIDEWR	EQU 0F02Dh
 1766                   
