  360                   	; Disk 0 (A) ---------------------------------------------------------
  361                   	
  362                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  363                   	; 0 = NUMMER DES LAUFWERKS
  364                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  365                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  366                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  367                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  368                   	; 2048 = GROESSE EINES BLOCKS
  369                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  370                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NBIOS10 Z80

  371                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  372                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  373                   
  374                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  375                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  376         E2B3      DPB0	EQU	$	; DISK PARM BLOCK
  377 E2B3  0028        	DW	40	; SEC PER TRACK
  378 E2B5  04          	DB	4	; BLOCK SHIFT
  379 E2B6  0F          	DB	15	; BLOCK MASK
  380 E2B7  00          	DB	0	; EXTNT MASK
  381 E2B8  0184        	DW	388	; DISK SIZE-1
  382 E2BA  00FF        	DW	255	; DIRECTORY MAX
  383 E2BC  F0          	DB	240	; ALLOC0
  384 E2BD  00          	DB	0	; ALLOC1
  385 E2BE  0040        	DW	64	; CHECK SIZE
  386 E2C0  0004        	DW	4	; OFFSET
  387                   	; new parameters:
  388 E2C2  20          	DB	00100000B ; Mini/DD
  389 E2C3  03          	DB 	3	  ; 40 / 5 Tracks = 8 -> 2^3
  390 E2C4  07          	DB	00000111B ; 1024 bytes/sector -> modulo 0..7
  391                   	
  392         0000      XLT0	EQU	0	; NO XLATE TABLE
  393                   
  394         FFFF      	IF NOT DG_BHD
  395                   
  396                   	; Disk 1 (B), same as Disk A -----------------------------------------
  397                   	; DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
  398         E2B3      DPB1	EQU	DPB0	; EQUIVALENT PARAMETERS
  399         0000      XLT1	EQU	XLT0	; SAME TRANSLATE TABLE
  400                   
  401                   	ELSE
  445                   	ENDIF
  446                   
  447         0000      	IF NOT DG_CHD
  455                   	ELSE
  456                   
  457                   	; Disk 2 (C): PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
  458         E2C5       DPB2	EQU	$	; DISK PARM BLOCK
  459 E2C5  0048         	DW	72	; SEC PER TRACK
  460 E2C7  05           	DB	5	; BLOCK SHIFT
  461 E2C8  1F           	DB	31	; BLOCK MASK
  462 E2C9  01           	DB	1	; EXTNT MASK
  463 E2CA  0162         	DW	354	; DISK SIZE-1
  464 E2CC  00FF          	DW	255	; DIRECTORY MAX
  465 E2CE  C0           	DB	192	; ALLOC0
  466 E2CF  00           	DB	0	; ALLOC1
  467 E2D0  0040         	DW	64	; CHECK SIZE
  468 E2D2  0002         	DW	2	; OFFSET
  469                   	; new parameters:
  470 E2D4  00           	DB	00000000B ; Maxi/HD
  471 E2D5  02          	DB 	2	  ; 72 / 9 = 8 -> 2^3
  472 E2D6  03          	DB	00000011B ; 512 bytes/sector -> modulo 0..3
  473                   	
  474         0000       XLT2	EQU	0	; NO XLATE TABLE
  475                   	
  476                   	ENDIF
  477                   
  478                   
