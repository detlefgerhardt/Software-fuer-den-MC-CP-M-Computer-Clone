  921 E4BC  FE 03       	CP 3
  922 E4BE  DA E5BA     	JP C,MINIRD	; A < 3 -> drive 0,1,2 (Mini disks)
  923                   	
  924 E4C1  FE 04       	CP 4
  925 E4C3  DA E50F     	JP C,MAXIRD	; A < 4 -> drive 3 (Maxi disks)
  926                   	
  927                   	ENDIF
  928                   
  929                   	;---------------------------------------------------------------------
  930                   	; A >= 5, Read RAM disk
  931                   
  932         0000      	IF NOT DG01
  943                   	ELSE
  944                   	
  945 E4C6  FE 08       	CP 8
  946 E4C8  DA E6C6     	JP C,IDERD	; A < 8 -> IDE disks 4,5,6,7
  947                   	
  948                   	ENDIF
