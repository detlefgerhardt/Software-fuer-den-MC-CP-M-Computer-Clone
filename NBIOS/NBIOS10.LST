 1554                   ; Addresses of IDE-80 CF-Adapter card
 1555                   
 1556         0018      IDEDATA	EQU 018h	; IDE Data Register
 1557         001A      SECCND	EQU 01Ah	; Sector Count Register
 1558         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1559         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1560         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
