  134                   
  135         0000      	IF NOT DG01
  275                   	ELSE	; ------------------------------------------------------------
  276                   
  277                   	; size of mini disks A, B, C
  278                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  279                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  280         0185      SIZEAB	EQU 389
  281                   
  282                   	;DISKS 8		; define 8 drives (A..H)
  283         0008      NDISKS	EQU	8	
  284                   
  285         E236      DPBASE	EQU	$		;BASE OF DISK PARAMETER BLOCKS
