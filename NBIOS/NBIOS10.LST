  329 E2B2  EBB3  EB33  	DW	CSV7, ALV7
  330                   
  331                   	; Disk 0 (A) ---------------------------------------------------------
  332                   	
  333                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  334                   	; 0 = NUMMER DES LAUFWERKS
  335                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  336                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  337                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  338                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  339                   	; 2048 = GROESSE EINES BLOCKS
  340                   	; SIZEAB = ZAHL DER MAX. MOEGLICHEN BLOECKE
  341                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  342                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  343                   	; OFFSAB = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  344                   
  345                   	; physical format: 3,5 inch/5.25 inch, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  346                   	; DISKDEF 0,0,39,0,2048,SIZEAB,256,256,OFFSAB
  347         E2B6      DPB0	EQU	$	; DISK PARM BLOCK
  348 E2B6  0028        	DW	40	; SEC PER TRACK
  349 E2B8  04          	DB	4	; BLOCK SHIFT
  350 E2B9  0F          	DB	15	; BLOCK MASK
  351 E2BA  00          	DB	0	; EXTNT MASK
  352 E2BB  0184        	DW	388	; DISK SIZE-1
  353 E2BD  00FF        	DW	255	; DIRECTORY MAX
  354 E2BF  F0          	DB	240	; ALLOC0
  355 E2C0  00          	DB	0	; ALLOC1
  356 E2C1  0040        	DW	64	; CHECK SIZE
  357 E2C3  0004        	DW	4	; OFFSET
  358         0000      XLT0	EQU	0	; NO XLATE TABLE
  359                   
  360                   	; Disk 1 (B), same as Disk A -----------------------------------------
  361                   
  362                   	; DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
  363         E2B6      DPB1	EQU	DPB0	; EQUIVALENT PARAMETERS
  364                   ;ALS1	EQU	ALS0	; SAME ALLOCATION VECTOR SIZE
  365                   ;CSS1	EQU	CSS0	; SAME CHECKSUM VECTOR SIZE
  366         0000      XLT1	EQU	XLT0	; SAME TRANSLATE TABLE
  367                   
  368                   	; Disk 2 (C), same as Disk A -----------------------------------------
  369                   
  370         0000      	IF NOT DG_CHD
  378                   	ELSE
  379                   
  380                   	; PHYSICAL FORMAT: 1,44 MB, HD, DS, 1024 BYTES/SECTOR, 9 SECTORS/TRACK, 80 TRACKS
  381                   	; DISKDEF 0, 1, 72, 0, 4096, 341, 255, 0, 2
  382         E2C5       DPB2	EQU	$	; DISK PARM BLOCK
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NBIOS10 Z80

  383 E2C5  0048         	DW	72	; SEC PER TRACK
  384 E2C7  05           	DB	5	; BLOCK SHIFT
  385 E2C8  1F           	DB	31	; BLOCK MASK
  386 E2C9  01           	DB	1	; EXTNT MASK
  387 E2CA  0162         	DW	354	; DISK SIZE-1
  388 E2CC  00FF          	DW	255	; DIRECTORY MAX
  389 E2CE  C0           	DB	192	; ALLOC0
  390 E2CF  00           	DB	0	; ALLOC1
  391 E2D0  0040         	DW	64	; CHECK SIZE
  392 E2D2  0002         	DW	2	; OFFSET
  393         0000       XLT2	EQU	0	; NO XLATE TABLE
  394                   	
  395                   	ENDIF
  396                   
  397                   
  398                   	; Disk 3 (D) --------------------------------------------------------
  399                   	; physical format: 8 inch, SD, SS, 128 bytes/sector, 26 sectors/track, 77 tracks
  400                   	; DISKDEF 3,1,26,6,1024,243,64,64,2 ; 8 ZOLL DEFINITION
  401                   
  402         E2D4      DPB3	EQU	$	; DISK PARM BLOCK
  403 E2D4  001A         	DW	26	; SEC PER TRACK
  404 E2D6  03           	DB	3	; BLOCK SHIFT
  405 E2D7  07           	DB	7	; BLOCK MASK
  406 E2D8  00           	DB	0	; EXTNT MASK
  407 E2D9  00F2         	DW	242	; DISK SIZE-1
  408 E2DB  003F         	DW	63	; DIRECTORY MAX
  409 E2DD  C0           	DB	192	; ALLOC0
  410 E2DE  00           	DB	0	; ALLOC1
  411 E2DF  0010         	DW	16	; CHECK SIZE
  412 E2E1  0002         	DW	2	; OFFSET
  413                   	
  414         E2E3      XLT3	EQU	$	; TRANSLATE TABLE
  415 E2E3  01           	DB	1		
  416 E2E4  07           	DB	7		
  417 E2E5  0D           	DB	13		
  418 E2E6  13           	DB	19		
  419 E2E7  19           	DB	25		
  420 E2E8  05           	DB	5		
  421 E2E9  0B           	DB	11		
  422 E2EA  11           	DB	17		
  423 E2EB  17           	DB	23		
  424 E2EC  03           	DB	3		
  425 E2ED  09           	DB	9		
  426 E2EE  0F           	DB	15		
  427 E2EF  15           	DB	21		
  428 E2F0  02           	DB	2		
  429 E2F1  08           	DB	8		
  430 E2F2  0E           	DB	14		
  431 E2F3  14           	DB	20		
  432 E2F4  1A            	DB	26		
  433 E2F5  06           	DB	6		
  434 E2F6  0C           	DB	12		
  435 E2F7  12           	DB	18		
  436 E2F8  18           	DB	24		
  437 E2F9  04           	DB	4		
  438 E2FA  0A           	DB	10		
  439 E2FB  10           	DB	16		
  440 E2FC  16           	DB	22	
