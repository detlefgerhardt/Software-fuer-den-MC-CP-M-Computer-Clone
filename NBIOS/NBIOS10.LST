 1239                   	; logical sector to physical sector
 1240                   
 1241                   	; get drive specific factor
 1242 E563  3A E762     	LD A,(DBANK)
 1243 E566  E6 03       	AND 00000011B	; max 4 drives here
 1244 E568  21 E5A3     	LD HL,POWTB
