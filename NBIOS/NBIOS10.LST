  491         F012      CONST	EQU 0F012H
  492                   
  493                   ;-----------------------------------------------------------------------------
  494                   ; read one char from CONSOLE and clears parity bit
  495                   
  496 E382  CD F003     CONIN:	CALL 0F003H
  497 E385  E6 7F       	AND 7FH
  498                   
  499         FFFF      	IF DEBOUT
  500                   
  501 E387  FE 01       	CP A,1
  502 E389  C0          	RET NZ
  503                   
  504                   	; toggle debug
  505 E38A  47          	LD B,A
  506 E38B  3A E882     	LD A,(DEBACT)
  507 E38E  EE 01       	XOR A,01H
  508 E390  32 E882     	LD (DEBACT),A
  509 E393  78          	LD A,B
  510                   
  511                   	ENDIF
  512                   	
  513 E394  C9          	RET
  514                   
  515                   ;-----------------------------------------------------------------------------
  516                   ; read one char from READER device -> A
  517                   
  518         F006      READER	EQU 0F006H
  519                   
  520                   ;-----------------------------------------------------------------------------
  521                   ; write one char to CONSOLE (C)
  522                   
