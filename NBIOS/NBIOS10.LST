 1462                   ; Calculates the pointer into PHSBUF based on sector number in IOS
 1463                   ; (PHSBUF + offset) -> DE
 1464                   ; (IOD) -> HL
 1465                   ; 128 -> BC (logical sector length)
 1466                   
 1467         FFFF      	IF DG01
 1468                   
 1469                   ; mask for modulo (n = IOS mod mask)
 1470 E62A  07          MSKTB:	DB 00000111B	; drive a: phys. sector = 1024, modulo 0..7
 1471 E62B  07          	DB 00000111B	; drive b: phys. sector = 1024, modulo 0..7
 1472 E62C  07          	DB 00000111B	; drive c: phys. sector = 1024, modulo 0..7
 1473                   	;DB 00000011B	; drive c: phys. sector = 512, modulo 0..3
 1474 E62D  00          	DB 00000000B	; phys. sector = 128, modulo 0
 1475                   
 1476 E62E              CALCPHS:
 1477 E62E  3A E82A     	LD A,(DBANK)
 1478 E631  21 E62A     	LD HL,MSKTB
 1479 E634  CD E57C     	CALL LOOKUP
 1480 E637  47          	LD B,A
 1481                   
 1482 E638  3A E82E     	LD A,(IOS)	; logical sector number (0..n-1)
 1483 E63B  A0          	AND B
 1484 E63C  57          	LD D,A		; load to high-byte (mul 256)
 1485 E63D  1E 00       	LD E,0
 1486 E63F  CB 2A       	SRA D		; div/2 by shift right
 1487 E641  CB 1B       	RR E
 1488                   	; now we have (IOS mod SECSIZE) * 128 in DE
 1489 E643  21 FC00     	LD HL,PHSBUF
 1490 E646  19          	ADD HL,DE	; pointer into PHSBUF in DE
 1491 E647  EB          	EX DE,HL
 1492 E648  2A E82F     	LD HL,(IOD)
 1493 E64B  01 0080     	LD BC,128
 1494 E64E  C9          	RET
