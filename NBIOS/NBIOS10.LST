  534                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  535 E303              DPB4:	;disk parameter block for all disks.
  536         0000      	IF FALSE
  548                   	ELSE
  549                   	; Disk size 2 MB, 128 Byte/Sector, 64 sectors, 256 tracks (0 to 255)
  550 E303  0040        	DW	64	; sectors per track
  551 E305  05          	DB	5	; block shift factor
  552 E306  1F          	DB	31	; block mask - with block shift, sets block size to 1024
  553 E307  01          	DB	1	; null mask
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   7
NBIOS10 Z80

  554 E308  01FD        	DW	509	; disk size-1 = number of blocks in a disk - 1
  555 E30A  00FF        	DW	255	; directory max = no. directory entries/disk, arbitrary
  556 E30C  C0          	DB	192	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  557 E30D  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  558 E30E  0000        	DW	0	; check size -- no checking, so zero
  559 E310  0001        	DW	1	; track offset -- first track for system
  560                   	ENDIF
