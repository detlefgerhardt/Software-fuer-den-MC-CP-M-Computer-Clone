  486                   	; Disk 3 (D) --------------------------------------------------------
  487                   	; physical format: 8 inch, SD, SS, 128 bytes/sector, 26 sectors/track, 77 tracks
  488                   	; DISKDEF 3,1,26,6,1024,243,64,64,2 ; 8 ZOLL DEFINITION
  489                   
  490         E2D7      DPB3	EQU	$	; DISK PARM BLOCK
  491 E2D7  001A         	DW	26	; SEC PER TRACK
  492 E2D9  03           	DB	3	; BLOCK SHIFT
  493 E2DA  07           	DB	7	; BLOCK MASK
  494 E2DB  00           	DB	0	; EXTNT MASK
  495 E2DC  00F2         	DW	242	; DISK SIZE-1
  496 E2DE  003F         	DW	63	; DIRECTORY MAX
  497 E2E0  C0           	DB	192	; ALLOC0
  498 E2E1  00           	DB	0	; ALLOC1
  499 E2E2  0010         	DW	16	; CHECK SIZE
  500 E2E4  0002         	DW	2	; OFFSET
  501                   	; new parameters:
  502 E2E6  10          	DB	00010000B ; Maxi/SD
  503 E2E7  00          	DB	0	; no deblocking
  504 E2E8  00          	DB	0	; no deblocking
  505                   	
  506         E2E9      XLT3	EQU	$	; TRANSLATE TABLE
  507 E2E9  01           	DB	1		
