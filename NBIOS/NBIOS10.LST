  382                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  383 E303              DPB4:	;disk parameter block for all disks.
  384         0000      	IF FALSE
  396                   	ELSE
  397                   	; Disk size 2 MB, 128 Byte/Sector, 64 sectors, 256 tracks (0 to 255), Blocksize 4096
  398                   	; DISKDEF 0,1,64,0,4096,510,256,0,1
  399 E303  0040        	DW	64	; sectors per track
  400 E305  05          	DB	5	; block shift factor
  401 E306  1F          	DB	31	; block mask - with block shift, sets block size to 1024
  402 E307  01          	DB	1	; null mask
  403 E308  01FD        	DW	509	; disk size-1 = number of blocks in a disk - 1
  404 E30A  00FF        	DW	255	; directory max = no. directory entries/disk, arbitrary
  405 E30C  C0          	DB	192	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  406 E30D  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  407 E30E  0000        	DW	0	; check size -- no checking, so zero
  408 E310  0001        	DW	1	; track offset -- first track for system
  409                   	ENDIF
  410                   
