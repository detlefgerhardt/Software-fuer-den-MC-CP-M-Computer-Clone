 1734                   ; Read one sector from disk.
 1735                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1736                   ; Disk number in 'diskno' (4..7)
 1737                   ; Track number in 'track' (0..255)
 1738                   ; Sector number in 'sector' (0..63)
 1739                   ; DMA address in 'dmaad' (0-65535)
 1740                   ; 
 1741                   ; LBA
 1742                   ; 00000000 00000000 00000000
 1743                   ; 00000000 tttttttt ssssssdd
 1744                   ;        E        B        C
 1745                   
 1746         FC00      HSTBUF	EQU PHSBUF	; buffer for phyiscal sector
 1747         E825      DISKNO	EQU DBANK
 1748         E828      TRACK	EQU IOT
