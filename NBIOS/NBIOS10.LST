 1303                   	;LD E,0
 1304                   	;SRA D		; div/2 by shift right
 1305                   	;RR E
 1306                   	;ADD HL,DE	; HL = source (PHSBUF+offset)
 1307                   	;EX DE,HL	; DE = source
 1308                   	;LD HL,(IOD)	; HL = dest (IOD)
 1309                   	;EX DE,HL	; DE = dest, HL = source
 1310                   	;LD BC,128	; logical sector length
 1311                   	;LDIR		; (DE++) <- (HL++), BC--
 1312                   			; (IOD) <- (PHSBUF+offset), 128 Byte
