  351                   	; Disk 0 (A) ---------------------------------------------------------
  352                   	
  353                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  354                   	; 0 = NUMMER DES LAUFWERKS
  355                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  356                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  357                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  358                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  359                   	; 2048 = GROESSE EINES BLOCKS
  360                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  361                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  362                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  363                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  364                   
  365                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  366                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  367         E2B6      DPB0	EQU	$	; DISK PARM BLOCK
  368 E2B6  0028        	DW	40	; SEC PER TRACK
  369 E2B8  04          	DB	4	; BLOCK SHIFT
  370 E2B9  0F          	DB	15	; BLOCK MASK
  371 E2BA  00          	DB	0	; EXTNT MASK
  372 E2BB  0184        	DW	388	; DISK SIZE-1
  373 E2BD  00FF        	DW	255	; DIRECTORY MAX
  374 E2BF  F0          	DB	240	; ALLOC0
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
