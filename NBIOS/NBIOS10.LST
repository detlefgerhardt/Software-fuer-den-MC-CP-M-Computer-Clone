  215                   	; Disk 0 (A) ---------------------------------------------------------
  216                   	
  217                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  218                   	; 0 = NUMMER DES LAUFWERKS
  219                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  220                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  221                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  222                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  223                   	; 2048 = GROESSE EINES BLOCKS
  224                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  225                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  226                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  227                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  228                   
  229                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  230                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  231         E2B3      DPB0	EQU	$	; DISK PARM BLOCK
  232 E2B3  0028        	DW	40	; SEC PER TRACK
  233 E2B5  04          	DB	4	; BLOCK SHIFT
  234 E2B6  0F          	DB	15	; BLOCK MASK
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NBIOS10 Z80

  235 E2B7  00          	DB	0	; EXTNT MASK
  236 E2B8  0184        	DW	388	; DISK SIZE-1
  237 E2BA  00FF        	DW	255	; DIRECTORY MAX
  238 E2BC  F0          	DB	240	; ALLOC0
  239 E2BD  00          	DB	0	; ALLOC1
  240 E2BE  0040        	DW	64	; CHECK SIZE
  241 E2C0  0004        	DW	4	; OFFSET
  242                   	; new parameters:
  243 E2C2  20          	DB	00100000B ; Mini/DD
  244 E2C3  03          	DB 	3	  ; 40 / 5 Tracks = 8 -> 2^3
  245 E2C4  07          	DB	00000111B ; 1024 bytes/sector -> modulo 0..7
  246                   	
  247         0000      XLT0	EQU	0	; NO XLATE TABLE
  248                   
  249         FFFF      	IF NOT DG_BHD
  250                   
  251                   	; Disk 1 (B), same as Disk A -----------------------------------------
  252                   	; DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
  253         E2B3      DPB1	EQU	DPB0	; EQUIVALENT PARAMETERS
  254         0000      XLT1	EQU	XLT0	; SAME TRANSLATE TABLE
  255                   
  256                   	ELSE
  300                   	ENDIF
  301                   
  302         0000      	IF NOT DG_CHD
  310                   	ELSE
  311                   
  312                   	; Disk 2 (C): PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
  313         E2C5       DPB2	EQU	$	; DISK PARM BLOCK
  314 E2C5  0048         	DW	72	; SEC PER TRACK
  315 E2C7  05           	DB	5	; BLOCK SHIFT
  316 E2C8  1F           	DB	31	; BLOCK MASK
  317 E2C9  01           	DB	1	; EXTNT MASK
  318 E2CA  0162         	DW	354	; DISK SIZE-1
  319 E2CC  00FF          	DW	255	; DIRECTORY MAX
  320 E2CE  C0           	DB	192	; ALLOC0
  321 E2CF  00           	DB	0	; ALLOC1
  322 E2D0  0040         	DW	64	; CHECK SIZE
  323 E2D2  0002         	DW	2	; OFFSET
  324                   	; new parameters:
  325 E2D4  00           	DB	00000000B ; Maxi/HD
  326 E2D5  02          	DB 	2	  ; 72 / 9 = 8 -> 2^3
  327 E2D6  03          	DB	00000011B ; 512 bytes/sector -> modulo 0..3
  328                   	
  329         0000       XLT2	EQU	0	; NO XLATE TABLE
  330                   	
  331                   	ENDIF
  332                   
  333                   
