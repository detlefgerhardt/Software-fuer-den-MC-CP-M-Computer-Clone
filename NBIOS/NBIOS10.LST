  277                   	ELSE	; ------------------------------------------------------------
  278                   
  279                   	; size of mini disks A, B, C
  280                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  281                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  282         0185      SIZEAB	EQU 389
  283                   
  284                   	;DISKS 8		; define 8 drives (A..H)
  285         0008      NDISKS	EQU	8	
  286                   
  287         E236      DPBASE	EQU	$		;BASE OF DISK PARAMETER BLOCKS
