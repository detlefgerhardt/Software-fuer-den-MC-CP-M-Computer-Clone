  867 E50D  07           	RLCA			; 0mmttttt
  868 E50E  07           	RLCA			; Banknummer
  869 E50F  E6 03        	AND 03H			; 000000mm
  870 E511  C6 01       	ADD A,1			; erst ab Bank 1 starten
  871 E513  47           	LD B,A			; da BANK 0=CP/M RAM und TPA
  872 E514  4F           	LD C,A			; ok beide definiert
  873 E515  C9           	RET
