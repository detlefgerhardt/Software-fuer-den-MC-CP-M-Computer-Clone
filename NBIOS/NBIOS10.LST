 1166                   ; Read Mini disk, 80 Spur, DD, DS
 1167                   
 1168                   ;READ und WRITE unter Verwendung von MEXEC
 1169                   ; HL=DMA ADR
 1170                   ; DE=TRACK/SECTOR
 1171                   ; B=0 RSTORE
 1172                   ;   1 READ
 1173                   ;   2 WRITE
 1174                   ; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
 1175                   ;                                          A   C    B    D
 1176                   
 1177         FC00      PHSBUF	EQU 0FC00H	; Memory area of interactive Monitor for logical sector (1K)
 1178                   
 1179                   ;-----------------------------------------------------------------------------
 1180                   ; Calculates physical drive from DBANK and IOT -> C
 1181                   ; only for Mini disks
 1182                   
 1183                   ; DBANK, IOT     C
 1184                   ;  0     F    -> 0
 1185                   ;  1     F    -> 2
 1186                   ;  0     B    -> 1
 1187                   ;  1     B    -> 3
 1188                   
 1189                   ; muss fuer Minidisk C und D erweitert werden
 1190                   
