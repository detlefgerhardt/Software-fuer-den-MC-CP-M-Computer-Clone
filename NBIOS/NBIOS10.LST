  327                   	; Disk 0 (A) ---------------------------------------------------------
  328                   	
  329                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  330                   	; 0 = NUMMER DES LAUFWERKS
  331                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  332                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  333                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  334                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  335                   	; 2048 = GROESSE EINES BLOCKS
  336                   	; SIZEAB = ZAHL DER MAX. MOEGLICHEN BLOECKE
  337                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  338                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  339                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  340                   
  341                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  342                   	; DISKDEF 0,0,39,0,2048,SIZEAB,256,256,4
  343         E2B6      DPB0	EQU	$	; DISK PARM BLOCK
  344 E2B6  0028        	DW	40	; SEC PER TRACK
  345 E2B8  04          	DB	4	; BLOCK SHIFT
  346 E2B9  0F          	DB	15	; BLOCK MASK
  347 E2BA  00          	DB	0	; EXTNT MASK
  348 E2BB  0184        	DW	388	; DISK SIZE-1
  349 E2BD  00FF        	DW	255	; DIRECTORY MAX
  350 E2BF  F0          	DB	240	; ALLOC0
  351 E2C0  00          	DB	0	; ALLOC1
  352 E2C1  0040        	DW	64	; CHECK SIZE
  353 E2C3  0004        	DW	4	; OFFSET
  354         0000      XLT0	EQU	0	; NO XLATE TABLE
  355                   
  356         0000      	IF NOT DG_BHD
  365                   	ELSE
  366                   
  367         0000      	IF FALSE
  382                   	ENDIF
  383                   
  384                   	; Disk 1 (B): PHYSICAL FORMAT: 1.2 MB, HD, DS, 512 BYTES/SECTOR, 4096 Bytes/Block, 15 SECTORS/TRACK, 80 TRACKS
  385         E2C5       DPB1	EQU	$	; DISK PARM BLOCK
  386                    	;DW	56 ; 60	; SEC PER TRACK
  387 E2C5  003C         	DW	60	; SEC PER TRACK
  388 E2C7  05           	DB	5	; BLOCK SHIFT
  389 E2C8  1F           	DB	31	; BLOCK MASK
  390 E2C9  01           	DB	1	; EXTNT MASK
  391                    	;DW	275 ; 295	; DISK SIZE-1
  392 E2CA  0127         	DW	295	; DISK SIZE-1
  393 E2CC  00FF          	DW	255	; DIRECTORY MAX
  394 E2CE  C0           	DB	192	; ALLOC0
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NBIOS10 Z80

  395 E2CF  00           	DB	0	; ALLOC1
  396 E2D0  0040         	DW	64	; CHECK SIZE
  397 E2D2  0002         	DW	2	; OFFSET
  398         0000       XLT1	EQU	0	; NO XLATE TABLE
  399                   
  400                   
  401                   	ENDIF
  402                   
  403         0000      	IF NOT DG_CHD
  413                   	ELSE
  414                   
  415                   	; Disk 2 (C): PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
  416         E2D4       DPB2	EQU	$	; DISK PARM BLOCK
  417 E2D4  0048         	DW	72	; SEC PER TRACK
  418 E2D6  05           	DB	5	; BLOCK SHIFT
  419 E2D7  1F           	DB	31	; BLOCK MASK
  420 E2D8  01           	DB	1	; EXTNT MASK
  421 E2D9  0162         	DW	354	; DISK SIZE-1
  422 E2DB  00FF          	DW	255	; DIRECTORY MAX
  423 E2DD  C0           	DB	192	; ALLOC0
  424 E2DE  00           	DB	0	; ALLOC1
  425 E2DF  0040         	DW	64	; CHECK SIZE
  426 E2E1  0002         	DW	2	; OFFSET
  427         0000       XLT2	EQU	0	; NO XLATE TABLE
  428                   	
  429                   	ENDIF
  430                   
  431                   
  432                   	; Disk 3 (D) --------------------------------------------------------
  433                   	; physical format: 8 inch, SD, SS, 128 bytes/sector, 26 sectors/track, 77 tracks
  434                   	; DISKDEF 3,1,26,6,1024,243,64,64,2 ; 8 ZOLL DEFINITION
  435                   
  436         E2E3      DPB3	EQU	$	; DISK PARM BLOCK
  437 E2E3  001A         	DW	26	; SEC PER TRACK
  438 E2E5  03           	DB	3	; BLOCK SHIFT
  439 E2E6  07           	DB	7	; BLOCK MASK
  440 E2E7  00           	DB	0	; EXTNT MASK
  441 E2E8  00F2         	DW	242	; DISK SIZE-1
  442 E2EA  003F         	DW	63	; DIRECTORY MAX
  443 E2EC  C0           	DB	192	; ALLOC0
  444 E2ED  00           	DB	0	; ALLOC1
  445 E2EE  0010         	DW	16	; CHECK SIZE
  446 E2F0  0002         	DW	2	; OFFSET
  447                   	
  448         E2F2      XLT3	EQU	$	; TRANSLATE TABLE
  449 E2F2  01           	DB	1		
  450 E2F3  07           	DB	7		
  451 E2F4  0D           	DB	13		
  452 E2F5  13           	DB	19		
  453 E2F6  19           	DB	25		
  454 E2F7  05           	DB	5		
  455 E2F8  0B           	DB	11		
  456 E2F9  11           	DB	17		
  457 E2FA  17           	DB	23		
  458 E2FB  03           	DB	3		
  459 E2FC  09           	DB	9		
  460 E2FD  0F           	DB	15		
  461 E2FE  15           	DB	21		
