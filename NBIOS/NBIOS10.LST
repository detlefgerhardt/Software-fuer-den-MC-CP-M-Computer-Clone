  420 E2E5  03           	DB	3	; BLOCK SHIFT
  421 E2E6  07           	DB	7	; BLOCK MASK
  422 E2E7  00           	DB	0	; EXTNT MASK
  423 E2E8  00F2         	DW	242	; DISK SIZE-1
  424 E2EA  003F         	DW	63	; DIRECTORY MAX
  425 E2EC  C0           	DB	192	; ALLOC0
  426 E2ED  00           	DB	0	; ALLOC1
  427 E2EE  0010         	DW	16	; CHECK SIZE
  428 E2F0  0002         	DW	2	; OFFSET
