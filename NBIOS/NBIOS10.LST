  492                   ; CP/M message after cold start
  493                   
  494 E31B              SIGNON:
  495                   
  496         0000      	IF NOT DG01
  505                   	ELSE
  506                   
  507 E31B  1A          	DB 26
  508 E31C  0D 0A 43 50 	DB CR,LF,'CP/M '
  509 E323  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
  510 E326  20 66 6F 72 	DB ' for MC-Computer '
  511 E337  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  512 E339  4B 20 4E 42 	DB 'K NBIOS 260803-02 BOOT='
  513 E350  30          	DB BTDRV+'0'
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   7
