  529 E337  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  530 E339  4B 20 4E 42 	DB 'K NBIOS 260807-01'
  531 E34A  20 42 4F 4F 	DB " BOOT=",BTDRV+'A',CR,LF
