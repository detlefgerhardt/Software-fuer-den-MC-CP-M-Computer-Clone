 1161                   
 1162                   	;---------------------------------------------------------------------
 1163                   	; Calculate address for ram disk, source in HL
 1164                   	; SEKTOR 0..E,  TRAck 0..5fh
 1165                   	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
 1166 E50C  3A E85A     ADRERZ:	LD A,(IOT)		; Track holen
 1167 E50F  0F           	RRCA 			; und umrechnen
 1168 E510  E6 0F        	AND 0FH			; unterer Teil vom MSB
 1169 E512  67           	LD H,A
 1170 E513  3A E85B      	LD A,(IOS)		; dann Sektor dazu
 1171 E516  07           	RLCA
 1172 E517  07           	RLCA
 1173 E518  07           	RLCA
 1174 E519  07           	RLCA
 1175 E51A  E6 F0        	AND 0F0H
 1176 E51C  B4           	OR H
 1177 E51D  67           	LD H,A			; damit sssstttt ok
 1178 E51E  3A E85A      	LD A,(IOT)
 1179 E521  0F           	RRCA			; txxxxxxx
 1180 E522  E6 80        	AND 80H
 1181 E524  6F           	LD L,A			; t0000000
 1182 E525  3A E85A      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
 1183 E528  07           	RLCA			; und dazu msb-Teil des Tracks verwenden
 1184 E529  07           	RLCA			; 0mmttttt
 1185 E52A  07           	RLCA			; Banknummer
 1186 E52B  E6 03        	AND 03H			; 000000mm
 1187 E52D  C6 01       	ADD A,1			; erst ab Bank 1 starten
 1188 E52F  47           	LD B,A			; da BANK 0=CP/M RAM und TPA
 1189 E530  4F           	LD C,A			; ok beide definiert
 1190 E531  C9           	RET
