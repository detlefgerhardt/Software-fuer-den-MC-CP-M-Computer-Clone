 1471                   
 1472                   ; Addresses of IDE-80 CF-Adapter card
 1473                   
 1474         0018      IDEDATA	EQU 018h	; IDE Data Register
 1475         001A      SECCND	EQU 01Ah	; Sector Count Register
 1476         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1477         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1478         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1479         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1480         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1481                   
 1482                   ; IDE/CF physical format: 
 1483                   ; 4 partitions
 1484                   ; 8192 KB bytes/partition 
 1485                   ; 128 bytes/sector
 1486                   ; 256 sectors/track
 1487                   ; 256 tracks
 1488                   ; 128 * 256 * 256 / 1024 = 8192
 1489                   
 1490                   ; old (2048K):
 1491                   ; LBA
 1492                   ; 00000000 00000000 00000000
 1493                   ; 00000000 tttttttt ssssssdd
 1494                   ;        E        B        C
 1495                   
 1496                   ; NEWIDE (8192K):
 1497                   ; LBA
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  25
NBIOS10 Z80

 1498                   ; 00000000 00000000 00000000
 1499                   ; 000000dd tttttttt ssssssss
