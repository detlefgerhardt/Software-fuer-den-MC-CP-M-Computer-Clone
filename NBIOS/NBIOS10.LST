 1076                   ; returns the physical drive parameters for the current drive
 1077                   
 1078                   ; HL = bytes/sector (1..n)
 1079                   ; D  = highest sectors/track (0..n-1)
 1080                   ; C  = highest tracks/side (0..n-1)
 1081                   ; E  = sides (1..n)
 1082                   
 1083 E4C5  2A E862     GETPHY:	LD HL,(PHYBYTS)
