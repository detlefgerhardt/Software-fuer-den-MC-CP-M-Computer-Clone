  293 E24A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  294 E24E  E856  E2C5  	DW	DIRBUF,DPB1	;DIR BUFF,PARM BLOCK
  295 E252  E96C  E947  	DW	CSV1,ALV1	;CHECK, ALLOC VECTORS
  296                   	
