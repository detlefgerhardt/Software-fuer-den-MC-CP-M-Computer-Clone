  500                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  501 E30C              DPB4:	;disk parameter block for all disks.
  502         0000      	IF FALSE
  514                   	ELSE
  515                   	; Disk size 2 MB, 128 Byte/Sector, 64 sectors, 256 tracks (0 to 255)
  516 E30C  0040        	DW	64	; sectors per track
  517 E30E  05          	DB	5	; block shift factor
  518 E30F  1F          	DB	31	; block mask - with block shift, sets block size to 1024
  519 E310  01          	DB	1	; null mask
  520 E311  01FD        	DW	509	; disk size-1 = number of blocks in a disk - 1
  521 E313  00FF        	DW	255	; directory max = no. directory entries/disk, arbitrary
  522 E315  C0          	DB	192	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  523 E316  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  524 E317  0000        	DW	0	; check size -- no checking, so zero
  525 E319  0001        	DW	1	; track offset -- first track for system
  526                   	ENDIF
