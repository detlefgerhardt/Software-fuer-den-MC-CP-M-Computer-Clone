 1676 E69F  CB 27       	SLA A
 1677 E6A1  47          	LD B,A
 1678 E6A2  3A E865     	LD A,(DISKNO)
 1679 E6A5  D6 04       	SUB A,4
 1680 E6A7  B0          	OR B
 1681 E6A8  4F          	LD C,A		; C = sector * 4 + (diskno - 4)
 1682                   	
 1683                   	; LBA8..15 -> B
 1684 E6A9  3A E868     	LD A,(TRACK)
 1685 E6AC  47          	LD B,A
 1686                   	
 1687                   	; LBA16..23) -> E
 1688 E6AD  1E 00       	LD E,0
 1689                   
 1690                   	;LD A,'R'
 1691                   	;CALL DEBIDE	; debug output
 1692 E6AF  CD F02A     	CALL MIDERD
 1693                   	
 1694         0000      	IF FALSE
 1744                   	ENDIF		; FALSE
 1745                   
 1746 E6B2  E6 01       	AND 01H
 1747 E6B4  C0          	RET NZ		; -> exit with error
 1748                   			
