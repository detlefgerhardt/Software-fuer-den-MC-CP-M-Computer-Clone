  343 E2D6  03          	DB	00000011B ; 512 bytes/sector -> modulo 4 (0..3)
  344                   	
  345         0000       XLT2	EQU	0	; NO XLATE TABLE
  346                   	
  347                   	ENDIF	; DG_CHD
  348                   
