Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NBIOS10 Z80

    1                   ;************************************************************************
    2                   ;* NBIOS.Z80								*
    3                   ;*									*
    4                   ;* basiert auf der Version 3.1 1984 Rolf-Dieter Klein 841220            *
    5                   ;* Urspr|ngliche Version fuer 2 Mini und 2 Maxi Laufwerke		*
    6                   ; ***********************************************************************
    7                   ;
    8                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
    9                   ;
   10                   ; 24.06.2026 *dg* Kommentare hinzugefuegt
   11                   ;                 Binaer identisch zur Origial-Version
   12                   ; 06.07.2026 *dg* V1.0 Erste Aenderungen am BIOS. Alte Monnitor-Routinen werden
   13                   ;                 nicht mehr verwendet. Laufwerksumrechnung gedndert.
   14                   ;                 Version getestet.
   15                   ;                 Alle Aenderungen mit bedingter Assemblierung (Flag MINI3)
   16                   ;                 Testweise den Speicherbereich fuer das BIOS auf E200..EFFF
   17                   ;		  geaendert. CP/M startet dann bei CC00 (58K)
   18                   ; 09.07.2026 *dg* V1.0 Erweitert um 4 IDE/CF-Laufwerke - funktioniert nicht
   19                   ;                 System bootet aber Schreiben auf die IDE-Laufwerke schldgt fehl.
   20                   ; 12.07.2026 *dg* Lesen und Schreiben von CF funktioniert
   21                   ; 31.07.2026 *dg* V1.0 Laufwerk C als HD Laufwerk konfiguriert (1.44 MB)
   22                   ;                 funktioniert noch nicht
   23                   
   24                   ;------------------------------------------------------------------------------
   25                   
   26                   	;MACLIB DISKDEF1	; LOAD DEFINTION FOR DISKS
   27                   
   28         0016      CPMVER	EQU 22		; CP/M version
   29         0000      FALSE	EQU 0
   30         FFFF      TRUE	EQU NOT FALSE
   31         FFFF      TEST	EQU TRUE
   32         000D      CR	EQU 0DH		; carriage return
   33         000A      LF	EQU 0AH		; line feed
   34                   
   35                   ;------------------------------------------------------------------------------
   36                   ; Variant switches
   37                   
   38                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 3.1
   39         FFFF      DG01	EQU TRUE
   40         FFFF      MINI3	EQU TRUE	; 3 MINI, 1 MAXI drive
   41         FFFF      DG_CHD	EQU TRUE	; drive C as HD drive (1.44 MB)
   42         0000      DEBOUT	EQU FALSE	; debug outputs
   43                   
   44                   ; aendert die Laufwerksdefinition:
   45                   ; 3 Mini drives
   46                   ; A = Mini drive 0
   47                   ; B = Mini drive 1
   48                   ; C = Mini drive 2
   49                   ; D = Maxi drive 3 Side 0
   50                   ; E = Maxi drive 3 Side 1
   51                   ; F = RAM disk
   52                   
   53                   ; logical drive to boot from
   54         0000      	IF NOT MINI3
   56                   	ELSE
   57                   ;BTDRV	EQU 4		; drive E: (CF)
   58         0000      BTDRV	EQU 0		; drive A:
   59                   	ENDIF
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBIOS10 Z80

   60                   
   61                   ;------------------------------------------------------------------------------
   62                   ; Monitor functions
   63                   
   64         FFFF      	IF DG01
   65                   
   66         F009      MCONOUT	EQU 0F009h	; character in C
   67                   
   68                   	ENDIF
   69                   
   70                   ;------------------------------------------------------------------------------
   71                   
   72                   ;MSIZE 	EQU 60		; Speichergroesse, hier 60K
   73         003A      MSIZE 	EQU 58		; Speichergroesse, hier 58K
   74                   
   75         9800      BIAS	EQU (MSIZE-20)*1024	; min=20K
   76         CC00      CCP	EQU 3400H+BIAS	; start of CCP (CP/M)
   77         D406      BDOS	EQU CCP+806H	; BDOS entry behind serial number (6 bytes)
   78         E200      BIOS	EQU CCP+1600H	; start of BIOS
   79                   
   80         D400      BDOSADR	EQU BDOS - 6
   81                   
   82         CC00      CPMB	EQU CCP		; Start CP/M-Boot
   83                   
   84         1600      CPML	EQU BIOS-CPMB	; Laenge des CP/Ms
   85         002C      NSECTS	EQU CPML/128	; Anzahl der von CP/M belegten Sektoren
   86                   
   87                   
   88         0000      JWARM	EQU 0000H	; JMP to WBOOT
   89         0003      IOBYTE	EQU 0003H	; Address of IOBYTE
   90         0004      CDISK	EQU 0004H	; Address of last used drive and user (low-nibble: current drive, high-nibble: current user)
   91         0005      JBDOS	EQU 0005H	; JMP to BDOS
   92         0038      JRST7	EQU 0038H	; JMP RST7 (7*8)
   93         0080      BUFF	EQU 0080H	; buffer address
   94         0005      RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write
   95                   
   96                   ;-----------------------------------------------------------------------------
   97                   
   98         E200      	ORG BIOS	; regular start of BIOS
   99                   	;ORG BIOS-4000H	; for debugging
  100                   
  101 E200              STARTBIOS:
  102                   
  103 E200  C3 E34E     	JP BOOT		; Cold boot
  104                   
  105                   	; --- start of offical BIOS calls ---
  106                   	
  107 E203  C3 E374     WBOOTE:	JP WBOOT	; Warm boot (CTRL-C)
  108 E206  C3 E345     	JP CONST	; Get CONSOLE status -> A
  109 E209  C3 E348     	JP CONIN	; Input character from CONSOLE -> A
  110 E20C  C3 F009     	JP CONOUT	; Output character to CONSOLE (C)
  111 E20F  C3 F00F     	JP LIST		; Output character to LIST device (C)
  112 E212  C3 F00C     	JP PUNCH	; Output character to PUNCH device (C)
  113 E215  C3 F006     	JP READER	; Input character from READER device -> A
  114                   
  115 E218  C3 E415     	JP HOME		; Select track home position (no execution)
  116 E21B  C3 E41A     	JP SELDSK	; Select drive, drive 0..n-1 in C, returns disk parameter header block in HL
  117 E21E  C3 E430     	JP SETTRK	; Select track for read/write, track in C (logic tracks!!! e.g. 0..159)
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBIOS10 Z80

  118 E221  C3 E435     	JP SETSEC	; Select sector for read/write, sector in C (logic sectors!!! e.g. 0..39)
  119 E224  C3 E453     	JP SETDMA	; Set disk read/write address (no real DMA), address in BC
  120 E227  C3 E466     	JP READ		; Read sector
  121 E22A  C3 E4DC     	JP WRITE	; Write sector
  122 E22D  C3 E412     	JP LISTST	; Listener ready? (not implemented, returns 1 = not ready)
  123 E230  C3 E43A     	JP SECTRAN	; sector translation (skew only)
  124                   	
  125                   	; --- end of offical BIOS calls ---
  126                   	
  127         FFFF      	IF DG01
  128 E233  C3 E511     	JP FLUSH	; BDOS close and write sector buffer to disk
  129                   	ENDIF
  130                   
  131                   ;-----------------------------------------------------------------------------
  132                   
  133         0000      	IF NOT MINI3
  276                   	ELSE	; ------------------------------------------------------------
  277                   
  278                   	; size of mini disks A, B, C
  279                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  280                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  281         0185      SIZEAB	EQU 389
  282                   
  283                   	; track offset for disk A, B, C
  284         0004      OFFSAB	EQU 4
  285                   
  286                   	;DISKS 8		; define 8 drives (A..H)
  287         0008      NDISKS	EQU	8	
  288                   
  289         E236      DPBASE	EQU	$		;BASE OF DISK PARAMETER BLOCKS
  290                   
  291 E236  0000  0000  DPE0:	DW	XLT0,0000H	;TRANSLATE TABLE
  292 E23A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  293 E23E  E71F  E2B6  	DW	DIRBUF,DPB0	;DIR BUFF,PARM BLOCK
  294 E242  E7D0  E79F  	DW	CSV0,ALV0	;CHECK, ALLOC VECTORS
  295                   	
  296 E246  0000  0000  DPE1:	DW	XLT1,0000H	;TRANSLATE TABLE
  297 E24A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  298 E24E  E71F  E2B6  	DW	DIRBUF,DPB1	;DIR BUFF,PARM BLOCK
  299 E252  E841  E810  	DW	CSV1,ALV1	;CHECK, ALLOC VECTORS
  300                   	
  301 E256  0000  0000  DPE2:	DW	XLT2,0000H	;TRANSLATE TABLE
  302 E25A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  303 E25E  E71F  E2C5  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
  304 E262  E941  E881  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
  305                   	
  306 E266  E2E3  0000  DPE3:	DW	XLT3,0000H	;TRANSLATE TABLE
  307 E26A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  308 E26E  E71F  E2D4  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
  309 E272  E9A0  E981  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
  310                   	
  311 E276  0000  0000  DPE4:	DW	0000h, 0000h
  312 E27A  0000  0000  	DW	0000h, 0000h
  313 E27E  E71F  E2FD  	DW	DIRBUF, DPB4
  314 E282  EA30  E9B0  	DW	CSV4, ALV4
  315                   	
  316 E286  0000  0000  DPE5:	DW	0000h, 0000h
  317 E28A  0000  0000  	DW	0000h, 0000h
