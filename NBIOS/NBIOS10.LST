Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NBIOS10 Z80

    1                   ;************************************************************************
    2                   ;* NBIOS10.Z80								*
    3                   ;*									*
    4                   ;* basiert auf der Version 3.1 1984 Rolf-Dieter Klein 841220            *
    5                   ;* Urspr|ngliche Version fuer 2 Mini und 2 Maxi Laufwerke		*
    6                   ; ***********************************************************************
    7                   ;
    8                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
    9                   ;
   10                   ; 24.06.2026 *dg* Kommentare hinzugefuegt
   11                   ;                 Binaer identisch zur Origial-Version
   12                   ; 06.07.2026 *dg* V1.0 Erste Aenderungen am BIOS. Alte Monnitor-Routinen werden
   13                   ;                 nicht mehr verwendet. Laufwerksumrechnung gedndert.
   14                   ;                 Version getestet.
   15                   ;                 Alle Aenderungen mit bedingter Assemblierung (Flag MINI3)
   16                   ;                 Testweise den Speicherbereich fuer das BIOS auf E200..EFFF
   17                   ;		  geaendert. CP/M startet dann bei CC00 (58K)
   18                   ; 09.07.2026 *dg* V1.0 Erweitert um 4 IDE/CF-Laufwerke - funktioniert nicht
   19                   ;                 System bootet aber Schreiben auf die IDE-Laufwerke schldgt fehl.
   20                   ; 12.07.2026 *dg* Lesen und Schreiben von CF funktioniert
   21                   ; 31.07.2026 *dg* V1.0 Laufwerk C als HD Laufwerk konfiguriert (1.44 MB)
   22                   ;                 Probleme immer beim ersten Scheiben nach dem Formatieren
   23                   ; 02.07.2026 *dg* Laufwerk B: als HD Laufwerk (1.2 MB)
   24                   ;		  Funktioniert noch nicht, Format und Laufwerksparameter unklar 
   25                   ; 03.07.2026 *dg* BIOS Debug-Ausgaben per Ctrl-A toggelbar
   26                   
   27                   ;------------------------------------------------------------------------------
   28                   
   29                   	;MACLIB DISKDEF1	; LOAD DEFINTION FOR DISKS
   30                   
   31         0016      CPMVER	EQU 22		; CP/M version
   32         0000      FALSE	EQU 0
   33         FFFF      TRUE	EQU NOT FALSE
   34         FFFF      TEST	EQU TRUE
   35         000D      CR	EQU 0DH		; carriage return
   36         000A      LF	EQU 0AH		; line feed
   37                   
   38                   ;------------------------------------------------------------------------------
   39                   ; Variant switches
   40                   
   41                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 3.1
   42         FFFF      DG01	EQU TRUE
   43         FFFF      MINI3	EQU TRUE	; 3 MINI, 1 MAXI drive
   44         FFFF      DG_BHD	EQU TRUE	; drive B as HD drive (1.2 MB)
   45         FFFF      DG_CHD	EQU TRUE	; drive C as HD drive (1.44 MB)
   46         FFFF      DEBOUT	EQU TRUE	; debug outputs
   47                   
   48                   ; aendert die Laufwerksdefinition:
   49                   ; 3 Mini drives
   50                   ; A = Mini drive 0
   51                   ; B = Mini drive 1
   52                   ; C = Mini drive 2
   53                   ; D = Maxi drive 3 Side 0
   54                   ; E = Maxi drive 3 Side 1
   55                   ; F = RAM disk
   56                   
   57                   ; logical drive to boot from
   58         0000      	IF NOT MINI3
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBIOS10 Z80

   60                   	ELSE
   61                   ;BTDRV	EQU 4		; drive E: (CF)
   62         0000      BTDRV	EQU 0		; drive A:
   63                   	ENDIF
   64                   
   65                   ;------------------------------------------------------------------------------
   66                   ; Monitor functions
   67                   
   68         FFFF      	IF DG01
   69                   
   70         F009      MCONOUT	EQU 0F009h	; character in C
   71                   
   72                   	ENDIF
   73                   
   74                   ;------------------------------------------------------------------------------
   75                   
   76                   ;MSIZE 	EQU 60		; Speichergroesse, hier 60K
   77         003A      MSIZE 	EQU 58		; Speichergroesse, hier 58K
   78                   
   79         9800      BIAS	EQU (MSIZE-20)*1024	; min=20K
   80         CC00      CCP	EQU 3400H+BIAS	; start of CCP (CP/M)
   81         D406      BDOS	EQU CCP+806H	; BDOS entry behind serial number (6 bytes)
   82         E200      BIOS	EQU CCP+1600H	; start of BIOS
   83                   
   84         D400      BDOSADR	EQU BDOS - 6
   85                   
   86         CC00      CPMB	EQU CCP		; Start CP/M-Boot
   87                   
   88         1600      CPML	EQU BIOS-CPMB	; Laenge des CP/Ms
   89         002C      NSECTS	EQU CPML/128	; Anzahl der von CP/M belegten Sektoren
   90                   
   91                   
   92         0000      JWARM	EQU 0000H	; JMP to WBOOT
   93         0003      IOBYTE	EQU 0003H	; Address of IOBYTE
   94         0004      CDISK	EQU 0004H	; Address of last used drive and user (low-nibble: current drive, high-nibble: current user)
   95         0005      JBDOS	EQU 0005H	; JMP to BDOS
   96         0038      JRST7	EQU 0038H	; JMP RST7 (7*8)
   97         0080      BUFF	EQU 0080H	; buffer address
   98         0005      RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write
   99                   
  100                   ;-----------------------------------------------------------------------------
  101                   
  102         E200      	ORG BIOS	; regular start of BIOS
  103                   	;ORG BIOS-4000H	; for debugging
  104                   
  105 E200              STARTBIOS:
  106                   
  107 E200  C3 E36A     	JP BOOT		; Cold boot
  108                   
  109                   	; --- start of offical BIOS calls ---
  110                   	
  111 E203  C3 E390     WBOOTE:	JP WBOOT	; Warm boot (CTRL-C)
  112 E206  C3 E354     	JP CONST	; Get CONSOLE status -> A
  113 E209  C3 E357     	JP CONIN	; Input character from CONSOLE -> A
  114 E20C  C3 F009     	JP CONOUT	; Output character to CONSOLE (C)
  115 E20F  C3 F00F     	JP LIST		; Output character to LIST device (C)
  116 E212  C3 F00C     	JP PUNCH	; Output character to PUNCH device (C)
  117 E215  C3 F006     	JP READER	; Input character from READER device -> A
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
