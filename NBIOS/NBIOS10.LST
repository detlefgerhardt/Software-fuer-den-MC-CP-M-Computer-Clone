  298 E25A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  299 E25E  E856  E2D4  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
  300 E262  E9D9  E9AC  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
  301                   	
  302 E266  E2F2  0000  DPE3:	DW	XLT3,0000H	;TRANSLATE TABLE
  303 E26A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  304 E26E  E856  E2E3  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
  305 E272  EA38  EA19  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
