  770 E400  FE 27       	CP BTSECN-1
  771 E402  DA E40F     	JP C,WBOO4
  772                   
  773                   	; next track, Caution! track scheme is hardcoded !!!
  774 E405  3A E828     	LD A,(IOT)	; increment track
  775 E408  3C          	INC A	  	; jedoch im Verfahren 0,2,...
  776 E409  3C          	INC A		; SPUR 0, dann SPUR 2, wegen BOOT.ASM
  777 E40A  32 E828     	LD (IOT),A	; denn 1,3,5 ist die Rueckseite des Laufwerks
  778 E40D  3E FF       	LD A,0FFH	; 0,1,2,3.... will by incremented to 0
  779                   	
  780 E40F  3C          WBOO4:	INC A
