  235                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  236                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  237         E2B3      DPB0	EQU	$	; DISK PARM BLOCK
  238 E2B3  0028        	DW	40	; SEC PER TRACK
  239 E2B5  04          	DB	4	; BLOCK SHIFT
  240 E2B6  0F          	DB	15	; BLOCK MASK
  241 E2B7  00          	DB	0	; EXTNT MASK
  242 E2B8  0184        	DW	388	; DISK SIZE-1
  243 E2BA  00FF        	DW	255	; DIRECTORY MAX
  244 E2BC  F0          	DB	240	; ALLOC0
  245 E2BD  00          	DB	0	; ALLOC1
  246 E2BE  0040        	DW	64	; CHECK SIZE
  247 E2C0  0004        	DW	4	; OFFSET
  248                   	; new parameters:
  249 E2C2  20          	DB	00100000B ; Mini/DD
  250 E2C3  03          	DB 	3	  ; 40 / 5 sectors = 8 -> 2^3
  251 E2C4  07          	DB	00000111B ; 1024 bytes/sector -> modulo 8 (0..7)
  252                   	
  253         0000      XLT0	EQU	0	; NO XLATE TABLE
  254                   
  255         FFFF      	IF NOT DG_BHD
  256                   
  257                   	; Disk 1 (B), same as Disk A -----------------------------------------
  258                   	; DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
  259         E2B3      DPB1	EQU	DPB0	; EQUIVALENT PARAMETERS
  260         0000      XLT1	EQU	XLT0	; SAME TRANSLATE TABLE
  261                   
  262                   	ELSE
  306                   	ENDIF
  307                   
  308         0000      	IF NOT DG_CHD
  316                   	ELSE
  317                   
  318                   	; Disk 2 (C): PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
  319         E2C5       DPB2	EQU	$	; DISK PARM BLOCK
  320 E2C5  0048         	DW	72	; SEC PER TRACK
  321 E2C7  05           	DB	5	; BLOCK SHIFT
  322 E2C8  1F           	DB	31	; BLOCK MASK
  323 E2C9  01           	DB	1	; EXTNT MASK
  324 E2CA  0162         	DW	354	; DISK SIZE-1
  325 E2CC  00FF          	DW	255	; DIRECTORY MAX
  326 E2CE  C0           	DB	192	; ALLOC0
  327 E2CF  00           	DB	0	; ALLOC1
  328 E2D0  0040         	DW	64	; CHECK SIZE
  329 E2D2  0002         	DW	2	; OFFSET
  330                   	; new parameters:
  331 E2D4  00           	DB	00000000B ; Maxi/HD
  332 E2D5  03          	DB 	3	  ; 72 / 9 = 8 -> 2^3
  333 E2D6  03          	DB	00000011B ; 512 bytes/sector -> modulo 4 (0..3)
  334                   	
  335         0000       XLT2	EQU	0	; NO XLATE TABLE
  336                   	
  337                   	ENDIF
  338                   
  339                   
