  527                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  528 E303              DPB4:	;disk parameter block for all disks.
  529         0000      	IF FALSE
  541                   	ELSE
  542                   	; Disk size 2 MB, 128 Byte/Sector, 64 sectors, 256 tracks (0 to 255), Blocksize 4096
  543                   	; DISKDEF 0,1,64,0,4096,510,256,0,1
  544 E303  0040        	DW	64	; sectors per track
  545 E305  05          	DB	5	; block shift factor
  546 E306  1F          	DB	31	; block mask - with block shift, sets block size to 1024
  547 E307  01          	DB	1	; null mask
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   7
NBIOS10 Z80

  548 E308  01FD        	DW	509	; disk size-1 = number of blocks in a disk - 1
  549 E30A  00FF        	DW	255	; directory max = no. directory entries/disk, arbitrary
  550 E30C  C0          	DB	192	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  551 E30D  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  552 E30E  0000        	DW	0	; check size -- no checking, so zero
  553 E310  0001        	DW	1	; track offset -- first track for system
  554                   	ENDIF
  555                   
