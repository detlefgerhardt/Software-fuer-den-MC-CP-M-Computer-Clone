  118                   
  119 E218  C3 E431     	JP HOME		; Select track home position (no execution)
  120 E21B  C3 E436     	JP SELDSK	; Select drive, drive 0..n-1 in C, returns disk parameter header block in HL
  121 E21E  C3 E44C     	JP SETTRK	; Select track for read/write, track in C (logic tracks!!! e.g. 0..159)
  122 E221  C3 E451     	JP SETSEC	; Select sector for read/write, sector in C (logic sectors!!! e.g. 0..39)
  123 E224  C3 E46F     	JP SETDMA	; Set disk read/write address (no real DMA), address in BC
  124 E227  C3 E482     	JP READ		; Read sector
  125 E22A  C3 E4F8     	JP WRITE	; Write sector
  126 E22D  C3 E42E     	JP LISTST	; Listener ready? (not implemented, returns 1 = not ready)
  127 E230  C3 E456     	JP SECTRAN	; sector translation (skew only)
  128                   	
  129                   	; --- end of offical BIOS calls ---
  130                   	
  131         FFFF      	IF DG01
  132 E233  C3 E52F     	JP FLUSH	; BDOS close and write sector buffer to disk
  133                   	ENDIF
