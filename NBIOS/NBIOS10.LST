  294 E25A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  295 E25E  E769  E2D4  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
  296 E262  E8EC  E8BF  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
  297                   	
  298 E266  E2F2  0000  DPE3:	DW	XLT3,0000H	;TRANSLATE TABLE
  299 E26A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  300 E26E  E769  E2E3  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
  301 E272  E94B  E92C  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
  302                   	
  303 E276  0000  0000  DPE4:	DW	0000h, 0000h
  304 E27A  0000  0000  	DW	0000h, 0000h
