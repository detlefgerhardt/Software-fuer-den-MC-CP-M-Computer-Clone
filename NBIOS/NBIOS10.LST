  565                   	; pyhs: Disk size 8 MB, 268 Byte/Sector, 128 sectors/track, 256 tracks
  566                   	; BDOS: 256 Bytes/Sector, 256 sectors/track, blocksize 8192
  567                   	; DISKDEF d,1,256,0,8192,1020,256,0,1
