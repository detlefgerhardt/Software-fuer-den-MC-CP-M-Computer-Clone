  217 E257  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  218 E25B  E827  E2B3  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
  219 E25F  E9BA  E989  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
  220                   
