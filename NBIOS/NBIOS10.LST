 1221                   ;  0     B    -> 1
 1222                   ;  1     B    -> 3
 1223                   
 1224                   ; muss fuer Minidisk C und D erweitert werden
 1225                   
 1226                   ; drive number (0..n-1) -> C, Bit 0..3
 1227                   ; side -> (0..n-1) -> C, Bit 7
 1228                   
