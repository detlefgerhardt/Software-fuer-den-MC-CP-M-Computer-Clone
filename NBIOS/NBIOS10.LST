 1029                   	; error
 1030 E4DF  3E 01       	LD A,1		; Fehler da, Bank nicht vorhanden,
 1031 E4E1  C9          	RET		; wirkt wie BAD-Sektor
 1032                   
 1033                   	;---------------------------------------------------------------------
 1034                   	
 1035 E4E2  AF          NOERR:	XOR A		; sonst ok.
 1036 E4E3  C9          	RET
