  581                   ; Cold boot
  582                   
  583 E36A  31 0100     BOOT:	LD SP,BUFF+80H	; set stack
  584                   
  585 E36D  21 E31B     	LD HL,SIGNON	; output start message
  586 E370  CD E475     	CALL PRMSG
  587                   	
  588                   	; clear / set last used drive
  589         0000      	IF NOT MINI3
  591                   	ELSE
  592 E373  3E 00       	LD A,BTDRV
  593                   	ENDIF
  594 E375  32 0004     	LD (CDISK),A
  595                   	
  596                   	; sector buffer is empty, set to physical sector buffer not changed
  597 E378  AF          	XOR A
  598 E379  32 E823     	LD (BUFCHG),A
  599                   	
  600                   	; drive is undefined
  601 E37C  3E FF       	LD A,0FFH
  602 E37E  32 E824     	LD (CURDRV),A
  603                   
  604                   	; disable monitor entries, set to WBOOT
  605 E381  21 E390     	LD HL,WBOOT
  606 E384  22 F034     	LD (MWARM+1),HL
  607 E387  22 F037     	LD (MWRSTR+1),HL
  608                   	
  609         FFFF      	IF DG01
  610                   	;CALL PATF	; patch BDOS close function
  611 E38A  CD E703     	CALL PATA	; patch BDOS active drive
  612                   	;CALL PATB
  613                   	ENDIF
  614                   	
  615 E38D  C3 E3E9     	JP GOCPM	; start CP/M
  616                   
  617                   ;-----------------------------------------------------------------------------
  618                   ; Warm boot
  619                   
  620 E390              WBOOT:	; write physical sector buffer to disk if changed
  621 E390  3A E823     	LD A,(BUFCHG)
  622 E393  B7          	OR A
  623 E394  CA E39A     	JP Z,WBOO1
