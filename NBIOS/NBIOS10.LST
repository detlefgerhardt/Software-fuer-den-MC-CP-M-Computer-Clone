  484                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  485 E30C              DPB4:	;disk parameter block for all disks.
  486         0000      	IF FALSE
  498                   	ELSE
  499                   	; Disk size 2 MB, 128 Byte/Sector, 64 sectors, 256 tracks (0 to 255)
  500 E30C  0040        	DW	64	; sectors per track
  501 E30E  05          	DB	5	; block shift factor
  502 E30F  1F          	DB	31	; block mask - with block shift, sets block size to 1024
  503 E310  01          	DB	1	; null mask
  504 E311  01FD        	DW	509	; disk size-1 = number of blocks in a disk - 1
  505 E313  00FF        	DW	255	; directory max = no. directory entries/disk, arbitrary
  506 E315  C0          	DB	192	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  507 E316  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  508 E317  0000        	DW	0	; check size -- no checking, so zero
  509 E319  0001        	DW	1	; track offset -- first track for system
  510                   	ENDIF
  511                   
  512                   	; Disk 5 (F), IDE partition 1 ----------------------------------------
  513         E30C      DPB5	EQU	DPB4	; EQUIVALENT PARAMETERS
  514                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  515                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  516                   
  517                   	; Disk 6 (G), IDE partition 2 ----------------------------------------
  518         E30C      DPB6	EQU	DPB4	; EQUIVALENT PARAMETERS
  519                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  520                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  521                   
  522                   	; Disk 7 (H), IDE partition 3 ----------------------------------------
  523         E30C      DPB7	EQU	DPB4	; EQUIVALENT PARAMETERS
  524                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  525                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  526                   
  527                   	ENDIF	; DG01
