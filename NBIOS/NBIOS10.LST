  814 E466              READ:
  815         0000      	IF NOT DG01
  824                   	ELSE
  825                   
  826                   	;POP HL
  827                   	;PUSH HL
  828                   	;CALL DEBDRV	; debug output (DBANK)
  829                   
  830 E466  3A E718     	LD A,(DBANK)	; drive 0..5
  831 E469  FE 03       	CP 3
  832 E46B  DA E566     	JP C,MINIRD	; A < 3 -> drive 0,1,2 (Mini disks)
  833                   	
  834 E46E  FE 04       	CP 4
  835 E470  DA E4BC     	JP C,MAXIRD	; A < 4 -> drive 3 (Maxi disks)
  836                   	
  837                   	ENDIF
  838                   
  839                   	;---------------------------------------------------------------------
  840                   	; A >= 5, Read RAM disk
  841                   
  842         0000      	IF NOT DG01
  853                   	ELSE
  854                   	
  855 E473  FE 08       	CP 8
  856 E475  DA E66B     	JP C,IDERD	; A < 8 -> IDE disks 4,5,6,7
  857                   	
  858                   	ENDIF
  859                   	
  860                   	; error
  861 E478  3E 01       	LD A,1		; Fehler da, Bank nicht vorhanden,
  862 E47A  C9          	RET		; wirkt wie BAD-Sektor
  863                   
  864                   	;---------------------------------------------------------------------
  865                   	
  866 E47B  AF          NOERR:	XOR A		; sonst ok.
  867 E47C  C9          	RET
  868                   
  869                   	;---------------------------------------------------------------------
  870                   	; Calculate address for ram disk, source in HL
  871                   	; SEKTOR 0..E,  TRAck 0..5fh
  872                   	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
  873 E47D  3A E71B     ADRERZ:	LD A,(IOT)		; Track holen
