  303 E26A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  304 E26E  E857  E2E3  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
  305 E272  EA39  EA1A  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
