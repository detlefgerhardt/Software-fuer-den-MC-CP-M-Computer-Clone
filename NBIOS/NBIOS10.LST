  231                   	; Disk 0 (A) ---------------------------------------------------------
  232                   
  233                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  234                   	; 0 = NUMMER DES LAUFWERKS
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NBIOS10 Z80

  235                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  236                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  237                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  238                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  239                   	; 2048 = GROESSE EINES BLOCKS
  240                   	; 389 = ZAHL DER MAX. MOEGLICHEN BLOECKE
  241                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  242                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  243                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  244                   
  245                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  246                   	; DISKDEF 0,0,39,0,2048,389,256,256,4
  247         E2B3      DPB0	EQU	$	; DISK PARM BLOCK
  248 E2B3  0028        	DW	40	; SEC PER TRACK
  249 E2B5  04          	DB	4	; BLOCK SHIFT
  250 E2B6  0F          	DB	15	; BLOCK MASK
  251 E2B7  00          	DB	0	; EXTNT MASK
  252 E2B8  0184        	DW	388	; DISK SIZE-1
  253 E2BA  00FF        	DW	255	; DIRECTORY MAX
  254 E2BC  F0          	DB	240	; ALLOC0
  255 E2BD  00          	DB	0	; ALLOC1
  256 E2BE  0040        	DW	64	; CHECK SIZE
  257 E2C0  0004        	DW	4	; OFFSET
  258                   	; new parameters:
  259 E2C2  20          	DB	00100000B ; Mini/DD
  260 E2C3  03          	DB 	3	  ; 40 / 5 sectors = 8 -> 2^3
  261 E2C4  07          	DB	00000111B ; 1024 bytes/sector -> modulo 8 (0..7)
  262                   	
  263         0000      XLT0	EQU	0	; NO XLATE TABLE
  264                   
  265         FFFF      	IF NOT DG_BHD
  266                   
  267                   	; Disk 1 (B), same as Disk A -----------------------------------------
  268                   	; DISKDEF 1,0	; LAUFWERK 1 WIE LAUFWERK 0 DEFINIERT
  269         E2B3      DPB1	EQU	DPB0	; EQUIVALENT PARAMETERS
  270         0000      XLT1	EQU	XLT0	; SAME TRANSLATE TABLE
  271                   
  272                   	ELSE	; DG_BHD
  316                   	ENDIF	; DG_BHD
  317                   
  318         0000      	IF NOT DG_CHD
  326                   	ELSE	; DG_CHD
  327                   
  328                   	; Disk 2 (C): PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
  329         E2C5       DPB2	EQU	$	; DISK PARM BLOCK
  330 E2C5  0048         	DW	72	; SEC PER TRACK
  331 E2C7  05           	DB	5	; BLOCK SHIFT
  332 E2C8  1F           	DB	31	; BLOCK MASK
  333 E2C9  01           	DB	1	; EXTNT MASK
  334 E2CA  0162         	DW	354	; DISK SIZE-1
  335 E2CC  00FF          	DW	255	; DIRECTORY MAX
  336 E2CE  C0           	DB	192	; ALLOC0
  337 E2CF  00           	DB	0	; ALLOC1
  338 E2D0  0040         	DW	64	; CHECK SIZE
  339 E2D2  0002         	DW	2	; OFFSET
  340                   	; new parameters:
  341 E2D4  00           	DB	00000000B ; Maxi/HD
  342 E2D5  03          	DB 	3	  ; 72 / 9 = 8 -> 2^3
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   6
