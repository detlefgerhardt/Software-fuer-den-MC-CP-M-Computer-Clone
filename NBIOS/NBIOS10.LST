  450 E2EA  003F         	DW	63	; DIRECTORY MAX
  451 E2EC  C0           	DB	192	; ALLOC0
  452 E2ED  00           	DB	0	; ALLOC1
  453 E2EE  0010         	DW	16	; CHECK SIZE
  454 E2F0  0002         	DW	2	; OFFSET
