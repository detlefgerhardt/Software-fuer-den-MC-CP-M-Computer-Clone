  985                   ;=============================================================================
  986                   ; Read Mini disk, 80 Spur, DD, DS
  987                   
  988                   ;READ und WRITE unter Verwendung von MEXEC
  989                   ; HL=DMA ADR
  990                   ; DE=TRACK/SECTOR
  991                   ; B=0 RSTORE
  992                   ;   1 READ
  993                   ;   2 WRITE
  994                   ; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
