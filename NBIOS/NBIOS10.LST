  291 E23E  E86D  E2B6  	DW	DIRBUF,DPB0	;DIR BUFF,PARM BLOCK
  292 E242  E91E  E8ED  	DW	CSV0,ALV0	;CHECK, ALLOC VECTORS
  293                   	
  294 E246  0000  0000  DPE1:	DW	XLT1,0000H	;TRANSLATE TABLE
  295 E24A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  296 E24E  E86D  E2C5  	DW	DIRBUF,DPB1	;DIR BUFF,PARM BLOCK
  297 E252  E981  E95E  	DW	CSV1,ALV1	;CHECK, ALLOC VECTORS
  298                   	
  299 E256  0000  0000  DPE2:	DW	XLT2,0000H	;TRANSLATE TABLE
  300 E25A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  301 E25E  E86D  E2D4  	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
  302 E262  EA81  E9C1  	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS
  303                   	
  304 E266  E2F2  0000  DPE3:	DW	XLT3,0000H	;TRANSLATE TABLE
  305 E26A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  306 E26E  E86D  E2E3  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
  307 E272  EAE0  EAC1  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
  308                   	
  309 E276  0000  0000  DPE4:	DW	0000h, 0000h
  310 E27A  0000  0000  	DW	0000h, 0000h
