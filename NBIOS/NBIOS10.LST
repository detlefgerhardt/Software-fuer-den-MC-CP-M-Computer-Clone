 1499                   ; Addresses of IDE-80 CF-Adapter card
 1500                   
 1501         0018      IDEDATA	EQU 018h	; IDE Data Register
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  25
NBIOS10 Z80

 1502         001A      SECCND	EQU 01Ah	; Sector Count Register
 1503         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1504         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1505         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1506         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1507         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1508                   
 1509                   ; IDE/CF physical format: 
 1510                   ; 4 partitions
 1511                   ; 8192 KB bytes/partition 
 1512                   ; 128 bytes/sector
 1513                   ; 256 sectors/track
 1514                   ; 256 tracks
 1515                   ; 128 * 256 * 256 / 1024 = 8192
 1516                   
 1517                   ; old (2048K):
 1518                   ; LBA
 1519                   ; 00000000 00000000 00000000
 1520                   ; 00000000 tttttttt ssssssdd
 1521                   ;        E        B        C
 1522                   
 1523                   ; NEWIDE (8192K):
 1524                   ; LBA
 1525                   ; 00000000 00000000 00000000
 1526                   ; 000000dd tttttttt ssssssss
 1527                   ;        E        B        C
 1528                   
 1529         F02A      MIDERD	EQU 0F02Ah
 1530         F02D      MIDEWR	EQU 0F02Dh
 1531                   
 1532                   ;-----------------------------------------------------------------------------
 1533                   ; Read one 256 byte sector from disk.
 1534                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1535                   ; Disk number in DBANK  (4..7)
 1536                   ; Track number in IOT
 1537                   ; Sector number in IOS
 1538                   ; DMA address in IOD
 1539                   
 1540         0000      	IF NOT NEWIDE
 1590                   	ENDIF		; NEWIDE
 1591                   	
 1592                   ;-----------------------------------------------------------------------------
 1593                   ; Write one 26 byte sector to IDE
 1594                   ; Return a 00h in register A if the operation completes properly, and 0lh if an error occurs during the read or write
 1595                   ; Disk number in DBANK (4..7)
 1596                   ; Track number in IOT (0..n-1)
 1597                   ; Sector number in IOS (0..n-1)
 1598                   ; DMA address in IOD (0-65535)
 1599                   
 1600         0000      	IF NOT NEWIDE
 1637                   	ENDIF		; NEWIDE
