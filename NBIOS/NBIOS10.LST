  602                   	ELSE
  603 E35B  2C 43 3A 31 	DB ",C:1.44MB"
  604                   	ENDIF
  605                   
  606 E364  2C 44 3A 49 	DB ",D:IBM SS/SD,E..H:IDE"
  607                   
  608 E379  0D 0A 00    	DB CR,LF,0
  609                   
  610                   	ENDIF
