  466 E387  47          	LD B,A
  467 E388  3A E82F     	LD A,(DEBACT)
  468 E38B  EE 01       	XOR A,01H
  469 E38D  32 E82F     	LD (DEBACT),A
  470 E390  78          	LD A,B
