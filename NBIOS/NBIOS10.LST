 1547 E65B  07          MSKTB:	DB 00000111B	; drive a: phys. sector = 1024, modulo 0..7
 1548                   	;DB 00000111B	; drive b: phys. sector = 1024, modulo 0..7
 1549 E65C  03          	DB 00000011B	; drive b: phys. sector = 512, modulo 0..3
 1550 E65D  07          	DB 00000111B	; drive c: phys. sector = 1024, modulo 0..7
 1551 E65E  03          	DB 00000011B	; drive c: phys. sector = 512, modulo 0..3
 1552 E65F  00          	DB 00000000B	; phys. sector = 128, modulo 0
