  638 E2E9  06          	DB	6
  639 E2EA  3F          	DB	63
  640 E2EB  03          	DB	3
  641 E2EC  03FB        	DW	1019
  642 E2EE  00FF        	DW	255
  643 E2F0  80          	DB	128
  644 E2F1  00          	DB	0
  645 E2F2  0000        	DW	0
  646 E2F4  0001        	DW	1
  647                   	; blocking/deblocking parameters (not used):
