 1201                   
 1202                   ; DBANK, IOT     C
 1203                   ;  0     F    -> 0
 1204                   ;  1     F    -> 2
 1205                   ;  0     B    -> 1
 1206                   ;  1     B    -> 3
 1207                   
 1208                   ; muss fuer Minidisk C und D erweitert werden
 1209                   
 1210                   ; drive number (0..n-1) -> C, Bit 0..3
 1211                   ; side -> (0..n-1) -> C, Bit 7
 1212                   
 1213                   ; calculates physical sector from logical sector, IOS -> E
 1214                   ; logical sector 0..39 -> physical sector 1..5
 1215                   
 1216                   ; calculates logical track from physical track, IOT -> D
 1217                   ; 0..159 -> 0..79 (max 127)
 1218                   
 1219 E56F              MINCAL:
 1220                   
 1221         0000      	IF NOT DG01	; ----------
 1260                   	ELSE	; ----------
 1261                   
 1262         0000      	IF FALSE
 1269                   	ENDIF
