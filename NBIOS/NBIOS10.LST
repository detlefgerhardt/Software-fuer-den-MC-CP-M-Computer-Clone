  518                   ;-----------------------------------------------------------------------------
  519                   ; get state of CONSOLE (if character is available)
  520                   
  521 E354  C3 F012     CONST:	JP 0F012H
  522                   
  523                   ;-----------------------------------------------------------------------------
  524                   ; read one char from CONSOLE and clears parity bit
  525                   
  526 E357  CD F003     CONIN:	CALL 0F003H
  527 E35A  E6 7F       	AND 7FH
  528                   
  529         FFFF      	IF DEBOUT
  530                   
  531 E35C  FE 01       	CP A,1
  532 E35E  C0          	RET NZ
  533                   
  534                   	; toggle debug
  535 E35F  47          	LD B,A
  536 E360  3A E86C     	LD A,(DEBACT)
  537 E363  EE 01       	XOR A,01H
  538 E365  32 E86C     	LD (DEBACT),A
  539 E368  78          	LD A,B
  540                   
  541                   	ENDIF
  542                   	
  543 E369  C9          	RET
  544                   
  545                   ;-----------------------------------------------------------------------------
  546                   ; read one char from READER device -> A
  547                   
  548         F006      READER	EQU 0F006H
  549                   
  550                   ;-----------------------------------------------------------------------------
  551                   ; write one char to CONSOLE (C)
  552                   
  553         F009      CONOUT	EQU 0F009H
  554                   
  555                   ;-----------------------------------------------------------------------------
  556                   ; write one char to PUNCH device (C)
  557                   
  558         F00C      PUNCH	EQU 0F00CH
  559                   
  560                   ;-----------------------------------------------------------------------------
  561                   ; write one char to LIST device (C)			
  562                   
  563         F00F      LIST	EQU 0F00FH
  564                   
  565                   ;-----------------------------------------------------------------------------
  566                   ; restart Monitor
  567                   
  568         F01E      MSTART	EQU 0F01EH
  569                   
  570                   ;-----------------------------------------------------------------------------
  571                   ; Monitor warm start
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   8
