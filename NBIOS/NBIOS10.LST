 1690                   
 1691                   ; Addresses of IDE-80 CF-Adapter card
 1692                   
 1693         0018      IDEDATA	EQU 018h	; IDE Data Register
 1694         001A      SECCND	EQU 01Ah	; Sector Count Register
 1695         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1696         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1697         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1698         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1699         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1700                   
 1701                   ; IDE/CF physical format: 
 1702                   ; 4 partitions
 1703                   ; 8192 KB bytes/partition 
 1704                   ; 128 bytes/sector
 1705                   ; 256 sectors/track
 1706                   ; 256 tracks
 1707                   ; 128 * 256 * 256 / 1024 = 8192
 1708                   
 1709                   ; old (2048K):
 1710                   ; LBA
 1711                   ; 00000000 00000000 00000000
 1712                   ; 00000000 tttttttt ssssssdd
 1713                   ;        E        B        C
 1714                   
 1715                   ; NEWIDE (8192K):
 1716                   ; LBA
 1717                   ; 00000000 00000000 00000000
 1718                   ; 000000dd tttttttt ssssssss
 1719                   ;        E        B        C
 1720                   
 1721                   ;-----------------------------------------------------------------------------
 1722                   ; Read one 256 byte sector from disk.
 1723                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1724                   ; Disk number in DBANK  (4..7)
 1725                   ; Track number in IOT
 1726                   ; Sector number in IOS
 1727                   ; DMA address in IOD
 1728                   
 1729         0000      	IF NOT NEWIDE
 1779                   	ENDIF		; NEWIDE
 1780                   	
 1781                   ;-----------------------------------------------------------------------------
 1782                   ; Write one 26 byte sector to IDE
 1783                   ; Return a 00h in register A if the operation completes properly, and 0lh if an error occurs during the read or write
 1784                   ; Disk number in DBANK (4..7)
 1785                   ; Track number in IOT (0..n-1)
 1786                   ; Sector number in IOS (0..n-1)
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  26
NBIOS10 Z80

 1787                   ; DMA address in IOD (0-65535)
 1788                   
 1789         0000      	IF NOT NEWIDE
 1826                   	ENDIF		; NEWIDE
