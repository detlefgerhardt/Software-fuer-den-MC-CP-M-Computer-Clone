 1650                   ; Read one sector from disk.
 1651                   ; Return a 00h in A if the operation completes properly, and 01h if an error occurs during the read.
 1652                   ; Disk number in 'diskno' (4..7)
 1653                   ; Track number in 'track' (0..255)
 1654                   ; Sector number in 'sector' (0..63)
 1655                   ; DMA address in 'dmaad' (0-65535)
 1656                   ; 
 1657                   ; LBA
 1658                   ; 00000000 00000000 00000000
 1659                   ; 00000000 tttttttt ssssssdd
 1660                   ;        E        B        C
 1661                   
 1662         FC00      HSTBUF	EQU PHSBUF	; buffer for phyiscal sector
 1663         E865      DISKNO	EQU DBANK
 1664         E868      TRACK	EQU IOT
 1665         E869      SECTOR	EQU IOS
 1666         E86A      DMAAD	EQU IOD
