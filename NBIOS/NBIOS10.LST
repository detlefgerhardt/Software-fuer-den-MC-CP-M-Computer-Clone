  932 E4AE  0F           	RRCA			; txxxxxxx
  933 E4AF  E6 80        	AND 80H
  934 E4B1  6F           	LD L,A		; t0000000
  935 E4B2  3A E82D      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
