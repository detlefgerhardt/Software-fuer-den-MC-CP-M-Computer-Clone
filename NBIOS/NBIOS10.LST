  222 E267  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  223 E26B  E827  E2C5  	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
  224 E26F  EA27  E9FA  	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS
