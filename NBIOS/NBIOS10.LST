  871                   	; Calculate address for ram disk, source in HL
  872                   	; SEKTOR 0..E,  TRAck 0..5fh
  873                   	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
  874 E4F0  3A E87A     ADRERZ:	LD A,(IOT)		; Track holen
  875 E4F3  0F           	RRCA 			; und umrechnen
  876 E4F4  E6 0F        	AND 0FH			; unterer Teil vom MSB
  877 E4F6  67           	LD H,A
  878 E4F7  3A E87B      	LD A,(IOS)		; dann Sektor dazu
  879 E4FA  07           	RLCA
