 1504                   ;-----------------------------------------------------------------------------
 1505                   ; Calculates the pointer into PHSBUF based on sector number in IOS
 1506                   ; (PHSBUF + offset) -> DE
 1507                   ; (IOD) -> HL
 1508                   ; 128 -> BC (logical sector length)
 1509                   
 1510         FFFF      	IF DG01
 1511                   
 1512                   ; mask for modulo (n = IOS mod mask)
 1513 E653  07          MSKTB:	DB 00000111B	; drive a: phys. sector = 1024, modulo 0..7
 1514                   	;DB 00000111B	; drive b: phys. sector = 1024, modulo 0..7
 1515 E654  03          	DB 00000011B	; drive b: phys. sector = 512, modulo 0..3
 1516 E655  07          	DB 00000111B	; drive c: phys. sector = 1024, modulo 0..7
 1517 E656  03          	DB 00000011B	; drive c: phys. sector = 512, modulo 0..3
 1518 E657  00          	DB 00000000B	; phys. sector = 128, modulo 0
 1519                   
 1520 E658              CALCPHS:
 1521 E658  3A E762     	LD A,(DBANK)
 1522 E65B  21 E653     	LD HL,MSKTB
 1523 E65E  CD E5A7     	CALL LOOKUP
 1524 E661  47          	LD B,A
 1525                   
 1526 E662  3A E766     	LD A,(IOS)	; logical sector number (0..n-1)
 1527 E665  A0          	AND B
 1528 E666  57          	LD D,A		; load to high-byte (mul 256)
 1529 E667  1E 00       	LD E,0
 1530 E669  CB 2A       	SRA D		; div/2 by shift right
 1531 E66B  CB 1B       	RR E
 1532                   	; now we have (IOS mod SECSIZE) * 128 in DE
