  472                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  473                   	; 64-sector tracks, numbering starting at zero (sectors 0 to 63)
  474                   	; Block size 2048
  475                   	; Disk size 2 mb, DSM 1023, yields 256 tracks (0 to 255)
  476 E30C              DPB4:	;disk parameter block for all disks.
  477 E30C  0040        	DW	64	; sectors per track
  478 E30E  04          	DB	4	; block shift factor
  479 E30F  0F          	DB	15	; block mask - with block shift, sets block size to 1024
  480 E310  00          	DB	0	; null mask
  481 E311  03FF        	DW	1023	; disk size-1 = number of blocks in a disk - 1
  482 E313  0100        	DW	256	; directory max = no. directory entries/disk, arbitrary
  483 E315  F0          	DB	240	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  484 E316  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  485 E317  0000        	DW	0	; check size -- no checking, so zero
  486 E319  0001        	DW	1	; track offset -- first track for system
  487                   
  488                   	; Disk 5 (F), IDE partition 1 ----------------------------------------
  489         E30C      DPB5	EQU	DPB4	; EQUIVALENT PARAMETERS
  490                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  491                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  492                   
  493                   	; Disk 6 (G), IDE partition 2 ----------------------------------------
  494         E30C      DPB6	EQU	DPB4	; EQUIVALENT PARAMETERS
  495                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  496                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  497                   
  498                   	; Disk 7 (H), IDE partition 3 ----------------------------------------
  499         E30C      DPB7	EQU	DPB4	; EQUIVALENT PARAMETERS
  500                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  501                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  502                   
  503                   	ENDIF	; DG01
  504                   
