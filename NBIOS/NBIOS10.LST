  804                   ; Read and write sector using FEXEC into monitor
  805                   
  806                   ;-----------------------------------------------------------------------------
  807                   ; Read sector
  808                   
  809                   ; Buffer (DMA address) in IOD
  810                   ; Drive in DBANK (0..n-1)
  811                   ; Track in IOT (0..n-1 * side)
  812                   ; Sector in IOS (0..n-1)
