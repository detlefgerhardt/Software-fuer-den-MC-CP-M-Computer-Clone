  595 E312  1A          	DB 26
  596 E313  0D 0A 43 50 	DB CR,LF,'CP/M '
  597 E31A  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
  598 E31D  20 66 6F 72 	DB ' for MC-Computer '
  599 E32E  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  600 E330  4B 20 4E 42 	DB 'K NBIOS 260903-06'
  601 E341  20 42 4F 4F 	DB " BOOT=",BTDRV+'A',CR,LF
  602                   
  603 E34A  41 3A 4E 4B 	DB "A:NKC800"
  604                   
  605         FFFF      	IF NOT DG_BHD
  606 E352  2C 42 3A 4E 	DB ",B:NKC800"
  607                   	ELSE
  610                   	ENDIF
  611                   
