  614                   	ELSE
  615 E35B  2C 43 3A 31 	DB ",C:1.44MB"
  616                   	ENDIF
  617                   
  618 E364  2C 44 3A 49 	DB ",D:IBM SS/SD,E..H:IDE"
  619                   
  620 E379  0D 0A 00    	DB CR,LF,0
  621                   
  622                   	ENDIF
