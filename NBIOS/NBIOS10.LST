 1081         FC00      PHSBUF	EQU 0FC00H	; Memory area of interactive Monitor for logical sector (1K)
 1082                   
 1083                   ;-----------------------------------------------------------------------------
 1084                   ; Calculates physical drive from DBANK and IOT -> C
 1085                   ; only for Mini disks
 1086                   
 1087                   ; DBANK, IOT     C
 1088                   ;  0     F    -> 0
 1089                   ;  1     F    -> 2
 1090                   ;  0     B    -> 1
 1091                   ;  1     B    -> 3
 1092                   
 1093                   ; muss fuer Minidisk C und D erweitert werden
 1094                   
 1095                   ; drive number (0..n-1) -> C, Bit 0..3
 1096                   ; side -> (0..n-1) -> C, Bit 7
 1097                   
 1098                   ; calculates physical sector from logical sector, IOS -> E
 1099                   ; logical sector 0..39 -> physical sector 1..5
 1100                   
 1101                   ; calculates logical track from physical track, IOT -> D
 1102                   ; 0..159 -> 0..79 (max 127)
 1103                   
 1104 E51C              MINCAL:
 1105                   
 1106         0000      	IF NOT DG01	; ----------
 1145                   	ELSE	; ----------
 1146                   
 1147                   	; logical sector to physical sector
 1148                   
 1149                   	; get drive specific factor
 1150 E51C  3A E718     	LD A,(DBANK)
 1151 E51F  E6 03       	AND 00000011B	; max 4 drives here
 1152 E521  21 E55A     	LD HL,POWTB
 1153 E524  CD E55E     	CALL LOOKUP
 1154 E527  5F          	LD E,A
 1155                   	
 1156 E528  3A E71C     	LD A,(IOS)	; logical sector
 1157                   
 1158                   	;LD E,POWTB
