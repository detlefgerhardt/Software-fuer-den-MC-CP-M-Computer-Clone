  329                   	; Disk 0 (A) ---------------------------------------------------------
  330                   	
  331                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  332                   	; 0 = NUMMER DES LAUFWERKS
  333                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  334                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  335                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  336                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  337                   	; 2048 = GROESSE EINES BLOCKS
  338                   	; SIZEAB = ZAHL DER MAX. MOEGLICHEN BLOECKE
  339                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  340                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  341                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  342                   
  343                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  344                   	; DISKDEF 0,0,39,0,2048,SIZEAB,256,256,4
  345         E2B6      DPB0	EQU	$	; DISK PARM BLOCK
  346 E2B6  0028        	DW	40	; SEC PER TRACK
  347 E2B8  04          	DB	4	; BLOCK SHIFT
  348 E2B9  0F          	DB	15	; BLOCK MASK
  349 E2BA  00          	DB	0	; EXTNT MASK
  350 E2BB  0184        	DW	388	; DISK SIZE-1
  351 E2BD  00FF        	DW	255	; DIRECTORY MAX
  352 E2BF  F0          	DB	240	; ALLOC0
  353 E2C0  00          	DB	0	; ALLOC1
  354 E2C1  0040        	DW	64	; CHECK SIZE
  355 E2C3  0004        	DW	4	; OFFSET
  356         0000      XLT0	EQU	0	; NO XLATE TABLE
  357                   
  358         0000      	IF NOT DG_BHD
  367                   	ELSE
  368                   
  369                   	; Disk 1 (B): PHYSICAL FORMAT: 1,2 MB, HD, DS, 1024 BYTES/SECTOR, 7 SECTORS/TRACK, 80 TRACKS
  370         E2C5       DPB1	EQU	$	; DISK PARM BLOCK
  371 E2C5  0038         	DW	56	; SEC PER TRACK
  372 E2C7  05           	DB	5	; BLOCK SHIFT
  373 E2C8  1F           	DB	31	; BLOCK MASK
  374 E2C9  01           	DB	1	; EXTNT MASK
  375 E2CA  0113         	DW	275	; DISK SIZE-1
  376 E2CC  00FF          	DW	255	; DIRECTORY MAX
  377 E2CE  C0           	DB	192	; ALLOC0
  378 E2CF  00           	DB	0	; ALLOC1
  379 E2D0  0040         	DW	64	; CHECK SIZE
  380 E2D2  0002         	DW	2	; OFFSET
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
