  182                   	; size of mini disks A, B, C
  183                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  184                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  185                   
