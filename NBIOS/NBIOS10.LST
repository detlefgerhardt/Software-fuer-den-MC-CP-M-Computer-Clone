  781                   ; skew table in DE (or 0)
  782                   ; write calculated sector to IOS and L
  783                   
  784 E4A4  7A          SECTRAN:LD A,D		; check if skew table != 0
  785 E4A5  B3                  OR E
  786 E4A6  CA E4B5             JP Z,SECTR1	; =0, -> no skew
  787                   
  788                   	; calc sector offset into skew table
  789 E4A9  06 00       	LD B,0
  790 E4AB  EB          	EX DE,HL
  791 E4AC  09          	ADD HL,BC	; sector in C
  792 E4AD  7E          	LD A,(HL)	; load skew value
  793 E4AE  32 E835     	LD (IOS),A	; save in IOS 
  794 E4B1  6F          	LD L,A		; and in L
  795 E4B2  26 00               LD H,0		; was missing *dg* 27.07.2026
  796 E4B4  C9          	RET
  797                   
  798 E4B5              SECTR1:	; no skew, return sector
  799 E4B5  69          	LD L,C		; sector in C
  800 E4B6  79                  LD A,C
  801 E4B7  32 E835             LD (IOS),A	; save in IOS
  802 E4BA  26 00               LD H,0
  803 E4BC  C9                  RET
