  553                   ;-----------------------------------------------------------------------------
  554                   ; get state of CONSOLE (if character is available)
  555                   
  556 E384  C3 F012     CONST:	JP 0F012H
  557                   
  558                   ;-----------------------------------------------------------------------------
  559                   ; read one char from CONSOLE and clears parity bit
  560                   
  561 E387  CD F003     CONIN:	CALL 0F003H
  562 E38A  E6 7F       	AND 7FH
  563                   
  564         FFFF      	IF DG01
  565         FFFF      	IF DEBOUT
  566                   
  567 E38C  FE 01       	CP A,1
  568 E38E  C0          	RET NZ
  569                   
  570                   	; toggle debug
  571 E38F  47          	LD B,A
  572 E390  3A E855     	LD A,(DEBACT)
  573 E393  EE 01       	XOR A,01H
  574 E395  32 E855     	LD (DEBACT),A
  575 E398  78          	LD A,B
  576                   
  577                   	ENDIF
  578                   	ENDIF
  579                   	
  580 E399  C9          	RET
  581                   
