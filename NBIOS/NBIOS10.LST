  546                   ; CP/M message after cold start
  547                   
  548 E31B              SIGNON:
  549                   
  550         0000      	IF NOT DG01
  559                   	ELSE
  560                   
  561 E31B  1A          	DB 26
  562 E31C  0D 0A 43 50 	DB CR,LF,'CP/M '
  563 E323  32 2E 32    	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
  564 E326  20 66 6F 72 	DB ' for MC-Computer '
  565 E337  35 38       	DB MSIZE/10+'0',MSIZE MOD 10+'0'
  566 E339  4B 20 4E 42 	DB 'K NBIOS 260809-02'
  567 E34A  20 42 4F 4F 	DB " BOOT=",BTDRV+'A',CR,LF
  568                   
  569 E353  41 3A 4E 4B 	DB "A:NKC800"
  570                   
