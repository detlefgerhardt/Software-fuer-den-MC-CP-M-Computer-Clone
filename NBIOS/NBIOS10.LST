  600 E399  C9          	RET
  601                   
  602                   ;-----------------------------------------------------------------------------
  603                   ; read one char from READER device -> A
  604                   
  605         F006      READER	EQU 0F006H
  606                   
  607                   ;-----------------------------------------------------------------------------
  608                   ; write one char to CONSOLE (C)
  609                   
  610         F009      CONOUT	EQU 0F009H
  611                   
  612                   ;-----------------------------------------------------------------------------
  613                   ; write one char to PUNCH device (C)
  614                   
  615         F00C      PUNCH	EQU 0F00CH
  616                   
  617                   ;-----------------------------------------------------------------------------
  618                   ; write one char to LIST device (C)			
  619                   
  620         F00F      LIST	EQU 0F00FH
  621                   
  622                   ;-----------------------------------------------------------------------------
  623                   ; restart Monitor
  624                   
  625         F01E      MSTART	EQU 0F01EH
  626                   
  627                   ;-----------------------------------------------------------------------------
  628                   ; Monitor warm start
  629                   
  630         F033      MWARM	EQU 0F033H	; Monitor warm start, will be overwritten by BIOS
  631                   
  632                   ;-----------------------------------------------------------------------------
  633                   ; Monitor write string
  634                   
  635         F036      MWRSTR	EQU 0F036H	; Write string, will be overwritten by BIOS
  636                   
  637                   ;-----------------------------------------------------------------------------
  638                   ; Cold boot
  639                   
  640 E39A  31 0100     BOOT:	LD SP,BUFF+80H	; set stack
  641                   
  642 E39D  21 E31B     	LD HL,SIGNON	; output start message
  643 E3A0  CD E4AC     	CALL PRMSG
  644                   	
  645                   	; clear / set last used drive
  646         0000      	IF NOT DG01
  648                   	ELSE
  649 E3A3  3E 00       	LD A,BTDRV
  650                   	ENDIF
  651 E3A5  32 0004     	LD (CDISK),A
  652                   	
  653                   	; sector buffer is empty, set to physical sector buffer not changed
  654 E3A8  AF          	XOR A
  655 E3A9  32 E848     	LD (BUFCHG),A
  656                   	
