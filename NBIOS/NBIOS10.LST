  617                   ;-----------------------------------------------------------------------------
  618                   ; read one char from CONSOLE and clears parity bit
  619                   
  620 E37F  CD F003     CONIN:	CALL 0F003H
  621 E382  E6 7F       	AND 7FH
  622                   
  623         FFFF      	IF DG01
  624         FFFF      	IF DEBOUT
  625                   
  626 E384  FE 01       	CP A,1
  627 E386  C0          	RET NZ
  628                   
  629                   	; toggle debug
  630 E387  47          	LD B,A
  631 E388  3A E82F     	LD A,(DEBACT)
  632 E38B  EE 01       	XOR A,01H
  633 E38D  32 E82F     	LD (DEBACT),A
  634 E390  78          	LD A,B
  635                   
  636                   	ENDIF
  637                   	ENDIF
  638                   	
  639 E391  C9          	RET
  640                   
  641                   ;-----------------------------------------------------------------------------
  642                   ; read one char from READER device -> A
  643                   
  644         F006      READER	EQU 0F006H
  645                   
  646                   ;-----------------------------------------------------------------------------
