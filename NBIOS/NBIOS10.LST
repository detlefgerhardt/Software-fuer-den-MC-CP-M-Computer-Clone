  434 E2E5  03           	DB	3	; BLOCK SHIFT
  435 E2E6  07           	DB	7	; BLOCK MASK
  436 E2E7  00           	DB	0	; EXTNT MASK
  437 E2E8  00F2         	DW	242	; DISK SIZE-1
  438 E2EA  003F         	DW	63	; DIRECTORY MAX
  439 E2EC  C0           	DB	192	; ALLOC0
  440 E2ED  00           	DB	0	; ALLOC1
  441 E2EE  0010         	DW	16	; CHECK SIZE
  442 E2F0  0002         	DW	2	; OFFSET
  443                   	
  444         E2F2      XLT3	EQU	$	; TRANSLATE TABLE
  445 E2F2  01           	DB	1		
