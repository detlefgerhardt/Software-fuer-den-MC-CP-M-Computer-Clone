 1085 E4CB  57          	LD D,A
 1086 E4CC  3A E865     	LD A,(PHYTRKS)
 1087 E4CF  4F          	LD C,A
 1088 E4D0  3A E866     	LD A,(PHYSIDS)
 1089 E4D3  5F          	LD E,A
 1090 E4D4  C9          	RET
