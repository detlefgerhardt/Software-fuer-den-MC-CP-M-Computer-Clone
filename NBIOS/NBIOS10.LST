  476                   	; Disk 4 (E), IDE partition 0 ----------------------------------------
  477                   	; 64-sector tracks, numbering starting at zero (sectors 0 to 63)
  478                   	; Block size 2048
  479                   	; Disk size 2 mb, DSM 1023, yields 256 tracks (0 to 255)
  480 E30C              DPB4:	;disk parameter block for all disks.
  481 E30C  0040        	DW	64	; sectors per track
  482 E30E  04          	DB	4	; block shift factor
  483 E30F  0F          	DB	15	; block mask - with block shift, sets block size to 1024
  484 E310  00          	DB	0	; null mask
  485 E311  03FF        	DW	1023	; disk size-1 = number of blocks in a disk - 1
  486 E313  0100        	DW	256	; directory max = no. directory entries/disk, arbitrary
  487 E315  F0          	DB	240	; alloc 0 -- need 4 bits (blocks) for 256 directory entries -- 
  488 E316  00          	DB	0	; alloc 1 -- no. bits = (directory max x 32)/block size	
  489 E317  0000        	DW	0	; check size -- no checking, so zero
  490 E319  0001        	DW	1	; track offset -- first track for system
  491                   
  492                   	; Disk 5 (F), IDE partition 1 ----------------------------------------
  493         E30C      DPB5	EQU	DPB4	; EQUIVALENT PARAMETERS
  494                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  495                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  496                   
  497                   	; Disk 6 (G), IDE partition 2 ----------------------------------------
  498         E30C      DPB6	EQU	DPB4	; EQUIVALENT PARAMETERS
  499                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  500                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  501                   
  502                   	; Disk 7 (H), IDE partition 3 ----------------------------------------
  503         E30C      DPB7	EQU	DPB4	; EQUIVALENT PARAMETERS
  504                   ;ALS3	EQU	ALS2	; SAME ALLOCATION VECTOR SIZE
  505                   ;CSS3	EQU	CSS2	; SAME CHECKSUM VECTOR SIZE
  506                   
  507                   	ENDIF	; DG01
  508                   
