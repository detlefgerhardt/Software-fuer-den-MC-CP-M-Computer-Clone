  142                   
  143         0000      	IF NOT DG01
  283                   	ELSE	; ------------------------------------------------------------
  284                   
  285                   	; size of mini disks A, B, C
  286                   	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
  287                   	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K
  288         0185      SIZEAB	EQU 389
  289                   
  290                   	;DISKS 8		; define 8 drives (A..H)
  291         0008      NDISKS	EQU	8	
