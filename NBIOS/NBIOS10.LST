  881 E4FC  07           	RLCA
  882 E4FD  07           	RLCA
  883 E4FE  E6 F0        	AND 0F0H
  884 E500  B4           	OR H
  885 E501  67           	LD H,A			; damit sssstttt ok
  886 E502  3A E87A      	LD A,(IOT)
  887 E505  0F           	RRCA			; txxxxxxx
  888 E506  E6 80        	AND 80H
  889 E508  6F           	LD L,A			; t0000000
  890 E509  3A E87A      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
  891 E50C  07           	RLCA			; und dazu msb-Teil des Tracks verwenden
  892 E50D  07           	RLCA			; 0mmttttt
  893 E50E  07           	RLCA			; Banknummer
  894 E50F  E6 03        	AND 03H			; 000000mm
  895 E511  C6 01       	ADD A,1			; erst ab Bank 1 starten
