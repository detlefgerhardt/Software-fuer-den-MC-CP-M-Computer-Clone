  895 E505  0F           	RRCA			; txxxxxxx
  896 E506  E6 80        	AND 80H
  897 E508  6F           	LD L,A			; t0000000
  898 E509  3A E834      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
  899 E50C  07           	RLCA			; und dazu msb-Teil des Tracks verwenden
