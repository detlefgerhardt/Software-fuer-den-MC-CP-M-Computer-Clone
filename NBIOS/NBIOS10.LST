  381         0000       XLT1	EQU	0	; NO XLATE TABLE
  382                   
  383                   	ENDIF
  384                   
  385         0000      	IF NOT DG_CHD
  395                   	ELSE
  396                   
  397                   	; Disk 2 (C): PHYSICAL FORMAT: 1,44 MB, HD, DS, 1024 BYTES/SECTOR, 9 SECTORS/TRACK, 80 TRACKS
  398         E2D4       DPB2	EQU	$	; DISK PARM BLOCK
  399 E2D4  0048         	DW	72	; SEC PER TRACK
  400 E2D6  05           	DB	5	; BLOCK SHIFT
  401 E2D7  1F           	DB	31	; BLOCK MASK
  402 E2D8  01           	DB	1	; EXTNT MASK
  403 E2D9  0162         	DW	354	; DISK SIZE-1
  404 E2DB  00FF          	DW	255	; DIRECTORY MAX
  405 E2DD  C0           	DB	192	; ALLOC0
  406 E2DE  00           	DB	0	; ALLOC1
  407 E2DF  0040         	DW	64	; CHECK SIZE
  408 E2E1  0002         	DW	2	; OFFSET
  409         0000       XLT2	EQU	0	; NO XLATE TABLE
  410                   	
  411                   	ENDIF
  412                   
  413                   
