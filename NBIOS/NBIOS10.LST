 1464                   ;-----------------------------------------------------------------------------
 1465                   
 1466                   ; Addresses of IDE-80 CF-Adapter card
 1467                   
 1468         0018      IDEDATA	EQU 018h	; IDE Data Register
 1469         001A      SECCND	EQU 01Ah	; Sector Count Register
 1470         001B      LBA7	EQU 01Bh	; LBA Bits 0-7
 1471         001C      LBA15	EQU 01Ch	; LBA Bits 8-15
 1472         001D      LBA23	EQU 01Dh	; LBA Bits 16-23
 1473         001E      IDEHEAD	EQU 01Eh	; IDE Drive Head Register
 1474         001F      IDESTAT	EQU 01Fh	; IDE Command/Status Register
 1475                   
 1476                   ; IDE/CF physical format: 
 1477                   ; 4 partitions
 1478                   ; 8192 KB bytes/partition 
 1479                   ; 128 bytes/sector
 1480                   ; 256 sectors/track
 1481                   ; 256 tracks
 1482                   ; 128 * 256 * 256 / 1024 = 8192
 1483                   
 1484                   ; old (2048K):
 1485                   ; LBA
 1486                   ; 00000000 00000000 00000000
 1487                   ; 00000000 tttttttt ssssssdd
 1488                   ;        E        B        C
 1489                   
 1490                   ; NEWIDE (8192K):
 1491                   ; LBA
 1492                   ; 00000000 00000000 00000000
 1493                   ; 000000dd tttttttt ssssssss
 1494                   ;        E        B        C
 1495                   
