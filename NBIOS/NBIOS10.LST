  959                   	;---------------------------------------------------------------------
  960                   	; Calculate address for ram disk, source in HL
  961                   	; SEKTOR 0..E,  TRAck 0..5fh
  962                   	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
  963 E4D0  3A E852     ADRERZ:	LD A,(IOT)		; Track holen
  964 E4D3  0F           	RRCA 			; und umrechnen
  965 E4D4  E6 0F        	AND 0FH			; unterer Teil vom MSB
  966 E4D6  67           	LD H,A
  967 E4D7  3A E853      	LD A,(IOS)		; dann Sektor dazu
  968 E4DA  07           	RLCA
  969 E4DB  07           	RLCA
  970 E4DC  07           	RLCA
  971 E4DD  07           	RLCA
  972 E4DE  E6 F0        	AND 0F0H
  973 E4E0  B4           	OR H
  974 E4E1  67           	LD H,A			; damit sssstttt ok
  975 E4E2  3A E852      	LD A,(IOT)
  976 E4E5  0F           	RRCA			; txxxxxxx
  977 E4E6  E6 80        	AND 80H
  978 E4E8  6F           	LD L,A			; t0000000
  979 E4E9  3A E852      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
  980 E4EC  07           	RLCA			; und dazu msb-Teil des Tracks verwenden
  981 E4ED  07           	RLCA			; 0mmttttt
  982 E4EE  07           	RLCA			; Banknummer
  983 E4EF  E6 03        	AND 03H			; 000000mm
  984 E4F1  C6 01       	ADD A,1			; erst ab Bank 1 starten
  985 E4F3  47           	LD B,A			; da BANK 0=CP/M RAM und TPA
  986 E4F4  4F           	LD C,A			; ok beide definiert
  987 E4F5  C9           	RET
