  920                   ;-----------------------------------------------------------------------------
  921                   ; Sector translation (used by BDOS)
  922                   ; sector in C
  923                   ; skew table in DE (or 0)
  924                   ; write calculated sector to IOS and L
  925                   
  926 E4A1  7A          SECTRAN:LD A,D		; check if skew table != 0
  927 E4A2  B3                  OR E
  928 E4A3  CA E4B2             JP Z,SECTR1	; =0, -> no skew
  929                   
  930                   	; calc sector offset into skew table
  931 E4A6  06 00       	LD B,0
  932 E4A8  EB          	EX DE,HL
  933 E4A9  09          	ADD HL,BC	; sector in C
  934 E4AA  7E          	LD A,(HL)	; load skew value
  935 E4AB  32 E829     	LD (IOS),A	; save in IOS 
  936 E4AE  6F          	LD L,A		; and in L
  937         FFFF      	IF DG01
  938 E4AF  26 00               LD H,0		; was missing *dg* 27.07.2026
  939                   	ENDIF
  940 E4B1  C9          	RET
  941                   
  942 E4B2              SECTR1:	; no skew, return sector
  943 E4B2  69          	LD L,C		; sector in C
  944 E4B3  79                  LD A,C
  945 E4B4  32 E829             LD (IOS),A	; save in IOS
  946 E4B7  26 00               LD H,0
  947 E4B9  C9                  RET
