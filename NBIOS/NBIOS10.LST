  894                   ; Read and write sector using FEXEC into monitor
  895                   
  896                   ;-----------------------------------------------------------------------------
  897                   ; Read sector
  898                   
  899                   ; Buffer (DMA address) in IOD
  900                   ; Drive in DBANK (0..n-1)
  901                   ; Track in IOT (0..n-1 * side)
  902                   ; Sector in IOS (0..n-1)
  903                   
  904 E4B9              READ:
  905         0000      	IF NOT DG01
  914                   	ELSE
  915                   
