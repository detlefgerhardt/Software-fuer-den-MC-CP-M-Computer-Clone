 1275                   ;-----------------------------------------------------------------------------
 1276                   ; Calculates physical drive from DBANK and IOT -> C
 1277                   ; only for Mini disks
 1278                   
 1279                   ; DBANK, IOT     C
 1280                   ;  0     F    -> 0
 1281                   ;  1     F    -> 2
 1282                   ;  0     B    -> 1
 1283                   ;  1     B    -> 3
 1284                   
 1285                   ; muss fuer Minidisk C und D erweitert werden
 1286                   
 1287                   ; drive number (0..n-1) -> C, Bit 0..3
 1288                   ; side -> (0..n-1) -> C, Bit 7
 1289                   
 1290                   ; calculates physical sector from logical sector, IOS -> E
 1291                   ; logical sector 0..39 -> physical sector 1..5
 1292                   
 1293                   ; calculates logical track from physical track, IOT -> D
 1294                   ; 0..159 -> 0..79 (max 127)
