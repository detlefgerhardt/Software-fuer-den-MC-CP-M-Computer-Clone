  323                   	; Disk 0 (A) ---------------------------------------------------------
  324                   	
  325                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  326                   	; 0 = NUMMER DES LAUFWERKS
  327                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  328                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  329                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  330                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  331                   	; 2048 = GROESSE EINES BLOCKS
  332                   	; SIZEAB = ZAHL DER MAX. MOEGLICHEN BLOECKE
  333                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  334                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  335                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  336                   
  337                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  338                   	; DISKDEF 0,0,39,0,2048,SIZEAB,256,256,4
  339         E2B6      DPB0	EQU	$	; DISK PARM BLOCK
  340 E2B6  0028        	DW	40	; SEC PER TRACK
  341 E2B8  04          	DB	4	; BLOCK SHIFT
  342 E2B9  0F          	DB	15	; BLOCK MASK
  343 E2BA  00          	DB	0	; EXTNT MASK
  344 E2BB  0184        	DW	388	; DISK SIZE-1
  345 E2BD  00FF        	DW	255	; DIRECTORY MAX
  346 E2BF  F0          	DB	240	; ALLOC0
  347 E2C0  00          	DB	0	; ALLOC1
  348 E2C1  0040        	DW	64	; CHECK SIZE
  349 E2C3  0004        	DW	4	; OFFSET
  350         0000      XLT0	EQU	0	; NO XLATE TABLE
  351                   
  352         0000      	IF NOT DG_BHD
  361                   	ELSE
  362                   
  363         0000      	IF FALSE
  378                   	ENDIF
  379                   
  380                   	; Disk 1 (B): PHYSICAL FORMAT: 1.2 MB, HD, DS, 512 BYTES/SECTOR, 4096 Bytes/Block, 15 SECTORS/TRACK, 80 TRACKS
  381         E2C5       DPB1	EQU	$	; DISK PARM BLOCK
  382                    	;DW	56 ; 60	; SEC PER TRACK
  383 E2C5  003C         	DW	60	; SEC PER TRACK
  384 E2C7  05           	DB	5	; BLOCK SHIFT
  385 E2C8  1F           	DB	31	; BLOCK MASK
  386 E2C9  01           	DB	1	; EXTNT MASK
  387                    	;DW	275 ; 295	; DISK SIZE-1
  388 E2CA  0127         	DW	295	; DISK SIZE-1
  389 E2CC  00FF          	DW	255	; DIRECTORY MAX
  390 E2CE  C0           	DB	192	; ALLOC0
  391 E2CF  00           	DB	0	; ALLOC1
  392 E2D0  0040         	DW	64	; CHECK SIZE
  393 E2D2  0002         	DW	2	; OFFSET
  394         0000       XLT1	EQU	0	; NO XLATE TABLE
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NBIOS10 Z80

  395                   
  396                   
  397                   	ENDIF
  398                   
  399         0000      	IF NOT DG_CHD
  409                   	ELSE
  410                   
  411                   	; Disk 2 (C): PHYSICAL FORMAT: 1.44 MB, HD, DS, 1024 BYTES/SECTOR, 4096 Bytes/Block, 9 SECTORS/TRACK, 80 TRACKS
  412         E2D4       DPB2	EQU	$	; DISK PARM BLOCK
  413 E2D4  0048         	DW	72	; SEC PER TRACK
  414 E2D6  05           	DB	5	; BLOCK SHIFT
  415 E2D7  1F           	DB	31	; BLOCK MASK
  416 E2D8  01           	DB	1	; EXTNT MASK
  417 E2D9  0162         	DW	354	; DISK SIZE-1
  418 E2DB  00FF          	DW	255	; DIRECTORY MAX
  419 E2DD  C0           	DB	192	; ALLOC0
  420 E2DE  00           	DB	0	; ALLOC1
  421 E2DF  0040         	DW	64	; CHECK SIZE
  422 E2E1  0002         	DW	2	; OFFSET
  423         0000       XLT2	EQU	0	; NO XLATE TABLE
  424                   	
  425                   	ENDIF
  426                   
  427                   
