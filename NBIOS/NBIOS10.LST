  521                   	; PHYSICAL FORMAT: 1.2 MB, HD, DS, 512 BYTES/SECTOR, 4096 Bytes/Block, 15 SECTORS/TRACK, 80 TRACKS
  522         E2C5      DPB3	EQU	$	; DISK PARM BLOCK
  523 E2C5  003C         	DW	60	; SEC PER TRACK
  524 E2C7  05           	DB	5	; BLOCK SHIFT
  525 E2C8  1F           	DB	31	; BLOCK MASK
  526 E2C9  01           	DB	1	; EXTNT MASK
  527                    	;DW	275 ; 295 ; DISK SIZE-1
  528 E2CA  0127         	DW	295	; DISK SIZE-1
  529 E2CC  00FF          	DW	255	; DIRECTORY MAX
  530 E2CE  C0           	DB	192	; ALLOC0
  531 E2CF  00           	DB	0	; ALLOC1
  532 E2D0  0040         	DW	64	; CHECK SIZE
  533 E2D2  0002         	DW	2	; OFFSET
  534                   	; new parameters:
  535 E2D4  00          	DB	00000000B ; Maxi/HD
  536 E2D5  02          	DB 	2	  ; 60 / 15 = 4 -> 2^2
  537 E2D6  03          	DB	00000011B ; 512 bytes/sector -> modulo 4 (0..3)
  538         0000      XLT3	EQU	0	; NO XLATE TABLE
