Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NBIOS10 Z80

    1                   ;************************************************************************
    2                   ;* NBIOS10.Z80								*
    3                   ;*									*
    4                   ;* basiert auf der Version 3.1 1984 Rolf-Dieter Klein 841220            *
    5                   ;* Urspr|ngliche Version fuer 2 Mini und 2 Maxi Laufwerke		*
    6                   ;*									*
    7                   ;************************************************************************
    8                   ;
    9                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
   10                   ;
   11                   ; 24.06.2026 *dg* Kommentare hinzugefuegt
   12                   ;                 Binaer identisch zur Origial-Version
   13                   ; 06.07.2026 *dg* V1.0 Erste Aenderungen am BIOS. Alte Monnitor-Routinen werden
   14                   ;                 nicht mehr verwendet. Laufwerksumrechnung gedndert.
   15                   ;                 Version getestet.
   16                   ;                 Alle Aenderungen mit bedingter Assemblierung (Flag MINI3)
   17                   ;                 Testweise den Speicherbereich fuer das BIOS auf E200..EFFF
   18                   ;		  geaendert. CP/M startet dann bei CC00 (58K)
   19                   ; 09.07.2026 *dg* V1.0 Erweitert um 4 IDE/CF-Laufwerke - funktioniert nicht
   20                   ;                 System bootet aber Schreiben auf die IDE-Laufwerke schldgt fehl.
   21                   ; 12.07.2026 *dg* Lesen und Schreiben von CF funktioniert
   22                   ; 31.07.2026 *dg* V1.0 Laufwerk C als HD Laufwerk konfiguriert (1.44 MB)
   23                   ;                 Probleme immer beim ersten Scheiben nach dem Formatieren
   24                   ; 02.08.2026 *dg* Laufwerk B: als 5.25 Zoll HD Laufwerk
   25                   ;		  Funktioniert noch nicht, Format und Laufwerksparameter unklar 
   26                   ; 03.08.2026 *dg* BIOS Debug-Ausgaben per Ctrl-A toggelbar
   27                   ; 06.08.2026 *dg* 5.25 Zoll Format mit 1024*8 funktioniert (1.4 MB)
   28                   ;                 5.25 Zoll Format mit 512*15 funktioniert (1.2 MB)
   29                   
   30                   ;------------------------------------------------------------------------------
   31                   
   32                   	;MACLIB DISKDEF1	; LOAD DEFINTION FOR DISKS
   33                   
   34         0016      CPMVER	EQU 22		; CP/M version
   35         0000      FALSE	EQU 0
   36         FFFF      TRUE	EQU NOT FALSE
   37         FFFF      TEST	EQU TRUE
   38         000D      CR	EQU 0DH		; carriage return
   39         000A      LF	EQU 0AH		; line feed
   40                   
   41                   ;------------------------------------------------------------------------------
   42                   ; Variant switches
   43                   
   44                   ; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 3.1
   45         FFFF      DG01	EQU TRUE
   46                   ;MINI3	EQU TRUE	; 3 MINI, 1 MAXI drive
   47         FFFF      DG_BHD	EQU TRUE	; drive B as HD drive (1.4 MB)
   48         FFFF      DG_CHD	EQU TRUE	; drive C as HD drive (1.44 MB)
   49         0000      DEBOUT	EQU FALSE	; debug outputs
   50                   
   51                   ; logical drive to boot from
   52         0000      	IF NOT DG01
   54                   	ELSE
   55                   ;BTDRV	EQU 4		; drive E: (CF)
   56         0000      BTDRV	EQU 0		; drive A:
   57                   	ENDIF
   58                   
   59                   ;------------------------------------------------------------------------------
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBIOS10 Z80

   60                   ; Monitor functions
   61                   
   62         FFFF      	IF DG01
   63                   
   64         F009      MCONOUT	EQU 0F009h	; character in C
   65                   
   66                   	ENDIF
   67                   
   68                   ;------------------------------------------------------------------------------
   69                   
   70                   ;MSIZE 	EQU 60		; Speichergroesse, hier 60K
   71         003A      MSIZE 	EQU 58		; Speichergroesse, hier 58K
   72                   
   73         9800      BIAS	EQU (MSIZE-20)*1024	; min=20K
   74         CC00      CCP	EQU 3400H+BIAS	; start of CCP (CP/M)
   75         D406      BDOS	EQU CCP+806H	; BDOS entry behind serial number (6 bytes)
   76         E200      BIOS	EQU CCP+1600H	; start of BIOS
   77                   
   78         D400      BDOSADR	EQU BDOS - 6
   79                   
   80         CC00      CPMB	EQU CCP		; Start CP/M-Boot
   81                   
   82         1600      CPML	EQU BIOS-CPMB	; Laenge des CP/Ms
   83         002C      NSECTS	EQU CPML/128	; Anzahl der von CP/M belegten Sektoren
   84                   
   85                   
   86         0000      JWARM	EQU 0000H	; JMP to WBOOT
   87         0003      IOBYTE	EQU 0003H	; Address of IOBYTE
   88         0004      CDISK	EQU 0004H	; Address of last used drive and user (low-nibble: current drive, high-nibble: current user)
   89         0005      JBDOS	EQU 0005H	; JMP to BDOS
   90         0038      JRST7	EQU 0038H	; JMP RST7 (7*8)
   91         0080      BUFF	EQU 0080H	; buffer address
   92         0005      RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write
   93                   
   94                   ;-----------------------------------------------------------------------------
   95                   
   96         E200      	ORG BIOS	; regular start of BIOS
   97                   	;ORG BIOS-4000H	; for debugging
   98                   
   99 E200              STARTBIOS:
  100                   
  101 E200  C3 E38D     	JP BOOT		; Cold boot
  102                   
  103                   	; --- start of offical BIOS calls ---
  104                   	
  105 E203  C3 E3B3     WBOOTE:	JP WBOOT	; Warm boot (CTRL-C)
  106 E206  C3 E384     	JP CONST	; Get CONSOLE status -> A
  107 E209  C3 E387     	JP CONIN	; Input character from CONSOLE -> A
  108 E20C  C3 F009     	JP CONOUT	; Output character to CONSOLE (C)
  109 E20F  C3 F00F     	JP LIST		; Output character to LIST device (C)
  110 E212  C3 F00C     	JP PUNCH	; Output character to PUNCH device (C)
  111 E215  C3 F006     	JP READER	; Input character from READER device -> A
  112                   
  113 E218  C3 E454     	JP HOME		; Select track home position (no execution)
  114 E21B  C3 E459     	JP SELDSK	; Select drive, drive 0..n-1 in C, returns disk parameter header block in HL
  115 E21E  C3 E46F     	JP SETTRK	; Select track for read/write, track in C (logic tracks!!! e.g. 0..159)
  116 E221  C3 E474     	JP SETSEC	; Select sector for read/write, sector in C (logic sectors!!! e.g. 0..39)
  117 E224  C3 E492     	JP SETDMA	; Set disk read/write address (no real DMA), address in BC
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBIOS10 Z80

  118 E227  C3 E4A5     	JP READ		; Read sector
  119 E22A  C3 E51B     	JP WRITE	; Write sector
  120 E22D  C3 E451     	JP LISTST	; Listener ready? (not implemented, returns 1 = not ready)
  121 E230  C3 E479     	JP SECTRAN	; sector translation (skew only)
  122                   	
  123                   	; --- end of offical BIOS calls ---
  124                   	
  125         FFFF      	IF DG01
  126 E233  C3 E550     	JP FLUSH	; BDOS close and write sector buffer to disk
  127                   	ENDIF
