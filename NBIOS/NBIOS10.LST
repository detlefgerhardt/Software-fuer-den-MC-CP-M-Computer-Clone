  584                   ; write one char to CONSOLE (C)
  585                   
  586         F009      CONOUT	EQU 0F009H
  587                   
  588                   ;-----------------------------------------------------------------------------
  589                   ; write one char to PUNCH device (C)
  590                   
  591         F00C      PUNCH	EQU 0F00CH
  592                   
