 1090 E5B9  AF          	XOR A
 1091 E5BA  37          	SCF		; shift in carry
 1092 E5BB  17          MINIC6:	RLA
 1093 E5BC  10 FD       	DJNZ MINIC6
 1094                   
 1095 E5BE  47          	LD B,A
 1096 E5BF  3A E838     	LD A,(BLREG)
 1097 E5C2  B0          	OR B
 1098 E5C3  4F          	LD C,A
