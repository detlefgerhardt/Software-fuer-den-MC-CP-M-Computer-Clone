 1534 E670  19          	ADD HL,DE	; pointer into PHSBUF in DE
 1535                   	
 1536         0000      	IF DEBOUT
 1542                   	ENDIF
 1543                   	
 1544 E671  EB          	EX DE,HL
 1545 E672  2A E767     	LD HL,(IOD)
 1546 E675  01 0080     	LD BC,128
