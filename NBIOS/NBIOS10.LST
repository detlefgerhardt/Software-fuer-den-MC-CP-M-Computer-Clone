  289 E24A  0000  0000  	DW	0000H,0000H	;SCRATCH AREA
  290 E24E  E769  E2C5  	DW	DIRBUF,DPB1	;DIR BUFF,PARM BLOCK
  291 E252  E87F  E85A  	DW	CSV1,ALV1	;CHECK, ALLOC VECTORS
  292                   	
