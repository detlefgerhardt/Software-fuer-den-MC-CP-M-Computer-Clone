  335                   	; Disk 0 (A) ---------------------------------------------------------
  336                   	
  337                   	; *** DISKDEF BEDEUTUNG DER PARAMETER***
  338                   	; 0 = NUMMER DES LAUFWERKS
  339                   	; 0 = NUMMER DES ERSTEN SEKTORS EINER SPUR
  340                   	; 39 =  NUMMER DES LETZTEN SEKTORS EINER SPUR
  341                   	; 0 = OPTIONALER VERSCHIEBUNGSFAKTOR ZUM
  342                   	;     VERSETZEN ABSPEICHERN DER SEKTOREN
  343                   	; 2048 = GROESSE EINES BLOCKS
  344                   	; SIZEAB = ZAHL DER MAX. MOEGLICHEN BLOECKE
  345                   	; 256 = ZAHL DER DIRECTORY EINTRITTSPUNKTE
  346                   	; 256 = ZAHL DER GEPRUEFTEN EINTRITTSPUNKTE
  347                   	; OFFS = ADDITIVE KONSTANTE ZUM ANSPRECHEN DER SPUR 00
  348                   
  349                   	; physical format: 3,5 inch NKC, DD, DS, 1024 bytes/sector, 5 sectors/track, 80 tracks
  350                   	; DISKDEF 0,0,39,0,2048,SIZEAB,256,256,4
  351         E2B6      DPB0	EQU	$	; DISK PARM BLOCK
  352 E2B6  0028        	DW	40	; SEC PER TRACK
  353 E2B8  04          	DB	4	; BLOCK SHIFT
  354 E2B9  0F          	DB	15	; BLOCK MASK
  355 E2BA  00          	DB	0	; EXTNT MASK
  356 E2BB  0184        	DW	388	; DISK SIZE-1
  357 E2BD  00FF        	DW	255	; DIRECTORY MAX
  358 E2BF  F0          	DB	240	; ALLOC0
  359 E2C0  00          	DB	0	; ALLOC1
  360 E2C1  0040        	DW	64	; CHECK SIZE
  361 E2C3  0004        	DW	4	; OFFSET
  362         0000      XLT0	EQU	0	; NO XLATE TABLE
  363                   
  364         0000      	IF NOT DG_BHD
  373                   	ELSE
  374                   
  375         0000      	IF FALSE
  390                   	ENDIF
  391                   
  392                   	; Disk 1 (B): PHYSICAL FORMAT: 1.2 MB, HD, DS, 512 BYTES/SECTOR, 4096 Bytes/Block, 15 SECTORS/TRACK, 80 TRACKS
  393         E2C5       DPB1	EQU	$	; DISK PARM BLOCK
  394                    	;DW	56 ; 60	; SEC PER TRACK
  395 E2C5  003C         	DW	60	; SEC PER TRACK
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
