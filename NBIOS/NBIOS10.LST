  396 E2C7  05           	DB	5	; BLOCK SHIFT
  397 E2C8  1F           	DB	31	; BLOCK MASK
  398 E2C9  01           	DB	1	; EXTNT MASK
  399                    	;DW	275 ; 295	; DISK SIZE-1
  400 E2CA  0127         	DW	295	; DISK SIZE-1
  401 E2CC  00FF          	DW	255	; DIRECTORY MAX
  402 E2CE  C0           	DB	192	; ALLOC0
  403 E2CF  00           	DB	0	; ALLOC1
  404 E2D0  0040         	DW	64	; CHECK SIZE
  405 E2D2  0002         	DW	2	; OFFSET
  406         0000       XLT1	EQU	0	; NO XLATE TABLE
  407                   
  408                   
  409                   	ENDIF
  410                   
  411         0000      	IF NOT DG_CHD
  421                   	ELSE
  422                   
