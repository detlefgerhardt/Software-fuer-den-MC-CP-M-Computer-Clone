 1155                   ; Read Mini disk, 80 Spur, DD, DS
 1156                   
 1157                   ;READ und WRITE unter Verwendung von MEXEC
 1158                   ; HL=DMA ADR
 1159                   ; DE=TRACK/SECTOR
 1160                   ; B=0 RSTORE
 1161                   ;   1 READ
 1162                   ;   2 WRITE
 1163                   ; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
 1164                   ;                                          A   C    B    D
 1165                   
