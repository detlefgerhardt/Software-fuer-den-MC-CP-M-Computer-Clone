  859 E500  B4           	OR H
  860 E501  67           	LD H,A			; damit sssstttt ok
  861 E502  3A E834      	LD A,(IOT)
  862 E505  0F           	RRCA			; txxxxxxx
  863 E506  E6 80        	AND 80H
  864 E508  6F           	LD L,A			; t0000000
