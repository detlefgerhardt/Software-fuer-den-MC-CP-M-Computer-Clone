 1009                   	; A >= 5, Read RAM disk
 1010                   
 1011         0000      	IF NOT DG01
 1022                   	ELSE
 1023                   	
 1024 E4DA  FE 08       	CP 8
 1025 E4DC  DA E6AF     	JP C,IDERD	; A < 8 -> IDE disks 4,5,6,7
 1026                   	
 1027                   	ENDIF
