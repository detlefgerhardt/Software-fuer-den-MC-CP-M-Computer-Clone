 1030                   ;-----------------------------------------------------------------------------
 1031                   ; Calculates physical drive from DBANK and IOT -> C
 1032                   ; only for Mini disks
 1033                   
 1034                   ; DBANK, IOT     C
 1035                   ;  0     F    -> 0
 1036                   ;  1     F    -> 2
 1037                   ;  0     B    -> 1
 1038                   ;  1     B    -> 3
 1039                   
 1040                   ; muss fuer Minidisk C und D erweitert werden
 1041                   
 1042                   ; drive number (0..n-1) -> C, Bit 0..3
 1043                   ; side -> (0..n-1) -> C, Bit 7
 1044                   
 1045                   ; calculates physical sector from logical sector, IOS -> E
 1046                   ; logical sector 0..39 -> physical sector 1..5
 1047                   
 1048                   ; calculates logical track from physical track, IOT -> D
 1049                   ; 0..159 -> 0..79 (max 127)
 1050                   
 1051 E590              MINCAL:	; logical sector to physical sector
 1052                   	; get drive specific factor
 1053 E590  3A E839     	LD A,(BLPOW)
 1054 E593  A7          	AND A
 1055 E594  28 0A       	JR Z,MINIC4	; -> factor = 0
 1056                   
 1057 E596  47          	LD B,A		; factor
 1058 E597  3A E835     	LD A,(IOS)	; logical sector
 1059 E59A  CB 3F       MINIC2:	SRL A
 1060 E59C  10 FC       	DJNZ MINIC2
 1061                   	
 1062 E59E  18 03       	JR MINIC5
 1063                   
 1064 E5A0              MINIC4:	; factor = 0
 1065 E5A0  3A E835     	LD A,(IOS)
 1066                   
 1067 E5A3  3C          MINIC5:	INC A		; sector number starts with 1
 1068 E5A4  5F          	LD E,A		; save in E
 1069                   
 1070         FFFF      	IF NEWIDE
 1071                   	
 1072 E5A5  3A E83B     	LD A,(ISIDE)
 1073 E5A8  A7          	AND A
 1074 E5A9  28 09       	JR Z,MINC5A	; -> no CF/IDE drive
 1075                   
 1076                   	; -> is CF/IDE drive, no drive or track translation
 1077 E5AB  3A E833     	LD A,(DBANK)
 1078 E5AE  4F          	LD C,A
 1079 E5AF  3A E834     	LD A,(IOT)
 1080 E5B2  57          	LD D,A
 1081 E5B3  C9          	RET
 1082                   
 1083 E5B4              MINC5A:
 1084                   	ENDIF
 1085                   
 1086                   	; drive A,B,C,D -> 0001,0010,0100,1000
