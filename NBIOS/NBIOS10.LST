  992 E4E0  B4           	OR H
  993 E4E1  67           	LD H,A			; damit sssstttt ok
  994 E4E2  3A E852      	LD A,(IOT)
  995 E4E5  0F           	RRCA			; txxxxxxx
  996 E4E6  E6 80        	AND 80H
  997 E4E8  6F           	LD L,A			; t0000000
  998 E4E9  3A E852      	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
  999 E4EC  07           	RLCA			; und dazu msb-Teil des Tracks verwenden
 1000 E4ED  07           	RLCA			; 0mmttttt
