  599                   ; restart Monitor
  600                   
  601         F01E      MSTART	EQU 0F01EH
  602                   
  603                   ;-----------------------------------------------------------------------------
  604                   ; Monitor warm start
  605                   
  606         F033      MWARM	EQU 0F033H	; Monitor warm start, will be overwritten by BIOS
  607                   
  608                   ;-----------------------------------------------------------------------------
  609                   ; Monitor write string
  610                   
  611         F036      MWRSTR	EQU 0F036H	; Write string, will be overwritten by BIOS
  612                   
  613                   ;-----------------------------------------------------------------------------
  614                   ; Cold boot
  615                   
  616 E38D  31 0100     BOOT:	LD SP,BUFF+80H	; set stack
  617                   
  618 E390  21 E31B     	LD HL,SIGNON	; output start message
  619 E393  CD E498     	CALL PRMSG
  620                   	
  621                   	; clear / set last used drive
  622         0000      	IF NOT DG01
  624                   	ELSE
  625 E396  3E 00       	LD A,BTDRV
  626                   	ENDIF
  627 E398  32 0004     	LD (CDISK),A
  628                   	
  629                   	; sector buffer is empty, set to physical sector buffer not changed
  630 E39B  AF          	XOR A
  631 E39C  32 E75B     	LD (BUFCHG),A
  632                   	
  633                   	; drive is undefined
  634 E39F  3E FF       	LD A,0FFH
  635 E3A1  32 E75C     	LD (CURDRV),A
  636                   
  637                   	; disable monitor entries, set to WBOOT
  638 E3A4  21 E3B3     	LD HL,WBOOT
  639 E3A7  22 F034     	LD (MWARM+1),HL
  640 E3AA  22 F037     	LD (MWRSTR+1),HL
  641                   	
  642         FFFF      	IF DG01
  643                   	;CALL PATF	; patch BDOS close function
  644 E3AD  CD E727     	CALL PATA	; patch BDOS active drive
  645                   	;CALL PATB
  646                   	ENDIF
  647                   	
  648 E3B0  C3 E40C     	JP GOCPM	; start CP/M
  649                   
  650                   ;-----------------------------------------------------------------------------
  651                   ; Warm boot
  652                   
  653 E3B3              WBOOT:	; write physical sector buffer to disk if changed
  654 E3B3  3A E75B     	LD A,(BUFCHG)
  655 E3B6  B7          	OR A
  656 E3B7  CA E3BD     	JP Z,WBOO1
