Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NPUTB-CFZ80

    1                   ;*****************************************************************************
    2                   ; NPUTB-CF.Z80
    3                   ;
    4                   ; Write bootloader for MC CP/M-Computer IDE/CF drive
    5                   
    6                   ; based on BLOAD-CF von Ulrich Haumann from 05/2026
    7                   ;
    8                   ;*****************************************************************************
    9                   ; Writes Boot loader from address 1000h to IDE/Compact-Flash
   10                   ; Uses calls to Monitor and returns to Monitor
   11                   ;
   12                   ; DOES NOT USE BIOS or CP/M START ADDRESS !!!
   13                   ;
   14                   ; Writes track 0, sectors 0 
   15                   ; Subroutine to write one IDE/ATA Disk sector (256 bytes)
   16                   ; Address of data to write to disk passed in HL
   17                   ; LBA bits 0 to 7 passed in C, bits 8 to 15 passed in B
   18                   ; LBA bits 16 to 23 passed in E
   19                   ;
   20                   ; Version history
   21                   ;
   22                   ; 10.07.2026 *dg* Renamed to NBPUT-CF and reformatted
   23                   ; 09.08.2026 *dg* Renamed to NPUTB-CF
   24                   ; 25.10.2026 *dg* Adapted to new Monitor IDE/CF routines
   25                   ;
   26                   
   27                   ;-----------------------------------------------------------------------------
   28                   
   29         1000      BOOTADR	EQU 01000H	; the bootloader was loaded to this address before
   30                   
   31                   ; calls to Monitor
   32         F009      CONOUT	EQU 0F009h	; Output a chracter
   33         F02D      MIDEWR	EQU 0F02DH	; IDE/CF write routine in Monitor
   34         F033      MWARM	EQU 0F033H	; goto Monitor
   35                   
   36         0004      BOOTDRV	EQU 4		; first IDE/CF-drive (only used for message)
   37                   
   38                   ;-----------------------------------------------------------------------------
   39                   
   40         0100      	ORG 0100H	; start program here
   41                   
   42                   	; Monitor stack is used
   43                   
   44 0100  21 0126     START:	LD HL,MSG1
   45 0103  CD 011B     	CALL WRSTR
   46                   
   47 0106  21 1000     	LD HL,BOOTADR
   48 0109  0E 00       	LD C,00H	; volume 0
   49 010B  16 00       	LD D,00H	; track 0
   50 010D  1E 01       	LD E,01H	; sector 1 (boot sector)
   51 010F  CD F02D     	CALL MIDEWR	; write one 256 byte sector
   52                   	
   53 0112  21 0142     	LD HL,MSG2
   54 0115  CD 011B     	CALL WRSTR
   55                   	
   56                   	; we did not use the BIOS, so we can return to the Monitor
   57 0118  C3 F033     	JP MWARM
   58                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NPUTB-CFZ80

   59                   ;-----------------------------------------------------------------------------
   60                   ; Uses monitor CONOUT to print 0-terminated string
   61                   ; address in HL
   62                   ; 00h = string end
   63                   
   64 011B  7E          WRSTR:	LD A,(HL)	; get char from string
   65 011C  A7          	AND A		; check if 0
   66 011D  C8          	RET Z		; -> end of string
   67                   	
   68 011E  4F          	LD C,A
   69 011F  CD F009     	CALL CONOUT
   70 0122  23          	INC HL		; next char in string
   71 0123  C3 011B     	JP WRSTR	; start over
   72                   
   73                   ;-----------------------------------------------------------------------------
   74                   
   75         000D      CR	EQU 0DH
   76         000A      LF	EQU 0AH
   77                   
   78 0126  0D 0A 4E 50 MSG1:	DEFB CR,LF,"NPUTB-CF V1.1 261025-02",CR,LF,0
   79                   
   80 0142  42 6F 6F 74 MSG2:	DEFM "Bootloader written from 1000h to drive ",BOOTDRV+'A'," on IDE/CF",CR,LF,0
   81                   
   82                   ;-----------------------------------------------------------------------------
   83                   
   84                   	END
