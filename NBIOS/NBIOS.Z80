;************************************************************************
;* NBIOS12.Z80		RDK/UH/*DG*	10/2026				*
;*									*
;* basiert direct auf der Version 3.1 841220 von Rolf-Dieter Klein	*
;* Urspruengliche Version fuer 2 Mini- und 2 Maxi-Laufwerke		*
;*									*
;************************************************************************
;
; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
;
; 24.06.2026 *dg* Kommentare hinzugefuegt
;                 Binaer identisch zur Origial-Version
; 06.07.2026 *dg* V1.0 Erste Aenderungen am BIOS. Alte Monnitor-Routinen werden
;                 nicht mehr verwendet. Laufwerksumrechnung geaendert.
;                 Version getestet.
;                 Alle Aenderungen mit bedingter Assemblierung (Flag MINI3)
;                 Testweise den Speicherbereich fuer das BIOS auf E200..EFFF
;		  geaendert. CP/M startet dann bei CC00 (58K)
; 09.07.2026 *dg* V1.0 Erweitert um 4 IDE/CF-Laufwerke - funktioniert nicht
;                 System bootet aber Schreiben auf die IDE-Laufwerke schlaegt fehl.
; 12.07.2026 *dg* - Lesen und Schreiben von CF funktioniert
; 31.07.2026 *dg* - V1.0 Laufwerk C als HD Laufwerk konfiguriert (1.44 MB)
;                 - Probleme immer beim ersten Scheiben nach dem Formatieren
; 02.08.2026 *dg* - Laufwerk B: als 5.25 Zoll HD Laufwerk
;		  - Funktioniert noch nicht, Format und Laufwerksparameter unklar 
; 03.08.2026 *dg* - BIOS Debug-Ausgaben per Ctrl-A toggle-bar
; 06.08.2026 *dg* - 5.25 Zoll Format mit 1024*8 funktioniert (1.4 MB)
;                 - 5.25 Zoll Format mit 512*15 funktioniert! (1.2 MB)
; 08.08.2026 *dg* - CF-Card Laufwerksparameter geaendert
; 09.08.2026 *dg* - Quick'n dirty fix for Warmboot from IDE/CF 
;		    (Disk-Parameter immer hardcodiert beim Warmboot aber
;                   konfigurierbar)
; 03.09.2026 *dg* - Deblocking-Parameter fuer jedes Laufwerk stehen jetzt
;                   direkt hinter den DPBx Parameter-Bloecken         
; 05.09.2026 *dg* - New 8192K format for CF/IDE with deblocking
; 06.09.2026 *dg* - Cleanup
; 08.09.2026 *dg* - Cleanup
; 19.09.2026 *dg* - Change selection of disk formats (more defines)
; 21.09.2026 *dg* - Die Ausmaskierung von Bit 7 bei CONIN herausgenommen,
;                   damit Binaer-Transfers wie zum Beispiel Xmodem ueber das
;                   BIOS funktionieren.
; 25.09.2026 *dg* - Laufwerktabelle als Includes, Erzeugung mit neuem Tool
;                   NDiskDef.exe
;                 - NBIOS10 umgenannt in NBIOS11
; 25.10.2026 *dg* - NBIOS12, Adapted to new Monitor IDE/CF routines (Drive/Sector/
;		    Track) instead of LBA
;
; Verbesserung/Veraenderungen zu BIOS 3.1 seit Juni 2026
;
; - BIOS vergroessert, dadurch geaenderte Startadressen. CP/M ab CC00-E1FF,
;   BIOS ab E200-EFFF.
; - Dateinamen geaendert, die meisten Files und Tools beginnen mit "N" zu
;   Unterscheidung von den Original-Files.
; - Die Laufwerks-Parameter können über ein Windows-Tool definiert werden.
;   Dabei werden notwendigen Include-Dateien für das BIOS und einige Tools
;   erzeugt. Die Parameter einzelner Disk-Laufwerke können dann zu Laufzeit
;   geändert werden.
; - CF/IDE eingebunden, Laufwerke E bis H, je 8 MB, E ist bootfaehig
;   (geaenderte BIOS-Parameter)
; - Blocking/Deblocking geaendert, ist jetzt flexibler und leichter zu
;   konfigurieren.
; - max. Steprate wird beim Warmstart gesetzt.
; - Debug-Ausgaben im BIOS ueber Compiler-Schalter und zur Laufzeit mit Ctrl-A
;   ein- und ausschaltbar (über Assemnbler DEFINE komplett deaktivierbar)
; - Diverse Laufwerksformate gestestet, Test mit echten 8 Zoll Laufwerken
;   steht noch aus.
; - MOVCPM und SYSGEN funktionieren mit der geaenderten BIOS-Groesse
;   vermutlich nicht mehr und muessen angasst werden (oder flexible Variante
;   verwenden).
;
; TO-DO:
;
;-----------------------------------------------------------------------------

	.LFCOND

BIOSVER EQU 12		; BIOS version 1.2

CPMVER	EQU 22		; CP/M version 2.2
FALSE	EQU 0
TRUE	EQU NOT FALSE
TEST	EQU TRUE
CR	EQU 0DH		; carriage return
LF	EQU 0AH		; line feed

;------------------------------------------------------------------------------
; Variant switches

; aktiviert alle bisherigen Aenderungen gegenueber der Originalversion 3.1
NEWIDE	EQU TRUE	; new IDE/CF format (8192 KB)

DEBOUT	EQU FALSE	; debug outputs

;------------------------------------------------------------------------------
; Monitor functions

MCONIN	EQU 0F003H	; read one char from READER device -> A
MREAD	EQU 0F006H	; read one char from READER device -> A
MCONOUT	EQU 0F009H	; write one char to CONSOLE (C)
MPUNCH	EQU 0F00CH	; write one char to PUNCH device (C)
MLIST	EQU 0F00FH	; write one char to LIST device (C)			
MCONST	EQU 0F012H	; get console status
MSTART	EQU 0F01EH	; restart Monitor
MFLOP	EQU 0F021H	; new Mini/Maxi routine in Monitor
MIDERD	EQU 0F02AH	; read sector from mini/maxi floppy
MIDEWR	EQU 0F02DH	; write sector to mini/maxi floppy
MWARM	EQU 0F033H	; Monitor warm start, will be overwritten by BIOS
MWRSTR	EQU 0F036H	; Write string, will be overwritten by BIOS (do no call!)

MDEBDEC	EQU 0F039H	; debug output 16 bit unsigned decimal in HL
MDEBX16	EQU 0F03CH	; debug output 16 bit unsigned hex in HL
MDEBX8	EQU 0F03FH	; debug output 8 bit unsigned hex in A

;------------------------------------------------------------------------------
; CPM and BIOS sizes and addresses

MSIZE 	EQU 58			; actual memory size of this BIOS (58K)
;MSIZE 	EQU 59			; actual memory size of this BIOS (58K)
;MSIZE 	EQU 60			; default memory size model (60K)

BIAS	EQU (MSIZE - 20) * 1024	; smallest memory model is 20K
CCP	EQU 3400H + BIAS	; start of CCP (CP/M), smallest memory model starts at 3400h
BDOS	EQU CCP + 806H		; BDOS entry behind 6 byte serial number, size of CCP is 800h
CPML	EQU 1600H		; length of CP/M (CCP + BDOS)
BIOS	EQU CCP + CPML		; start of BIOS

BDOSADR	EQU BDOS - 6		; actual start address of BDOS (used for patches)

CPMB	EQU CCP			; CP/M boot entry

NSECTS	EQU CPML / 128		; Number of logical sectors ocupied by CP/M
				; (used for for WBOOT)

	IF FALSE
	
;BTDRV	EQU 0		; drive A:
BTDRV	EQU 4		; drive E: (IDE/CF)

	; boot from disk A (800KB NDE/NKC format)
	IF BTDRV = 0	; drive A
CPMST	EQU 8		; start sector of CP/M on disk with 1024 bytes/sector
BTSECN	EQU 40		; sector per track (< 128!)
	ENDIF
	
	; boot from IDE/CF
	IF BTDRV = 4	; drive E
CPMST	EQU 2		; start sector of CP/M on IDE/CF (second sector)
BTSECN	EQU 127		; logical sector per track or any number: BTSEC + NSECS < BTSECN < 128
	ENDIF

	ENDIF	; FALSE

;-----------------------------------------------------------------------------
; Memory addresses below 0100h

JWARM	EQU 0000H	; JMP to WBOOT
IOBYTE	EQU 0003H	; Address of IOBYTE
CDISK	EQU 0004H	; Address of last used drive and user (low-nibble: current drive, high-nibble: current user)
JBDOS	EQU 0005H	; JMP to BDOS
JRST7	EQU 0038H	; JMP RST7 (7*8)
BUFF	EQU 0080H	; buffer address
RETRY	EQU 5		; Fehlerversuche bei BOOT und Maxi Read/Write

;-----------------------------------------------------------------------------

	ORG BIOS	; regular start of BIOS
	;ORG BIOS-4000H	; for debugging

STARTBIOS:

	JP BOOT		; Cold boot

	; --- start of offical BIOS calls ---
	
WBOOTE:	JP WBOOT	; Warm boot (CTRL-C)
	JP MCONST	; Get CONSOLE status -> A, 0FFh if character available
	JP CONIN	; Input character from CONSOLE -> A
	JP MCONOUT	; Output character to CONSOLE (C)
	JP MLIST	; Output character to LIST device (C)
	JP MPUNCH	; Output character to PUNCH device (C)
	JP MREAD	; Input character from READER device -> A

	JP HOME		; Select track home position (no execution)
	JP SELDSK	; Select drive, drive 0..n-1 in C, returns disk parameter header block in HL
	JP SETTRK	; Select track for read/write, track in C (logic tracks!!! e.g. 0..159)
	JP SETSEC	; Select sector for read/write, sector in C (logic sectors!!! e.g. 0..39)
	JP SETDMA	; Set disk read/write address (no real DMA), address in BC
	JP READ		; Read sector
	JP WRITE	; Write sector
	JP LISTST	; Listener ready? (not implemented, returns 1 = not ready)
	JP SECTRAN	; sector translation (skew only)
	
	; --- end of offical BIOS calls ---

	JP GETVER	; get BIOS version
	JP GETPHY	; get physical drive parameters (for diskcopy and similar
			; utilities)
	
	;JP FLUSH	; BDOS close and write sector buffer to disk (not used)

;-----------------------------------------------------------------------------

	; size of mini disks A, B, C
	; TRUNC(5 logical sectors * 1024 logical sector size * (2*80 tracks - 4 offset) / 2048 block size) - 1 = ca. 780 KB
	; TRUNC (5 * 1024 * (160-4)/2048) - 1 = ca. 780 K

	;DISKS 8		; define 8 drives (A..H)
NDISKS	EQU	8	

DPBASE	EQU	$		;BASE OF DISK PARAMETER BLOCKS

DPE0:	DW	XLT0,0000H	;TRANSLATE TABLE
	DW	0000H,0000H	;SCRATCH AREA
	DW	DIRBUF,DPB0	;DIR BUFF,PARM BLOCK
	DW	CSV0,ALV0	;CHECK, ALLOC VECTORS

DPE1:	DW	XLT1,0000H	;TRANSLATE TABLE
	DW	0000H,0000H	;SCRATCH AREA
	DW	DIRBUF,DPB1	;DIR BUFF,PARM BLOCK
	DW	CSV1,ALV1	;CHECK, ALLOC VECTORS

DPE2:	DW	XLT2,0000H	;TRANSLATE TABLE
	DW	0000H,0000H	;SCRATCH AREA
	DW	DIRBUF,DPB2	;DIR BUFF,PARM BLOCK
	DW	CSV2,ALV2	;CHECK, ALLOC VECTORS

DPE3:	DW	XLT3,0000H	;TRANSLATE TABLE
	DW	0000H,0000H	;SCRATCH AREA
	DW	DIRBUF,DPB3	;DIR BUFF,PARM BLOCK
	DW	CSV3,ALV3	;CHECK, ALLOC VECTORS

DPE4:	DW	0000h, 0000h
	DW	0000h, 0000h
	DW	DIRBUF, DPB4
	DW	CSV4, ALV4

DPE5:	DW	0000h, 0000h
	DW	0000h, 0000h
	DW	DIRBUF, DPB5
	DW	CSV5, ALV5

DPE6:	DW	0000h, 0000h
	DW	0000h, 0000h
	DW	DIRBUF, DPB6
	DW	CSV6, ALV6

DPE7:	DW	0000h, 0000h
	DW	0000h, 0000h
	DW	DIRBUF, DPB7
	DW	CSV7, ALV7

;-----------------------------------------------------------------------------

	$INCLUDE NBIOS.DPB

;-----------------------------------------------------------------------------
; CP/M message after cold start

SIGNON:	DB 26
	DB CR,LF,'CP/M '
	DB CPMVER/10+'0','.',CPMVER MOD 10+'0'
	DB ' for MC-Computer '
	DB MSIZE/10+'0',MSIZE MOD 10+'0'
	DB 'K',CR,LF
	DB 'NBIOS '
	DB BIOSVER/10+'0','.',BIOSVER MOD 10+'0'
	DB ' 261025-06'
	DB " BOOT=",BTDRV+'A',CR,LF

	$INCLUDE NBIOS.SIG

	DB CR,LF,0

;-----------------------------------------------------------------------------
; return BIOS version in C

GETVER	LD C,BIOSVER
	RET

;-----------------------------------------------------------------------------
; read one char from CONSOLE and clears parity bit

CONIN:	CALL MCONIN
	;AND 7FH

	IF DEBOUT

	CP A,1
	RET NZ

	; toggle debug
	LD B,A
	LD A,(DEBACT)
	XOR A,01H
	LD (DEBACT),A
	LD A,B

	ENDIF		; DEBOUT
	
	RET

;-----------------------------------------------------------------------------
; Cold boot

BOOT:	LD SP,BUFF+80H	; set stack

	LD HL,SIGNON	; output start message
	CALL PRMSG

	; DEBUG E710
	;LD A,(0E710h)
	;CALL MDEBX8
	
	; clear / set last used drive
	LD A,BTDRV
	LD (CDISK),A
	
	; sector buffer is empty, set to physical sector buffer not changed
	XOR A
	LD (BUFCHG),A
	
	; drive is undefined
	LD A,0FFH
	LD (CURDRV),A

	; disable monitor entries, set to WBOOT
	LD HL,WBOOT
	LD (MWARM+1),HL
	LD (MWRSTR+1),HL
	
	;CALL PATF	; patch BDOS close function
	CALL PATA	; patch BDOS active drive
	;CALL PATB

	; set steprate
	;LD D,00000000B	; max steprate 00b, no sso
	LD D,10000000B	; max steprate 00b, use sso
	LD B,0		; set steprate
	CALL MFLOP
	
	JP GOCPM	; start CP/M

;-----------------------------------------------------------------------------
; Warm boot

WBOOT:	; write physical sector buffer to disk if changed
	LD A,(BUFCHG)
	OR A
	JP Z,WBOO1

	CALL PUTPHS	; normalerweise ist Schreibvorgang
			; nach einem Direktoryzugriff abgeschlossen
			; ACHTUNG BUG!? PUTPHS nur fuer Mini/DD-Laufwerke
			; Bei einem anderen Laufwerk geht das wohl schief
			
WBOO1:	LD A,0FFH	; alle Tracks ungueltig, bei Diskettenwechsel wichtig
	LD (CURDRV),A

	LD SP,BUFF	; Stack zuweisen
	LD C,RETRY	; Anzahl der Versuche
	PUSH BC		; und dann anfangen zu booten

WBOO2:	; loop, load CP/M
	LD BC,CPMB	; Init load address to CPM start address
	CALL SETDMA
	LD C,BTDRV	; drive 0 (or BTDRV)
	CALL SELDSK
	LD C,0		; track 0
	CALL SETTRK
	LD C,CPMST	; start with first logical sector behind physical boot sector
	CALL SETSEC	; (depends on the number of logical sectors per phyiscal sector)
	POP BC
	LD B,NSECTS	; number of sectors for CP/M without BIOS, do not overwrite BIOS
			; to preserve patches.

	;LD C,'1'
	;CALL MCONOUT

WBOO3:	; sector read loop
	PUSH BC
	CALL READ	; read logical secor
	JP NZ,BOOTERR	; -> error
	
	LD HL,(IOD)	; increment DMA address by 128
	LD DE,128
	ADD HL,DE
	LD (IOD),HL
	LD A,(IOS)	; check for end of track
	CP BTSECN-1
	JP C,WBOO4

	; next track, Caution! track scheme is hardcoded !!!
	LD A,(IOT)	; increment track
	INC A	  	; jedoch im Verfahren 0,2,...
	INC A		; SPUR 0, dann SPUR 2, wegen BOOT.ASM
	LD (IOT),A	; denn 1,3,5 ist die Rueckseite des Laufwerks
	LD A,0FFH	; 0,1,2,3.... will by incremented to 0
	
WBOO4:	INC A
	LD (IOS),A	; set new sector
	
	POP BC		; Schleifenzaehler zuruech
	DEC B		; und immer weiter lesen
	JP NZ,WBOO3	; -> read next sector
	
	;---------------------------------------------------------------------

GOCPM:	LD BC,BUFF	; Buffer auf Default einstellen
	CALL SETDMA	; so wie es CP/M braucht
	
	LD A,0C3H	; Sprung auf den WARM-Boot im
	LD (JWARM),A	; RAM ablegen.
	LD HL,WBOOTE	; Warm-Boot-Adresse
	LD (JWARM+1),HL	; nicht vergessen
	
	LD (JBDOS),A	; Sprung auf die BDOS-CALL-Adresse
	LD HL,BDOS	; legen und auch das Ziel
	LD (JBDOS+1),HL	; dorthin
	
	LD (JRST7),A	; RST7 definieren, default ist Monitor
	LD HL,MSTART	; der aber normalerweise kurzgeschl. ist.
	LD (JRST7+1),HL		
	
	; clear / set last used drive
	;LD A,BTDRV
	;LD (CDISK),A
	;CALL PATF	; patch BDOS close function
	CALL PATA	; patch BDOS active drive
	;CALL PATB
	
	LD A,(CDISK)	; das zuletzt verwendete Laufwerk
	LD C,A		; laden und damit selektieren.
	JP CPMB

	;---------------------------------------------------------------------

BOOTERR:		; im Fehlerfalle, bei BAD-Sektor.
	POP BC		; erst mal nocheinmal versuchen
	DEC C
	JP Z,BOOTE0	; bis hoffnungslos, dann Fehlermeldung
	
	PUSH BC
	JP WBOO2	; -> try again

BOOTE0:	; Fehlermeldung ausgeben und Monitor neu starten, bzw. WBOOT
	LD HL,ERRMSG
	CALL PRMSG
	JP MSTART

ERRMSG:	; Fehlermeldung
	DB '?BOOT',0

;-----------------------------------------------------------------------------
; List status (used by BDOS)
; LST state, not used

LISTST:	NOP
	XOR A		; 0 = not ready
	RET

;-----------------------------------------------------------------------------
; Home drive (used by BDOS)

HOME:	LD C,0		; aber nur anwaehlen, nicht
	JP SETTRK	; ausfuehren

;-----------------------------------------------------------------------------
; Select disk (used by BDOS)
; drive-code in C (0..n-1)
; seldsk sets also the parameters for blocking/deblocking and for the phys.
; drive parameters. The phys. drive parameters can be request by the new
; BIOS function GETPHY.

SELDSK:	LD HL,0		; und pruefen ob gueltig
	LD A,C		; wenn groesser als ndisks
	CP NDISKS	; dann nicht ok
	RET NC		; Nummer 0 bis n-1 erscheint in A
	
	LD (DBANK),A

	;POP HL
	;PUSH HL
	;CALL DEBSEL

	; get address of DPEx -> HL (= DPBASE + disk number * 16)
	LD L,C		; disk number
	LD H,0
	ADD HL,HL	; HL <- HL * 16
	ADD HL,HL	
	ADD HL,HL	
	ADD HL,HL	
	LD DE,DPBASE	; add DPBASE
	ADD HL,DE

	; get additional deblockling parameters from the end of
	; the regluar DPBx block
	PUSH HL

	; calc start of addidtion parameters
	LD DE,10	; position of DPBx in DPEx
	ADD HL,DE
	LD E,(HL)
	INC HL
	LD D,(HL)
	EX DE,HL	; address of DPEx now in HL
	LD DE,15	; length of DPBx
	ADD HL,DE
	
	; set blocking shift
	LD A,(HL)
	LD (BLPOW),A
	INC HL
	; set blocking mask
	LD A,(HL)
	LD (BLMSK),A
	INC HL
	; set blocking FLO register
	LD A,(HL)
	LD (BLREG),A
	INC HL

	; set phys. bytes/sector
	LD E,(HL)
	INC HL
	LD D,(HL)
	INC HL
	EX DE,HL
	LD (PHYBYTS),HL
	EX DE,HL
	; set phys. sectors/track
	LD A,(HL)
	LD (PHYSECS),A
	INC HL
	; set phys. tracks/side
	LD A,(HL)
	LD (PHYTRKS),A
	INC HL
	; set phys. sides
	LD A,(HL)
	LD (PHYSIDS),A
	
	POP HL

	RET

;-----------------------------------------------------------------------------
; Select track (used by BDOS)
; track in C

SETTRK:	LD HL,IOT
	LD (HL),C
	RET

;-----------------------------------------------------------------------------
; Select sector  (used by BDOS)
; sector in C

SETSEC:	LD HL,IOS
	LD (HL),C
	RET

;-----------------------------------------------------------------------------
; Sector translation (used by BDOS)
; sector in C
; skew table in DE (or 0)
; write calculated sector to IOS and L

SECTRAN:LD A,D		; check if skew table != 0
        OR E
        JP Z,SECTR1	; =0, -> no skew

	; calc sector offset into skew table
	LD B,0
	EX DE,HL
	ADD HL,BC	; sector in C
	LD A,(HL)	; load skew value
	LD (IOS),A	; save in IOS 
	LD L,A		; and in L
        LD H,0		; was missing *dg* 27.07.2026
	RET

SECTR1:	; no skew, return sector
	LD L,C		; sector in C
        LD A,C
        LD (IOS),A	; save in IOS
        LD H,0
        RET

;-----------------------------------------------------------------------------
; Set DMA address (used by BDOS)
; address in BC

SETDMA:	LD L,C
	LD H,B
	LD (IOD),HL
	RET

;-----------------------------------------------------------------------------
; returns the physical drive parameters for the current drive

; HL = bytes/sector (1..n)
; D  = highest sector/track (0..n-1)
; E  = highest track/side (0..n-1)
; B  = sides (1..n)
; C  = FLO register (density/datarate)

GETPHY:	LD HL,(PHYBYTS)
	LD A,(PHYSECS)
	LD D,A
	LD A,(PHYTRKS)
	LD E,A
	LD A,(PHYSIDS)
	LD B,A
	LD A,(BLREG)
	AND 10110000B
	LD C,A
	RET

;-----------------------------------------------------------------------------
; 0-terminerte Text ausgaben, Adresse in HL

PRMSG: 	LD A,(HL)
	OR A
	RET Z		; -> end of text
	
	PUSH HL
	LD C,A
	CALL MCONOUT
	POP HL
	INC HL
	JP PRMSG	; -> next char

;=============================================================================
; Read and write sector using MFLOP into monitor

;-----------------------------------------------------------------------------
; Read sector

; Buffer (DMA address) in IOD
; Drive in DBANK (0..n-1)
; Track in IOT (0..n-1 * side)
; Sector in IOS (0..n-1)

READ:	; reset CF/IDE flag
	XOR A
	LD (ISIDE),A

	LD A,(DBANK)
	CP 8
	JR NC,RDERR	; DBANK >= 8 -> does not exist
	
	; DBANK < 8
	LD A,(BLREG)
	AND 10000000B	; flag for IDE disk
	JR Z,READ1	; -> no IDE disk

	; IDE disk
	LD A,1
	LD (ISIDE),A
	JP MINIRD	; -> IDE disk

READ1:	LD A,(BLREG)
	AND 00110000B
	CP 00010000B	; flag for Maxi disk (bit5=0, bit4=4)
	JP Z,MAXIRD	; -> Maxi disk
	JP MINIRD	; -> Mini disk

	;---------------------------------------------------------------------

	; error
RDERR:	LD A,1		; Fehler da, Bank nicht vorhanden,
	RET		; wirkt wie BAD-Sektor

	;---------------------------------------------------------------------
	
NOERR:	XOR A		; sonst ok.
	RET

	;---------------------------------------------------------------------
	; Calculate address for ram disk, source in HL
	; SEKTOR 0..E,  TRAck 0..5fh
	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
ADRERZ:	LD A,(IOT)		; Track holen
 	RRCA 			; und umrechnen
 	AND 0FH			; unterer Teil vom MSB
 	LD H,A
 	LD A,(IOS)		; dann Sektor dazu
 	RLCA
 	RLCA
 	RLCA
 	RLCA
 	AND 0F0H
 	OR H
 	LD H,A			; damit sssstttt ok
 	LD A,(IOT)
 	RRCA			; txxxxxxx
 	AND 80H
 	LD L,A			; t0000000
 	LD A,(IOT)		; nun noch bank bestimmen, in c und b	
 	RLCA			; und dazu msb-Teil des Tracks verwenden
 	RLCA			; 0mmttttt
 	RLCA			; Banknummer
 	AND 03H			; 000000mm
	ADD A,1			; erst ab Bank 1 starten
 	LD B,A			; da BANK 0=CP/M RAM und TPA
 	LD C,A			; ok beide definiert
 	RET

;-----------------------------------------------------------------------------
  
; Umrechnen fuer Maxi fuer neue Monitor Floppy-Routine
; drive-code -> C

MAXCAL:	; drive A,B,C,D -> 0001,0010,0100,1000
	LD A,(DBANK)	; 0..3
	INC A		; -> 1..4
	LD B,A
	SCF		; shift in carry
MAXC2:	RLA
	DJNZ MAXC2
	
	LD B,A
	LD A,(BLREG)
	OR B
	LD C,A

	LD A,(DBANK)
	CP 4
	JP NZ,MAXC3
	
	; drive E, side 1
	LD A,C
	OR 10000000B
	LD C,A

MAXC3:	RET

;-----------------------------------------------------------------------------
; Read Maxi disk

MAXIRD:	LD B,RETRY	; Anzahl der Leseversuche

MAXIR1:	; retry loop
	PUSH BC		; dann ausfuehren
	LD HL,(IOD)	; Zieladresse holen
	LD A,(IOT)	; Spurnummer
	LD D,A	
	LD A,(IOS)	; Sektornummer
	LD E,A
	LD B,1		; Lese-Befehlscode
	CALL MAXCAL	; vorher Laufwerkscode umrechnen
	CALL MFLOP	; und dann ausfuehren
	POP BC		; Retry-Zaehler
	RET Z		; kein Fehler, dann ok zurueck
	DEC B		; sonst nochmals probieren
	JP NZ,MAXIR1	; -> retry		
	
	LD A,1		; BAD SEKTOR
	OR A
	RET

;-----------------------------------------------------------------------------
; Write sector using MFLOP into monitor

; Buffer (DMA address) in IOD
; Drive in DBANK (0..n-1)
; Track in IOT (0..n-1)
; Sector in IOS (0..n-1)
; BDOS-Flag in C (0 = standard sector, 1 = directory sector, 2 =  first sector in block)

WRITE:	; reset CF/IDE flag
	XOR A
	LD (ISIDE),A
	
	LD A,(DBANK)
	CP 8
	JR NC,WRERR	; DBANK >= 8 -> does not exist

	; DBANK < 8
	LD A,(BLREG)
	AND 10000000B	; flag for IDE disk
	JR Z,WRITE1	; -> no IDE disk

	; IDE disk
	LD A,1
	LD (ISIDE),A
	JP MINIWR	; -> IDE disk
	
WRITE1:	LD A,(BLREG)
	AND 00110000B
	CP 00010000B
	JP Z,MAXIWR	; -> Maxi disk
	JP MINIWR
	
	;---------------------------------------------------------------------

	; error
WRERR:	LD A,1		; Fehler da, Bank nicht vorhanden,
	RET		; wirkt wie BAD-Sektor

	;---------------------------------------------------------------------
	; Write Maxi disk

MAXIWR:	LD B,RETRY

MAXIW1:	PUSH BC		; Dazu Fehlerzaehler retten

	LD HL,(IOD)	; Quelleadresse laden
	
	LD A,(IOT)	; Spur
	LD D,A
	
	LD A,(IOS)	; Sektor
	LD E,A
	
	LD B,2		; Schreib-Befehlscode
	CALL MAXCAL	; vorher Laufwerk umrechnen
	CALL MFLOP	; und ausfuehren
	POP BC	
	RET Z		; -> no error
	
	DEC B
	JP NZ,MAXIW1	; -> retry
	
	LD A,1		; bad sector
	OR A
	RET

;-----------------------------------------------------------------------------
; Flush current sector buffer

	IF FALSE

FLUSH:	; BDOS close file
	JP BDOSADR + 08A2H

	; write sector buffer to disk if changed
	LD A,(BUFCHG)
	OR A
	RET Z
	JP PUTPHS

	ENDIF	; FALSE

;=============================================================================
; Read Mini disk, 80 Spur, DD, DS

;READ und WRITE unter Verwendung von MEXEC
; HL=DMA ADR
; DE=TRACK/SECTOR
; B=0 RSTORE
;   1 READ
;   2 WRITE
; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
;                                          A   C    B    D

PHSBUF	EQU 0FC00H	; Memory area of interactive Monitor for logical sector (1K)

;-----------------------------------------------------------------------------
; Calculates physical drive from DBANK and IOT -> C
; calculates physical sector from logical sector, IOS -> E
; calculates logical track from physical track, IOT -> D

MINCAL:	; logical sector to physical sector
	; get drive specific factor
	LD A,(BLPOW)
	AND A
	JR Z,MINIC4	; -> factor = 0

	LD B,A		; factor
	LD A,(IOS)	; logical sector
MINIC2:	SRL A
	DJNZ MINIC2
	
	JR MINIC5

MINIC4:	; factor = 0
	LD A,(IOS)

MINIC5:	INC A		; sector number starts with 1
	LD E,A		; save in E

	LD A,(ISIDE)
	AND A
	JR Z,MINC5A	; -> no CF/IDE drive

	; -> is CF/IDE drive, no drive or track translation
	LD A,(DBANK)
	LD C,A
	LD A,(IOT)
	LD D,A
	RET

MINC5A:	; drive A,B,C,D -> 0001,0010,0100,1000
	LD A,(DBANK)	; 0..3
	INC A		; -> 1..4
	LD B,A
	XOR A
	SCF		; shift in carry
MINIC6:	RLA
	DJNZ MINIC6

	LD B,A
	LD A,(BLREG)
	OR B
	LD C,A

	LD A,(IOT)
	SRL A		; Track / 2, Bit0 -> Carry (side 1)
	LD D,A		; Track merken
	JP NC,MINIC7	; -> side 0

	; side
	LD A,C
	OR 10000000B	; side 1 flag
	LD C,A
	
MINIC7:	; D=track, E=sector, C=drive-code + side
	RET

;-----------------------------------------------------------------------------
; Lookup table, table in HL, offset in A

	IF FALSE

LOOKUP:	PUSH DE
	LD E,A
	LD D,0
	ADD HL,DE
	LD A,(HL)
	POP DE
	RET
	
	ENDIF
	
;-----------------------------------------------------------------------------
; Read Mini disk
; DBANK, IOT, IOS,

MINIRD:	CALL MINCAL	; calc physical drive and sector data for compare

	LD A,(CURDRV)
	CP C		; compare drive + side
	JP NZ,MINIR2	; -> drive not equal, load sector
	
	LD A,(CURTRK)
	CP D		; compare track
	JP NZ,MINIR2	; -> track not equal, load sector
	
	LD A,(CURSEC)
	CP E		; compare sector
	JP NZ,MINIR2	; -> sector not equal, load sector

	; blocking / deblocking

MINIR1:	; actual physical sector is now in buffer PHSBUF

	CALL CALCPHS	; (PHSBUF+offset) -> DE, (IOD) -> HL, BC = 128
	EX DE,HL
	LDIR		; (DE++) <- (HL++), BC--
			; (IOD) <- (PHSBUF+offset), 128 Byte

	XOR A
	RET		; -> finished without error

MINIR2:	; neuen Sektor laden, ggf. alten zurueckschreiben
	LD A,(BUFCHG)
	OR A
	JP Z,MINIR3

	CALL PUTPHS	; ALTEN ZURUECKSCHREIBEN
	JP C,ERRIO

MINIR3:	CALL MINCAL	; BERECHNEN

	LD A,C
	LD (CURDRV),A
	LD A,E
	LD (CURSEC),A
	LD A,D
	LD (CURTRK),A
	CALL GETPHS	; neuen Sektor lesen
	JP C,ERRIO	; Fehler aufgetreten
	
	JP MINIR1

;-----------------------------------------------------------------------------
; Write Mini disk
; BDOS-Flag in C

MINIWR:	LD A,C
	LD (ISDIR),A	; flag for Directory Write (1=write)

	CALL MINCAL	; calc physical sector and drive data for compare

	LD A,(CURDRV)	; und wie bei MINIRD
	CP C		;
	JP NZ,MINIW3	; other drive -> load sector

	LD A,(CURTRK)
	CP D
	JP NZ,MINIW3	; other track -> load sector

	LD A,(CURSEC)
	CP E
	JP NZ,MINIW3	; other sector -> load sector

	; blocking / deblocking
	
MINIW1:	; actual physical sector is now in PHSBUF

	CALL CALCPHS	; (PHSBUF+offset) -> DE, (IOD) -> HL, BC = 128
	LDIR		; (DE++) <- (HL++), BC--
			; (PHSBUF+Offset) <- (IOD), 128 Byte
	LD A,1
	LD (BUFCHG),A	; set buffer changed flag
	
	LD A,(ISDIR)
  	CP 1
	JP NZ,MINIW2	; -> no directory sector

	; directory sector: do not cache
	CALL PUTPHS 
	JP C,ERRIO	; if error then bad sector

MINIW2:	; -> finished without error
	XOR A
	RET

MINIW3:	; load new sector, write current if changed
	LD A,(BUFCHG)
	OR A
	JP Z,MINIW4
	
	CALL PUTPHS	; write current sector to disk
	JP C,ERRIO
	
MINIW4:	CALL MINCAL	; calc physical drive and sector data
	LD A,C
	LD (CURDRV),A
	LD A,E
	LD (CURSEC),A
	LD A,D
	LD (CURTRK),A
	CALL GETPHS
	JP C,ERRIO

	; no error
	JP MINIW1

;-----------------------------------------------------------------------------

ERRIO:	LD A,1	; Fehler aufgetreten
	OR A
	RET

;-----------------------------------------------------------------------------
; Calculates the pointer into PHSBUF based on sector number in IOS
; (PHSBUF + offset) -> DE
; (IOD) -> HL
; 128 -> BC (logical sector length)

CALCPHS:
	LD A,(BLMSK)
	LD B,A

	LD A,(IOS)	; logical sector number (0..n-1)
	AND B
	LD D,A		; load to high-byte (mul 256)
	LD E,0
	SRA D		; div/2 by shift right
	RR E
	; now we have (IOS mod SECSIZE) * 128 in DE
	LD HL,PHSBUF
	ADD HL,DE	; pointer into PHSBUF in DE
	
	IF DEBOUT
	;LD C,'['
	;CALL MCONOUT
	;CALL MDEBX16
	;LD C,']'
	;CALL MCONOUT
	ENDIF
	
	EX DE,HL
	LD HL,(IOD)
	LD BC,128
	RET

;-----------------------------------------------------------------------------
; Read physical sector to PHSBUF
; Mini disk only
; TRKAKT,SEKAKT,DRVAKT ENTHALTEN NEUE BUFFERADRESSE

GETPHS:	; reset buffer changed flag
	XOR A		
	LD (BUFCHG),A

	LD A,(ISIDE)
	AND A
	JR NZ,GETIDE	; -> CF/IDE drive

	; floppy drive
	LD HL,PHSBUF	; buffer address for data
	LD A,(CURSEC)
	LD E,A
	LD A,(CURDRV)	; bit0..3 and side in bit7
	LD C,A
	LD B,1		; 1 = read
	LD A,(CURTRK)
	LD D,A
	
	CALL MFLOP	; -> new floppy routine
	JP C,PHSERR

	;IF DEBOUT
	;CALL DEBPHY
	;ENDIF
	
	; no error
	XOR A
	RET

	;---------------------------------------------------------------------

GETIDE:	; handle CD/IDE drive
	LD HL,PHSBUF	; buffer
	LD A,(CURDRV)
	SUB A,4
	LD C,A		; volume (0..3)
	LD A,(CURSEC)
	LD E,A		; sector (0..127)
	LD A,(CURTRK)
	LD D,A		; track (0..255)
	CALL MIDERD	; read sector from IDE/CF
	AND 01h
	RET

	;---------------------------------------------------------------------

PHSERR:	
	;IF DEBOUT
	;LD C,'*'
	;CALL MCONOUT
	;ENDIF

	SCF
	RET

;-----------------------------------------------------------------------------
; Write PHSBUF to physical sector
; Mini disk only

PUTPHS:	; reset buffer changed flag
	XOR A
	LD (BUFCHG),A

	LD A,(ISIDE)
	AND A
	JR NZ,PUTIDE	; -> CF/IDE drive
	
	; floppy drive
	LD HL,PHSBUF	; buffer address
	LD A,(CURSEC)
	LD E,A
	LD A,(CURDRV)	; bit0..3 and side in bit7
	LD C,A
	LD B,2		; 2 = write
	LD A,(CURTRK)
	LD D,A

	IF DEBOUT
	CALL DEBPHY
	ENDIF

	CALL MFLOP	; -> new floppy routine
	JP C,PHSERR

	; no error
	XOR A
	RET

	;---------------------------------------------------------------------

PUTIDE:	; handle CD/IDE drive
	LD HL,PHSBUF	; buffer
	LD A,(CURDRV)
	SUB A,4
	LD C,A		; volume (0..3)
	LD A,(CURSEC)
	LD E,A		; sector (0..127)
	LD A,(CURTRK)
	LD D,A		; track (0..255)
	CALL MIDEWR	; write sector to IDE/CF
	AND 01h
	RET

;-----------------------------------------------------------------------------
; Delay loop 40ms..10ms (???)

	IF FALSE

DELAY:	PUSH BC
	;LD BC,0D05H
	LD BC,2000H

DELAY1:	DEC BC
	LD A,C
	OR B
	JP NZ,DELAY1
	
	POP BC
	RET
	
	ENDIF

;------------------------------------------------------------------------------
; Patch BDOS close function

	IF FALSE

PATFADR	EQU BDOSADR + 0CA8H

PATF:	LD IX,PATFADR
	LD A,(IX)
	CP 0C3h		; Z80 JP
	JR NZ,PATF1	; -> patch data does not match, do not patch

	LD A,LOW FLUSH
	LD (IX+1),A
	LD A,HIGH FLUSH
	LD (IX+2),A
	
PATF1:	RET

	ENDIF

;------------------------------------------------------------------------------
; Patch BDOS drive initialisation

PATAADR	EQU BDOSADR + 0C8CH
;BDPADR	EQU	0E043h
BDACT	DW 0			; BDOS active drive address

PATA:	LD IX,PATAADR
	LD A,(IX)
	CP 0AFh			; Z80 XOR A
	JR NZ,PATA1		; -> patch data does not match, do not patch
	
	LD A,(IX+1)
	CP 032h			; Z80 LD (abs),A
	JR NZ,PATA1		; -> patch data does not match, do not patch

	LD A,(IX+2)
	LD L,A
	LD A,(IX+3)
	LD H,A
	LD (BDACT),HL

	LD (IX+1),0CDh		; Z80 CALL
	LD (IX+2),LOW PATACL
	LD (IX+3),HIGH PATACL

	;LD C,'+'
	;CALL MCONOUT

	;---------------------------------------------------------------------
	; BDOS patch: init BDOS active drive

PATACL:	LD HL,(BDACT)
	LD A,BTDRV
	LD (HL),A

	;PUSH BC
	;LD C,'!'
	;CALL MCONOUT
	;LD A,(ACTIVE)
	;ADD '0'
	;LD C,A
	;CALL MCONOUT
	;POP BC
	RET

PATA1:	;LD C,'-'
	;CALL MCONOUT
	RET

;-----------------------------------------------------------------------------

	IF FALSE

PADBADR	EQU 0D75BH

PATB:	LD IX,PADBADR
	LD A,(IX)
	CP 03Ah			; Z80 LD A,(abs)
	JP NZ,PATB1		; -> patch data does not match, do not patch

	LD (IX+0),0CDh		; Z80 CALL
	LD (IX+1),LOW PATBCL
	LD (IX+2),HIGH PATBCL

	LD C,'*'
	CALL MCONOUT

	;---------------------------------------------------------------------
	; BDOS patch

ACTIVE	EQU 0D744h

PATBCL:	LD C,'X'
	CALL MCONOUT
	LD A,(ACTIVE)	
	PUSH AF
	ADD A,'0'
	LD C,A
	CALL MCONOUT
	POP AF
	RET

PATB1:LD C,'-'
	CALL MCONOUT
	RET

	ENDIF		; FALSE

;=============================================================================
; Debuging routines

;-----------------------------------------------------------------------------
; Debug Read/Write physical sector
; B=1: read, B=2: write

	IF DEBOUT

DEBPHY:	LD A,(DEBACT)
	AND A,01H
	RET Z

	PUSH BC
	PUSH HL
	LD L,C		; save drive code
	
	LD C,'['
	CALL MCONOUT
	LD C,'P'
	CALL MCONOUT
	
	LD A,B
	;PUSH AF
	CP 1		; read
	JR NZ,DEBPH1	; -> write

	; read
	LD C,'R'
	JR DEBPH2

DEBPH1:	; write
	LD C,'W'

DEBPH2:	CALL MCONOUT

	LD C,','
	CALL MCONOUT

	; drive code in L
	LD A,L
	AND 10001111B
	;LD H,0
	CALL MDEBX8

	LD C,','
	CALL MCONOUT

	; track
	LD A,D
	CALL MDEBX8

	LD C,','
	CALL MCONOUT

	; sector
	LD A,E
	CALL MDEBX8

	LD C,']'
	CALL MCONOUT

	;POP AF
	;CP 1		; read
	;JR NZ,DEBPH3	; -> write

	; read
	CALL DEBLK

DEBPH3:	POP HL
	POP BC
	RET

	ENDIF

;-----------------------------------------------------------------------------

	IF DEBOUT

DEBLK:	PUSH DE

	LD C,'<'
	CALL MCONOUT

	LD HL,PHSBUF
	LD B,8

DEBLK1:	; loop B=8..1
	LD A,(HL)
	CALL MDEBX8
	LD C,'-'
	CALL MCONOUT

	INC HL
	LD A,(HL)
	CALL MDEBX8
	LD C,'-'
	CALL MCONOUT
	
	INC HL
	LD A,(HL)
	CALL MDEBX8
	LD C,','
	CALL MCONOUT

	DEC HL
	DEC HL
	LD DE,80H
	ADD HL,DE
	DJNZ DEBLK1
	
	LD C,'>'
	CALL MCONOUT

	POP DE
	
	RET

	ENDIF

;-----------------------------------------------------------------------------
; Debug output (DBANK) (READ/WRITE)

	IF FALSE

DEBDRV:	PUSH BC

	PUSH HL

	LD C,'['
	CALL MCONOUT
	LD C,'F'
	CALL MCONOUT
	LD A,(DBANK)
	LD L,A
	CALL MDEBDEC
	LD H,0
	
	LD C,','
	CALL MCONOUT
	POP HL
	CALL MDEBDEC
	LD C,']'
	CALL MCONOUT

	POP BC
	RET

	ENDIF

;-----------------------------------------------------------------------------
; Debug SELDRV

	IF FALSE

DEBSEL:	PUSH BC

	PUSH HL

	LD C,'['
	CALL MCONOUT
	LD C,'S'
	CALL MCONOUT
	LD A,(DBANK)
	LD L,A
	LD H,0
	CALL MDEBDEC
	
	LD C,','
	CALL MCONOUT
	POP HL
	CALL MDEBDEC
	LD C,']'
	CALL MCONOUT

	POP BC
	RET

	ENDIF

;-----------------------------------------------------------------------------
; Display drive, track, sector E,B,C
; D = read, write

	IF FALSE

DEBIDE:	;LD A,(DEBACT)
	;AND A,01H
	;RET Z

	PUSH HL
	PUSH BC
	PUSH DE

	LD L,D		; save D in L (read/write)
	LD D,C		; save C in D (sector)

	LD C,'['
	CALL MCONOUT

	; Read / Write
	LD C,L
	CALL MCONOUT

	; drive
	LD A,E
	CALL MDEBX8

	LD C,' '
	CALL MCONOUT

	; sectors
	LD A,B
	CALL MDEBX8
	
	LD C,' '
	CALL MCONOUT

	; tracks
	LD A,D		; saved sector in D
	CALL MDEBX8

	LD C,']'
	CALL MCONOUT
	LD C,CR
	CALL MCONOUT
	LD C,LF
	CALL MCONOUT

	POP DE
	POP BC
	POP HL
	RET

	ENDIF

;-----------------------------------------------------------------------------
; debug BDOS buffer, first 3 characters
; pointer in DMA, A=0: read, A=1: write

	IF FALSE

DEBBUF:	PUSH HL
	PUSH BC

	LD B,A		; read / write
	
	LD A,(DEBACT)
	AND A,01H
	JR Z,DEBBU3

	LD C,'['
	CALL MCONOUT
	
	LD A,B		; read/write
	CP A,1		; -> write
	JP NZ,DEBBU1
	
	; read
	LD C,'R'
	JR DEBBU2

DEBBU1:	; write
	LD C,'W'

DEBBU2:	CALL MCONOUT
	LD C,','
	CALL MCONOUT
	
	LD HL,(IOD)
	
	LD A,(HL)
	CALL MDEBX8	
	LD C,','
	CALL MCONOUT

	INC HL
	LD A,(HL)
	CALL MDEBX8	
	LD C,','
	CALL MCONOUT

	INC HL
	LD A,(HL)
	CALL MDEBX8	

	LD C,']'
	CALL MCONOUT

DEBBU3:	POP BC
	POP HL
	RET

	ENDIF

;=============================================================================

; BIOS data area

BUFCHG:	DB 0		; flag if PHSBUF is changed
CURDRV:	DB 0FFH		; DRIVE das geladen ist
CURDPB:	DW 0		; current disk parameter block
CURTRK:	DB 0		; TRACK 
CURSEC:	DB 0		; SEKTOR
ISDIR:	DB 0		; 1 = is directory write

DBANK:	DB 0		; selected disk
;IOPB:	DW 1		; address of DPB of selected disk
IOT:	DB 4		; track number (offset des boot laufwerks)
IOS:	DB 1		; NUMMER DES GEWUENSCHTEN SEKTORS
IOD:	DW BUFF		; DMA-ADRESSE
	
	; deblocking parameters for current drive
BLPOW:	DB 1		; power (shift) value
BLMSK:	DB 1		; sector mask (modulo value)
BLREG:	DB 1		; density/datarate bits for special FLO register (FLO+4)
ISIDE	DB 1

	; phys. parameters of current drive
PHYBYTS: DW 0		; bytes/sectors (1..n)
PHYSECS: DB 0		; highest sectors/track (0..n-1)
PHYTRKS: DB 0		; highest tracks per side (0..n-1)
PHYSIDS: DB 0		; sides (1..n)

	IF DEBOUT
DEBACT:	DB 0
	ENDIF

	; floppy data area

BEGDAT	EQU	$
DIRBUF:	DS	128	;DIRECTORY ACCESS BUFFER

;-----------------------------------------------------------------------------

	$INCLUDE NBIOS.ALV

;-----------------------------------------------------------------------------
	
ENDDAT	EQU	$
DATSIZ	EQU	$-BEGDAT

ENDBIOS:

SIZE	EQU ENDBIOS-STARTBIOS

	END
	  
; END OF FILE
