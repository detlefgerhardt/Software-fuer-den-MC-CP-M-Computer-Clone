Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NPUTS-CFZ80

    1                   ;*****************************************************************************
    2                   ; NPUTS-CF.Z80 V1.0
    3                   ;
    4                   ; Writes CP/M and BIOS from memory (notice start addresses to the IDE/CF
    5                   ; Interface
    6                   ;
    7                   ; based on PUTSYS from Donn Stewart, June 2019
    8                   ; changed by Ulrich Haumann 04/2026
    9                   ;
   10                   ;*****************************************************************************
   11                   ; Image size is 6400 bytes, so need to save 6400/128 = 50 sectors
   12                   ; For system with 64-sector tracks, image can all be on track 0
   13                   ; Load and run from ROM monitor
   14                   ; Uses calls to cbios, in memory at EA00h
   15                   ; benuzt calls zum Monitor im oberen RAM F000h
   16                   ; Copies the memory image of CP/M loaded at CPM onto track 0 of the first CP/M disk
   17                   ; Writes track 0, sectors 1 to 50 (sector 0 has cpm loader)
   18                   ;
   19                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS AND IDE/CF DRIVES !!!
   20                   ;
   21                   ; Version history
   22                   ;
   23                   ; 10.07.2026 *dg* Renamed to PUTSY-CF and reformatted
   24                   ;                 Changed BIOS address to E200
   25                   ;		  Changed for CF/IDE drives 4..7 (E..H)
   26                   ; 09.08.2026 *dg* Renamed to NPUTS-CF, Jump to BIOS when finished,
   27                   ;		  because the program uses the BIOS and overwrites the monitor.
   28                   ; 23.10.2026 *dg* Change system start on disk to second logical sector.
   29                   ;		  Added some comments
   30                   
   31         0000      FALSE	EQU 0
   32         FFFF      TRUE	EQU NOT FALSE
   33         FFFF      TEST	EQU TRUE
   34         000D      CR	EQU 0DH
   35         000A      LF	EQU 0AH
   36                   
   37         FFFF      NEWIDE	EQU TRUE	; new 8192 KB format
   38                   
   39         CC00      CPM	EQU 0D400H-800H
   40         E200      BIOS	EQU 0EA00H-800H
   41                   
   42                   ; Monitor calls
   43                   
   44                   ;MWARM	EQU 0F033H	; Monitor entry
   45                   
   46                   ; bios calls
   47                   
   48         E20C      CONOUT	EQU BIOS+00CH	; output char in C
   49         E21B      SELDSK	EQU BIOS+01BH	; pass disk no. in c
   50         E224      SETDMA	EQU BIOS+024H	; pass address in bc
   51         E21E      SETTRK	EQU BIOS+01EH	; pass track in reg C
   52         E221      SETSEC	EQU BIOS+021H	; pass sector in reg c
   53         E22A      WRITE	EQU BIOS+02AH	; write one CP/M sector to disk
   54                   
   55         0004      BOOTDRV	EQU 4		; first IDE/CF-drive
   56                   
   57                   ; This program uses the BIOS and logical sectors to write the system to
   58                   ; disk. The logical sector size is always 128 byte.
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NPUTS-CFZ80

   59                   ; The system's start sector is the first logcial sector of the first physical
   60                   ; sector. The first phyiscal sector is the boot sector.
   61                   ; By default, one tracks is reserved for the boot sector and the system.
   62                   
   63         0000      	IF NOT NEWIDE
   67                   	ELSE
   68         0002      SECSTRT	EQU 2		; 1. logical sector after phyiscal boot sector
   69         0048      SECCNT	EQU (0F000h-CPM) / 128
   70                   	ENDIF
   71                   	
   72                   ;-----------------------------------------------------------------------------
   73                   
   74         0100      	ORG 100H	; program starts at 100H
   75                   
   76                   ; write track 0, sectors 1 to SECCNT
   77                   ; only one system track available!
   78                   
   79 0100  21 0159     PUT:	LD HL,MSG1
   80 0103  CD 014E     	CALL WRSTR
   81                   
   82 0106  0E 04       	LD C,BOOTDRV	; first CF/IDE drive
   83 0108  CD E21B     	CALL SELDSK
   84 010B  3E 02       	LD A,SECSTRT	; starting with 2. physical sector (0..n-1)
   85 010D  32 019C     	LD (SECTOR),A
   86 0110  21 CC00     	LD HL,CPM	; memory address to start
   87 0113  22 019D     	LD (ADDR),HL
   88 0116  0E 00       	LD C,0		; CP/M track
   89 0118  CD E21E     	CALL SETTRK
   90                   
   91 011B              PUT1:	; track loop
   92 011B  3A 019C     	LD A,(SECTOR)
   93 011E  4F          	LD C,A		; CP/M sector
   94 011F  CD E221     	CALL SETSEC
   95 0122  ED 4B 019D  	LD BC,(ADDR)	; memory location
   96 0126  CD E224     	CALL SETDMA
   97 0129  CD E22A     	CALL WRITE
   98 012C  3A 019C     	LD A,(SECTOR)
   99                   	;CP 50
  100 012F  FE 48       	CP SECCNT
  101 0131  CA 0145     	JP Z,PUT2
  102                   		
  103 0134  3C          	INC A
  104 0135  32 019C     	LD (SECTOR),A
  105 0138  2A 019D     	LD HL,(ADDR)
  106 013B  11 0080     	LD DE,128
  107 013E  19          	ADD HL,DE
  108 013F  22 019D     	LD (ADDR),HL
  109 0142  C3 011B     	JP PUT1
  110                   
  111 0145              PUT2:	; finished
  112 0145  21 0175     	LD HL,MSG2
  113 0148  CD 014E     	CALL WRSTR
  114                   
  115 014B  C3 E200     	JP BIOS
  116                   
  117                   ;-----------------------------------------------------------------------------
  118                   ; Uses BIOS CONOUT to print 0-terminated string
  119                   ; address in HL
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NPUTS-CFZ80

  120                   
  121 014E  7E          WRSTR:	LD A,(HL)	; get char from string
  122 014F  A7          	AND A		; check if 0
  123 0150  C8          	RET Z		; -> end of string
  124                   	
  125 0151  4F          	LD C,A
  126 0152  CD E20C     	CALL CONOUT
  127 0155  23          	INC HL		; next char in string
  128 0156  C3 014E     	JP WRSTR	; start over
  129                   
  130                   ;-----------------------------------------------------------------------------
  131                   
  132 0159  0D 0A 4E 50 MSG1:	DEFB CR,LF,"NPUTS-CF V1.1 260905-02",CR,LF,0
  133                   	
  134 0175  53 79 73 74 MSG2:	DEFM "System written to drive ",BOOTDRV+'A'," on IDE/CF",CR,LF,LF,0
  135                   
  136                   ;-----------------------------------------------------------------------------
  137                   
  138 019C  00          SECTOR:	DB	00H
  139 019D  0000        ADDR:	DW	0000H
  140                   
  141                   ;-----------------------------------------------------------------------------
  142                   
  143                   	END
