Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NPUTBOOTZ80

    1                   	.Z80
    2                   ;**********************************************************************
    3                   ;* NPUTBOOT.Z80
    4                   ;*
    5                   ;* Write Bootloader from memory location 1000H to Disk.
    6                   ;* This program is designated to be started from the Monitor.
    7                   ;*
    8                   ;* based on LOAD80.Z80 by U. Haumann 07.05.2026
    9                   ;*
   10                   ;**********************************************************************
   11                   ; Der Boot Loader muss sich an Adresse 1000H befinden							
   12                   ; 80 Spur Laufwerke   1K pro Sektor Boot       
   13                   ;
   14                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS !!!
   15                   ;
   16                   ; Version history
   17                   ;
   18                   ; 10.07.2026 *dg* Renamed to NPUTBOOT and reformatted source code
   19                   ; 11.07.2026 *dg* Use new floppy routine 0F021h in Monitor
   20                   ; 09.08.2026 *dg* Added output version and error message
   21                   
   22                   ;-----------------------------------------------------------------------------
   23                   
   24         0100      	ORG	0100H		
   25                   
   26         9800      OFFSET	EQU 0A000H-800H		; damit BIOS Start bei E200h
   27         CC00      CPMB	EQU 03400H+OFFSET	; start CP/M
   28         E200      BIOS	EQU 04A00H+OFFSET	; start BIOS
   29                   
   30                   ; Monitor functions
   31         F009      CONOUT	EQU 0F009h	; Output a chracter
   32                   ;RSTRT	EQU 0F01EH	; Restart routine in Monitor
   33         F021      FLOP	EQU 0F021H	; Monior Floppy routine
   34         F033      MWARM	EQU 0F033H	; goto Monitor
   35                   
   36         1000      MEMADDR	EQU 01000H	; address for boot loader in memory
   37                   
   38         0000      BOOTDRV	EQU 0		; only used for message
   39                   
   40                   ;-----------------------------------------------------------------------------
   41                   
   42 0100  31 00FF     WBOOT:	LD SP,0FFH	; set stack
   43                   
   44 0103  21 013B     	LD HL,MSG1
   45 0106  CD 0131     	CALL WRSTR
   46                   
   47 0109  21 1000     	LD HL,MEMADDR	; START ADRESSE Boot Loader
   48 010C  16 00       	LD D,0		; write to track 0
   49 010E  1E 01       	LD E,1		; write to sector 1 (first sector)
   50                   
   51 0110  E5          	PUSH HL
   52 0111  D5          	PUSH DE
   53 0112  C5          	PUSH BC
   54                   	;LD C,11010000B	; laufwerk 0 double dense mini
   55                   	;LD B,2		; 1=read, 2=write
   56                   	;CALL MINI	; Monitor Einsprung Mini Laufwerk
   57                   	; use new floppy routine instead
   58 0113  0E 21       	LD C,00100001B	; drive 0, dd, mini
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NPUTBOOTZ80

   59 0115  06 02       	LD B,2		; 2 = write
   60 0117  CD F021     	CALL FLOP	; -> read sector
   61 011A  C1          	POP BC
   62 011B  D1          	POP DE
   63 011C  E1          	POP HL
   64 011D  38 09       	JR C,WBOOT2	; -> error -> call monitor restart
   65                   		
   66                   	; no error
   67                   	; we did not use the BIOS, so we can return to the Monitor
   68 011F  21 0157     	LD HL,MSG2
   69 0122  CD 0131     	CALL WRSTR
   70 0125  C3 F033     	JP MWARM
   71                   
   72 0128              WBOOT2:	; error
   73 0128  21 0182     	LD HL,ERRMSG
   74 012B  CD 0131     	CALL WRSTR
   75 012E  C3 F033     	JP MWARM
   76                   
   77                   ;-----------------------------------------------------------------------------
   78                   ; Uses monitor CONOUT to print 0-terminated string
   79                   ; address in HL
   80                   ; 00h = string end
   81                   
   82 0131  7E          WRSTR:	LD A,(HL)	; get char from string
   83 0132  A7          	AND A		; check if 0
   84 0133  C8          	RET Z		; -> end of string
   85                   	
   86 0134  4F          	LD C,A
   87 0135  CD F009     	CALL CONOUT
   88 0138  23          	INC HL		; next char in string
   89 0139  18 F6       	JR WRSTR	; start over
   90                   
   91         000D      CR	EQU 0DH
   92         000A      LF	EQU 0AH
   93                   
   94 013B  0D 0A 4E 50 MSG1:	DEFB CR,LF,"NPUTBOOT V1.0 260809-01",CR,LF,0
   95                   
   96 0157  42 6F 6F 74 MSG2:	DEFM "Bootloader written from 1000h to drive ",BOOTDRV+'A',CR,LF,0
   97                   
   98 0182  0D 0A 45 72 ERRMSG	DEFM CR,LF,"Error",CR,LF,0
   99                   
  100                   ;-----------------------------------------------------------------------------
  101                   
  102                   	END
