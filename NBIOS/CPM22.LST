 3575 E0EC  CD D972     FCREATE:CALL	CLEARS2		;clear the 's2' byte on all creates.
 3576 E0EF  CD E051     	CALL	AUTOSEL		;select proper drive and get the next
 3577 E0F2  C3 DD24     	JP	GETEMPTY	;empty directory space.
