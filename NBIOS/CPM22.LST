 3513 E08D  32 D742     	LD	(ACTIVE),A
 3514 E090  21 0080     	LD	HL,TBUFF	;setup default dma address.
 3515 E093  22 E1B1     	LD	(USERDMA),HL
 3516 E096  CD D9DA     	CALL	DEFDMA
 3517 E099  C3 E021     	JP	LOGINDRV	;now log in drive 'A'.
 3518                   ;
 3519                   ;   Function to open a specified file.
 3520                   ;
 3521 E09C  CD D972     OPENFIL:CALL	CLEARS2		;clear 's2' byte.
 3522 E09F  CD E051     	CALL	AUTOSEL		;select proper disk.
 3523 E0A2  C3 DC51     	JP	OPENIT		;and open the file.
 3524                   ;
 3525                   ;   Function to close a specified file.
 3526                   ;
 3527 E0A5  CD E051     CLOSEFIL: CALL	AUTOSEL		;select proper disk.
 3528 E0A8  C3 DCA2     	JP	CLOSEIT		;and close the file.
 3529                   ;
 3530                   ;   Function to return the first occurence of a specified file
 3531                   ; name. If the first byte of the fcb is '?' then the name will
 3532                   ; not be checked (get the first entry no matter what).
 3533                   ;
 3534 E0AB  0E 00       GETFST:	LD	C,0		;prepare for special search.
 3535 E0AD  EB          	EX	DE,HL
 3536 E0AE  7E          	LD	A,(HL)		;is first byte a '?'?
 3537 E0AF  FE 3F       	CP	'?'
 3538 E0B1  CA E0C2     	JP	Z,GETFST1	;yes, just get very first entry (zero length match).
 3539 E0B4  CD D8A6     	CALL	SETEXT		;get the extension byte from fcb.
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  62
CPM22   Z80

 3540 E0B7  7E          	LD	A,(HL)		;is it '?'? if yes, then we want
 3541 E0B8  FE 3F       	CP	'?'		;an entry with a specific 's2' byte.
 3542 E0BA  C4 D972     	CALL	NZ,CLEARS2	;otherwise, look for a zero 's2' byte.
 3543 E0BD  CD E051     	CALL	AUTOSEL		;select proper drive.
 3544 E0C0  0E 0F       	LD	C,15		;compare bytes 0-14 in fcb (12&13 excluded).
 3545 E0C2  CD DB18     GETFST1:CALL	FINDFST		;find an entry and then move it into
 3546 E0C5  C3 D9E9     	JP	MOVEDIR		;the users dma space.
 3547                   ;
 3548                   ;   Function to return the next occurence of a file name.
 3549                   ;
 3550 E0C8  2A E1D9     GETNXT:	LD	HL,(SAVEFCB)	;restore pointers. note that no
 3551 E0CB  22 D743     	LD	(PARAMS),HL	;other dbos calls are allowed.
 3552 E0CE  CD E051     	CALL	AUTOSEL		;no error will be returned, but the
 3553 E0D1  CD DB2D     	CALL	FINDNXT		;results will be wrong.
 3554 E0D4  C3 D9E9     	JP	MOVEDIR
