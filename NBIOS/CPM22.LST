 3579                   ;   Function to rename a file.
 3580                   ;
 3581 E0F5  CD E051     RENFILE:CALL	AUTOSEL		;select proper drive and then switch
 3582 E0F8  CD DC16     	CALL	CHGNAMES	;file names.
 3583 E0FB  C3 DB01     	JP	STSTATUS
