 3612                   ;
 3613 E11D  CD E051     SETATTR:CALL	AUTOSEL		;select proper drive then save attributes.
 3614 E120  CD DC3B     	CALL	SAVEATTR
 3615 E123  C3 DB01     	JP	STSTATUS
