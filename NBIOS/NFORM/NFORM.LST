Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NFORM   Z80

    1                   	.z80
    2                   
    3                   ;*****************************************************************************
    4                   ; NFORM.Z80  Universal Formatierer fuer Mini/Maxi
    5                   ;
    6                   ; Boot loader for MC CP/M-Computer Mini drive with FLO2 contoller
    7                   ;
    8                   ; based on UFORMAT Rev 1.22 (C) 1984 Rolf-Dieter Klein / JS
    9                   ;
   10                   ;*****************************************************************************
   11                   ; works directly on Monitor and FLO2 hardware, does not need CP/M or BIOS
   12                   
   13                   ; 80 Spur Laufwerke   1K pro Sektor Boot
   14                   ; das programm wird auf sektor 1 track 0 abgelegt
   15                   ;
   16                   ; PLEASE NOTE THE CHANGED CPM & BIOS START ADDRESS!!!
   17                   ;
   18                   ; Version history
   19                   ;
   20                   ; 31.05.2026 *dg* Source code of version 1.22 retrieved from binary
   21                   ; 10.07.2026 *dg* Renamed to NFORM and reformatted
   22                   ; 27.07.2026 *dg* Experimental Interleave for NDR format (hard coded)
   23                   
   24                   ;-----------------------------------------------------------------------------
   25                   
   26         0000      FALSE	EQU 0
   27         FFFF      TRUE	EQU NOT FALSE
   28                   
   29                   ;-----------------------------------------------------------------------------
   30                   ; variantes
   31         FFFF      DG01	EQU TRUE
   32                   
   33                   ;-----------------------------------------------------------------------------
   34                   
   35                   ; IO ADDESSES FLO1/FLO2 Mini/Maxi
   36         00C0      FLO0	EQU 0C0H	; Status/Command
   37         00C1      FLO1	EQU 0C1H	; Track
   38         00C2      FLO2	EQU 0C2H	; Sector
   39         00C3      FLO3	EQU 0C3H	; Data
   40         00C4      FLO4	EQU 0C4H	; Special FLO-Flags
   41                   
   42                   ; IO ADDESSES FLO1 Maxi
   43         0040      FLOA0	EQU 040H
   44         0041      FLOA1	EQU 041H
   45         0042      FLOA2	EQU 042H
   46         0043      FLOA3	EQU 043H
   47         0044      FLOA4	EQU 044H
   48                   
   49                   ; IO ADDESSES FLO1 Mini
   50         0030      FLOB0	EQU 030H
   51         0031      FLOB1	EQU 031H
   52         0032      FLOB2	EQU 032H
   53         0033      FLOB3	EQU 033H
   54         0034      FLOB4	EQU 034H
   55                   
   56                   ;-----------------------------------------------------------------------------
   57                   
   58         0100      	ORG 100H
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NFORM   Z80

   59                   
   60 0100  C3 0722     	JP START 	; Hauptprogramm
   61                   
   62                   ;-----------------------------------------------------------------------------
   63                   
   64 0103  C3 F009     CONOUT:	JP 0F009H 	; Ausgabe eines Zeichens in C
   65                   
   66                   ;-----------------------------------------------------------------------------
   67                   
   68 0106  CD F003     CONIN:	CALL 0F003H 	; Eingabe eines Zeichens nach A
   69 0109  E6 7F       	AND 7FH
   70 010B  C9          	RET
   71                   
   72                   ;-----------------------------------------------------------------------------
   73                   ; Interrupt routine
   74                   
   75 010C  F1          INTR:	POP AF
   76                   	; reset interrupts
   77 010D  DB 40       	IN A,(FLOA0)
   78 010F  DB 30       	IN A,(FLOB0)
   79 0111  DB C0       	IN A,(FLO0)
   80 0113  FB          	EI
   81 0114  ED 4D       	RETI
   82                   
   83                   ;-----------------------------------------------------------------------------
   84                   ; Universal Formatter
   85                   
   86 0116  21 1548     FORMAT:	LD HL,FMSG 
   87 0119  CD 0BAD     	CALL PRNMSG
   88                   	
   89                   	; reset interrupts
   90 011C  DB 40       	IN A,(FLOA0) 	; ggf. bei gemischtem Betrieb auch
   91 011E  DB 30       	IN A,(FLOB0)   	; andere Ports loeschen
   92 0120  DB C0       	IN A,(FLO0) 	; alle Interrupts loeschen
   93                   
   94 0122  ED 56       	IM 1  		; MODE 1, RST-7 verwenden
   95 0124  3E C3       	LD A,0C3H 	; Sprungvektor setzen (JP)
   96 0126  32 0038     	LD (38H),A
   97 0129  21 010C     	LD HL,INTR
   98 012C  22 0039     	LD (39H),HL 	; auf Interruptroutine
   99                   
  100                   	; --- format ---------------------------------------------------------
  101                   
  102 012F  CD 04A2     	CALL HOME 	; set head to track 0
  103                   
  104 0132  AF          	XOR A
  105 0133  32 18A3     	LD (CURTRK),A  	; start with track 0
  106 0136  3A 189D     	LD A,(TRKCNT) 	; number of tracks
  107 0139  47          	LD B,A
  108                   
  109 013A              FORM1:	; format loop (tracks)
  110                   
  111                   	; --- format side 0 ---
  112                   	
  113 013A  C5          	PUSH BC
  114 013B  CD 01F3     	CALL ECMACHK 	; check if track 0 and ECMA70
  115 013E  CD 02E3     	CALL GENTRK 	; create track
  116 0141  CD 0688     	CALL FRMTRK 	; format track
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NFORM   Z80

  117 0144  CD 0245     	CALL ERRCHK
  118                   	
  119 0147  3A 189E     	LD A,(SSDS)
  120 014A  FE 01       	CP 1
  121 014C  C2 0178     	JP NZ,FORM3	; -> single sided
  122                   
  123                   	; --- double-sided,. format side 1 ---
  124                   	
  125 014F  3A 18A0     	LD A,(DRIVE)	; Rueckseite setzen
  126 0152  F6 80       	OR 80H  	; aber kein Side-sel
  127 0154  32 18A0     	LD (DRIVE),A
  128                   
  129 0157  3A 18A2     	LD A,(USESSO)
  130 015A  B7          	OR A
  131 015B  CA 0163     	JP Z,FORM2	; -> no SSO
  132                   	
  133                   	; SSO
  134 015E  3E 80       	LD A,80H 
  135 0160  32 18A1     	LD (SIDESEL),A 	; setzen
  136                   
  137 0163  CD 02E3     FORM2:	CALL GENTRK
  138 0166  CD 0688     	CALL FRMTRK
  139 0169  CD 0245     	CALL ERRCHK
  140                   	
  141                   	; set side 0
  142 016C  3A 18A0     	LD A,(DRIVE)
  143 016F  E6 7F       	AND 7FH
  144 0171  32 18A0     	LD (DRIVE),A   
  145 0174  AF          	XOR A
  146 0175  32 18A1     	LD (SIDESEL),A
  147                   
  148 0178  3A 18A3     FORM3:	LD A,(CURTRK)
  149 017B  3C          	INC A
  150 017C  32 18A3     	LD (CURTRK),A
  151 017F  47          	LD B,A
  152 0180  3A 189D     	LD A,(TRKCNT)
  153 0183  B8          	CP B
  154 0184  CA 018A     	JP Z,FORM4	; AKTRK = TRKCNT
  155                   	
  156 0187  CD 055A     	CALL STEPIN
  157                   	
  158 018A  0E 46       FORM4:	LD C,'F'
  159 018C  CD 0103     	CALL CONOUT 	; Meldung FFFFF ausgeben bei jeder Spur ein F
  160 018F  C1          	POP BC
  161 0190  10 A8       	DJNZ FORM1	; -> format loop (tracks)
  162                   
  163                   	; verify -------------------------------------------------------------
  164                   	
  165 0192  21 1814     	LD HL,VMSG
  166 0195  CD 0BAD     	CALL PRNMSG
  167                   	
  168 0198  CD 04A2     	CALL HOME	; set head to track 0
  169                   	
  170 019B  AF          	XOR A
  171 019C  32 18A3     	LD (CURTRK),A  	; start with track 0
  172 019F  3A 189D     	LD A,(TRKCNT) 	; number of tracks
  173 01A2  47          	LD B,A
  174                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
NFORM   Z80

  175 01A3              FORM5:	; verify loop (tracks)
  176                   
  177                   	; --- verify side 0 ---
  178                   
  179 01A3  C5          	PUSH BC
  180 01A4  CD 01F3     	CALL ECMACHK
  181 01A7  CD 0465     	CALL VERIFY
  182 01AA  3A 189E     	LD A,(SSDS)
  183 01AD  FE 01       	CP 1
  184 01AF  C2 01D5     	JP NZ,FORM7	; -> single-sided
  185                   
  186                   	; --- double-sided, verify side 1 ---
  187                   	
  188 01B2  3A 18A0     	LD A,(DRIVE)
  189 01B5  F6 80       	OR 80H
  190 01B7  32 18A0     	LD (DRIVE),A
  191 01BA  3A 18A2     	LD A,(USESSO)
  192 01BD  B7          	OR A
  193 01BE  CA 01C6     	JP Z,FORM6	; -> no SSO
  194                   	
  195                   	; SSO
  196 01C1  3E 80       	LD A,80H
  197 01C3  32 18A1     	LD (SIDESEL),A
  198                   
  199 01C6  CD 0465     FORM6:	CALL VERIFY
  200                   
  201                   	; set side 0
  202 01C9  3A 18A0     	LD A,(DRIVE)
  203 01CC  E6 7F       	AND 7FH
  204 01CE  32 18A0     	LD (DRIVE),A 
  205 01D1  AF          	XOR A
  206 01D2  32 18A1     	LD (SIDESEL),A 	; wieder Seite 0
  207                   
  208 01D5  3A 18A3     FORM7:	LD A,(CURTRK)
  209 01D8  3C          	INC A
  210 01D9  32 18A3     	LD (CURTRK),A
  211 01DC  47          	LD B,A
  212 01DD  3A 189D     	LD A,(TRKCNT)
  213 01E0  B8          	CP B
  214 01E1  CA 01E7     	JP Z,FORM8	; -> TRKCNT = CURTRK
  215                   
  216 01E4  CD 055A     	CALL STEPIN
  217                   
  218 01E7  0E 56       FORM8:	LD C,'V' 
  219 01E9  CD 0103     	CALL CONOUT 	; VVVVV fuer Verify
  220 01EC  C1          	POP BC
  221 01ED  10 B4       	DJNZ FORM5	; -> verify loop (tracks)
  222                   	
  223 01EF  CD 04A2     	CALL HOME 	; set head to track 0
  224 01F2  C9          	RET
  225                   	
  226                   ;-----------------------------------------------------------------------------
  227                   ; Set ECMA70 format
  228                   
  229 01F3              ECMACHK:
  230 01F3  3A 1897     	LD A,(ECMA)	; 1=ECMA70
  231 01F6  B7          	OR A
  232 01F7  C8          	RET Z  		; no ECMA70
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   5
NFORM   Z80

  233                   	
  234 01F8  AF          	XOR A
  235 01F9  32 1896     	LD (MINMAX),A 	; always mini drive
  236                   	
  237 01FC  3A 18A3     	LD A,(CURTRK)
  238 01FF  B7          	OR A
  239 0200  C2 0225     	JP NZ,ECMAC1	; -> not track 0
  240                   	
  241                   	; track 0, format single-density
  242 0203  21 0080     	LD HL,128
  243 0206  22 1898     	LD (BYTCNT),HL
  244                    	
  245 0209  3E 00       	LD A,0 		; single density
  246 020B  32 189B     	LD (DENSITY),A 	;
  247 020E  3E 00       	LD A,0		; single-sided
  248 0210  32 189E     	LD (SSDS),A
  249 0213  3E 10       	LD A,16		; 16 sectors
  250 0215  32 189F     	LD (SECCNT),A
  251 0218  3E 1B       	LD A,27
  252 021A  32 189C     	LD (GAPLEN),A
  253 021D  3E 28       	LD A,40		; 40 tracks
  254 021F  32 189D     	LD (TRKCNT),A
  255 0222  C3 0244     	JP ECMAC2
  256                   	
  257 0225              ECMAC1:	; not track 0, format double density
  258 0225  21 0100     	LD HL,256
  259 0228  22 1898     	LD (BYTCNT),HL
  260                   	
  261 022B  3E 01       	LD A,1		; double density
  262 022D  32 189B     	LD (DENSITY),A
  263 0230  3E 00       	LD A,0 		; single-sided
  264 0232  32 189E     	LD (SSDS),A
  265 0235  3E 10       	LD A,16 	; 16 sectors
  266 0237  32 189F     	LD (SECCNT),A
  267 023A  3E 36       	LD A,54
  268 023C  32 189C     	LD (GAPLEN),A 	; STD Gap
  269 023F  3E 28       	LD A,40 	; 40 tracks
  270 0241  32 189D     	LD (TRKCNT),A
  271                   
  272 0244  C9          ECMAC2:	RET
  273                   
  274                   ;-----------------------------------------------------------------------------
  275                   ; General error check routine
  276                   
  277                   ; error code in A
  278                   ;   bit 2 = CPU to slow
  279                   ;   bit 3 = CRC error
  280                   ;   bit 4 = record not found
  281                   ;   bit 5 = wrong record type
  282                   ;   bit 6 = write protected
  283                   
  284 0245  B7          ERRCHK:	OR A
  285 0246  C8          	RET Z  	; =0? -> Status ok
  286                   	
  287                   	; TRACK, Spur ausgeben
  288 0247  F5          	PUSH AF 	; save error code
  289 0248  21 16FD     	LD HL,TKMSG
  290 024B  CD 0BAD     	CALL PRNMSG
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   6
NFORM   Z80

  291 024E  3A 18A3     	LD A,(CURTRK)
  292 0251  6F          	LD L,A
  293 0252  26 00       	LD H,0 
  294 0254  CD 02AE     	CALL PRNTHL
  295 0257  21 1708     	LD HL,SKMSG
  296 025A  CD 0BAD     	CALL PRNMSG
  297 025D  3A 18A4     	LD A,(CURSEC)
  298 0260  6F          	LD L,A
  299 0261  26 00       	LD H,0
  300 0263  CD 02AE     	CALL PRNTHL
  301 0266  CD 0D64     	CALL CRLF
  302                   
  303 0269  F1          	POP AF  	; restore error code
  304                   	
  305                   	; check bit 2
  306 026A  CB 57       	BIT 2,A
  307 026C  21 16C9     	LD HL,F0MSG 	; error message
  308 026F  CA 0275     	JP Z,ERRC1	; -> bit 2 not set
  309                   	
  310                   	; bit 2, CPU too slow
  311 0272  21 1657     	LD HL,F2MSG
  312                   
  313 0275              ERRC1:	; check bit 3
  314 0275  CB 5F       	BIT 3,A
  315 0277  CA 027D     	JP Z,ERRC2	; -> bit 3 not set
  316                   
  317                   	; bit 3, CRC errror
  318 027A  21 161F     	LD HL,F3MSG
  319                   
  320 027D              ERRC2:	; check bit 4
  321 027D  CB 67       	BIT 4,A
  322 027F  CA 0285     	JP Z,ERRC3	; -> bit 4 not set
  323                   	
  324                   	; bit 4, record not found
  325 0282  21 15E8     	LD HL,F4MSG
  326                   	
  327 0285              ERRC3:	; check bit 5
  328 0285  CB 6F       	BIT 5,A
  329 0287  CA 028D     	JP Z,ERRC4	; -> bit 5 not set
  330                   
  331                   	; bit 5, wrong record type
  332 028A  21 15B1     	LD HL,F5MSG
  333                   
  334 028D              ERRC4:	; check bit 6
  335 028D  CB 77       	BIT 6,A
  336 028F  CA 0295     	JP Z,ERRC5	; -> bit 6 not set
  337                   
  338                   	; bit 6, write protected
  339 0292  21 157A     	LD HL,F6MSG
  340                   	
  341 0295              ERRC5:	; check bit 7
  342 0295  CA 029B     	JP Z,ERRC6
  343                   	
  344                   	; bit 7, write protected
  345 0298  21 157A     	LD HL,F6MSG 	; dominant is write proteced error
  346                   
  347 029B  CD 0BAD     ERRC6:	CALL PRNMSG
  348                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   7
NFORM   Z80

  349 029E              ERRC7:	; wait for 'W' or 'w'
  350 029E  CD 0106     	CALL CONIN
  351 02A1  FE 57       	CP 'W'
  352 02A3  CA 02AB     	JP Z,ERRC8
  353 02A6  FE 77       	CP 'w'
  354 02A8  C2 029E     	JP NZ,ERRC7
  355                   
  356 02AB  C3 0722     ERRC8:	JP START 	; no stack adjust needed
  357                   	
  358                   ;-----------------------------------------------------------------------------
  359                   ; PRNMSG decimal value in HL
  360                   	
  361 02AE  AF          PRNTHL:	XOR A
  362 02AF  F5          	PUSH AF
  363                   
  364 02B0              PRNTH1:	; digit loop
  365 02B0  3E 10       	LD A,16
  366 02B2  01 000A     	LD BC,10 	; div 10
  367 02B5  11 0000     	LD DE,0 	; Rest
  368 02B8  EB          	EX DE,HL
  369                   	
  370 02B9              PRNTH2:	; division loop
  371 02B9  F5          	PUSH AF
  372 02BA  CB 23       	SLA E
  373 02BC  CB 12       	RL D
  374 02BE  CB 15       	RL L
  375 02C0  CB 14       	RL H
  376 02C2  CB C3       	SET 0,E
  377 02C4  AF          	XOR A
  378 02C5  ED 42       	SBC HL,BC
  379 02C7  D2 02CD     	JP NC,PRNTH3
  380                   	
  381 02CA  09          	ADD HL,BC
  382 02CB  CB 83       	RES 0,E
  383                   	
  384 02CD  F1          PRNTH3:	POP AF
  385 02CE  3D          	DEC A
  386 02CF  20 E8       	JR NZ,PRNTH2
  387                   	
  388 02D1  EB          	EX DE,HL 	; HL=result, DE=remainder
  389 02D2  7B          	LD A,E
  390 02D3  F6 30       	OR 30H
  391 02D5  F5          	PUSH AF
  392 02D6  7C          	LD A,H
  393 02D7  B5          	OR L
  394 02D8  20 D6       	JR NZ,PRNTH1	; -> loop
  395                   	
  396 02DA              PRNTH4:	;output
  397 02DA  F1          	POP AF
  398 02DB  B7          	OR A
  399 02DC  C8          	RET Z
  400                   	
  401 02DD  4F          	LD C,A
  402 02DE  CD 0103     	CALL CONOUT
  403 02E1  18 F7       	JR PRNTH4
  404                   	
  405                   ;-----------------------------------------------------------------------------
  406                   ; Create new track
