  845                   ;=============================================================================
  846                   ; Read Mini disk, 80 Spur, DD, DS
  847                   
  848                   ;READ und WRITE unter Verwendung von MEXEC
  849                   ; HL=DMA ADR
  850                   ; DE=TRACK/SECTOR
  851                   ; B=0 RSTORE
  852                   ;   1 READ
  853                   ;   2 WRITE
  854                   ; C=DRIVE 0...3  10H,11H,12H,13H  DOUBMIN 0D0H,0D1H,0D2H,0D3H
  855                   ;                                          A   C    B    D
  856                   
  857         FC00      PHSBUF	EQU 0FC00H	; Memory area of interactive Monitor for logical sector (1K)
  858                   
  859                   ;-----------------------------------------------------------------------------
  860                   ; Calculates physical drive from DBANK and IOT -> C
  861                   ; calculates physical sector from logical sector, IOS -> E
  862                   ; calculates logical track from physical track, IOT -> D
  863                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page  19
NBIOS   Z80

  864 E5F0              MINCAL:	; logical sector to physical sector
  865                   	; get drive specific factor
  866 E5F0  3A E7A6     	LD A,(BLPOW)
  867 E5F3  A7          	AND A
  868 E5F4  28 0A       	JR Z,MINIC4	; -> factor = 0
  869                   
