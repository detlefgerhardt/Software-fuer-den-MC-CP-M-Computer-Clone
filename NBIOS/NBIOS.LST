  611 E4FF  5F          	LD E,A
  612 E500  3A E7AE     	LD A,(PHYSIDS)
  613 E503  47          	LD B,A
  614 E504  3A E7A8     	LD A,(BLREG)
  615 E507  E6 B0       	AND 10110000B
  616 E509  4F          	LD C,A
  617 E50A  C9          	RET
