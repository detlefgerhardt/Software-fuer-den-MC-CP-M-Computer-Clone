  762                   ;-----------------------------------------------------------------------------
  763                   ; Write sector using MFLOP into monitor
  764                   
  765                   ; Buffer (DMA address) in IOD
  766                   ; Drive in DBANK (0..n-1)
  767                   ; Track in IOT (0..n-1)
  768                   ; Sector in IOS (0..n-1)
  769                   ; BDOS-Flag in C (0 = standard sector, 1 = directory sector, 2 =  first sector in block)
  770                   
  771 E5A6              WRITE:	; reset CF/IDE flag
  772 E5A6  AF          	XOR A
  773 E5A7  32 E7A9     	LD (ISIDE),A
  774                   	
  775 E5AA  3A E7A1     	LD A,(DBANK)
  776 E5AD  FE 08       	CP 8
  777 E5AF  30 1C       	JR NC,WRERR	; DBANK >= 8 -> does not exist
  778                   
  779                   	; DBANK < 8
  780 E5B1  3A E7A8     	LD A,(BLREG)
  781 E5B4  E6 80       	AND 10000000B	; flag for IDE disk
  782 E5B6  28 08       	JR Z,WRITE1	; -> no IDE disk
  783                   
  784                   	; IDE disk
  785 E5B8  3E 01       	LD A,1
  786 E5BA  32 E7A9     	LD (ISIDE),A
  787 E5BD  C3 E677     	JP MINIWR	; -> IDE disk
  788                   	
  789 E5C0  3A E7A8     WRITE1:	LD A,(BLREG)
  790 E5C3  E6 30       	AND 00110000B
  791 E5C5  FE 10       	CP 00010000B
  792 E5C7  CA E5D0     	JP Z,MAXIWR	; -> Maxi disk
  793 E5CA  C3 E677     	JP MINIWR
  794                   	
  795                   	;---------------------------------------------------------------------
  796                   
  797                   	; error
  798 E5CD  3E 01       WRERR:	LD A,1		; Fehler da, Bank nicht vorhanden,
  799 E5CF  C9          	RET		; wirkt wie BAD-Sektor
  800                   
  801                   	;---------------------------------------------------------------------
  802                   	; Write Maxi disk
  803                   
  804 E5D0  06 05       MAXIWR:	LD B,RETRY
  805                   
