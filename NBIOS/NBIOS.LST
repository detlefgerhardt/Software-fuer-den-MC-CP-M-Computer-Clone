  597                   
  598                   ;-----------------------------------------------------------------------------
  599                   ; returns the physical drive parameters for the current drive
  600                   
  601                   ; HL = bytes/sector (1..n)
  602                   ; D  = highest sector/track (0..n-1)
  603                   ; E  = highest track/side (0..n-1)
  604                   ; B  = sides (1..n)
  605                   ; C  = FLO register (density/datarate)
  606                   
  607 E4F5  2A E7AA     GETPHY:	LD HL,(PHYBYTS)
  608 E4F8  3A E7AC     	LD A,(PHYSECS)
  609 E4FB  57          	LD D,A
