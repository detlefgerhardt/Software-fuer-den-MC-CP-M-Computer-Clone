  395 E426  3C          	INC A		; SPUR 0, dann SPUR 2, wegen BOOT.ASM
  396 E427  32 E7A2     	LD (IOT),A	; denn 1,3,5 ist die Rueckseite des Laufwerks
  397 E42A  3E FF       	LD A,0FFH	; 0,1,2,3.... will by incremented to 0
  398                   	
  399 E42C  3C          WBOO4:	INC A
