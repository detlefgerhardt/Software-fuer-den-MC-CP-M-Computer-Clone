  467                   ;-----------------------------------------------------------------------------
  468                   ; Select disk (used by BDOS)
  469                   ; drive-code in C (0..n-1)
  470                   ; seldsk sets also the parameters for blocking/deblocking and for the phys.
  471                   ; drive parameters. The phys. drive parameters can be request by the new
  472                   ; BIOS function GETPHY.
  473                   
  474 E482  21 0000     SELDSK:	LD HL,0		; und pruefen ob gueltig
  475 E485  79          	LD A,C		; wenn groesser als ndisks
  476 E486  FE 08       	CP NDISKS	; dann nicht ok
  477 E488  D0          	RET NC		; Nummer 0 bis n-1 erscheint in A
  478                   	
  479 E489  32 E7A1     	LD (DBANK),A
  480                   
  481                   	;POP HL
  482                   	;PUSH HL
  483                   	;CALL DEBSEL
  484                   
  485                   	; get address of DPEx -> HL (= DPBASE + disk number * 16)
  486 E48C  69          	LD L,C		; disk number
  487 E48D  26 00       	LD H,0
  488 E48F  29          	ADD HL,HL	; HL <- HL * 16
  489 E490  29          	ADD HL,HL	
  490 E491  29          	ADD HL,HL	
  491 E492  29          	ADD HL,HL	
  492 E493  11 E239     	LD DE,DPBASE	; add DPBASE
  493 E496  19          	ADD HL,DE
  494                   
  495                   	; get additional deblockling parameters from the end of
  496                   	; the regluar DPBx block
  497 E497  E5          	PUSH HL
  498                   
  499                   	; calc start of addidtion parameters
  500 E498  11 000A     	LD DE,10	; position of DPBx in DPEx
  501 E49B  19          	ADD HL,DE
  502 E49C  5E          	LD E,(HL)
  503 E49D  23          	INC HL
  504 E49E  56          	LD D,(HL)
  505 E49F  EB          	EX DE,HL	; address of DPEx now in HL
  506 E4A0  11 000F     	LD DE,15	; length of DPBx
  507 E4A3  19          	ADD HL,DE
  508                   	
  509                   	; set blocking shift
  510 E4A4  7E          	LD A,(HL)
  511 E4A5  32 E7A6     	LD (BLPOW),A
  512 E4A8  23          	INC HL
  513                   	; set blocking mask
  514 E4A9  7E          	LD A,(HL)
  515 E4AA  32 E7A7     	LD (BLMSK),A
