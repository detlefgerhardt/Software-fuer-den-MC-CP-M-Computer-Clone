  944 E639  C2 E652     	JP NZ,MINIR2	; -> drive not equal, load sector
  945                   	
  946 E63C  3A E79E     	LD A,(CURTRK)
  947 E63F  BA          	CP D		; compare track
  948 E640  C2 E652     	JP NZ,MINIR2	; -> track not equal, load sector
  949                   	
  950 E643  3A E79F     	LD A,(CURSEC)
  951 E646  BB          	CP E		; compare sector
  952 E647  C2 E652     	JP NZ,MINIR2	; -> sector not equal, load sector
  953                   
  954                   	; blocking / deblocking
