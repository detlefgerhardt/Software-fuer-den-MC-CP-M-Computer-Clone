  632                   
  633                   ;=============================================================================
  634                   ; Read and write sector using MFLOP into monitor
  635                   
  636                   ;-----------------------------------------------------------------------------
  637                   ; Read sector
  638                   
  639                   ; Buffer (DMA address) in IOD
  640                   ; Drive in DBANK (0..n-1)
  641                   ; Track in IOT (0..n-1 * side)
  642                   ; Sector in IOS (0..n-1)
  643                   
  644 E518              READ:	; reset CF/IDE flag
  645 E518  AF          	XOR A
  646 E519  32 E7A9     	LD (ISIDE),A
  647                   
  648 E51C  3A E7A1     	LD A,(DBANK)
  649 E51F  FE 08       	CP 8
  650 E521  30 1C       	JR NC,RDERR	; DBANK >= 8 -> does not exist
  651                   	
  652                   	; DBANK < 8
  653 E523  3A E7A8     	LD A,(BLREG)
  654 E526  E6 80       	AND 10000000B	; flag for IDE disk
  655 E528  28 08       	JR Z,READ1	; -> no IDE disk
  656                   
  657                   	; IDE disk
  658 E52A  3E 01       	LD A,1
  659 E52C  32 E7A9     	LD (ISIDE),A
  660 E52F  C3 E632     	JP MINIRD	; -> IDE disk
  661                   
  662 E532  3A E7A8     READ1:	LD A,(BLREG)
  663 E535  E6 30       	AND 00110000B
  664 E537  FE 10       	CP 00010000B	; flag for Maxi disk (bit5=0, bit4=4)
  665 E539  CA E586     	JP Z,MAXIRD	; -> Maxi disk
  666 E53C  C3 E632     	JP MINIRD	; -> Mini disk
  667                   
  668                   	;---------------------------------------------------------------------
  669                   
  670                   	; error
  671 E53F  3E 01       RDERR:	LD A,1		; Fehler da, Bank nicht vorhanden,
  672 E541  C9          	RET		; wirkt wie BAD-Sektor
  673                   
  674                   	;---------------------------------------------------------------------
  675                   	
  676 E542  AF          NOERR:	XOR A		; sonst ok.
  677 E543  C9          	RET
  678                   
  679                   	;---------------------------------------------------------------------
  680                   	; Calculate address for ram disk, source in HL
  681                   	; SEKTOR 0..E,  TRAck 0..5fh
  682                   	; SSSSTTTT T0000000   , adresse fuer RAM-Floppy
  683 E544  3A E7A2     ADRERZ:	LD A,(IOT)		; Track holen
  684 E547  0F           	RRCA 			; und umrechnen
  685 E548  E6 0F        	AND 0FH			; unterer Teil vom MSB
  686 E54A  67           	LD H,A
  687 E54B  3A E7A3      	LD A,(IOS)		; dann Sektor dazu
  688 E54E  07           	RLCA
  689 E54F  07           	RLCA
