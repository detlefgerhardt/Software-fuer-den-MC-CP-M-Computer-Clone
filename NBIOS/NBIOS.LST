  877 E600              MINIC4:	; factor = 0
  878 E600  3A E7A3     	LD A,(IOS)
  879                   
  880 E603  3C          MINIC5:	INC A		; sector number starts with 1
  881 E604  5F          	LD E,A		; save in E
  882                   
  883 E605  3A E7A9     	LD A,(ISIDE)
  884 E608  A7          	AND A
  885 E609  28 09       	JR Z,MINC5A	; -> no CF/IDE drive
  886                   
  887                   	; -> is CF/IDE drive, no drive or track translation
  888 E60B  3A E7A1     	LD A,(DBANK)
  889 E60E  4F          	LD C,A
  890 E60F  3A E7A2     	LD A,(IOT)
  891 E612  57          	LD D,A
  892 E613  C9          	RET
  893                   
  894 E614              MINC5A:	; drive A,B,C,D -> 0001,0010,0100,1000
  895 E614  3A E7A1     	LD A,(DBANK)	; 0..3
