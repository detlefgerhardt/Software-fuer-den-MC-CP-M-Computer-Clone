  364 E3F1  01 CC00     	LD BC,CPMB	; Init load address to CPM start address
  365 E3F4  CD E4EF     	CALL SETDMA
  366 E3F7  0E 00       	LD C,BTDRV	; drive 0 (or BTDRV)
  367 E3F9  CD E482     	CALL SELDSK
  368 E3FC  0E 00       	LD C,0		; track 0
  369 E3FE  CD E4CC     	CALL SETTRK
  370 E401  0E 08       	LD C,CPMST	; start with first logical sector behind physical boot sector
  371 E403  CD E4D1     	CALL SETSEC	; (depends on the number of logical sectors per phyiscal sector)
  372 E406  C1          	POP BC
