  356 E3E6  3E FF       WBOO1:	LD A,0FFH	; alle Tracks ungueltig, bei Diskettenwechsel wichtig
  357 E3E8  32 E79B     	LD (CURDRV),A
  358                   
  359 E3EB  31 0080     	LD SP,BUFF	; Stack zuweisen
  360 E3EE  0E 05       	LD C,RETRY	; Anzahl der Versuche
