/* format IBMSD 250KB  (128/26/77/1) */
drvfmt IBMSD =
{
	"IBMSD",
	250,
	{
		128,	/* bytes/sector */
		26,	/* sectors/track */
		77,	/* tracks/side */
		0,	/* 0=SS/1=DS */
		0,	/* 1=DD/0=SD (inverted to FLO reg) */
		1,	/* 1=Maxi/0=Mini (inverted to FLO reg) */
		0,	/* UseSSO */
		27,	/* gap3 length */
		0xE5	/* filler */
	}
};

#define FMTCNT 5
drvfmt *fmtlist[] = {F800K,F1440K,F1280K,F1200K,IBMSD};

