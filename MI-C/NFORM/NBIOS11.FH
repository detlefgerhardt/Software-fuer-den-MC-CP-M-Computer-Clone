/* ndiskdef NBIOS11.FH created 03.10.26 19:51 by NDiskDef 1.0 */
/* format F800K 800KB  (1024/5/80/2) */
drvfmt F800K =
{
	"F800K",
	800,
	{
		1024,	/* bytes/sector */
		5,	/* sectors/track */
		80,	/* tracks/side */
		1,	/* 0=SS/1=DS */
		1,	/* 1=DD/0=SD (inverted to FLO reg) */
		0,	/* 1=Maxi/0=Mini (inverted to FLO reg) */
		1,	/* UseSSO */
		54,	/* gap3 length */
		0xE5	/* filler */
	}
};

