  0047'   D5                    	PUSH DE
  0048'   41                    	LD B,C			; timeout value
  0049'                         RECV1:
                                	;LD DE,159 SHL 7	; 4 MHZ *)	
                                	;LD DE,159 SHL 8		; 49 cycle loop, 6.272ms/wrap * 159 = 1 second (6 MHz)
                                	;LD DE,120 SHL 8		; 4 Mhz	(low byte must be 0)
  0049'   11 B400               	LD DE,180 SHL 8			; 6 Mhz	(low byte must be 0)
  004C'   3A 0000               	LD	A,(0)
  004F'   B7                    	OR	A
  0050'   C2 0053'              	JP	NZ,RECV2
  0053'                         RECV2:
  0053'   CD 0002'              	CALL BCONST
  0056'   B7                    	OR A
  0057'   C2 006A'              	JP NZ,RECV3		; -> got char
                                ;
                                	; wait for char
  005A'   1D                    	DEC E			; counter low
  005B'   C2 0053'              	JP NZ,RECV2
  005E'   15                    	DEC D			; counter high
  005F'   C2 0053'              	JP NZ,RECV2
  0062'   05                    	DEC B			; timeout counter
  0063'   C2 0049'              	JP NZ,RECV1
                                	; timeout, set carry
  0066'                         RECVTO:
  0066'   21 FFFF               	LD HL,0FFFFH	; -1 = timeout
  0069'   C9                    	RET
  006A'                         RECV3:
  006A'   CD 0005'              	CALL BCONIN		; char -> A
  006D'   6F                    	LD L,A			; return char in HL
  006E'   26 00                 	LD H,0
  0070'   C9                    	RET
  0071'   C9                    	RET
