  0000                          FALSE	EQU 0
  FFFF                          TRUE	EQU NOT FALSE
                                ;SIOADR	EQU	020H	; SIO port A data register
                                ;SIOACR	EQU	021H	; SIO port A control register
                                ; UART
                                ;XMTMASK EQU 1		; MASK TO ISOLATE XMIT READY BIT
                                ;XMTRDY  EQU 1		; VALUE WHEN READY
                                ;RCVMASK EQU 2		; MASK TO ISOLATE RECEIVE READY BIT
                                ;RCVRDY	EQU	2		; BIT ON WHEN READY
                                ; Monitor
                                ;MCONIN	EQU 0F003H
                                ;MCONOUT EQU 0F009H
                                ;MCONST	EQU 0F012H
                                ; BIOS
  0000'   0000                  BIOS:	DW 0
  0002'                         BCONST: DS 3	; JP BCONST
  0005'                         BCONIN:	DS 3	; JP CONIN
  0008'                         BCONOUT:DS 3	; JP BCONOUT
  000B'                         SetBios:
  000B'   3E C3                 	LD A,0C3H		; JP
  000D'   32 0002'              	LD (BCONST),A
  0010'   32 0005'              	LD (BCONIN),A
  0013'   32 0008'              	LD (BCONOUT),A
  0016'   2A 0001               	LD HL,(0001H)	; BIOS address + 3
                                ;
  0019'   E5                    	PUSH HL
  001A'   11 0003               	LD DE,0006H - 3
  001D'   19                    	ADD HL,DE
  001E'   22 0003'              	LD (BCONST+1),HL
  0021'   E1                    	POP HL
  0022'   E5                    	PUSH HL
  0023'   11 0006               	LD DE,0009H - 3
  0026'   19                    	ADD HL,DE
  0027'   22 0006'              	LD (BCONIN+1),HL
  002A'   E1                    	POP HL
  002B'   E5                    	PUSH HL
  002C'   11 0009               	LD DE,000CH - 3
  002F'   19                    	ADD HL,DE
  0030'   22 0009'              	LD (BCONOUT+1),HL
  0033'   E1                    	POP HL
  0034'   22 0000'              	LD (BIOS),HL
  0037'   C9                    	RET
  0038'                         Send:
  0038'   E1                    	POP HL
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


  0039'   C1                    	POP BC			; get char in C
  003A'   C5                    	PUSH BC
  003B'   E5                    	PUSH HL
                                ;
  003C'                         SEND1:
