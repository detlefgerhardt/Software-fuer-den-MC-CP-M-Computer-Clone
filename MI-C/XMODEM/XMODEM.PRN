  0050'   C2 0063'              	JP NZ,RECV3		; -> got char
                                ;
                                	; wait for char
  0053'   1D                    	DEC E			; counter low
  0054'   C2 004C'              	JP NZ,RECV2
  0057'   15                    	DEC D			; counter high
  0058'   C2 004C'              	JP NZ,RECV2
  005B'   05                    	DEC B			; timeout counter
  005C'   C2 0049'              	JP NZ,RECV1
                                	; timeout, set carry
