  0033'   E1                    	POP HL
  0034'   22 0000'              	LD (BIOS),HL
  0037'   C9                    	RET
  0038'                         Send:
  0038'   E1                    	POP HL
  0039'   C1                    	POP BC			; get char in C
  003A'   C5                    	PUSH BC
  003B'   E5                    	PUSH HL
                                ;
  003C'                         SEND1:
