Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NFORM-CFZ80

    1                   ;*****************************************************************************
    2                   ; NFORM-CF.Z80
    3                   ;
    4                   ; Formats a physikal disk at the IDE/CF interface as 4 partitions for 4
    5                   ; CP/M drives
    6                   ;
    7                   ; based on FORM-CF by Uli Haumann 05/2026
    8                   ;
    9                   ;*****************************************************************************
   10                   ; Writes E5h to 64 (256) sectors on tracks 1 to 255 of each disk (track 0 is reserved for system)
   11                   ; Uses BIOS calls. Load a BIOS that supports CF-card to the BIOS address before starting the
   12                   ; format program.
   13                   ;
   14                   ; PLEASE NOTE THE CHANGED BIOS START ADDRESS !!!
   15                   ;
   16                   ; Version history
   17                   ;
   18                   ; 09.07.2026 *dg* Renamed to NFORM-CF and reformatted
   19                   ;                 Replaced Monitor write_string function because it might
   20                   ;                 be overwritten bei the BIOS
   21                   ; 05.09.2026 *dg* Adapted to new 8192KB format
   22                   
   23         0000      FALSE	EQU 0
   24         FFFF      TRUE	EQU NOT FALSE
   25                   
   26                   
   27         E200      BIOS	EQU 0EA00H-800H
   28                   
   29         FFFF      NEWIDE	EQU TRUE
   30                   
   31                   ; BIOS functions
   32         E21B      SELDSK	EQU BIOS+01BH		; pass disk no. in C
   33         E21E      SETTRK	EQU BIOS+01EH		; pass track in reg C
   34         E221      SETSEC	EQU BIOS+021H		; pass sector in reg C
   35         E224      SETDMA	EQU BIOS+024H		; pass address in BC
   36         E22A      WRITE	EQU BIOS+02AH		; write one CP/M sector to disk (128 bytes)
   37                   
   38                   ; Monitor functions
   39         F009      CONOUT	EQU 0F009H		; print a character im Monitor
   40         F033      MWARM	EQU 0F033H
   41                   
   42         0004      STRDSK	EQU 4			; first CF disk (E:)
   43         0007      ENDDSK	EQU 7			; last CF disk (H:)
   44                   
   45         0100      	ORG 0100H
   46                   
   47 0100  31 0388     FORM:	LD SP,STACK
   48                   
   49 0103  21 01AC     	LD HL,STRMSG
   50 0106  CD 01A2     	CALL WRSTR		; output start message
   51                   
   52 0109  3E 00       	LD A,0
   53 010B  32 0208     	LD (CHAR_COUNT),A
   54                   	
   55 010E  3E 04       	LD A,STRDSK		; first ide/cf disk
   56 0110  32 0205     	LD (CURDSK),A
   57                   
   58 0113              FORM1:	; disk loop
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NFORM-CFZ80

   59 0113  3A 0205     	LD A,(CURDSK)
   60 0116  4F          	LD C,A			; set current disk
   61 0117  CD E21B     	CALL SELDSK
   62 011A  3E 01       	LD A,1			; starting track (offset = 1)
   63 011C  32 0207     	LD (CURTRK),A
   64                   
   65 011F              FORM2:	; track loop
   66 011F  3E 00       	LD A,0			; starting sector 0
   67 0121  32 0206     	LD (CURSEC),A
   68 0124  3A 0207     	LD A,(CURTRK)
   69 0127  4F          	LD C,A			; set track
   70 0128  CD E21E     	CALL SETTRK
   71                   
   72 012B              FORM3:	; sector loop
   73 012B  3A 0206     	LD A,(CURSEC)
   74 012E  4F          	LD C,A			; set sector
   75 012F  CD E221     	CALL SETSEC
   76 0132  01 0209     	LD BC,DIR_SECTOR
   77 0135  CD E224     	CALL SETDMA
   78 0138  CD E22A     	CALL WRITE
   79 013B  E6 01       	AND 01h			; error flag
   80 013D  20 5A       	JR NZ,ERROR
   81                   
   82 013F  3A 0206     	LD A,(CURSEC)
   83         0000      	IF NOT NEWIDE
   85                   	ELSE
   86 0142  FE FF       	CP 255
   87                   	ENDIF
   88 0144  28 06       	JR Z,FORM4
   89                   
   90 0146  3C          	INC A
   91 0147  32 0206     	LD (CURSEC),A
   92 014A  18 DF       	JR FORM3		; -> next sector
   93                   
   94 014C              FORM4:	; next track
   95 014C  3A 0207     	LD A,(CURTRK)
   96 014F  FE FF       	CP 255
   97 0151  28 26       	JR Z,FORM6		; -> next disk
   98                   		
   99 0153  3C          	INC A
  100 0154  32 0207     	LD (CURTRK),A
  101                   	;LD A,'.'		; print dot
  102 0157  0E 2E       	LD C,'.'
  103 0159  CD F009     	CALL CONOUT
  104 015C  3A 0208     	LD A,(CHAR_COUNT)
  105 015F  3C          	INC A
  106 0160  FE 50       	CP 80
  107 0162  28 05       	JR Z,FORM5
  108                   	
  109 0164  32 0208     	LD (CHAR_COUNT),A
  110 0167  18 B6       	JR FORM2		; -> next track
  111                   
  112 0169  AF          FORM5:	XOR A
  113 016A  32 0208     	LD (CHAR_COUNT),A
  114                   	;LD A,0DH		; CR ausgeben
  115 016D  0E 0D       	LD C,0DH
  116 016F  CD F009     	CALL CONOUT
  117                   	;LD A,0AH		; LF ausgeben
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NFORM-CFZ80

  118 0172  0E 0A       	LD C,0Ah
  119 0174  CD F009     	CALL CONOUT
  120 0177  18 A6       	JR FORM2		; -> next track
  121                   
  122 0179              FORM6:	; next disk
  123 0179  AF          	XOR A
  124 017A  32 0208     	LD (CHAR_COUNT),A
  125 017D  3A 0205     	LD A,(CURDSK)		;naechste virtuelle Diskette
  126 0180  3C          	INC A
  127 0181  FE 08       	CP ENDDSK+1		;fertig ?
  128 0183  28 0B       	JR Z,FORM7		; -> done
  129                   
  130 0185  32 0205     	LD (CURDSK),A
  131                   	;PUSH HL
  132 0188  21 01ED     	LD HL,DISK_STRING	;next Disk ausgeben
  133 018B  CD 01A2     	CALL WRSTR
  134                   	;POP HL
  135 018E  18 83       	JR FORM1		; -> next disk
  136                   
  137 0190              FORM7:	; done
  138 0190  21 01D3     	LD HL,END_STRING	; success message
  139 0193  CD 01A2     	CALL WRSTR
  140                   	
  141 0196  C3 F033     	JP MWARM
  142                   
  143                   
  144 0199  21 01FB     ERROR:	LD HL,ERRMSG
  145 019C  CD 01A2     	CALL WRSTR
  146 019F  C3 F033     	JP MWARM
  147                   
  148                   ;-----------------------------------------------------------------------------
  149                   ; Uses monitor CONOUT to print 0-terminated string
  150                   ; address in HL
  151                   ; 00h = string end
  152                   
  153 01A2  7E          WRSTR:	LD A,(HL)		; get char from string
  154 01A3  A7          	AND A			; check if 0
  155 01A4  C8          	RET Z			; -> end of string
  156                   
  157 01A5  4F          	LD C,A
  158 01A6  CD F009     	CALL CONOUT
  159 01A9  23          	INC HL			; next char in string
  160                   	
  161 01AA  18 F6       	JR WRSTR		; start over
  162                   
  163                   ;-----------------------------------------------------------------------------
  164                   
  165 01AC  0D 0A 0A 46 STRMSG:		DEFM	0dh,0ah,0ah,"Formating 4 virtual disks",0dh,0ah,"disk 1",0dh,0ah,0
  166 01D3  0D 0A 46 6F END_STRING:	DEFM	0dh,0ah,'Formatting completed',0dh,0dh,0ah,0
  167 01ED  0D 0A 4E 65 DISK_STRING:	DEFM	0dh,0ah,'Next disk',0dh,0ah,0
  168                   
  169 01FB  0D 0A 65 72 ERRMSG:		DEFM	0Dh,0Ah,"error",0Dh,0Ah,0
  170                   
  171 0205    0001      CURDSK:		DEFS	1
  172 0206    0001      CURSEC:		DEFS	1
  173 0207    0001      CURTRK:		DEFS	1
  174                   ;ADDRESS:	DEFS	2
  175 0208    0001      CHAR_COUNT:	DEFS	1
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   4
NFORM-CFZ80

  176 0209  E5 E5 E5 E5 DIR_SECTOR:	DS	128,0E5h	;byte for empty directory
  177 0289    00FF      		DS	0FFh		;stack space
  178                   
  179 0388              STACK:
  180                   
  181                   ;-----------------------------------------------------------------------------
  182                   
  183                   	END
