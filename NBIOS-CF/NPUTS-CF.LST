Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NPUTS-CFZ80

    1                   ;*****************************************************************************
    2                   ; NPUTS-CF.Z80 V1.0
    3                   ;
    4                   ; Writes CP/M and BIOS from memory (notice start addresses to the IDE/CF
    5                   ; Interface
    6                   ;
    7                   ; based on PUTSYS from Donn Stewart, June 2019
    8                   ; changed by Ulrich Haumann 04/2026
    9                   ;
   10                   ;*****************************************************************************
   11                   ; Image size is 6400 bytes, so need to save 6400/128 = 50 sectors
   12                   ; For system with 64-sector tracks, image can all be on track 0
   13                   ; Load and run from ROM monitor
   14                   ; Uses calls to cbios, in memory at EA00h
   15                   ; benuzt calls zum Monitor im oberen RAM F000h
   16                   ; Copies the memory image of CP/M loaded at CPM onto track 0 of the first CP/M disk
   17                   ; Writes track 0, sectors 1 to 50 (sector 0 has cpm loader)
   18                   ;
   19                   ; PLEASE NOTE THE CHANGED CP/M & BIOS START ADDRESS AND CF/IDE DRIVES !!!
   20                   ;
   21                   ; Version history
   22                   ;
   23                   ; 10.07.2026 *dg* Renamed to PUTSY-CF and reformatted
   24                   ;                 Changed BIOS address to E200
   25                   ;		  Changed for CF/IDE drives 4..7 (E..H)
   26                   ; 09.08.2026 *dg* Renamed to NPUTS-CF, Jump to BIOS when finished,
   27                   ;		  because the program uses the BIOS and overwrites the monitor.
   28                   
   29         0000      FALSE	EQU 0
   30         FFFF      TRUE	EQU NOT FALSE
   31         FFFF      TEST	EQU TRUE
   32         000D      CR	EQU 0DH
   33         000A      LF	EQU 0AH
   34                   
   35         FFFF      NEWIDE	EQU TRUE	; new 8192 KB format
   36                   
   37         CC00      CPM	EQU 0D400H-800H
   38         E200      BIOS	EQU 0EA00H-800H
   39                   
   40                   ; Monitor calls
   41                   
   42                   ;MWARM	EQU 0F033H	; Monitor entry
   43                   
   44                   ; bios calls
   45                   
   46         E20C      CONOUT	EQU BIOS+00CH	; output char in C
   47         E21B      SELDSK	EQU BIOS+01BH	; pass disk no. in c
   48         E224      SETDMA	EQU BIOS+024H	; pass address in bc
   49         E21E      SETTRK	EQU BIOS+01EH	; pass track in reg C
   50         E221      SETSEC	EQU BIOS+021H	; pass sector in reg c
   51         E22A      WRITE	EQU BIOS+02AH	; write one CP/M sector to disk
   52                   
   53         0004      BOOTDRV	EQU 4		; first IDE/CF-drive
   54                   
   55                   ; sector count (1024 byte sectors)
   56                   ; on a IDE/CF disk 1 track is reserved: 64 sectors
   57         0000      	IF NOT NEWIDE
   59                   	ELSE
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NPUTS-CFZ80

   60         0048      SECCNT	EQU (0F000h-CPM) / 128
   61                   	ENDIF
   62                   	
   63                   ;-----------------------------------------------------------------------------
   64                   
   65         0100      	ORG 100H	; program starts at 100H
   66                   
   67                   ; write track 0, sectors 1 to SECCNT
   68                   ; only one system track available!
   69                   
   70 0100  21 0159     PUT:	LD HL,MSG1
   71 0103  CD 014E     	CALL WRSTR
   72                   
   73 0106  0E 04       	LD C,BOOTDRV	; first CF/IDE drive
   74 0108  CD E21B     	CALL SELDSK		
   75 010B  3E 01       	LD A,1		; starting with 2. sector (0..n-1) 
   76 010D  32 019C     	LD (SECTOR),A
   77 0110  21 CC00     	LD HL,CPM	; memory address to start
   78 0113  22 019D     	LD (ADDR),HL
   79 0116  0E 00       	LD C,0		; CP/M track
   80 0118  CD E21E     	CALL SETTRK
   81                   
   82 011B              PUT1:	; track loop
   83 011B  3A 019C     	LD A,(SECTOR)
   84 011E  4F          	LD C,A		; CP/M sector
   85 011F  CD E221     	CALL SETSEC
   86 0122  ED 4B 019D  	LD BC,(ADDR)	; memory location
   87 0126  CD E224     	CALL SETDMA
   88 0129  CD E22A     	CALL WRITE
   89 012C  3A 019C     	LD A,(SECTOR)
   90                   	;CP 50
   91 012F  FE 48       	CP SECCNT
   92 0131  CA 0145     	JP Z,PUT2
   93                   		
   94 0134  3C          	INC A
   95 0135  32 019C     	LD (SECTOR),A
   96 0138  2A 019D     	LD HL,(ADDR)
   97 013B  11 0080     	LD DE,128
   98 013E  19          	ADD HL,DE
   99 013F  22 019D     	LD (ADDR),HL
  100 0142  C3 011B     	JP PUT1
  101                   
  102 0145              PUT2:	; finished
  103 0145  21 0175     	LD HL,MSG2
  104 0148  CD 014E     	CALL WRSTR
  105                   
  106 014B  C3 E200     	JP BIOS
  107                   
  108                   ;-----------------------------------------------------------------------------
  109                   ; Uses BIOS CONOUT to print 0-terminated string
  110                   ; address in HL
  111                   
  112 014E  7E          WRSTR:	LD A,(HL)	; get char from string
  113 014F  A7          	AND A		; check if 0
  114 0150  C8          	RET Z		; -> end of string
  115                   	
  116 0151  4F          	LD C,A
  117 0152  CD E20C     	CALL CONOUT
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NPUTS-CFZ80

  118 0155  23          	INC HL		; next char in string
  119 0156  C3 014E     	JP WRSTR	; start over
  120                   
  121                   ;-----------------------------------------------------------------------------
  122                   
  123 0159  0D 0A 4E 50 MSG1:	DEFB CR,LF,"NPUTS-CF V1.1 260905-02",CR,LF,0
  124                   	
  125 0175  53 79 73 74 MSG2:	DEFM "System written to drive ",BOOTDRV+'A'," on IDE/CF",CR,LF,LF,0
  126                   
  127                   ;-----------------------------------------------------------------------------
  128                   
  129 019C  00          SECTOR:	DB	00H
  130 019D  0000        ADDR:	DW	0000H
  131                   
  132                   ;-----------------------------------------------------------------------------
  133                   
  134                   	END
