Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   1
NBOOT-CFZ80

    1                   ;*****************************************************************************
    2                   ; NBOOT-CF.Z80
    3                   ;
    4                   ; Boot loader for MC CP/M-Computer IDE/CF drive
    5                   ;
    6                   ; based on BLOAD-CF von Uli Haumann from 06/2026
    7                   ;
    8                   ;*****************************************************************************
    9                   ; Load CP/M image from IDE/Compact-Flash into memory starting at cpm_start
   10                   ; Uses calls to Monitor routine for read directly from IDE interface
   11                   ;
   12                   ; Reads track 0, sectors 1 to 50
   13                   ; This program is loaded into LBA sector 0 of disk with the tool NBPUT-CF.
   14                   ; At boot time it is loaded by the Monitor to address 08000h and executed.
   15                   ;
   16                   ; PLEASE NOTE THE CHANGED CPM & BIOS START ADDRESS!!!
   17                   ;
   18                   ; Version history
   19                   ;
   20                   ; 10.07.2026 *dg* Renamed to NBOOT-CF and reformatted
   21                   ; 11.07.2026 *dg* Increased number of sectors to read to 63 because of larger BIOS
   22                   ; 05.09.2026 *dg* Adapted to new IDE/CF format NEWIDE (8192 KB)
   23                   
   24         0000      FALSE	EQU 0
   25         FFFF      TRUE	EQU NOT FALSE
   26                   
   27         FFFF      NEWIDE	EQU TRUE
   28                   
   29         8100      HSTBUF	EQU 08100H		; will put 256-byte raw sector here
   30         E200      BIOS	EQU 0EA00H-800H		; CP/M cold start entry
   31         CC00      CPM	EQU 0D400H-800H		; CCP Start
   32                   
   33         F009      CONOUT	EQU 0F009H		; Console out
   34         F02A      IDEREAD	EQU 0F02AH		; Monitor function IDEREAD
   35                   
   36         0019      IDESTAT	EQU 010+0FH		; Hardwareadresse IDE Statusregister
   37                   
   38         0000      	IF NOT NEWIDE
   41                   	ELSE
   42                   	; on a IDE/CF disk 1 track is reserved: 128 sectors
   43         0048      SECCNT	EQU (0F000h-CPM)/128
   44                   	ENDIF
   45                   	
   46                   ;-----------------------------------------------------------------------------
   47                   
   48         8000      	ORG 08000H
   49                   
   50                   ; read track 0, sectors 1 to SECCNT
   51                   
   52 8000  21 805A     BOOT:	LD HL,MSG
   53 8003  CD 8050     	CALL WRSTR
   54                   
   55 8006  3E 01       	LD A,1			; starting sector -- sector 0 has cpm_loader
   56 8008  32 8072     	LD (SECTOR),A
   57 800B  21 CC00     	LD HL,CPM		; memory address to place image
   58 800E  22 8074     	LD (DMAAD),HL
   59 8011  3E 00       	LD A,0			; CP/M track
   60 8013  32 8073     	LD (TRACK),A
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
NBOOT-CFZ80

   61                   
   62 8016              BOOT1:	; read track 0 loop
   63 8016  CD 8033     	CALL RDSEC
   64 8019  3A 8072     	LD A,(SECTOR)
   65 801C  FE 48       	CP SECCNT
   66 801E  28 10       	JR Z,BOOT2
   67                   
   68                   	; inc sector
   69 8020  3C          	INC A
   70 8021  32 8072     	LD (SECTOR),A
   71                   
   72                   	; (DMAAD) += 128
   73 8024  2A 8074     	LD HL,(DMAAD)
   74 8027  11 0080     	LD DE,128
   75 802A  19          	ADD HL,DE
   76 802B  22 8074     	LD (DMAAD),HL
   77                   	
   78 802E  18 E6       	JR BOOT1
   79                   
   80 8030  C3 E200     BOOT2:	JP BIOS
   81                   
   82                   ;-----------------------------------------------------------------------------
   83                   ; Read one CP/M sector from partition 0 by calling the monitor.
   84                   ; No drive number needed)
   85                   ; Track number in (TRACK)
   86                   ; Sector number in (SECTOR)
   87                   ; DMA address in (DMAAD), location in memory to place the CP/M sector
   88                   
   89 8033              RDSEC:	
   90         0000      	IF NOT NEWIDE
  119                   	ELSE		; NEWIDE
  120                   
  121                   	; NEWIDE (8192K):
  122                   	; LBA
  123                   	; 00000000 00000000 00000000
  124                   	; 0000000d dsssssss tttttttt
  125                   	;        E        B        C
  126                   
  127                   	; LBA0..7 -> C
  128 8033  3A 8073     	LD A,(TRACK)
  129 8036  4F          	LD C,A		; LBA0..7 -> B
  130                   
  131                   	;LD A,(CURDRV)
  132                   	;SUB A,4	; drive 4..7 -> drive 0..3
  133                   	;LD E,A
  134 8037  1E 00       	LD E,0		; partition 0
  135 8039  CB 3B       	SRL E		; drive bit 1 -> bit 0, bit 0 -> carry
  136                   			; LBA16..23 -> E
  137                   
  138 803B  06 00       	LD B,0
  139 803D  CB 18       	RR B		; carry -> bit 7
  140 803F  3A 8072     	LD A,(SECTOR)
  141 8042  3D          	DEC A		; phys sect. starts wird 1
  142 8043  B0          	OR B
  143 8044  47          	LD B,A		; LBA8..15 -> B
  144                   
  145 8045  21 8100     	LD HL,HSTBUF	; buffer to place raw disk sector (256 bytes)
  146                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
NBOOT-CFZ80

  147 8048  CD F02A     	CALL IDEREAD	; ide read routine in Monitor
  148                   			; Transfer top 128-bytes out of buffer to memory
  149                   			
  150 804B  DB 19       	IN A,(IDESTAT)	; get status
  151 804D  E6 01       	AND 01H		; error bit
  152 804F  C9          	RET
  153                   	
  154                   	ENDIF		; NEWIDE
  155                   
  156                   ;-----------------------------------------------------------------------------
  157                   
  158 8050  7E          WRSTR:	LD A,(HL)	; get char from string
  159 8051  A7          	AND A		; check if 0
  160 8052  C8          	RET Z		; -> end of string
  161                   	
  162 8053  4F          	LD C,A
  163 8054  CD F009     	CALL CONOUT
  164 8057  23          	INC HL		; next char in string
  165 8058  18 F6       	JR WRSTR	; start over
  166                   
  167         000D      CR	EQU 0DH
  168         000A      LF	EQU 0AH
  169                   
  170 805A  0D 0A 4E 42 MSG:	DEFB CR,LF,"NBOOT-CF 1.1 260906",CR,LF,0
  171                   
  172                   ;-----------------------------------------------------------------------------
  173                   
  174 8072    0001      SECTOR:	DS	1
  175 8073    0001      TRACK:	DS	1
  176 8074    0002      DMAAD:	DS	2
  177                   
  178                   	END
